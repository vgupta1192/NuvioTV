+
+private val SLEEP_CHOICES = listOf(0, 15, 30, 60, 90, 120)
+
+/**
+ * Live TV options panel: subtitles, audio language, video quality, sleep timer, mute, previous channel,
+ * stream reload and a short line of stream stats. Opened from the fullscreen HUD with OK / Menu / Info / Captions.
+ */
+@OptIn(ExperimentalTvMaterial3Api::class, UnstableApi::class)
+@Composable
+fun TvChannelOptionsPanel(
+    player: ExoPlayer?,
+    channelName: String?,
+    previousChannelName: String?,
+    sleepMinutes: Int,
+    isMuted: Boolean,
+    onPreviousChannel: () -> Unit,
+    onSleepSelected: (Int) -> Unit,
+    onMuteToggle: () -> Unit,
+    onReload: () -> Unit,
+    onClose: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    var tracks by remember(player) { mutableStateOf(player?.currentTracks ?: Tracks.EMPTY) }
+    var autoQuality by remember(player) { mutableStateOf(true) }
+    var stats by remember(player) { mutableStateOf("") }
+    val firstFocus = remember { FocusRequester() }
+
+    DisposableEffect(player) {
+        val listener = object : Player.Listener {
+            override fun onTracksChanged(newTracks: Tracks) {
+                tracks = newTracks
+            }
+        }
+        player?.addListener(listener)
+        onDispose { player?.removeListener(listener) }
+    }
+
+    LaunchedEffect(player) {
+        while (true) {
+            stats = player?.let { buildStatsLine(it) }.orEmpty()
+            delay(2_000L)
+        }
+    }
+
+    LaunchedEffect(Unit) {
+        yield()
+        delay(60L)
+        runCatching { firstFocus.requestFocus() }
+    }
+
+    val textGroups = tracks.groups.filter { it.type == C.TRACK_TYPE_TEXT }
+    val audioGroups = tracks.groups.filter { it.type == C.TRACK_TYPE_AUDIO }
+    val videoGroups = tracks.groups.filter { it.type == C.TRACK_TYPE_VIDEO }
+    val anyTextSelected = textGroups.any { it.isSelected }
+
+    Box(
+        modifier = modifier
+            .fillMaxHeight()
+            .width(400.dp)
+            .background(
+                Brush.horizontalGradient(
+                    listOf(Color(0xE60A0A10), Color(0xF20A0A10))
+                )
+            )
+            .padding(horizontal = 22.dp, vertical = 20.dp)
+    ) {
+        LazyColumn(
+            modifier = Modifier.fillMaxWidth(),
+            verticalArrangement = Arrangement.spacedBy(8.dp)
+        ) {
+            item {
+                Column {
+                    Text(
+                        text = "Live TV options",
+                        style = MaterialTheme.typography.titleLarge,
+                        fontWeight = FontWeight.ExtraBold,
+                        color = Color.White
+                    )
+                    if (!channelName.isNullOrBlank()) {
+                        Text(
+                            text = channelName,
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = Color.White.copy(alpha = 0.7f),
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis
+                        )
+                    }
+                    if (stats.isNotBlank()) {
+                        Text(
+                            text = stats,
+                            fontSize = 12.sp,
+                            color = NuvioTheme.colors.Secondary
+                        )
+                    }
+                }
+            }
+
+            item { SectionLabel("Subtitles") }
+            item {
+                OptionRow(
+                    label = "Off",
+                    selected = !anyTextSelected,
+                    modifier = Modifier.focusRequester(firstFocus),
+                    onClick = {
+                        player?.let {
+                            it.trackSelectionParameters = it.trackSelectionParameters.buildUpon()
+                                .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, true)
+                                .build()
+                        }
+                    }
+                )
+            }
+            if (textGroups.isEmpty()) {
+                item { HintText("This stream has no subtitle tracks.") }
+            } else {
+                textGroups.forEach { group ->
+                    for (i in 0 until group.length) {
+                        item {
+                            OptionRow(
+                                label = trackLabel(group.getTrackFormat(i), "Subtitle ${i + 1}"),
+                                selected = group.isTrackSelected(i),
+                                onClick = {
+                                    player?.let {
+                                        it.trackSelectionParameters = it.trackSelectionParameters.buildUpon()
+                                            .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, false)
+                                            .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, i))
+                                            .build()
+                                    }
+                                }
+                            )
+                        }
+                    }
+                }
+            }
+
+            if (audioGroups.sumOf { it.length } > 1) {
+                item { SectionLabel("Audio") }
+                audioGroups.forEach { group ->
+                    for (i in 0 until group.length) {
+                        item {
+                            OptionRow(
+                                label = trackLabel(group.getTrackFormat(i), "Audio ${i + 1}"),
+                                selected = group.isTrackSelected(i),
+                                onClick = {
+                                    player?.let {
+                                        it.trackSelectionParameters = it.trackSelectionParameters.buildUpon()
+                                            .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, i))
+                                            .build()
+                                    }
+                                }
+                            )
+                        }
+                    }
+                }
+            }
+
+            val heights = videoGroups
+                .flatMap { g -> (0 until g.length).map { i -> Triple(g, i, g.getTrackFormat(i).height) } }
+                .filter { it.third > 0 }
+                .distinctBy { it.third }
+                .sortedByDescending { it.third }
+            if (heights.size > 1) {
+                item { SectionLabel("Quality") }
+                item {
+                    OptionRow(
+                        label = "Auto",
+                        selected = autoQuality,
+                        onClick = {
+                            autoQuality = true
+                            player?.let {
+                                it.trackSelectionParameters = it.trackSelectionParameters.buildUpon()
+                                    .clearOverridesOfType(C.TRACK_TYPE_VIDEO)
+                                    .build()
+                            }
+                        }
+                    )
+                }
+                heights.forEach { (group, index, height) ->
+                    item {
+                        OptionRow(
+                            label = "${height}p",
+                            selected = !autoQuality && group.isTrackSelected(index),
+                            onClick = {
+                                autoQuality = false
+                                player?.let {
+                                    it.trackSelectionParameters = it.trackSelectionParameters.buildUpon()
+                                        .setOverrideForType(TrackSelectionOverride(group.mediaTrackGroup, index))
+                                        .build()
+                                }
+                            }
+                        )
+                    }
+                }
+            }
+
+            item { SectionLabel("Sleep timer") }
+            item {
+                Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                    SLEEP_CHOICES.forEach { minutes ->
+                        Chip(
+                            label = if (minutes == 0) "Off" else "${minutes}m",
+                            selected = sleepMinutes == minutes,
+                            onClick = { onSleepSelected(minutes) }
+                        )
+                    }
+                }
+            }
+
+            item { SectionLabel("Playback") }
+            item {
+                OptionRow(
+                    label = if (isMuted) "Unmute" else "Mute",
+                    selected = isMuted,
+                    onClick = onMuteToggle
+                )
+            }
+            if (!previousChannelName.isNullOrBlank()) {
+                item {
+                    OptionRow(
+                        label = "Previous channel: $previousChannelName",
+                        selected = false,
+                        onClick = onPreviousChannel
+                    )
+                }
+            }
+            item {
+                OptionRow(
+                    label = "Reload stream",
+                    selected = false,
+                    onClick = onReload
+                )
+            }
+            item {
+                OptionRow(
+                    label = "Close",
+                    selected = false,
+                    onClick = onClose
+                )
+            }
+        }
+    }
+}
+
+@Composable
+private fun SectionLabel(text: String) {
+    Text(
+        text = text.uppercase(),
+        fontSize = 11.sp,
+        fontWeight = FontWeight.Bold,
+        color = Color.White.copy(alpha = 0.5f),
+        modifier = Modifier.padding(top = 10.dp)
+    )
+}
+
+@Composable
+private fun HintText(text: String) {
+    Text(
+        text = text,
+        fontSize = 12.sp,
+        color = Color.White.copy(alpha = 0.45f),
+        modifier = Modifier.padding(horizontal = 4.dp)
+    )
+}
+
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun OptionRow(
+    label: String,
+    selected: Boolean,
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val shape = RoundedCornerShape(14.dp)
+    Surface(
+        onClick = onClick,
+        modifier = modifier.fillMaxWidth(),
+        shape = ClickableSurfaceDefaults.shape(shape),
+        scale = ClickableSurfaceDefaults.scale(focusedScale = 1.03f),
+        colors = ClickableSurfaceDefaults.colors(
+            containerColor = if (selected) NuvioTheme.colors.Secondary.copy(alpha = 0.22f) else Color.White.copy(alpha = 0.06f),
+            focusedContainerColor = Color.White,
+            contentColor = Color.White,
+            focusedContentColor = Color.Black
+        ),
+        border = ClickableSurfaceDefaults.border(
+            border = Border(
+                border = BorderStroke(1.dp, if (selected) NuvioTheme.colors.Secondary else Color.Transparent),
+                shape = shape
+            )
+        )
+    ) {
+        Row(
+            modifier = Modifier
+                .fillMaxWidth()
+                .padding(horizontal = 16.dp, vertical = 11.dp),
+            horizontalArrangement = Arrangement.SpaceBetween
+        ) {
+            Text(
+                text = label,
+                fontSize = 15.sp,
+                fontWeight = if (selected) FontWeight.Bold else FontWeight.Medium,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+                modifier = Modifier.weight(1f, fill = false)
+            )
+            if (selected) {
+                Text(text = "●", fontSize = 13.sp, color = NuvioTheme.colors.Secondary)
+            }
+        }
+    }
+}
+
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun Chip(label: String, selected: Boolean, onClick: () -> Unit) {
+    val shape = RoundedCornerShape(50)
+    Surface(
+        onClick = onClick,
+        shape = ClickableSurfaceDefaults.shape(shape),
+        scale = ClickableSurfaceDefaults.scale(focusedScale = 1.08f),
+        colors = ClickableSurfaceDefaults.colors(
+            containerColor = if (selected) NuvioTheme.colors.Secondary else Color.White.copy(alpha = 0.08f),
+            focusedContainerColor = Color.White,
+            contentColor = Color.White,
+            focusedContentColor = Color.Black
+        )
+    ) {
+        Text(
+            text = label,
+            fontSize = 13.sp,
+            fontWeight = FontWeight.SemiBold,
+            modifier = Modifier.padding(horizontal = 12.dp, vertical = 7.dp)
+        )
+    }
+}
+
+private fun trackLabel(format: Format, fallback: String): String {
+    val language = format.language?.takeIf { it.isNotBlank() && it != "und" }?.let {
+        Locale(it).displayLanguage.replaceFirstChar { c -> c.uppercase() }
+    }
+    val name = format.label?.takeIf { it.isNotBlank() } ?: language
+    val channels = when (format.channelCount) {
+        Format.NO_VALUE, 1, 2 -> null
+        6 -> "5.1"
+        8 -> "7.1"
+        else -> "${format.channelCount}ch"
+    }
+    val parts = listOfNotNull(name, channels)
+    return if (parts.isEmpty()) fallback else parts.joinToString(" · ")
+}
+
+@OptIn(UnstableApi::class)
+private fun buildStatsLine(player: ExoPlayer): String {
+    val video = player.videoFormat
+    val parts = ArrayList<String>(4)
+    if (video != null && video.width > 0 && video.height > 0) parts += "${video.width}×${video.height}"
+    if (video != null && video.frameRate > 0f) parts += "${video.frameRate.toInt()} fps"
+    val bitrate = video?.bitrate?.takeIf { it > 0 } ?: video?.averageBitrate?.takeIf { it > 0 }
+    if (bitrate != null) parts += String.format(Locale.US, "%.1f Mbps", bitrate / 1_000_000f)
+    val latency = player.currentLiveOffset
+    if (latency != C.TIME_UNSET && latency > 0) parts += String.format(Locale.US, "%.0f s behind live", latency / 1000f)
+    return parts.joinToString("  ·  ")
+}
