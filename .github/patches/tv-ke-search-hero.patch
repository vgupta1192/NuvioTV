+
+/**
+ * Search results hero (Nuvio-KE port). The KE screens draw the results hero as a full-bleed
+ * backdrop under a band-geometry layout; this tree renders the results as rows in one list, so
+ * the concept is adapted: a fixed-height backdrop panel that sits above the result rows as a
+ * list item. What is kept from KE is the settle model — the hero never changes while the user
+ * types or scrolls, and it only settles on the focused card (else the top result) after the
+ * settle delay and once the results list has stopped scrolling.
+ */
+
+/** Skeleton results (the screens' "__placeholder_" ids) never seed, settle or show the hero. */
+internal const val SEARCH_HERO_PLACEHOLDER_PREFIX = "__placeholder_"
+
+/** KE's settle timing: focus changes within this window are rapid D-pad travel. */
+private const val SEARCH_HERO_RAPID_NAV_THRESHOLD_MS = 130L
+
+/** KE's settle timing: rapid travel settles slightly faster than the base debounce. */
+private const val SEARCH_HERO_RAPID_NAV_SETTLE_MS = 400L
+
+/** The settle delay for a focus change at [nowMs]; [lastNavAtMs] is the previous change (0 = none). */
+internal fun searchHeroSettleDelayMs(lastNavAtMs: Long, nowMs: Long): Long {
+    val sinceLast = nowMs - lastNavAtMs
+    return if (lastNavAtMs != 0L && sinceLast in 1 until SEARCH_HERO_RAPID_NAV_THRESHOLD_MS) {
+        SEARCH_HERO_RAPID_NAV_SETTLE_MS
+    } else {
+        MODERN_HERO_FOCUS_DEBOUNCE_MS
+    }
+}
+
+/**
+ * Which result the hero shows. [focusedKey] is written per card focus (no settle without one for
+ * focus moves); the settle effect in [rememberSearchHeroSettle] waits the debounce and for the
+ * list to stop scrolling before writing [displayedKey]. The hero draws the result for
+ * [displayedKey] and falls back to the seed (the top result) while nothing has settled.
+ */
+@Stable
+internal class SearchHeroSettle {
+    /** The card the settle is waiting on, cleared when a new query's results start. */
+    var focusedKey by mutableStateOf<String?>(null)
+        private set
+    /** What the hero draws. Only the settle effect writes it, after the debounce and scroll-idle. */
+    var displayedKey by mutableStateOf<String?>(null)
+        private set
+    var settleDelayMs: Long = MODERN_HERO_FOCUS_DEBOUNCE_MS
+        private set
+    private var lastNavAtMs = 0L
+
+    /** A result card took focus: KE's rule — rapid D-pad travel shortens the next settle. */
+    fun onFocused(key: String) {
+        if (key == focusedKey) return
+        val now = System.currentTimeMillis()
+        settleDelayMs = searchHeroSettleDelayMs(lastNavAtMs, now)
+        lastNavAtMs = now
+        focusedKey = key
+    }
+
+    internal fun settle(key: String) {
+        displayedKey = key
+    }
+
+    /** New results (a query change): focus bookkeeping drops and the settle restarts (KE's reset). */
+    fun reset() {
+        focusedKey = null
+        lastNavAtMs = 0L
+        settleDelayMs = MODERN_HERO_FOCUS_DEBOUNCE_MS
+    }
+}
+
+/**
+ * The search results hero's settle state. The settle target is the focused card while one is
+ * recorded, else [seedKey] (the top result). Every target change restarts the debounce — a
+ * keystroke's new results change the seed, so the settle also waits for the query to stop
+ * changing — and then waits for [listState] to stop scrolling before it lands. KE's reset rule:
+ * a submitted-query change drops the focus bookkeeping and the hero restarts from the seed.
+ */
+@Composable
+internal fun rememberSearchHeroSettle(
+    seedKey: String?,
+    listState: LazyListState,
+    submittedQuery: String
+): SearchHeroSettle {
+    val settle = remember { SearchHeroSettle() }
+    LaunchedEffect(settle, listState, seedKey) {
+        snapshotFlow { settle.focusedKey ?: seedKey }.collectLatest { target ->
+            if (target == null) return@collectLatest
+            delay(settle.settleDelayMs)
+            snapshotFlow { listState.isScrollInProgress }.first { !it }
+            settle.settle(target)
+        }
+    }
+    LaunchedEffect(submittedQuery) { settle.reset() }
+    return settle
+}
+
+/**
+ * The hero's result for [displayedKey] over [rows]: the settled card while it still resolves to a
+ * real (non-placeholder) result, else null — the hero keeps its last artwork while the settle is
+ * pending, so typing churn never flickers it.
+ */
+internal fun searchHeroItemOf(rows: List<CatalogRow>, displayedKey: String?): MetaPreview? {
+    val key = displayedKey ?: return null
+    return rows.asSequence()
+        .flatMap { it.items.asSequence() }
+        .firstOrNull { it.id == key && !it.id.startsWith(SEARCH_HERO_PLACEHOLDER_PREFIX) }
+}
+
+/** The hero panel's fixed height: it must not push the result rows off-screen. */
+private val SEARCH_HERO_HEIGHT = 220.dp
+
+/**
+ * The backdrop panel above the result rows: [item]'s backdrop full-bleed under a bottom scrim,
+ * the title, a type/year/rating meta line and the description. [item] is the settled result and
+ * may be null while the first settle is pending; the last non-null result stays on screen (KE's
+ * displayed-backdrop rule), so the art never blanks or churns mid-debounce. Decorative only —
+ * focus stays in the results grid.
+ */
+@Composable
+internal fun SearchResultsHero(
+    item: MetaPreview?,
+    modifier: Modifier = Modifier
+) {
+    var displayed by remember { mutableStateOf(item) }
+    if (item != null) displayed = item
+    val hero = displayed
+    Box(
+        modifier = modifier
+            .fillMaxWidth()
+            .height(SEARCH_HERO_HEIGHT)
+            .focusProperties { canFocus = false }
+            .clip(RoundedCornerShape(NuvioTheme.radii.lg))
+            .background(NuvioTheme.colors.BackgroundCard)
+    ) {
+        if (hero != null) {
+            val context = LocalContext.current
+            val imageModel = remember(context, hero.backdropUrl) {
+                hero.backdropUrl?.let { url ->
+                    ImageRequest.Builder(context).data(url).build()
+                }
+            }
+            Crossfade(
+                targetState = imageModel,
+                animationSpec = tween(durationMillis = NuvioMotion.tokens.durations.overlay),
+                label = "searchHeroBackdropCrossfade",
+                modifier = Modifier.fillMaxSize()
+            ) { model ->
+                if (model != null) {
+                    AsyncImage(
+                        model = model,
+                        contentDescription = null,
+                        contentScale = ContentScale.Crop,
+                        modifier = Modifier.fillMaxSize()
+                    )
+                }
+            }
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .background(
+                        Brush.verticalGradient(
+                            0.0f to Color.Transparent,
+                            0.55f to Color.Transparent,
+                            1.0f to Color.Black.copy(alpha = 0.78f)
+                        )
+                    )
+            )
+            val metaText = remember(context, hero.id, hero.apiType, hero.releaseInfo, hero.imdbRating) {
+                listOfNotNull(
+                    localizedContentType(context, hero.apiType),
+                    hero.releaseInfo?.trim()?.takeIf(String::isNotEmpty),
+                    hero.imdbRating?.let { String.format(java.util.Locale.US, "%.1f", it) }
+                ).joinToString(separator = " • ")
+            }
+            Column(
+                modifier = Modifier
+                    .align(Alignment.BottomStart)
+                    .fillMaxWidth()
+                    .padding(horizontal = NuvioTheme.spacing.lg, vertical = NuvioTheme.spacing.md),
+                verticalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.xxs)
+            ) {
+                Text(
+                    text = hero.name,
+                    style = MaterialTheme.typography.titleLarge,
+                    color = NuvioTheme.colors.TextPrimary,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis
+                )
+                if (metaText.isNotEmpty()) {
+                    Text(
+                        text = metaText,
+                        style = MaterialTheme.typography.labelMedium,
+                        color = NuvioTheme.colors.TextSecondary,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                }
+                hero.description?.trim()?.takeIf(String::isNotEmpty)?.let { description ->
+                    Text(
+                        text = description,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = NuvioTheme.colors.TextSecondary,
+                        maxLines = 2,
+                        overflow = TextOverflow.Ellipsis
+                    )
+                }
+            }
+        } else {
+            Spacer(modifier = Modifier.fillMaxSize())
+        }
+    }
+}
