 internal const val HOME_HERO_TRAILER_OWNER = "home_hero"
+
+/**
+ * Immersive-hero "View title" pill. Focus and click are reported to the caller: focus pulls the
+ * bottom row into its hidden header-sliver state and click opens the focused hero title.
+ */
+@Composable
+internal fun HeroViewTitleButton(
+    onClick: () -> Unit,
+    onFocusedChanged: (Boolean) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    var isFocused by remember { mutableStateOf(false) }
+    val buttonShape = RoundedCornerShape(percent = 50)
+    Box(
+        modifier = modifier
+            .clip(buttonShape)
+            .background(if (isFocused) NuvioTheme.colors.PrimaryVariant else NuvioTheme.colors.Primary)
+            .border(
+                width = 2.dp,
+                color = if (isFocused) NuvioTheme.colors.TextPrimary else Color.Transparent,
+                shape = buttonShape
+            )
+            .onFocusChanged {
+                isFocused = it.isFocused
+                onFocusedChanged(it.isFocused)
+            }
+            .clickable { onClick() }
+            .padding(horizontal = NuvioTheme.spacing.lg, vertical = NuvioTheme.spacing.md),
+        contentAlignment = Alignment.Center
+    ) {
+        Text(
+            text = stringResource(R.string.home_hero_view_title),
+            style = MaterialTheme.typography.titleMedium,
+            color = NuvioTheme.colors.TextPrimary
+        )
+    }
+}
