+    /** Netflix style master switch: trailer autoplay on the detail page with a short delay; OFF restores the snapshot. */
+    suspend fun applyNetflixStyle(on: Boolean) {
+        store().edit { prefs ->
+            val saved = prefs[netflixSavedKey] ?: false
+            if (on) {
+                if (!saved) {
+                    prefs[netflixPrevEnabledKey] = prefs[enabledKey] ?: true
+                    prefs[netflixPrevDelayKey] = prefs[delaySecondsKey] ?: 7
+                    prefs[netflixSavedKey] = true
+                }
+                prefs[enabledKey] = true
+                prefs[delaySecondsKey] = 2
+            } else if (saved) {
+                prefs[enabledKey] = prefs[netflixPrevEnabledKey] ?: true
+                prefs[delaySecondsKey] = prefs[netflixPrevDelayKey] ?: 7
+                prefs[netflixSavedKey] = false
+            }
+        }
+    }
+
     suspend fun setEnabled(enabled: Boolean) {
         store().edit { it[enabledKey] = enabled }
     }
