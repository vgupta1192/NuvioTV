+/** Nuvio fork: applies the saved sidebar order to the movable pages (unlisted pages keep their usual place after the listed ones). */
+object ForkSidebarOrder {
+    fun apply(routes: List<String>, saved: List<String>): List<String> {
+        val mine = saved.filter { it in routes }.distinct()
+        return mine + routes.filter { it !in mine }
+    }
+}
