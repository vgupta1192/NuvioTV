+                    async { gate.withPermit { runCatching { tmdbApi.discoverAiringTv(key, language, page, from, to, FRESH_VOTES) }.getOrNull()?.body()?.results.orEmpty().mapNotNull { it.toPick(true) } } }
+                )
+            }.awaitAll().flatten()
