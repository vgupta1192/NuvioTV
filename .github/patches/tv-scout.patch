+package com.nuvio.tv.ui.v2.appearance
+
+import androidx.compose.runtime.staticCompositionLocalOf
+
+/**
+ * Port shim of Arc's V2 presentation environment. Always null in this fork, which makes every
+ * V2-styled branch in Scout fall back to the classic Nuvio theme rendering.
+ */
+val LocalV2Appearance = staticCompositionLocalOf<Any?> { null }
