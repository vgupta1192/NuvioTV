+package com.nuvio.tv.core.ratinglimit
+
+import android.content.Context
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+
+/**
+ * Port shim of Arc's kids rating gate. This fork never applies a rating limit, so
+ * [ratingLimitGateOrNull] always returns null and every consumer keeps its items unchanged.
+ */
+@Singleton
+class RatingLimitGate @Inject constructor() {
+    val limits: StateFlow<Map<Int, RatingLimit>> = MutableStateFlow(emptyMap())
+
+    suspend fun activeLimit(): RatingLimit? = null
+
+    suspend fun limitFor(profileId: Int): RatingLimit? = null
+
+    inline fun <T> keepFitting(limit: RatingLimit?, items: List<T>, idOf: (T) -> Pair<String, String>): List<T> = items
+
+    inline fun <T> withPermit(block: () -> T): T = block()
+}
+
+/** Always null in this fork: no rating limit is configured, so callers skip filtering. */
+fun ratingLimitGateOrNull(context: Context): RatingLimitGate? = null
