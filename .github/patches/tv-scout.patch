@@ -0,0 +1,191 @@
+package com.nuvio.tv.core.scout.sync
+
+import android.util.Log
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.data.local.ScoutOutItem
+import com.nuvio.tv.data.local.ScoutStore
+import com.nuvio.tv.data.simkl.SimklSyncRepository
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlin.coroutines.cancellation.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/**
+ * Keeps Scout thumbs and the trackers of the active profile in step: thumbs pressed in Arc go out when
+ * sending is on, tracker ratings come in as thumbs when using them is on.
+ */
+@Singleton
+class ScoutRatingSync @Inject constructor(
+    private val store: ScoutStore,
+    private val profileManager: ProfileManager,
+    private val simklSync: SimklSyncRepository,
+    trakt: TraktRatingClient,
+    simkl: SimklRatingClient,
+    mdbList: MdbListRatingClient
+) {
+    private val clients: List<TrackerRatingClient> = listOf(trakt, simkl, mdbList)
+    private val polled: List<TrackerRatingClient> = listOf(trakt, mdbList)
+    private val simklClient = simkl
+
+    suspend fun follow() = withContext(Dispatchers.IO) {
+        profileManager.activeProfileId.collectLatest { profileId ->
+            coroutineScope {
+                launch { followOutbox(profileId) }
+                launch { followImports(profileId) }
+            }
+        }
+    }
+
+    private suspend fun followOutbox(profileId: Int) {
+        combine(store.outboxSize(profileId), store.profile.map { it.settings.sendToTrackers }) { size, on -> size > 0 && on }
+            .distinctUntilChanged()
+            .collectLatest { work ->
+                var failures = 0
+                while (work) {
+                    val wait = runCatching { drain(profileId) }.getOrElse { error ->
+                        if (error is CancellationException) throw error
+                        Log.w(TAG, "send failed: ${error.javaClass.simpleName}")
+                        RETRY_MS
+                    }
+                    when {
+                        wait == null -> failures = 0
+                        else -> failures++
+                    }
+                    delay(wait?.let { (it shl (failures - 1).coerceIn(0, 6)).coerceAtMost(MAX_RETRY_MS) } ?: IDLE_CHECK_MS)
+                }
+            }
+    }
+
+    /** Sends what is queued. Null when every connected tracker is done; otherwise how long to wait before trying again. */
+    internal suspend fun drain(profileId: Int): Long? {
+        val queued = store.outbox(profileId)
+        if (queued.isEmpty()) return null
+        val connected = clients.filter { it.connected() }
+        if (connected.isEmpty()) return null
+        val required = connected.map { it.providerId.storageId }.toSet()
+        var retry: Long? = null
+        connected.forEach { client ->
+            val provider = client.providerId.storageId
+            val items = queued.values.filter { provider !in it.done }
+            if (items.isEmpty()) return@forEach
+            try {
+                sendTo(client, profileId, items, required)
+            } catch (error: TrackerRateLimitedException) {
+                retry = maxOf(retry ?: 0L, error.retryAfterMs ?: RETRY_MS)
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                Log.w(TAG, "$provider send failed: ${error.javaClass.simpleName}")
+                retry = maxOf(retry ?: 0L, RETRY_MS)
+            }
+        }
+        return retry
+    }
+
+    private suspend fun sendTo(client: TrackerRatingClient, profileId: Int, items: List<ScoutOutItem>, required: Set<String>) {
+        val provider = client.providerId.storageId
+        val remote = client.ratings().byKey()
+        val sent = store.sent(profileId, provider)
+        val writes = ArrayList<Pair<ScoutOutItem, TrackerRatingWrite>>()
+        val removes = ArrayList<Pair<ScoutOutItem, TrackerTitle>>()
+        suspend fun finish(item: ScoutOutItem, value: Double?, keepSent: Boolean = false) =
+            store.finishOut(profileId, item.title.id, item.action.stamp, provider, if (keepSent) sent[item.title.id] else value, required)
+        items.forEach { item ->
+            val title = item.title.trackerTitle()
+            if (title == null) {
+                store.dropOut(profileId, item.title.id, item.action.stamp)
+                return@forEach
+            }
+            if (item.action.rating != null && !client.accepts(title)) {
+                finish(item, null, keepSent = true)
+                return@forEach
+            }
+            when (val step = planPush(item.action, remote.find(title)?.value, sent[item.title.id])) {
+                is PushStep.Write -> writes += item to TrackerRatingWrite(title, step.value, item.action.stamp)
+                PushStep.Remove -> removes += item to title
+                is PushStep.Done -> finish(item, step.value)
+                PushStep.Keep -> finish(item, null)
+            }
+        }
+        writes.chunked(BATCH).forEach { batch ->
+            val rejected = runRejectable { client.write(batch.map { it.second }) }
+            batch.forEach { (item, write) -> finish(item, write.value, keepSent = rejected) }
+        }
+        removes.chunked(BATCH).forEach { batch ->
+            val rejected = runRejectable { client.remove(batch.map { it.second }) }
+            batch.forEach { (item, _) -> finish(item, null, keepSent = rejected) }
+        }
+    }
+
+    /** True when the tracker refused the batch for good; it is then dropped rather than retried forever. */
+    private suspend fun runRejectable(block: suspend () -> Unit): Boolean = try {
+        block()
+        false
+    } catch (error: TrackerRejectedException) {
+        Log.w(TAG, "batch refused: ${error.message}")
+        true
+    }
+
+    private suspend fun followImports(profileId: Int) {
+        store.profile.map { it.settings.useTrackerRatings }.distinctUntilChanged().collectLatest { on ->
+            if (!on) return@collectLatest
+            coroutineScope {
+                launch {
+                    simklSync.state.map { it.snapshot.storageRevision to it.hasLoaded }.distinctUntilChanged().collectLatest { (_, loaded) ->
+                        if (!loaded) return@collectLatest
+                        delay(SETTLE_MS)
+                        pull(simklClient, profileId)
+                    }
+                }
+                while (true) {
+                    val now = System.currentTimeMillis()
+                    polled.forEach { client ->
+                        if (client.connected() && now - store.lastPulled(profileId, client.providerId.storageId) >= PULL_EVERY_MS) {
+                            pull(client, profileId)
+                        }
+                    }
+                    delay(POLL_CHECK_MS)
+                }
+            }
+        }
+    }
+
+    internal suspend fun pull(client: TrackerRatingClient, profileId: Int) {
+        if (!client.connected()) return
+        val provider = client.providerId.storageId
+        try {
+            val remote = client.ratings()
+            val now = System.currentTimeMillis()
+            val changed = store.applyImport(profileId) { profile, pending, sent ->
+                if (!profile.settings.useTrackerRatings) return@applyImport emptyList()
+                val mine = sent.filterKeys { it.startsWith("$provider:") }.mapKeys { it.key.removePrefix("$provider:") }
+                planImport(client.providerId, remote, profile.ratings, profile.dismissed, mine, pending, now)
+            }
+            store.markPulled(profileId, provider, now)
+            if (changed > 0) Log.i(TAG, "$provider: $changed thumbs updated from ${remote.size} ratings")
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: Exception) {
+            Log.w(TAG, "$provider read failed: ${error.javaClass.simpleName}")
+        }
+    }
+
+    private companion object {
+        const val TAG = "ScoutRatingSync"
+        const val BATCH = 50
+        const val RETRY_MS = 30_000L
+        const val MAX_RETRY_MS = 30 * 60_000L
+        const val IDLE_CHECK_MS = 10 * 60_000L
+        const val SETTLE_MS = 3_000L
+        const val POLL_CHECK_MS = 15 * 60_000L
+        const val PULL_EVERY_MS = 6 * 60 * 60_000L
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/scout/sync/ScoutRatingSyncLogic.kt b/app/src/main/java/com/nuvio/tv/core/scout/sync/ScoutRatingSyncLogic.kt
new file mode 100644
index 000000000..2ec15f5a4
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/scout/sync/ScoutRatingSyncLogic.kt
@@ -0,0 +1,135 @@
+package com.nuvio.tv.core.scout.sync
+
+import com.nuvio.tv.core.tracking.TrackingProviderId
+import com.nuvio.tv.core.tracking.parseTrackingExternalIds
+import com.nuvio.tv.domain.model.ScoutRating
+import com.nuvio.tv.domain.model.ScoutRatingEntry
+import com.nuvio.tv.domain.model.ScoutTitle
+import kotlin.math.abs
+
+/** A film or show as the trackers know it. */
+data class TrackerTitle(val movie: Boolean, val imdb: String? = null, val tmdb: Long? = null) {
+    val hasIds: Boolean get() = imdb != null || tmdb != null
+
+    /** Keys under which the same title can be found on both sides; tmdb ids repeat between films and shows. */
+    val keys: List<String>
+        get() = listOfNotNull(
+            imdb?.let { "imdb:$it" },
+            tmdb?.let { "tmdb:${if (movie) "m" else "s"}:$it" }
+        )
+}
+
+data class TrackerRating(
+    val title: TrackerTitle,
+    val value: Double,
+    val ratedAtMs: Long? = null,
+    val name: String? = null
+)
+
+data class TrackerRatingWrite(val title: TrackerTitle, val value: Double, val ratedAtMs: Long)
+
+fun ScoutRating.trackerValue(): Double = when (this) {
+    ScoutRating.NOT_FOR_ME -> 3.0
+    ScoutRating.LIKE -> 7.0
+    ScoutRating.LOVE -> 10.0
+}
+
+/** 9-10 love, 6-8 like, 1-4 not for me; a 5, or anything under 1, says nothing. */
+fun scoutRatingFromTracker(value: Double): ScoutRating? = when {
+    value >= 9.0 -> ScoutRating.LOVE
+    value >= 6.0 -> ScoutRating.LIKE
+    value in 1.0..4.99 -> ScoutRating.NOT_FOR_ME
+    else -> null
+}
+
+internal fun sameTrackerValue(a: Double, b: Double): Boolean = abs(a - b) < 0.26
+
+fun ScoutTitle.trackerTitle(): TrackerTitle? {
+    val ids = parseTrackingExternalIds(id)
+    val movie = type.trim().lowercase() in setOf("movie", "film")
+    return TrackerTitle(movie, ids.imdb?.takeIf { it.startsWith("tt") }, ids.tmdb?.takeIf { it > 0 }).takeIf { it.hasIds }
+}
+
+fun TrackerTitle.scoutContentId(): String = imdb ?: "tmdb:$tmdb"
+
+fun Collection<TrackerRating>.byKey(): Map<String, TrackerRating> {
+    val out = HashMap<String, TrackerRating>()
+    forEach { rating -> rating.title.keys.forEach { out.putIfAbsent(it, rating) } }
+    return out
+}
+
+fun Map<String, TrackerRating>.find(title: TrackerTitle): TrackerRating? = title.keys.firstNotNullOfOrNull { this[it] }
+
+/** What Arc wants a tracker to hold for one title: a value, or nothing (a cleared thumb). */
+data class OutAction(val rating: ScoutRating?, val stamp: Long)
+
+sealed interface PushStep {
+    data class Write(val value: Double) : PushStep
+    data object Remove : PushStep
+    /** The tracker already holds what Arc wants; [value] is what to remember as sent. */
+    data class Done(val value: Double?) : PushStep
+    /** The tracker holds a rating the user gave there; it stays and Arc forgets what it sent. */
+    data object Keep : PushStep
+}
+
+/**
+ * Arc only ever replaces or removes a value it sent itself. [lastSent] is what Arc last sent this tracker
+ * for the title, [remote] what the tracker holds now.
+ */
+fun planPush(action: OutAction, remote: Double?, lastSent: Double?): PushStep {
+    val arcOwns = remote != null && lastSent != null && sameTrackerValue(remote, lastSent)
+    val wanted = action.rating?.trackerValue()
+    return when {
+        wanted == null && remote == null -> PushStep.Done(null)
+        wanted == null -> if (arcOwns) PushStep.Remove else PushStep.Keep
+        remote == null -> PushStep.Write(wanted)
+        sameTrackerValue(remote, wanted) -> PushStep.Done(wanted)
+        arcOwns -> PushStep.Write(wanted)
+        else -> PushStep.Keep
+    }
+}
+
+data class ImportChange(val contentId: String, val entry: ScoutRatingEntry?)
+
+/**
+ * Turns one tracker's full list of ratings into thumbs. A thumb pressed in Arc always wins, a title the user
+ * cleared in Arc stays clear, a rating Arc sent or is about to send is left alone, and only thumbs this
+ * tracker brought in are changed or removed.
+ */
+fun planImport(
+    source: TrackingProviderId,
+    remote: Collection<TrackerRating>,
+    local: Map<String, ScoutRatingEntry>,
+    dismissed: Set<String>,
+    sentByArc: Map<String, Double>,
+    pending: Set<String>,
+    now: Long
+): List<ImportChange> {
+    val sourceId = source.storageId
+    val localByKey = HashMap<String, String>()
+    local.forEach { (id, entry) -> entry.title.trackerTitle()?.keys?.forEach { localByKey.putIfAbsent(it, id) } }
+    val changes = LinkedHashMap<String, ImportChange>()
+    val seen = HashSet<String>()
+    remote.forEach { rating ->
+        val existingId = rating.title.keys.firstNotNullOfOrNull { localByKey[it] }
+        val id = existingId ?: rating.title.scoutContentId()
+        if (!seen.add(id) || id in dismissed || id in pending) return@forEach
+        val sent = sentByArc[id]
+        if (sent != null && sameTrackerValue(sent, rating.value)) return@forEach
+        val existing = local[id]
+        if (existing != null && existing.source != sourceId) return@forEach
+        val mapped = scoutRatingFromTracker(rating.value)
+        if (mapped == null) {
+            if (existing != null) changes[id] = ImportChange(id, null)
+            return@forEach
+        }
+        if (existing?.rating == mapped) return@forEach
+        val name = rating.name?.takeIf(String::isNotBlank) ?: existing?.title?.name ?: return@forEach
+        val title = existing?.title ?: ScoutTitle(id, if (rating.title.movie) "movie" else "series", name)
+        changes[id] = ImportChange(id, ScoutRatingEntry(title, mapped, rating.ratedAtMs ?: now, sourceId))
+    }
+    local.forEach { (id, entry) ->
+        if (entry.source == sourceId && id !in seen && id !in changes) changes[id] = ImportChange(id, null)
+    }
+    return changes.values.toList()
+}
