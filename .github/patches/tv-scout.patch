+    val facePlaceholder = "#%06X".format(NuvioTheme.colors.BackgroundElevated.toArgb() and 0xFFFFFF)
+    Column(Modifier.width(slot), horizontalAlignment = Alignment.CenterHorizontally) {
+        Card(
+            onClick = onClick,
