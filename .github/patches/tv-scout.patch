+    name = name,
+    poster = poster,
+    posterShape = PosterShape.POSTER,
+    background = backdrop,
+    logo = null,
+    description = overview,
+    releaseInfo = released?.take(4),
+    released = released,
+    imdbRating = rating,
+    voteCount = votes,
+    genres = emptyList()
