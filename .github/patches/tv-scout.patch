+    tv = tv,
+    name = name ?: return null,
+    poster = poster ?: return null,
+    backdrop = backdrop,
+    overview = overview,
+    released = released,
+    rating = rating,
+    votes = votes,
+    genres = genres,
+    language = language
+)
