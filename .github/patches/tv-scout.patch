+package com.nuvio.tv.ui.screens.scout
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.nuvio.tv.BuildConfig
+import com.nuvio.tv.data.local.MDBListSettingsDataStore
+import com.nuvio.tv.data.remote.api.TmdbApi
+import com.nuvio.tv.domain.model.ContentType
+import com.nuvio.tv.domain.model.MDBListRatings
+import com.nuvio.tv.domain.model.MDBListSettings
+import com.nuvio.tv.domain.model.Meta
+import com.nuvio.tv.domain.model.PosterShape
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+
+data class ScoutHeroExtras(
+    val ratings: MDBListRatings?,
+    val order: List<String> = MDBListSettings.DEFAULT_RATING_ORDER,
+    val imdbId: String?
+)
+
+/**
+ * Per-hero-title lookups for the Scout homepage hero: the MDBList ratings badges shown next to
+ * the meta line (same row as the details page) and the IMDb id the trackers rate under, which the
+ * shared "Your rating" dialog needs. Cached per title; empty when MDBList is off.
+ */
+@HiltViewModel
+class ScoutHeroExtrasViewModel @Inject constructor(
+    private val tmdbApi: TmdbApi,
+    private val mdbListRepository: com.nuvio.tv.data.repository.MDBListRepository,
+    private val mdbListSettings: MDBListSettingsDataStore
+) : ViewModel() {
+    private val cache = HashMap<String, ScoutHeroExtras>()
+
+    suspend fun load(tmdbId: Int, tv: Boolean): ScoutHeroExtras {
+        val key = "$tmdbId:$tv"
+        cache[key]?.let { return it }
+        val extras = ScoutHeroExtras(
+            ratings = runCatching {
+                mdbListRepository.getRatingsForMeta(
+                    meta = ratingsMeta(tmdbId, tv),
+                    fallbackItemId = "tmdb:$tmdbId",
+                    fallbackItemType = if (tv) "series" else "movie"
+                )?.ratings
+            }.getOrNull(),
+            order = runCatching { mdbListSettings.settings.first().enabledRatingOrder() }
+                .getOrDefault(MDBListSettings.DEFAULT_RATING_ORDER),
+            imdbId = runCatching {
+                if (tv) tmdbApi.getTvExternalIds(tmdbId, BuildConfig.TMDB_API_KEY).body()?.imdbId
+                else tmdbApi.getMovieExternalIds(tmdbId, BuildConfig.TMDB_API_KEY).body()?.imdbId
+            }.getOrNull()?.takeIf { it.startsWith("tt") }
+        )
+        cache[key] = extras
+        return extras
+    }
+
+    /** The IMDb id for the shared rating dialog, resolved through the same cached load. */
+    fun resolveImdbId(tmdbId: Int, tv: Boolean, onReady: (String?) -> Unit) {
+        viewModelScope.launch { onReady(load(tmdbId, tv).imdbId) }
+    }
+
+    // resolveMediaRef in MDBListRepository reads only the id prefix and the api type.
+    private fun ratingsMeta(tmdbId: Int, tv: Boolean) = Meta(
+        id = "tmdb:$tmdbId",
+        type = if (tv) ContentType.SERIES else ContentType.MOVIE,
+        name = "",
+        poster = null,
+        posterShape = PosterShape.POSTER,
+        background = null,
+        logo = null,
+        description = null,
+        releaseInfo = null,
+        imdbRating = null,
+        genres = emptyList(),
+        runtime = null,
+        director = emptyList(),
+        cast = emptyList(),
+        videos = emptyList(),
+        country = null,
+        awards = null,
+        language = null,
+        links = emptyList()
+    )
+}
