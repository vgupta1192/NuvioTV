+        val best = logos.firstOrNull { it.iso6391 == language } ?: logos.firstOrNull { it.iso6391 == "en" } ?: logos.firstOrNull()
+        val found = best?.filePath?.let { "https://image.tmdb.org/t/p/w500$it" }
