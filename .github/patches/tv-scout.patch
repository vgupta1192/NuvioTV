+            ScoutWatch.ANIME -> listOf(ANY, ANIME_SERIES, ANIME_FILM, SHORT_SERIES, COMPLETE)
+            ScoutWatch.DOCUMENTARY -> listOf(ANY, UNDER_90, FEATURE, DOC_SERIES, MINISERIES)
