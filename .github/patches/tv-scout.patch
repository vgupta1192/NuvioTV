+package com.nuvio.tv.core.image
+
+/** Port of Arc's home artwork sizing: only TMDB originals get a sized variant. */
+fun sizedHomeArtworkUrl(data: String, width: Int?): String {
+    if (width == null || width <= 0 || width > 780) return data
+    val size = when {
+        width <= 342 -> "w342"
+        width <= 500 -> "w500"
+        else -> "w780"
+    }
+    return if (data.startsWith("https://image.tmdb.org/t/p/original/")) {
+        data.replaceFirst("https://image.tmdb.org/t/p/original/", "https://image.tmdb.org/t/p/$size/")
+    } else data
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/image/ScoutMixArt.kt b/app/src/main/java/com/nuvio/tv/core/image/ScoutMixArt.kt
