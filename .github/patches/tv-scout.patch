+                        .padding(horizontal = NuvioTheme.spacing.xs, vertical = NuvioTheme.spacing.xxs)
+                )
+            }
+            corner?.invoke(this)
+            Column(Modifier.align(Alignment.BottomStart).padding(NuvioTheme.spacing.md)) {
