+    private val trackers: TrackingProviderRegistry
+) : ViewModel() {
+    val profile: StateFlow<ScoutProfile> = store.profile
+        .stateIn(viewModelScope, SharingStarted.WhileSubscribed(5_000), ScoutProfile())
