+/** Nuvio fork: the player's own auto refresh, mirroring StreamScreenViewModel.startAutoRefresh. */
+internal fun PlayerRuntimeController.resetSourceAutoRefresh() {
+    sourceAutoRefreshJob?.cancel()
+    sourceAutoRefreshJob = null
+    sourceAutoRefreshRounds = 0
+    sourceAutoRefreshAdded = 0
+    sourceAutoRefreshDryRounds = 0
+    sourceAutoRefreshLastAtMs = 0L
+    sourceAutoRefreshLastOk = true
+}
+
+internal fun PlayerRuntimeController.startSourceAutoRefresh(
+    type: String,
+    vid: String,
+    seasonArg: Int?,
+    episodeArg: Int?,
+    installedAddonOrder: List<String>,
+    preferredServerNames: Set<String>,
+    seed: com.nuvio.tv.core.streams.StreamScreenResultsCache.Entry?
+) {
+    val loopScope = sourceStreamsScope ?: return
+    sourceAutoRefreshJob?.cancel()
+    if (seed != null) {
+        sourceAutoRefreshRounds = seed.refreshRounds
+        sourceAutoRefreshAdded = seed.refreshAdded
+        sourceAutoRefreshDryRounds = seed.refreshDryRounds
+        sourceAutoRefreshLastAtMs = seed.refreshLastAtMs
+        sourceAutoRefreshLastOk = seed.refreshLastOk
+    }
+    sourceAutoRefreshJob = loopScope.launch {
+        val requestKey = sourceStreamsCacheRequestKey
+        while (isActive && sourceStreamsCacheRequestKey == requestKey) {
+            kotlinx.coroutines.delay(SOURCE_AUTO_REFRESH_INTERVAL_MS)
+            if (sourceStreamsCacheRequestKey != requestKey || !sourceStreamsFetchCompleted) continue
+            publishSourceAutoRefreshStatus(phase = 1)
+            var roundOk = false
+            var roundAdded = 0
+            try {
+                roundOk = kotlinx.coroutines.withTimeoutOrNull(SOURCE_AUTO_REFRESH_TIMEOUT_MS) {
+                    streamRepository.getStreamsFromAllAddons(
+                        type = type,
+                        videoId = vid,
+                        season = seasonArg,
+                        episode = episodeArg,
+                        forceRefresh = true
+                    ).collect { result ->
+                        if (result is NetworkResult.Success) {
+                            val ordered = StreamAutoPlaySelector.orderAddonStreams(result.data, installedAddonOrder, preferredServerNames)
+                            roundAdded += applyRefreshedSourceGroups(ordered)
+                        }
+                    }
+                    true
+                } == true
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (_: Exception) {
+                // A failed round keeps the list as it is; the next round tries again.
+            }
+            sourceAutoRefreshRounds += 1
+            sourceAutoRefreshDryRounds = if (roundAdded > 0) 0 else sourceAutoRefreshDryRounds + 1
+            sourceAutoRefreshAdded = (sourceAutoRefreshAdded + roundAdded).coerceAtMost(_uiState.value.sourceAllStreams.size)
+            sourceAutoRefreshLastAtMs = System.currentTimeMillis()
+            sourceAutoRefreshLastOk = roundOk
+            publishSourceAutoRefreshStatus(phase = 2)
+            // Publish back so the Stream screen adopts the merged list and the rounds when the
+            // player closes (same two-way sync the player's manual refresh uses).
+            val current = _uiState.value
+            val groups = current.sourceAvailableAddons.mapNotNull { name ->
+                current.sourceAllStreams.filter { it.addonName == name }
+                    .takeIf { it.isNotEmpty() }
+                    ?.let { AddonStreams(addonName = name, addonLogo = null, streams = it) }
+            }
+            if (groups.isNotEmpty()) {
+                com.nuvio.tv.core.streams.StreamScreenResultsCache.put(
+                    type = type,
+                    videoId = vid,
+                    season = seasonArg,
+                    episode = episodeArg,
+                    groups = groups,
+                    loading = false,
+                    refreshPhase = 2,
+                    refreshRounds = sourceAutoRefreshRounds,
+                    refreshAdded = sourceAutoRefreshAdded,
+                    refreshDryRounds = sourceAutoRefreshDryRounds,
+                    refreshLastAtMs = sourceAutoRefreshLastAtMs,
+                    refreshLastOk = sourceAutoRefreshLastOk
+                )
+            }
+        }
+    }
+}
+
+private fun PlayerRuntimeController.publishSourceAutoRefreshStatus(phase: Int) {
+    _uiState.update {
+        it.copy(
+            sourceRefreshStatus = com.nuvio.tv.ui.screens.player.SourceRefreshStatusSnapshot(
+                phase = phase,
+                rounds = sourceAutoRefreshRounds,
+                added = sourceAutoRefreshAdded,
+                dryRounds = sourceAutoRefreshDryRounds,
+                lastAtMs = sourceAutoRefreshLastAtMs,
+                lastOk = sourceAutoRefreshLastOk
+            )
+        )
+    }
+}
+
+/** Merges a refreshed addon list into the panel, badge- and filter-preserving. Returns the count of new links. */
+internal fun PlayerRuntimeController.applyRefreshedSourceGroups(ordered: List<AddonStreams>): Int {
+    val existingKeys = _uiState.value.sourceAllStreams.map { it.sourceBadgeMergeKey() }.toHashSet()
+    var added = 0
+    _uiState.update { current ->
+        val freshAllStreams = ordered.flatMap { group -> group.streams }
+        added = freshAllStreams.count { it.sourceBadgeMergeKey() !in existingKeys }
+        if (added == 0 && ordered.map { it.addonName }.none { it !in current.sourceAvailableAddons }) return@update current
+        val badged = current.sourceAllStreams
+            .filter { it.badges.isNotEmpty() }
+            .associateBy { it.sourceBadgeMergeKey() }
+        val badgePreserved = freshAllStreams.map { stream ->
+            val known = badged[stream.sourceBadgeMergeKey()]
+            if (known != null && stream.badges.isEmpty()) stream.copy(badges = known.badges) else stream
+        }
+        val combined = mergeSourceStreams(current.sourceAllStreams, badgePreserved)
+        val selected = current.sourceSelectedAddonFilter
+        val filtered = if (selected == null) combined else combined.filter { it.addonName == selected }
+        sourceFilterFullList = filtered
+        val shown = filtered.take(
+            maxOf(current.sourceFilteredStreams.size, SOURCE_FILTER_PAGE_SIZE).coerceAtMost(filtered.size)
+        )
+        current.copy(
+            isLoadingSourceStreams = false,
+            sourceAllStreams = combined,
+            sourceFilteredStreams = shown,
+            sourceAvailableAddons = (current.sourceAvailableAddons + ordered.map { it.addonName }).distinct(),
+            sourceStreamCounts = ordered.associate { group -> group.addonName to group.streams.size }
+        )
+    }
+    return added
+}
