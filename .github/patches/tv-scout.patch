+/** Port shims of the Arc V2 kit pieces Scout uses unconditionally. Glass/focus paths stay
+ *  inert because [com.nuvio.tv.ui.v2.appearance.LocalV2Appearance] is always null here. */
+
+enum class GlassRole { NAVIGATION, CONTROL, PANEL, MODAL, HUD, CARD_FOCUS, TOOLTIP }
+
+@Composable
+fun Modifier.nuvioGlass(role: GlassRole, focused: Boolean = false, shape: androidx.compose.ui.graphics.Shape = RoundedCornerShape(20.dp)): Modifier =
+    this.background(NuvioTheme.colors.Secondary.copy(alpha = if (focused) 0.24f else 0.16f), shape)
+
+@Composable
+fun Modifier.nuvioV2Focus(
+    focused: Boolean,
+    shape: androidx.compose.ui.graphics.Shape,
+    accentOverride: Color? = null,
+    hardwareShadow: Boolean = true,
+    stationary: Boolean = false
+): Modifier = this
+
+@Composable
+fun Modifier.sidebarPageContent(): Modifier = this
+
+data class AvatarModel(
+    val id: String,
+    val name: String,
+    val colorHex: String,
+    val imageUrl: String?
+)
+
+@Composable
+fun NuvioAvatar(
+    avatar: AvatarModel,
+    size: Dp,
+    modifier: Modifier = Modifier,
+    focused: Boolean = false,
+    selected: Boolean = false,
+    portraitPlaceholder: Boolean = false,
+    description: String? = avatar.name
+) {
+    val fallback = runCatching { androidx.compose.ui.graphics.Color(android.graphics.Color.parseColor(avatar.colorHex)) }
+        .getOrDefault(NuvioTheme.colors.Secondary)
+    Box(
+        modifier = modifier
+            .size(size)
+            .clip(CircleShape)
+            .background(if (selected || focused) fallback.copy(alpha = 0.9f) else fallback, CircleShape),
+        contentAlignment = Alignment.Center
+    ) {
+        if (avatar.imageUrl != null) {
+            AsyncImage(
+                model = avatar.imageUrl,
+                contentDescription = description,
+                modifier = Modifier.size(size)
+            )
+        } else {
+            Text(
+                text = avatar.name.trim().take(1).uppercase().ifEmpty { "?" },
+                style = MaterialTheme.typography.bodyMedium,
+                fontWeight = FontWeight.SemiBold,
+                color = NuvioTheme.colors.TextPrimary,
+                maxLines = 1,
+                overflow = TextOverflow.Clip
+            )
+        }
+    }
+}
+
+@Composable
+fun NuvioActionPill(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    enabled: Boolean = true,
+    neutralBackdrop: Boolean = false,
+    stationary: Boolean = false,
+    containerColor: Color? = null,
+    content: @Composable RowScope.() -> Unit
+) {
+    Button(
+        onClick = onClick,
+        modifier = modifier,
+        enabled = enabled,
+        shape = ButtonDefaults.shape(androidx.compose.foundation.shape.RoundedCornerShape(50)),
+        colors = ButtonDefaults.colors(
+            containerColor = containerColor ?: NuvioTheme.colors.Primary,
+            contentColor = NuvioTheme.colors.OnPrimary
+        )
+    ) {
+        content()
+    }
+}
