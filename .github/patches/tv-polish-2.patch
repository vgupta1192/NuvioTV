+/** Title, server and user pills, refresh and sign-out. */
+@Composable
+private fun JellyfinHeader(session: JellyfinSession, modifier: Modifier = Modifier) {
+    val accent = NuvioTheme.colors.Secondary
+    Row(
+        modifier = modifier.fillMaxWidth(),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Box(
+            modifier = Modifier
+                .size(40.dp)
+                .clip(RoundedCornerShape(NuvioTheme.radii.md))
+                .background(accent),
+            contentAlignment = Alignment.Center,
+        ) {
+            Text(
+                text = "J",
+                style = MaterialTheme.typography.titleLarge.copy(fontWeight = FontWeight.Bold),
+                color = onAccentColor(),
+            )
+        }
+        Spacer(modifier = Modifier.width(14.dp))
+        Column(modifier = Modifier.weight(1f)) {
+            Text(
+                text = "Jellyfin",
+                style = MaterialTheme.typography.headlineMedium.copy(fontWeight = FontWeight.SemiBold),
+                color = NuvioTheme.colors.TextPrimary,
+            )
+            Spacer(modifier = Modifier.height(4.dp))
+            Row(
+                horizontalArrangement = Arrangement.spacedBy(8.dp),
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                JellyfinInfoPill(session.serverName)
+                JellyfinInfoPill(session.userName)
+            }
+        }
+        TvJellyfinIconButton(
+            icon = Icons.Rounded.Refresh,
+            contentDescription = "Refresh",
+            onClick = { JellyfinRepository.refresh() },
+        )
+        Spacer(modifier = Modifier.width(10.dp))
+        TvJellyfinIconButton(
+            icon = Icons.Rounded.Logout,
+            contentDescription = "Sign out",
+            onClick = { JellyfinRepository.signOut() },
+        )
+    }
