+                trimDecoders()
+                deferredSinceLog++
+                val now = SystemClock.elapsedRealtime()
+                if (now - lastDeferLogAt >= DEFER_LOG_INTERVAL_MS) {
+                    Log.d(TAG, "slot=$slot P$priority deferred (x$deferredSinceLog): ${verdict.reason}")
