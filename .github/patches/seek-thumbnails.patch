+        private fun coverageStored(st: ThumbStore): Boolean {
+            val lattice = SeekGrid.latticeOrder(slotKeyframe.size, latticeStrides, 0, 0, 0)
+            return lattice.isNotEmpty() && lattice.none { needs(st, it) }
+        }
