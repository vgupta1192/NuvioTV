+                if (!ps.buffering && (!ps.isPlaying || ps.bufferedMs - ps.positionMs >= INDEX_GATE_AHEAD_MS ||
+                        (ps.durationMs > 0 && ps.bufferedMs >= ps.durationMs - 1_000L))) return
+                delay(1_000L)
