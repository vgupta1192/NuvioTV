+            val make = makeExtractor ?: return Outcome.FAILED
+            val t0 = SystemClock.elapsedRealtime()
+            val tapped = spooledAccessUnit(kf, idx)
+            val fetched = if (tapped != null) null else awaitFetch(kf, make)
