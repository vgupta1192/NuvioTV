+
+/** A History section's header: Today, This week, or the month (with the year when not this year). */
+@Composable
+private fun libraryHistorySectionTitle(section: LibraryHistorySection): String =
+    when (section.kind) {
+        LibraryHistoryGroupKind.TODAY -> stringResource(R.string.library_history_today)
+        LibraryHistoryGroupKind.THIS_WEEK -> stringResource(R.string.library_history_this_week)
+        LibraryHistoryGroupKind.MONTH -> section.month?.let { month ->
+            val pattern = if (month.year == LocalDate.now().year) "MMMM" else "MMMM yyyy"
+            DateTimeFormatter.ofPattern(pattern, Locale.getDefault()).format(month.atDay(1))
+        }.orEmpty()
+    }
+
+/**
+ * A History card's caption: "S1 E2 · 35% · Tue 20:15" for an unfinished episode, "S1 E2 · Tue
+ * 20:15" for a finished one, "Watched Tue 20:15" for a movie or a title-level mark.
+ */
+@Composable
+private fun libraryHistoryCardCaption(entry: LibraryHistoryEntry, zone: ZoneId): String? {
+    val context = LocalContext.current
+    val today = LocalDate.now(zone)
+    val parts = mutableListOf<String>()
+    if (entry.season != null && entry.episode != null) {
+        parts += context.getString(R.string.season_episode_format, entry.season, entry.episode)
+    }
+    entry.progressFraction?.let { fraction ->
+        parts += stringResource(R.string.library_history_percent, (fraction * 100).roundToInt())
+    }
+    val whenLine = libraryHistoryWhenLine(entry.watchedAt, today, zone)
+    return if (parts.isEmpty()) {
+        stringResource(R.string.library_history_watched_when, whenLine)
+    } else {
+        (parts + whenLine).joinToString(" · ")
+    }
+}
