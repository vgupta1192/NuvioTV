+package com.nuvio.tv.ui.screens.library
+
+import androidx.compose.runtime.Immutable
+import com.nuvio.tv.domain.model.LibraryEntry
+import com.nuvio.tv.domain.model.WatchedItem
+import com.nuvio.tv.domain.model.WatchProgress
+import java.time.Instant
+import java.time.LocalDate
+import java.time.YearMonth
+import java.time.ZoneId
+import java.time.ZonedDateTime
+
+// Library's History tab (Nuvio-KE port of the KE `u7-library-marquee` stage 7 concept, adapted to
+// this tree's grid library): one entry per title from the watch progress and the watched marks,
+// newest first, grouped Today / This week / by month for the grid section headers. The data comes
+// from the existing watch-progress store — it already retains finished entries (the recent bucket
+// plus the archive bucket, nothing deleted), so no separate history store is needed here; this
+// layer only dedupes per title and caps the rendered list. Pure, so the rules stay unit-testable.
+
+/**
+ * A rendered History list is bounded to this many titles (newest first). Mirrors the intent of
+ * the progress store's recent-bucket cap (`WATCH_PROGRESS_RECENT_LIMIT = 200`): a History tab is
+ * a "recently watched" view, not an unbounded dump.
+ */
+internal const val LIBRARY_HISTORY_MAX_ENTRIES = 200
+
+/**
+ * The "Not watched yet" section shown after the history groups is a shelf, not the full grid:
+ * this bounds it to a screenful-ish set of in-library titles.
+ */
+internal const val LIBRARY_HISTORY_NOT_WATCHED_MAX = 24
+
+/**
+ * One watched title: the newest of its watch progress entries and its watched marks.
+ * [card] carries everything the Library grid needs to render and navigate it.
+ */
+@Immutable
+data class LibraryHistoryEntry(
+    val id: String,
+    val type: String,
+    val name: String,
+    val poster: String?,
+    val backdrop: String?,
+    val logo: String?,
+    /** The latest episode watched (series); null for movies and title-level marks. */
+    val season: Int?,
+    val episode: Int?,
+    /** Last watched, epoch ms. */
+    val watchedAt: Long,
+    /** Played part (0..1) while the latest play is unfinished (under the completion threshold); null once finished or marked watched. */
+    val progressFraction: Float?,
+    val addonBaseUrl: String?
+) {
+    /**
+     * The grid card for this entry, built once per entry ([LibraryEntry.listedAt] carries the
+     * last-watched time). A cached property, so the grid and the ViewModel share one instance.
+     */
+    val card: LibraryEntry by lazy {
+        LibraryEntry(
+            id = id,
+            type = type,
+            name = name,
+            poster = poster,
+            background = backdrop,
+            logo = logo,
+            description = null,
+            releaseInfo = null,
+            imdbRating = null,
+            genres = emptyList(),
+            addonBaseUrl = addonBaseUrl,
+            listedAt = watchedAt
+        )
+    }
+}
+
+enum class LibraryHistoryGroupKind { TODAY, THIS_WEEK, MONTH }
+
+/** One History section: [entries] are newest first; [month] is set for [LibraryHistoryGroupKind.MONTH]. */
+@Immutable
+data class LibraryHistorySection(
+    val key: String,
+    val kind: LibraryHistoryGroupKind,
+    val month: YearMonth?,
+    val entries: List<LibraryHistoryEntry>
+)
+
+// The maxOf orders picking a title's latest mark and latest progress entry: time, then season,
+// then episode (a batch mark shares one time, so the higher episode wins, as the progress store
+// picks its latest entry per content the same way).
+private val LibraryProgressOrder: Comparator<WatchProgress> =
+    compareBy<WatchProgress> { it.lastWatched }.thenBy { it.season ?: -1 }.thenBy { it.episode ?: -1 }
+
+private val LibraryWatchedOrder: Comparator<WatchedItem> =
+    compareBy<WatchedItem> { it.watchedAt }.thenBy { it.season ?: -1 }.thenBy { it.episode ?: -1 }
+
+/**
+ * The History list: per title the newer of its latest progress entry and its latest watched mark
+ * (equal times: the progress entry, which carries the artwork and the stream's addon), newest
+ * first, capped at [cap]. A title known only from the watched set (a manual mark or a tracking
+ * sync) still lists with the mark's title and poster.
+ */
+internal fun buildLibraryHistory(
+    progress: List<WatchProgress>,
+    watched: List<WatchedItem>,
+    cap: Int = LIBRARY_HISTORY_MAX_ENTRIES
+): List<LibraryHistoryEntry> {
+    val latestProgress = HashMap<String, WatchProgress>(progress.size)
+    progress.forEach { p ->
+        if (p.contentId.isNotBlank()) {
+            latestProgress.merge(p.contentId, p) { a, b -> maxOf(a, b, LibraryProgressOrder) }
+        }
+    }
+    val latestWatched = HashMap<String, WatchedItem>()
+    watched.forEach { w ->
+        if (w.contentId.isNotBlank()) {
+            latestWatched.merge(w.contentId, w) { a, b -> maxOf(a, b, LibraryWatchedOrder) }
+        }
+    }
+    val ids = LinkedHashSet<String>(latestProgress.keys).apply { addAll(latestWatched.keys) }
+    return ids.map { id ->
+        val p = latestProgress[id]
+        val w = latestWatched[id]
+        // The progress entry when it is the newer of the two.
+        val latestPlay = p?.takeIf { w == null || it.lastWatched >= w.watchedAt }
+        LibraryHistoryEntry(
+            id = id,
+            type = (latestPlay?.contentType ?: w?.contentType).orEmpty().ifBlank { "movie" },
+            name = (latestPlay?.name ?: w?.title).orEmpty().ifBlank { id },
+            poster = latestPlay?.poster ?: w?.poster,
+            backdrop = latestPlay?.backdrop,
+            logo = latestPlay?.logo,
+            season = latestPlay?.season,
+            episode = latestPlay?.episode,
+            watchedAt = maxOf(p?.lastWatched ?: 0L, w?.watchedAt ?: 0L),
+            progressFraction = latestPlay?.takeUnless { it.isCompleted() }?.progressPercentage,
+            addonBaseUrl = latestPlay?.addonBaseUrl
+        )
+    }
+        .sortedWith(compareByDescending<LibraryHistoryEntry> { it.watchedAt }.thenBy { it.id })
+        .take(cap.coerceAtLeast(0))
+}
+
+/**
+ * [history] (newest first) as grid sections: Today (since local midnight; a time ahead of [now]
+ * counts as today), This week (the six days before), then one section per month. Empty sections
+ * are left out.
+ */
+internal fun libraryHistorySections(
+    history: List<LibraryHistoryEntry>,
+    zone: ZoneId,
+    now: ZonedDateTime
+): List<LibraryHistorySection> {
+    val today = now.toLocalDate()
+    val todayStartMs = today.atStartOfDay(zone).toInstant().toEpochMilli()
+    val weekStartMs = today.minusDays(6).atStartOfDay(zone).toInstant().toEpochMilli()
+    val todayEntries = mutableListOf<LibraryHistoryEntry>()
+    val weekEntries = mutableListOf<LibraryHistoryEntry>()
+    val byMonth = linkedMapOf<YearMonth, MutableList<LibraryHistoryEntry>>()
+    history.forEach { entry ->
+        when {
+            entry.watchedAt >= todayStartMs -> todayEntries += entry
+            entry.watchedAt >= weekStartMs -> weekEntries += entry
+            else -> byMonth.getOrPut(YearMonth.from(Instant.ofEpochMilli(entry.watchedAt).atZone(zone))) { mutableListOf() } += entry
+        }
+    }
+    return buildList {
+        add(LibraryHistorySection("history:today", LibraryHistoryGroupKind.TODAY, null, todayEntries))
+        add(LibraryHistorySection("history:week", LibraryHistoryGroupKind.THIS_WEEK, null, weekEntries))
+        byMonth.forEach { (month, entries) ->
+            add(LibraryHistorySection("history:$month", LibraryHistoryGroupKind.MONTH, month, entries))
+        }
+    }.filter { it.entries.isNotEmpty() }
+}
+
+/**
+ * When a title was last watched, as the History card caption says it: today's time ("20:15"),
+ * this week's weekday + time ("Tue 20:15"), then the date (with the year when not this year).
+ * Locale-default patterns; no string resources so the caption stays a pure function.
+ */
+internal fun libraryHistoryWhenLine(watchedAt: Long, today: LocalDate, zone: ZoneId): String {
+    val zoned = Instant.ofEpochMilli(watchedAt).atZone(zone)
+    val date = zoned.toLocalDate()
+    val pattern = when {
+        date == today -> "HH:mm"
+        date.isAfter(today.minusDays(7)) -> "EEE HH:mm"
+        date.year == today.year -> "MMM d"
+        else -> "MMM d, yyyy"
+    }
+    return java.time.format.DateTimeFormatter.ofPattern(pattern, java.util.Locale.getDefault()).format(zoned)
+}
