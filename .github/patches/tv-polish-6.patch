+    /**
+     * Continue Watching. With no hidden libraries the server's global resume list is used; otherwise
+     * each VISIBLE library is asked on its own (ParentId) so hidden libraries never leak titles into
+     * the strip, and the merged list is re-sorted by last played date.
+     */
+    private suspend fun getResumeItems(
+        session: JellyfinSession,
+        visibleLibraryIds: List<String>?,
+    ): List<JellyfinItem> {
+        suspend fun fetch(parentId: String?): List<Pair<JellyfinItem, String>> =
+            call(
+                session,
+                "/Users/${session.userId}/Items/Resume",
+                buildMap {
+                    put("MediaTypes", "Video")
+                    put("Limit", HOME_ROW_LIMIT.toString())
+                    put("Fields", LIST_FIELDS)
+                    put("Recursive", "true")
+                    put("EnableImageTypes", "Primary,Backdrop,Thumb,Logo")
+                    put("ImageTypeLimit", "1")
+                    if (parentId != null) put("ParentId", parentId)
+                },
+            ).array("Items").orEmpty().mapNotNull { element ->
+                val obj = element as? JsonObject ?: return@mapNotNull null
+                val item = parseItem(obj) ?: return@mapNotNull null
+                val played = ((obj["UserData"] as? JsonObject)?.get("LastPlayedDate") as? kotlinx.serialization.json.JsonPrimitive)
+                    ?.contentOrNull.orEmpty()
+                item to played
+            }
+        if (visibleLibraryIds == null) return fetch(null).map { it.first }
+        val pages = coroutineScope {
+            visibleLibraryIds.map { id -> async { runCatching { fetch(id) }.getOrDefault(emptyList()) } }.awaitAll()
+        }
+        return pages.flatten()
+            .distinctBy { it.first.id }
+            .sortedByDescending { it.second }
+            .take(HOME_ROW_LIMIT)
+            .map { it.first }
+    }
 
