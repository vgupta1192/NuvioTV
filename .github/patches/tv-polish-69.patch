@@ -0,0 +1,156 @@
+package com.nuvio.tv.ui.screens.player.seekpreview
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.BitmapRegionDecoder
+import android.graphics.Rect
+import android.util.Log
+import android.util.LruCache
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItemStoryboard
+import java.io.File
+import java.util.concurrent.TimeUnit
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+
+private const val TAG = "StoryboardPreview"
+private const val MAX_DISK_BYTES = 24L * 1024 * 1024
+private const val MEMORY_SHEETS = 8
+private const val MEMORY_TILES = 24
+private const val USER_AGENT =
+    "Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
+
+/**
+ * Sprite sheets are written under cacheDir and deleted when the track closes. The 24 MB cap is
+ * only a safety ceiling for very long videos.
+ */
+internal object YouTubeStoryboardCache {
+    private const val DIR = "youtube-storyboards"
+
+    fun cleanup(context: Context) {
+        runCatching { File(context.cacheDir, DIR).deleteRecursively() }
+    }
+
+    fun directory(context: Context, videoId: String): File =
+        File(File(context.cacheDir, DIR), videoId)
+}
+
+/** Seek previews for YouTube videos: a tile cut from YouTube's own sprite sheet, no decoder needed. */
+internal class YouTubeStoryboardTrack(
+    context: Context,
+    private val storyboard: MediaItemStoryboard,
+    videoId: String,
+) : SeekPreviewTrack {
+    override var offsetMs: Long = 0L
+
+    private val directory = YouTubeStoryboardCache.directory(context, videoId)
+    private val sheets = LruCache<String, ByteArray>(MEMORY_SHEETS)
+    private val tiles = LruCache<String, Bitmap>(MEMORY_TILES)
+    private val http by lazy {
+        OkHttpClient.Builder()
+            .connectTimeout(10, TimeUnit.SECONDS)
+            .readTimeout(10, TimeUnit.SECONDS)
+            .followRedirects(true)
+            .build()
+    }
+
+    @Volatile
+    private var closed = false
+
+    override suspend fun thumbnailFor(positionMs: Long): SeekPreviewThumbnail? =
+        withContext(Dispatchers.IO) { tileAt(positionMs + offsetMs) }
+
+    private fun tileAt(positionMs: Long): SeekPreviewThumbnail? {
+        if (closed) return null
+        val size = runCatching { storyboard.groupSize }.getOrNull() ?: return null
+        val width = size.width
+        val height = size.height
+        val columns = size.colCount.coerceAtLeast(1)
+        val rows = size.rowCount.coerceAtLeast(1)
+        if (width <= 0 || height <= 0) return null
+
+        val groupDurationMs = storyboard.groupDurationMS.toLong().coerceAtLeast(1L)
+        val tileDurationMs = size.durationEachMS.toLong().coerceAtLeast(1L)
+        val safePosition = positionMs.coerceAtLeast(0L)
+        val group = (safePosition / groupDurationMs).toInt()
+        val groupStart = group.toLong() * groupDurationMs
+        val tile = ((safePosition - groupStart) / tileDurationMs).toInt().coerceIn(0, rows * columns - 1)
+        val cueStart = groupStart + tile * tileDurationMs
+        val key = "$group/$tile"
+        tiles.get(key)?.let { return SeekPreviewThumbnail(it, cueStart, cueStart + tileDurationMs) }
+
+        val url = runCatching { storyboard.getGroupUrl(group) }.getOrNull() ?: return null
+        val bytes = sheets.get(url) ?: loadSheet(group, url) ?: return null
+        val x = (tile % columns) * width
+        val y = (tile / columns) * height
+        val decoder = runCatching { BitmapRegionDecoder.newInstance(bytes, 0, bytes.size, false) }.getOrNull()
+            ?: return null
+        val decoded: Bitmap? = try {
+            decoder.decodeRegion(
+                Rect(x, y, x + width, y + height),
+                BitmapFactory.Options().apply { inPreferredConfig = Bitmap.Config.ARGB_8888 }
+            )
+        } catch (error: Throwable) {
+            Log.w(TAG, "could not decode tile $group/$tile", error)
+            null
+        } finally {
+            decoder.recycle()
+        }
+        val bitmap = decoded ?: return null
+        tiles.put(key, bitmap)
+        return SeekPreviewThumbnail(bitmap, cueStart, cueStart + tileDurationMs)
+    }
+
+    private fun loadSheet(group: Int, url: String): ByteArray? {
+        val file = File(directory, "g$group.jpg")
+        if (file.isFile && file.length() > 0) {
+            runCatching { file.readBytes() }.getOrNull()?.let { cached ->
+                sheets.put(url, cached)
+                return cached
+            }
+        }
+        val bytes = runCatching {
+            http.newCall(Request.Builder().url(url).header("User-Agent", USER_AGENT).build())
+                .execute().use { response ->
+                    if (!response.isSuccessful) {
+                        Log.w(TAG, "sheet $group -> HTTP ${response.code}")
+                        null
+                    } else {
+                        response.body?.bytes()
+                    }
+                }
+        }.onFailure { Log.w(TAG, "sheet $group request failed", it) }.getOrNull() ?: return null
+
+        sheets.put(url, bytes)
+        runCatching {
+            directory.mkdirs()
+            val temp = File(directory, "g$group.tmp")
+            temp.writeBytes(bytes)
+            if (!temp.renameTo(file)) {
+                file.writeBytes(bytes)
+                temp.delete()
+            }
+            trimDiskCache()
+        }.onFailure { Log.w(TAG, "could not cache sheet $group", it) }
+        return bytes
+    }
+
+    private fun trimDiskCache() {
+        val files = directory.listFiles()?.filter { it.isFile }?.sortedBy { it.lastModified() } ?: return
+        var total = files.sumOf { it.length() }
+        for (file in files) {
+            if (total <= MAX_DISK_BYTES) break
+            total -= file.length()
+            file.delete()
+        }
+    }
+
+    override fun close() {
+        closed = true
+        sheets.evictAll()
+        tiles.evictAll()
+        runCatching { directory.deleteRecursively() }
+    }
+}
