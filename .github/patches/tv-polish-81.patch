+/** Nuvio fork: the page the app opens on, kept in a small file so it is known before the first screen is drawn. */
+object ForkStartPage {
+    private const val PREFS = "fork_start_page"
+    private const val KEY = "route"
+    val choices = listOf(
+        Screen.TvChannels.route to "Live TV",
+        Screen.Jellyfin.route to "Jellyfin",
+        Screen.Search.route to "Search",
+        Screen.Library.route to "Library",
+        Screen.YouTube.route to "YouTube"
+    )
+
+    fun get(context: android.content.Context): String? = runCatching {
+        context.getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE).getString(KEY, null)
+    }.getOrNull()?.takeIf { r -> choices.any { it.first == r } }
+
+    fun set(context: android.content.Context, route: String?) {
+        val p = context.getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+        p.edit().apply { if (route == null) remove(KEY) else putString(KEY, route) }.apply()
+    }
+}
