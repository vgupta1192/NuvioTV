diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt
new file mode 100644
index 000000000..2d65e1aac
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt
@@ -0,0 +1,92 @@
+package com.nuvio.tv.youtube
+
+import android.util.Log
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItemStoryboard
+import com.liskovsoft.youtubeapi.formatbuilders.storyboard.YouTubeStoryParser
+import com.liskovsoft.youtubeapi.service.data.YouTubeMediaItemStoryboard
+import com.liskovsoft.youtubeapi.videoinfo.V2.VideoInfoService
+import java.util.concurrent.ConcurrentHashMap
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * The storyboard spec that came back with a video's playback info. The spec is just sprite-sheet
+ * URLs and tile geometry; the images themselves are fetched on demand by the seek preview.
+ *
+ * The playback client used for the actual stream (VISIONOS in practice) does not always include
+ * storyboards. In that case [ensure] asks the older MediaServiceCore video-info path, which also
+ * repairs missing storyboards from its HLS response. That request runs in the background, once per
+ * video, so it never delays playback.
+ */
+object YouTubeStoryboards {
+    private const val TAG = "YouTubeStoryboards"
+    private const val MAX_ENTRIES = 32
+    private const val LEGACY_FETCH_DELAY_MS = 1_000L
+
+    private val entries = ConcurrentHashMap<String, MediaItemStoryboard>()
+    private val attempted = ConcurrentHashMap.newKeySet<String>()
+    private val fetching = ConcurrentHashMap<String, Boolean>()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    private val _version = MutableStateFlow(0)
+    /** Increments whenever a storyboard arrives or is removed, so the player can recompose. */
+    val version: StateFlow<Int> = _version.asStateFlow()
+
+    fun put(videoId: String, storyboard: MediaItemStoryboard?) {
+        if (storyboard == null) {
+            entries.remove(videoId)
+            _version.value++
+            return
+        }
+        if (entries.size >= MAX_ENTRIES) entries.clear()
+        entries[videoId] = storyboard
+        attempted.remove(videoId)
+        _version.value++
+        Log.i(TAG, "storyboard ready video=$videoId")
+    }
+
+    fun get(videoId: String): MediaItemStoryboard? = entries[videoId]
+
+    fun clear(videoId: String) {
+        entries.remove(videoId)
+        attempted.remove(videoId)
+        _version.value++
+    }
+
+    /**
+     * Fetches a missing storyboard once, in the background. Safe to call from composition: it
+     * returns immediately and never repeats the request for the same video in this session.
+     */
+    fun ensure(videoId: String) {
+        if (entries.containsKey(videoId)) return
+        if (!attempted.add(videoId)) return
+        if (fetching.putIfAbsent(videoId, true) != null) return
+        scope.launch {
+            try {
+                // Give playback a moment to start before the extra video-info request.
+                delay(LEGACY_FETCH_DELAY_MS)
+                val storyboard = fetchLegacy(videoId)
+                Log.i(TAG, "legacy storyboard video=$videoId available=${storyboard != null}")
+                if (storyboard != null) put(videoId, storyboard)
+            } finally {
+                fetching.remove(videoId)
+            }
+        }
+    }
+
+    private fun fetchLegacy(videoId: String): MediaItemStoryboard? = runCatching {
+        val videoInfo = VideoInfoService.instance().getVideoInfo(videoId, null) ?: return@runCatching null
+        val spec = videoInfo.storyboardSpec ?: return@runCatching null
+        val parser = YouTubeStoryParser.from(spec)
+        parser.setSegmentDurationUs(videoInfo.segmentDurationUs)
+        parser.setStartSegmentNum(videoInfo.startSegmentNum)
+        val story = parser.extractStory() ?: return@runCatching null
+        YouTubeMediaItemStoryboard.from(story)
+    }.onFailure { Log.w(TAG, "legacy storyboard failed video=$videoId", it) }.getOrNull()
+}
diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt
new file mode 100644
index 000000000..e41519c60
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt
@@ -0,0 +1,91 @@
+package com.nuvio.tv.youtube
+
+import android.util.Log
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.util.concurrent.TimeUnit
+
+/**
+ * Works out which translated caption line is showing at a given moment in a YouTube video.
+ *
+ * The player accepts the translated caption track this app serves but never turns its segments into
+ * cues, so nothing would be drawn. The lines are read from the same local server and handed to the
+ * subtitle overlay by the player screen instead. Only YouTube uses this: Live TV, On Demand and
+ * addon subtitles keep the normal path untouched.
+ */
+internal class YouTubeTranslatedCaptions(
+    private val videoId: String,
+    private val language: String
+) {
+    private var segmentNumber = -1L
+    private var cues: List<Cue> = emptyList()
+    private var wholeFileCues: List<Cue>? = null
+    private var wholeFileTried = false
+
+    private class Cue(val startMs: Long, val endMs: Long, val text: String)
+
+    /** The line showing at [positionMs], or null when nothing is said then. */
+    suspend fun lineAt(positionMs: Long): String? = withContext(Dispatchers.IO) {
+        if (!wholeFileTried) {
+            wholeFileTried = true
+            val file = YouTubeMpdServer.translatedCaptionFile(videoId, language)
+            val cleaned = file?.let {
+                if (YouTubeAutoCaptions.looksAutomatic(it)) YouTubeAutoCaptions.tidy(it) else it
+            }
+            val parsed = cleaned?.let(::parse).orEmpty()
+            if (parsed.isNotEmpty()) {
+                wholeFileCues = parsed
+                Log.i(TAG, "direct translated captions $videoId/$language cues=${parsed.size}")
+            } else {
+                Log.i(TAG, "direct translated captions $videoId/$language unavailable; using local translation")
+            }
+        }
+        wholeFileCues?.let { all ->
+            return@withContext all.firstOrNull { positionMs >= it.startMs && positionMs < it.endMs }?.text
+        }
+
+        val number = positionMs / SEGMENT_MS
+        if (number != segmentNumber) {
+            segmentNumber = number
+            cues = fetch(number)
+        }
+        val inside = positionMs - number * SEGMENT_MS
+        cues.firstOrNull { inside >= it.startMs && inside < it.endMs }?.text
+    }
+
+    private fun fetch(number: Long): List<Cue> {
+        val url = YouTubeMpdServer.segmentUrl(videoId, language, number) ?: return emptyList()
+        val body = runCatching {
+            http.newCall(Request.Builder().url(url).build()).execute().use { response ->
+                if (response.isSuccessful) response.body.string() else null
+            }
+        }.getOrNull() ?: return emptyList()
+        return parse(body)
+    }
+
+    private fun parse(vtt: String): List<Cue> {
+        val cues = ArrayList<Cue>()
+        for (block in vtt.replace("\r\n", "\n").split(Regex("\n{2,}"))) {
+            val lines = block.lines()
+            val timingIndex = lines.indexOfFirst { "-->" in it }
+            if (timingIndex < 0) continue
+            val match = timing.find(lines[timingIndex]) ?: continue
+            fun part(i: Int) = match.groupValues[i].toLongOrNull() ?: 0L
+            val start = part(1) * 3_600_000 + part(2) * 60_000 + part(3) * 1_000 + part(4)
+            val end = part(5) * 3_600_000 + part(6) * 60_000 + part(7) * 1_000 + part(8)
+            val text = lines.drop(timingIndex + 1).joinToString("\n").trim()
+            if (text.isNotEmpty()) cues += Cue(start, end, text)
+        }
+        return cues
+    }
+
+    private companion object {
+        const val TAG = "YouTubeCaptions"
+        const val SEGMENT_MS = YouTubeCaptionSegments.DURATION_SECONDS * 1_000
+        /** Hours are optional in the timing line; minutes and seconds are always there. */
+        val timing = Regex("(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})\\s*-->\\s*(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})")
+        val http by lazy { OkHttpClient.Builder().callTimeout(20, TimeUnit.SECONDS).build() }
+    }
+}
