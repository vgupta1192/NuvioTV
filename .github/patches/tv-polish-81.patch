+        val settings = playerSettingsDataStore.playerSettings.first()
+        DebugReportBuilder.build(
+            context = context,
+            addons = addonRepository.getInstalledAddons().first(),
+            diagnostics = playerSettingsDataStore.lastPlaybackDiagnostics.first(),
