--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeCaptionSegments.kt
@@ -0,0 +1,33 @@
+package com.nuvio.tv.youtube
+
+/** Builds a WebVTT segment with timestamps relative to its start, including cues crossing its edges. */
+internal object YouTubeCaptionSegments {
+    const val DURATION_SECONDS = 60L
+    private val timing = Regex("(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})\\s*-->\\s*(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})")
+
+    fun extract(file: String, number: Long): String {
+        if (number < 0 || number > (Long.MAX_VALUE - DURATION_SECONDS * 1000) / (DURATION_SECONDS * 1000)) return "WEBVTT\n\n"
+        val start = number * DURATION_SECONDS * 1000
+        val end = start + DURATION_SECONDS * 1000
+        val result = StringBuilder("WEBVTT\n\n")
+        for (block in file.replace("\r\n", "\n").split(Regex("\n{2,}"))) {
+            val lines = block.lines()
+            val index = lines.indexOfFirst { "-->" in it }
+            if (index < 0) continue
+            val match = timing.find(lines[index]) ?: continue
+            fun time(i: Int) = (match.groupValues[i].toLongOrNull() ?: 0L) * 3_600_000 +
+                match.groupValues[i + 1].toLong() * 60_000 + match.groupValues[i + 2].toLong() * 1_000 + match.groupValues[i + 3].toLong()
+            val cueStart = time(1)
+            val cueEnd = time(5)
+            if (cueEnd <= start || cueStart >= end) continue
+            result.append(stamp((cueStart - start).coerceAtLeast(0))).append(" --> ")
+                .append(stamp((cueEnd - start).coerceAtMost(end - start))).append('\n')
+            result.append(lines.drop(index + 1).joinToString("\n")).append("\n\n")
+        }
+        return result.toString()
+    }
+
+    private fun stamp(ms: Long): String = "%02d:%02d:%02d.%03d".format(
+        java.util.Locale.US, ms / 3_600_000, ms / 60_000 % 60, ms / 1_000 % 60, ms % 1_000
+    )
+}
diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeCaptionTranslation.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeCaptionTranslation.kt
new file mode 100644
index 0000000000..bb179ea433
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeCaptionTranslation.kt
@@ -0,0 +1,260 @@
+package com.nuvio.tv.youtube
+
+import android.util.Log
+import okhttp3.FormBody
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.net.URLEncoder
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+
+/**
+ * Translates caption text for the auto-translated tracks.
+ *
+ * YouTube hands translated captions only to its own apps, so the video's own captions are fetched
+ * and translated here. The free Google endpoint that does the translating refuses some networks
+ * outright: instead of a translation it answers with a captcha (HTTP 302 to google.com/sorry), and
+ * a home connection behind a VPN or a shared IP can stay barred for a long time.
+ *
+ * So more than one translator is tried. A provider that refuses is put on a cool-down and skipped
+ * for the next few minutes, which keeps the page from waiting on a service that is already saying
+ * no. Lines that did get translated are remembered in memory and on disk, so seeking back over the
+ * same minute costs no requests at all.
+ */
+internal object YouTubeCaptionTranslation {
+    private const val TAG = "YouTubeCaptions"
+    private const val USER_AGENT =
+        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
+    /** How long a refusing translator is skipped for. */
+    private const val COOLDOWN_MS = 10 * 60 * 1000L
+    /** MyMemory answers a single GET, and the free endpoint caps the query at about 500 URL-encoded bytes. */
+    private const val MYMEMORY_MAX_CHARS = 300
+    /** Translated lines kept in memory for the session. */
+    private const val MEMORY_LIMIT = 4_000
+    /** Translated lines read back from a language's cache file. */
+    private const val DISK_LIMIT = 20_000
+    private const val DISK_MAX_BYTES = 4L * 1024 * 1024
+    private const val SEP = "\u0000"
+
+    private class Provider(val name: String, val translate: (String, String, String?) -> String?)
+
+    private val providers = listOf(
+        Provider("google", ::translateWithGoogle),
+        Provider("mymemory", ::translateWithMyMemory)
+    )
+
+    private val cooldownUntil = ConcurrentHashMap<String, Long>()
+    private val memory = ConcurrentHashMap<String, String>()
+    private val diskMaps = ConcurrentHashMap<String, MutableMap<String, String>>()
+
+    @Volatile private var cacheDir: File? = null
+
+    private val writer = Executors.newSingleThreadExecutor { runnable ->
+        Thread(runnable, "yt-caption-cache").apply { isDaemon = true }
+    }
+
+    private val http by lazy {
+        // Redirects are not followed: a captcha block is a redirect, and following it would read as
+        // a successful HTML page rather than the refusal it is.
+        OkHttpClient.Builder()
+            .followRedirects(false)
+            .followSslRedirects(false)
+            .connectTimeout(10, TimeUnit.SECONDS)
+            .readTimeout(15, TimeUnit.SECONDS)
+            .callTimeout(20, TimeUnit.SECONDS)
+            .build()
+    }
+
+    /** Tells the translator where to keep its cache. Null keeps translations in memory only. */
+    fun attach(dir: File?) {
+        cacheDir = dir
+    }
+
+    /** Translates [text] into [language]; null when no translator could be reached. */
+    fun translate(text: String, language: String, source: String?): String? {
+        if (text.isBlank()) return text
+        val target = targetCode(language)
+        val sourceCode = source?.let(::sourceCode)
+        val key = target + SEP + text
+
+        memory[key]?.let { return it }
+        diskMap(target)[text]?.let {
+            memory[key] = it
+            return it
+        }
+
+        for (provider in providers) {
+            if (isCooling(provider.name)) continue
+            val result = runCatching { provider.translate(text, target, sourceCode) }
+                .onFailure { Log.w(TAG, "${provider.name} translate failed", it) }
+                .getOrNull()
+            if (!result.isNullOrBlank()) {
+                if (provider.name != "google") Log.d(TAG, "translated the captions with ${provider.name}")
+                remember(target, text, result)
+                return result
+            }
+        }
+        val cooling = providers.filter { isCooling(it.name) }.joinToString(",") { it.name }
+        Log.w(TAG, "no translator could handle the captions right now (source=${source ?: "unknown"}, cooling=[$cooling])")
+        return null
+    }
+
+    // ---- translators ----
+
+    private fun translateWithGoogle(text: String, target: String, source: String?): String? {
+        val request = Request.Builder()
+            .url("https://translate.googleapis.com/translate_a/single?client=gtx&sl=${source ?: "auto"}&tl=$target&dt=t")
+            .header("User-Agent", USER_AGENT)
+            .post(FormBody.Builder().add("q", text).build())
+            .build()
+        http.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) {
+                // 302 is the captcha block, 403 and 429 are the same refusal phrased differently.
+                if (response.code == 302 || response.code == 403 || response.code == 429) {
+                    cool("google")
+                    Log.w(TAG, "google translate refused this network (HTTP ${response.code}); using another translator")
+                } else {
+                    Log.w(TAG, "google translate -> HTTP ${response.code}")
+                }
+                return null
+            }
+            val parts = JSONArray(response.body.string()).getJSONArray(0)
+            val translated = buildString {
+                for (i in 0 until parts.length()) append(parts.getJSONArray(i).optString(0))
+            }
+            return translated.takeIf { it.isNotBlank() }
+        }
+    }
+
+    private fun translateWithMyMemory(text: String, target: String, source: String?): String? {
+        // It cannot guess the source language, and the free endpoint only takes short queries.
+        if (source == null || text.length > MYMEMORY_MAX_CHARS) return null
+        val query = URLEncoder.encode(text, "UTF-8").replace("+", "%20")
+        val request = Request.Builder()
+            .url("https://api.mymemory.translated.net/get?q=$query&langpair=$source%7C$target")
+            .header("User-Agent", USER_AGENT)
+            .build()
+        http.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) {
+                Log.w(TAG, "mymemory -> HTTP ${response.code}")
+                return null
+            }
+            val json = JSONObject(response.body.string())
+            if (json.optBoolean("quotaFinished")) {
+                cool("mymemory")
+                Log.w(TAG, "mymemory is out of quota for today; using another translator")
+                return null
+            }
+            val translated = json.optJSONObject("responseData")?.optString("translatedText").orEmpty()
+            if (translated.isBlank() || translated.contains("MYMEMORY WARNING", ignoreCase = true)) {
+                cool("mymemory")
+                return null
+            }
+            return translated
+        }
+    }
+
+    private fun isCooling(name: String) = (cooldownUntil[name] ?: 0L) > System.currentTimeMillis()
+
+    private fun cool(name: String) {
+        cooldownUntil[name] = System.currentTimeMillis() + COOLDOWN_MS
+    }
+
+    // ---- remembered lines ----
+
+    /** Remembers one line that a caller translated in a batch. */
+    fun rememberLine(language: String, text: String, translated: String) {
+        if (text.isBlank() || translated.isBlank()) return
+        remember(targetCode(language), text, translated)
+    }
+
+    private fun remember(language: String, text: String, translated: String) {
+        memory[language + SEP + text] = translated
+        if (memory.size > MEMORY_LIMIT) memory.clear()
+        diskMap(language)[text] = translated
+
+        val file = fileFor(language) ?: return
+        writer.execute {
+            runCatching {
+                if (file.length() > DISK_MAX_BYTES) {
+                    file.delete()
+                    diskMaps[language]?.clear()
+                }
+                file.appendText(escape(text) + "\t" + escape(translated) + "\n")
+            }.onFailure { Log.w(TAG, "couldn't cache a translated caption line", it) }
+        }
+    }
+
+    private fun diskMap(language: String): MutableMap<String, String> =
+        diskMaps[language] ?: synchronized(diskMaps) {
+            diskMaps.getOrPut(language) { readDisk(language) }
+        }
+
+    private fun readDisk(language: String): MutableMap<String, String> {
+        val lines = HashMap<String, String>()
+        val file = fileFor(language) ?: return lines
+        if (!file.exists()) return lines
+        runCatching {
+            file.useLines { all ->
+                all.take(DISK_LIMIT).forEach { line ->
+                    val tab = line.indexOf('\t')
+                    if (tab <= 0) return@forEach
+                    val text = unescape(line.substring(0, tab))
+                    if (text.isNotEmpty()) lines[text] = unescape(line.substring(tab + 1))
+                }
+            }
+        }.onFailure { Log.w(TAG, "couldn't read the caption translation cache", it) }
+        return lines
+    }
+
+    private fun fileFor(language: String): File? {
+        val dir = cacheDir ?: return null
+        val folder = File(dir, "yt-captions").apply { mkdirs() }
+        return File(folder, language.replace(Regex("[^A-Za-z0-9_-]"), "_") + ".tsv")
+    }
+
+    // ---- codes ----
+
+    internal fun targetCode(language: String): String = when (language) {
+        "zh-Hans" -> "zh-CN"
+        "zh-Hant" -> "zh-TW"
+        "iw" -> "he"
+        else -> language
+    }
+
+    internal fun sourceCode(language: String): String =
+        if (language == "iw") "he" else language.substringBefore('-')
+
+    // ---- cache file escaping ----
+
+    internal fun escape(value: String): String = value
+        .replace("\\", "\\\\")
+        .replace("\t", "\\t")
+        .replace("\r", "")
+        .replace("\n", "\\n")
+
+    internal fun unescape(value: String): String {
+        val out = StringBuilder(value.length)
+        var i = 0
+        while (i < value.length) {
+            val c = value[i]
+            if (c == '\\' && i + 1 < value.length) {
+                when (value[i + 1]) {
+                    't' -> out.append('\t')
+                    'n' -> out.append('\n')
+                    '\\' -> out.append('\\')
+                    else -> out.append(value[i + 1])
+                }
+                i += 2
+            } else {
+                out.append(c)
+                i++
+            }
+        }
+        return out.toString()
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeCompatibility.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeCompatibility.kt
new file mode 100644
index 0000000000..fd643803f3
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeCompatibility.kt
@@ -0,0 +1,130 @@
+package com.nuvio.tv.youtube
+
+import android.app.ActivityManager
+import android.content.Context
+import android.media.MediaCodecInfo
+import android.media.MediaCodecList
+import android.os.Build
+import androidx.media3.common.MimeTypes
+import java.util.Locale
+
+private const val GB = 1024L * 1024L * 1024L
+private const val ONE_GB = GB
+private const val ONE_AND_HALF_GB = 3L * GB / 2L
+
+/**
+ * What this device can decode reliably, used to decide YouTube's starting codec and quality.
+ *
+ * This is deliberately capability-based rather than brand-based: a 1.5 GB box with a good
+ * hardware H.264 decoder can still be a fine 1080p player, while a 2 GB box with a poor VP9
+ * decoder can freeze after seeking.
+ */
+internal data class YouTubeDeviceProfile(
+    val lowRamDevice: Boolean,
+    val totalRamBytes: Long,
+    val hasHardwareAvc: Boolean,
+    val hasHardwareVp9: Boolean,
+    val hasHardwareAv1: Boolean,
+    val maxAvcHeight: Int?,
+    val maxVp9Height: Int?,
+    val maxAv1Height: Int?,
+) {
+    /**
+     * H.264 + a quality cap are worth using when the device is short on memory or has no
+     * hardware VP9 decoder. AV1 alone doesn't trigger this: the normal codec order already
+     * leaves AV1 last.
+     */
+    val needsCompatibility: Boolean
+        get() =
+            lowRamDevice ||
+                (totalRamBytes in 1L..ONE_AND_HALF_GB) ||
+                !hasHardwareAvc ||
+                !hasHardwareVp9 ||
+                (maxVp9Height != null && maxVp9Height < 1080)
+
+    /** The starting size used when compatibility is active. */
+    val compatibilityHeight: Int
+        get() = when {
+            !hasHardwareAvc -> 720
+            totalRamBytes in 1L..ONE_GB -> 720
+            else -> 1080
+        }
+
+    /** A short explanation for the settings screen and diagnostics. */
+    val reason: String
+        get() = when {
+            !hasHardwareAvc -> "Limited hardware decoding"
+            !hasHardwareVp9 -> "No hardware VP9 decoder"
+            maxVp9Height != null && maxVp9Height < 1080 -> "VP9 limited to ${maxVp9Height}p"
+            lowRamDevice || totalRamBytes in 1L..ONE_AND_HALF_GB -> "Low memory"
+            else -> "Full hardware decoding"
+        }
+}
+
+internal object YouTubeCompatibility {
+    @Volatile
+    private var cached: YouTubeDeviceProfile? = null
+
+    fun deviceProfile(context: Context): YouTubeDeviceProfile {
+        cached?.let { return it }
+        return synchronized(this) {
+            cached?.let { return it }
+            val activityManager = context.getSystemService(Context.ACTIVITY_SERVICE) as? ActivityManager
+            val memory = ActivityManager.MemoryInfo()
+            runCatching { activityManager?.getMemoryInfo(memory) }
+            val avc = hardwareSupport(MimeTypes.VIDEO_H264)
+            val vp9 = hardwareSupport(MimeTypes.VIDEO_VP9)
+            val av1 = hardwareSupport(MimeTypes.VIDEO_AV1)
+            val profile = YouTubeDeviceProfile(
+                lowRamDevice = activityManager?.isLowRamDevice == true,
+                totalRamBytes = memory.totalMem,
+                hasHardwareAvc = avc.available,
+                hasHardwareVp9 = vp9.available,
+                hasHardwareAv1 = av1.available,
+                maxAvcHeight = avc.maxHeight,
+                maxVp9Height = vp9.maxHeight,
+                maxAv1Height = av1.maxHeight,
+            )
+            cached = profile
+            profile
+        }
+    }
+
+    private data class DecoderSupport(val available: Boolean, val maxHeight: Int?)
+
+    private fun hardwareSupport(mimeType: String): DecoderSupport {
+        var available = false
+        var maxHeight: Int? = null
+        runCatching {
+            val codecs = MediaCodecList(MediaCodecList.ALL_CODECS).codecInfos
+            for (info in codecs) {
+                if (info.isEncoder) continue
+                if (info.supportedTypes.none { it.equals(mimeType, true) }) continue
+                if (!isHardwareDecoder(info)) continue
+                available = true
+                val height = runCatching {
+                    info.getCapabilitiesForType(mimeType).videoCapabilities?.supportedHeights?.upper
+                }.getOrNull()
+                if (height != null && height > 0) {
+                    maxHeight = maxOf(maxHeight ?: 0, height)
+                }
+            }
+        }
+        return DecoderSupport(available, maxHeight)
+    }
+
+    private fun isHardwareDecoder(info: MediaCodecInfo): Boolean {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q && info.isHardwareAccelerated) return true
+        return !isSoftwareDecoderName(info.name)
+    }
+
+    private fun isSoftwareDecoderName(name: String): Boolean {
+        val lower = name.lowercase(Locale.US)
+        return lower.startsWith("omx.google.") ||
+            lower.startsWith("c2.android.") ||
+            lower.startsWith("c2.google.") ||
+            lower.startsWith("omx.ffmpeg.") ||
+            lower.startsWith("lib") ||
+            lower.startsWith("ffmpeg")
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt
new file mode 100644
index 0000000000..2d65e1aac7
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeStoryboards.kt
@@ -0,0 +1,92 @@
+package com.nuvio.tv.youtube
+
+import android.util.Log
+import com.liskovsoft.mediaserviceinterfaces.data.MediaItemStoryboard
+import com.liskovsoft.youtubeapi.formatbuilders.storyboard.YouTubeStoryParser
+import com.liskovsoft.youtubeapi.service.data.YouTubeMediaItemStoryboard
+import com.liskovsoft.youtubeapi.videoinfo.V2.VideoInfoService
+import java.util.concurrent.ConcurrentHashMap
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+
+/**
+ * The storyboard spec that came back with a video's playback info. The spec is just sprite-sheet
+ * URLs and tile geometry; the images themselves are fetched on demand by the seek preview.
+ *
+ * The playback client used for the actual stream (VISIONOS in practice) does not always include
+ * storyboards. In that case [ensure] asks the older MediaServiceCore video-info path, which also
+ * repairs missing storyboards from its HLS response. That request runs in the background, once per
+ * video, so it never delays playback.
+ */
+object YouTubeStoryboards {
+    private const val TAG = "YouTubeStoryboards"
+    private const val MAX_ENTRIES = 32
+    private const val LEGACY_FETCH_DELAY_MS = 1_000L
+
+    private val entries = ConcurrentHashMap<String, MediaItemStoryboard>()
+    private val attempted = ConcurrentHashMap.newKeySet<String>()
+    private val fetching = ConcurrentHashMap<String, Boolean>()
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    private val _version = MutableStateFlow(0)
+    /** Increments whenever a storyboard arrives or is removed, so the player can recompose. */
+    val version: StateFlow<Int> = _version.asStateFlow()
+
+    fun put(videoId: String, storyboard: MediaItemStoryboard?) {
+        if (storyboard == null) {
+            entries.remove(videoId)
+            _version.value++
+            return
+        }
+        if (entries.size >= MAX_ENTRIES) entries.clear()
+        entries[videoId] = storyboard
+        attempted.remove(videoId)
+        _version.value++
+        Log.i(TAG, "storyboard ready video=$videoId")
+    }
+
+    fun get(videoId: String): MediaItemStoryboard? = entries[videoId]
+
+    fun clear(videoId: String) {
+        entries.remove(videoId)
+        attempted.remove(videoId)
+        _version.value++
+    }
+
+    /**
+     * Fetches a missing storyboard once, in the background. Safe to call from composition: it
+     * returns immediately and never repeats the request for the same video in this session.
+     */
+    fun ensure(videoId: String) {
+        if (entries.containsKey(videoId)) return
+        if (!attempted.add(videoId)) return
+        if (fetching.putIfAbsent(videoId, true) != null) return
+        scope.launch {
+            try {
+                // Give playback a moment to start before the extra video-info request.
+                delay(LEGACY_FETCH_DELAY_MS)
+                val storyboard = fetchLegacy(videoId)
+                Log.i(TAG, "legacy storyboard video=$videoId available=${storyboard != null}")
+                if (storyboard != null) put(videoId, storyboard)
+            } finally {
+                fetching.remove(videoId)
+            }
+        }
+    }
+
+    private fun fetchLegacy(videoId: String): MediaItemStoryboard? = runCatching {
+        val videoInfo = VideoInfoService.instance().getVideoInfo(videoId, null) ?: return@runCatching null
+        val spec = videoInfo.storyboardSpec ?: return@runCatching null
+        val parser = YouTubeStoryParser.from(spec)
+        parser.setSegmentDurationUs(videoInfo.segmentDurationUs)
+        parser.setStartSegmentNum(videoInfo.startSegmentNum)
+        val story = parser.extractStory() ?: return@runCatching null
+        YouTubeMediaItemStoryboard.from(story)
+    }.onFailure { Log.w(TAG, "legacy storyboard failed video=$videoId", it) }.getOrNull()
+}
diff --git a/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt b/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt
new file mode 100644
index 0000000000..e41519c60c
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeTranslatedCaptions.kt
@@ -0,0 +1,91 @@
+package com.nuvio.tv.youtube
+
+import android.util.Log
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.util.concurrent.TimeUnit
+
+/**
+ * Works out which translated caption line is showing at a given moment in a YouTube video.
+ *
+ * The player accepts the translated caption track this app serves but never turns its segments into
+ * cues, so nothing would be drawn. The lines are read from the same local server and handed to the
+ * subtitle overlay by the player screen instead. Only YouTube uses this: Live TV, On Demand and
+ * addon subtitles keep the normal path untouched.
+ */
+internal class YouTubeTranslatedCaptions(
+    private val videoId: String,
+    private val language: String
+) {
+    private var segmentNumber = -1L
+    private var cues: List<Cue> = emptyList()
+    private var wholeFileCues: List<Cue>? = null
+    private var wholeFileTried = false
+
+    private class Cue(val startMs: Long, val endMs: Long, val text: String)
+
+    /** The line showing at [positionMs], or null when nothing is said then. */
+    suspend fun lineAt(positionMs: Long): String? = withContext(Dispatchers.IO) {
+        if (!wholeFileTried) {
+            wholeFileTried = true
+            val file = YouTubeMpdServer.translatedCaptionFile(videoId, language)
+            val cleaned = file?.let {
+                if (YouTubeAutoCaptions.looksAutomatic(it)) YouTubeAutoCaptions.tidy(it) else it
+            }
+            val parsed = cleaned?.let(::parse).orEmpty()
+            if (parsed.isNotEmpty()) {
+                wholeFileCues = parsed
+                Log.i(TAG, "direct translated captions $videoId/$language cues=${parsed.size}")
+            } else {
+                Log.i(TAG, "direct translated captions $videoId/$language unavailable; using local translation")
+            }
+        }
+        wholeFileCues?.let { all ->
+            return@withContext all.firstOrNull { positionMs >= it.startMs && positionMs < it.endMs }?.text
+        }
+
+        val number = positionMs / SEGMENT_MS
+        if (number != segmentNumber) {
+            segmentNumber = number
+            cues = fetch(number)
+        }
+        val inside = positionMs - number * SEGMENT_MS
+        cues.firstOrNull { inside >= it.startMs && inside < it.endMs }?.text
+    }
+
+    private fun fetch(number: Long): List<Cue> {
+        val url = YouTubeMpdServer.segmentUrl(videoId, language, number) ?: return emptyList()
+        val body = runCatching {
+            http.newCall(Request.Builder().url(url).build()).execute().use { response ->
+                if (response.isSuccessful) response.body.string() else null
+            }
+        }.getOrNull() ?: return emptyList()
+        return parse(body)
+    }
+
+    private fun parse(vtt: String): List<Cue> {
+        val cues = ArrayList<Cue>()
+        for (block in vtt.replace("\r\n", "\n").split(Regex("\n{2,}"))) {
+            val lines = block.lines()
+            val timingIndex = lines.indexOfFirst { "-->" in it }
+            if (timingIndex < 0) continue
+            val match = timing.find(lines[timingIndex]) ?: continue
+            fun part(i: Int) = match.groupValues[i].toLongOrNull() ?: 0L
+            val start = part(1) * 3_600_000 + part(2) * 60_000 + part(3) * 1_000 + part(4)
+            val end = part(5) * 3_600_000 + part(6) * 60_000 + part(7) * 1_000 + part(8)
+            val text = lines.drop(timingIndex + 1).joinToString("\n").trim()
+            if (text.isNotEmpty()) cues += Cue(start, end, text)
+        }
+        return cues
+    }
+
+    private companion object {
+        const val TAG = "YouTubeCaptions"
+        const val SEGMENT_MS = YouTubeCaptionSegments.DURATION_SECONDS * 1_000
+        /** Hours are optional in the timing line; minutes and seconds are always there. */
+        val timing = Regex("(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})\\s*-->\\s*(?:(\\d+):)?(\\d{1,2}):(\\d{2})[.,](\\d{3})")
+        val http by lazy { OkHttpClient.Builder().callTimeout(20, TimeUnit.SECONDS).build() }
+    }
+}
