+package com.nuvio.tv.ui.screens.tvchannels.components
+
+import android.content.Context
+import com.nuvio.tv.ui.screens.player.AspectMode
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Live TV player choices that outlive a channel: picture scale (default Custom Stretch) and automatic subtitles. */
+object LiveTvPlayerPrefs {
+    private const val FILE = "live_tv_player_prefs"
+    private const val KEY_SCALE = "scale"
+    private const val KEY_AUTO_SUBS = "auto_subtitles"
+
+    private val _scale = MutableStateFlow(AspectMode.CUSTOM_STRETCH)
+    val scale: StateFlow<AspectMode> = _scale.asStateFlow()
+
+    @Volatile
+    var autoSubtitles: Boolean = true
+        private set
+
+    @Volatile
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        synchronized(this) {
+            if (loaded) return
+            val prefs = context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+            prefs.getString(KEY_SCALE, null)?.let { name ->
+                runCatching { AspectMode.valueOf(name) }.getOrNull()?.let { _scale.value = it }
+            }
+            autoSubtitles = prefs.getBoolean(KEY_AUTO_SUBS, true)
+            loaded = true
+        }
+    }
+
+    fun setScale(context: Context, mode: AspectMode) {
+        ensureLoaded(context)
+        _scale.value = mode
+        context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().putString(KEY_SCALE, mode.name).apply()
+    }
+
+    fun setAutoSubtitles(context: Context, enabled: Boolean) {
+        ensureLoaded(context)
+        autoSubtitles = enabled
+        context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().putBoolean(KEY_AUTO_SUBS, enabled).apply()
+    }
+}
