+                ForkSportsPrefs.setShowLater(context, showLater)
+            }
+        )
+    }
+}
+
+/** Settings > Live TV: PIN that guards turning adult channels back on. */
+@Composable
+internal fun ForkParentalPinGroup(onUnlockAdult: () -> Unit) {
+    val context = LocalContext.current
+    var hasPin by remember { mutableStateOf(ForkSportsPrefs.hasPin(context)) }
+    var dialog by remember { mutableStateOf(false) }
+    SettingsGroupCard(
+        modifier = Modifier.fillMaxWidth(),
+        title = "Parental PIN",
+        subtitle = "With a PIN set, Hide adult channels can only be turned off by entering it here."
+    ) {
+        SettingsActionRow(
+            title = if (hasPin) "PIN is set" else "No PIN set",
+            subtitle = "Choose OK to " + if (hasPin) "unlock adult channels or remove the PIN." else "set a 4 to 8 digit PIN.",
+            value = if (hasPin) "On" else "Off",
+            onClick = { dialog = true }
+        )
+    }
+    if (dialog) {
+        NuvioDialog(onDismiss = { dialog = false }, title = "Parental PIN", width = 640.dp) {
+            Column(verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                if (!hasPin) {
+                    Text("Type a 4 to 8 digit PIN on your phone.")
+                    PhoneEntryButton(title = "New PIN", secret = true, onValue = { pin ->
+                        if (ForkSportsPrefs.setPin(context, pin.trim())) {
+                            hasPin = true
+                            dialog = false
+                            Toast.makeText(context, "PIN set", Toast.LENGTH_SHORT).show()
+                        } else {
+                            Toast.makeText(context, "Use 4 to 8 digits", Toast.LENGTH_SHORT).show()
+                        }
+                    })
+                } else {
+                    Text("Enter the PIN to unlock adult channels.")
+                    PhoneEntryButton(title = "PIN to unlock", secret = true, onValue = { pin ->
+                        if (ForkSportsPrefs.checkPin(context, pin)) {
+                            onUnlockAdult()
+                            dialog = false
+                            Toast.makeText(context, "Adult channels shown", Toast.LENGTH_SHORT).show()
+                        } else {
+                            Toast.makeText(context, "Wrong PIN", Toast.LENGTH_SHORT).show()
+                        }
+                    })
+                    Text("Or enter the PIN to remove it.")
+                    PhoneEntryButton(title = "PIN to remove", secret = true, onValue = { pin ->
+                        if (ForkSportsPrefs.checkPin(context, pin)) {
+                            ForkSportsPrefs.clearPin(context)
+                            hasPin = false
+                            dialog = false
+                            Toast.makeText(context, "PIN removed", Toast.LENGTH_SHORT).show()
+                        } else {
+                            Toast.makeText(context, "Wrong PIN", Toast.LENGTH_SHORT).show()
+                        }
+                    })
+                }
+                Button(onClick = { dialog = false }) { Text("Close") }
+            }
+        }
+    }
+}
