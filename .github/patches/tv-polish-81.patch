+/** Settings > Live TV: Sports hub options. */
+@Composable
+internal fun ForkSportsSettingsGroup() {
+    val context = LocalContext.current
+    var windowHours by remember { mutableIntStateOf(ForkSportsPrefs.liveWindowHours(context)) }
+    var showLater by remember { mutableStateOf(ForkSportsPrefs.showLater(context)) }
+    SettingsGroupCard(
+        modifier = Modifier.fillMaxWidth(),
+        title = "Sports hub",
+        subtitle = "Games found in your channels' guide. Scores and team following are not part of this fork."
+    ) {
+        SettingsActionRow(
