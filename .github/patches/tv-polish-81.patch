-                when (value[i + 1]) {
-                    't' -> out.append('\t')
-                    'n' -> out.append('\n')
-                    '\\' -> out.append('\\')
-                    else -> out.append(value[i + 1])
-                }
-                i += 2
-            } else {
-                out.append(c)
-                i++
-            }
-        }
-        return out.toString()
-    }
-}
