+package com.nuvio.tv.forklivetv
+
+import android.content.Context
+import java.security.MessageDigest
+
+/** Fork: Sports hub options and the Live TV parental PIN (device-wide, plain SharedPreferences). */
+object ForkSportsPrefs {
+    private const val FILE = "fork_sports"
+    private val WINDOW_CHOICES = listOf(2, 3, 4, 6)
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+
+    fun liveWindowHours(context: Context): Int = prefs(context).getInt("live_window_hours", 3)
+
+    fun cycleLiveWindowHours(context: Context): Int {
+        val next = WINDOW_CHOICES[(WINDOW_CHOICES.indexOf(liveWindowHours(context)) + 1).mod(WINDOW_CHOICES.size)]
+        prefs(context).edit().putInt("live_window_hours", next).apply()
+        return next
+    }
+
+    fun showLater(context: Context): Boolean = prefs(context).getBoolean("show_later", true)
+
+    fun setShowLater(context: Context, value: Boolean) {
+        prefs(context).edit().putBoolean("show_later", value).apply()
+    }
+
+    fun signature(context: Context): String = "${liveWindowHours(context)}:${showLater(context)}"
+
+    private fun hash(pin: String): String =
+        MessageDigest.getInstance("SHA-256").digest(("nuvio-fork-pin:$pin").toByteArray())
+            .joinToString("") { "%02x".format(it) }
+
+    fun hasPin(context: Context): Boolean = prefs(context).contains("pin_hash")
+
+    /** Returns false when the PIN is not 4 to 8 digits. */
+    fun setPin(context: Context, pin: String): Boolean {
+        if (!pin.matches(Regex("\\d{4,8}"))) return false
+        prefs(context).edit().putString("pin_hash", hash(pin)).apply()
+        return true
+    }
+
+    fun checkPin(context: Context, pin: String): Boolean =
+        prefs(context).getString("pin_hash", null) == hash(pin.trim())
+
+    fun clearPin(context: Context) {
+        prefs(context).edit().remove("pin_hash").apply()
+    }
+}
