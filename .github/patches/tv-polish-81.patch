+
+    // ---- cache file escaping ----
+
+    internal fun escape(value: String): String = value
+        .replace("\\", "\\\\")
+        .replace("\t", "\\t")
+        .replace("\r", "")
+        .replace("\n", "\\n")
+
+    internal fun unescape(value: String): String {
+        val out = StringBuilder(value.length)
+        var i = 0
+        while (i < value.length) {
+            val c = value[i]
+            if (c == '\\' && i + 1 < value.length) {
+                when (value[i + 1]) {
+                    't' -> out.append('\t')
+                    'n' -> out.append('\n')
+                    '\\' -> out.append('\\')
+                    else -> out.append(value[i + 1])
+                }
+                i += 2
+            } else {
+                out.append(c)
+                i++
+            }
+        }
+        return out.toString()
+    }
+}
