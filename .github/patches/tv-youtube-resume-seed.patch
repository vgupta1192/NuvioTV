+    /** Where this device left the video, as (position, duration) in ms, or null if it has not played it. */
+    fun load(context: Context, contentId: String?): Pair<Long, Long>? {
+        val videoId = contentId?.removePrefix(ID_PREFIX)?.takeIf { it.isNotBlank() } ?: return null
+        val v = runCatching {
+            context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString(videoId, null)
+        }.getOrNull() ?: return null
+        val parts = v.split(',')
+        val pos = parts.getOrNull(0)?.toLongOrNull() ?: return null
+        val dur = parts.getOrNull(1)?.toLongOrNull() ?: return null
+        return if (pos > 0 && dur > 0) pos to dur else null
+    }
+
+    /**
+     * Puts the account's position in the local store so the player resumes from it, but only when this device
+     * has no position of its own for the video.
+     */
+    fun seed(context: Context, contentId: String, positionMs: Long, durationMs: Long) {
+        if (load(context, contentId) != null) return
+        val videoId = contentId.removePrefix(ID_PREFIX).takeIf { it.isNotBlank() } ?: return
+        runCatching {
+            context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+                .putString(videoId, "$positionMs,$durationMs").apply()
+        }
+    }
