+/*
+ * Nuvio fork: data layer of the Profile page (modelled on NuvioMobile-Enhanced's profile insights).
+ * Counts come from the watch progress, watched and library repositories; genres, runtimes, episode
+ * totals and upcoming release dates come from the title details, which are fetched a few at a time
+ * and kept on the device ("facts"), so the page is instant after the first visit.
+ */
+
+@EntryPoint
+@InstallIn(SingletonComponent::class)
+internal interface DxInsightsEntryPoint {
+    fun metaRepository(): MetaRepository
+    fun watchProgressRepository(): WatchProgressRepository
+    fun libraryRepository(): LibraryRepository
+    fun profileManager(): ProfileManager
+    fun avatarRepository(): AvatarRepository
+    fun profileLockStateDataStore(): com.nuvio.tv.data.local.ProfileLockStateDataStore
+}
+
+internal data class DxUpcomingRef(val date: String, val season: Int?, val episode: Int?)
+
+internal data class DxTitleFacts(
+    val genres: List<String>,
+    val runtimeMin: Int,
+    val episodeRuntimeMin: Int,
+    val episodes: Int,
+    val upcoming: List<DxUpcomingRef>,
+    val fetchedAt: Long,
+)
+
+internal data class DxInsightItem(
+    val id: String,
+    val type: String,
+    val title: String,
+    val subtitle: String?,
+    val poster: String?,
+    val addonBaseUrl: String? = null,
+)
+
+internal data class DxGenreSlice(val name: String, val fraction: Float)
+
+internal data class DxInsights(
+    val watching: List<DxInsightItem>,
+    val saved: List<DxInsightItem>,
+    val upcoming: List<DxInsightItem>,
+    val completed: List<DxInsightItem>,
+    val ongoing: List<DxInsightItem>,
+    val watchedMovies: List<DxInsightItem>,
+    val episodes: List<DxInsightItem>,
+    val episodeCount: Int,
+    val watchTimeMs: Long,
+    val movieShare: Float,
+    val genres: List<DxGenreSlice>,
+    val genreTitles: Int,
+    val totalTitles: Int,
+    val chips: List<String>,
+)
+
+internal object DxInsightsFactsStore {
+    private const val PREFS = "nuvio_tv_dx_insight_facts"
+    private val map = HashMap<String, DxTitleFacts>()
+    private var loaded = false
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @Synchronized
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        runCatching {
+            val root = JSONObject(prefs(context).getString("facts", null) ?: return@runCatching)
+            root.keys().forEach { key ->
+                val o = root.optJSONObject(key) ?: return@forEach
+                val genres = o.optJSONArray("g")?.let { a -> (0 until a.length()).map { a.optString(it) } }.orEmpty()
+                val ups = o.optJSONArray("u")?.let { a ->
+                    (0 until a.length()).mapNotNull { i ->
+                        val u = a.optJSONObject(i) ?: return@mapNotNull null
+                        DxUpcomingRef(
+                            u.optString("d"),
+                            if (u.has("s")) u.optInt("s") else null,
+                            if (u.has("e")) u.optInt("e") else null,
+                        )
+                    }
+                }.orEmpty()
+                map[key] = DxTitleFacts(
+                    genres = genres,
+                    runtimeMin = o.optInt("r"),
+                    episodeRuntimeMin = o.optInt("er"),
+                    episodes = o.optInt("n"),
+                    upcoming = ups,
+                    fetchedAt = o.optLong("t"),
+                )
+            }
+        }
+    }
+
+    @Synchronized
+    fun get(key: String): DxTitleFacts? = map[key]
+
+    @Synchronized
+    fun put(key: String, facts: DxTitleFacts) {
+        map[key] = facts
+    }
+
+    @Synchronized
+    fun snapshot(): Map<String, DxTitleFacts> = HashMap(map)
+
+    @Synchronized
+    fun save(context: Context) {
+        val root = JSONObject()
+        map.entries.sortedByDescending { it.value.fetchedAt }.take(600).forEach { (key, f) ->
+            val o = JSONObject()
+            o.put("g", JSONArray(f.genres))
+            o.put("r", f.runtimeMin)
+            o.put("er", f.episodeRuntimeMin)
+            o.put("n", f.episodes)
+            o.put("t", f.fetchedAt)
+            o.put("u", JSONArray().also { a ->
+                f.upcoming.forEach { u ->
+                    a.put(JSONObject().also { j ->
+                        j.put("d", u.date)
+                        u.season?.let { j.put("s", it) }
+                        u.episode?.let { j.put("e", it) }
+                    })
+                }
+            })
+            root.put(key, o)
+        }
+        prefs(context).edit().putString("facts", root.toString()).apply()
+    }
+
+    fun lastUpdated(context: Context, profileId: Int): Long = prefs(context).getLong("updated_$profileId", 0L)
+
+    fun markUpdated(context: Context, profileId: Int) {
+        prefs(context).edit().putLong("updated_$profileId", System.currentTimeMillis()).apply()
+    }
+}
+
+private fun isMovieType(type: String?): Boolean = type.equals("movie", ignoreCase = true)
+
+internal fun dxFactsKey(type: String?, id: String): String = (if (isMovieType(type)) "movie:" else "series:") + id
+
+private fun parseDate(value: String?): LocalDate? {
+    val text = value?.trim()?.takeIf { it.isNotEmpty() } ?: return null
+    return runCatching { OffsetDateTime.parse(text).toLocalDate() }.getOrNull()
+        ?: runCatching { LocalDate.parse(text.take(10)) }.getOrNull()
+}
+
+private fun parseRuntimeMinutes(value: String?): Int {
+    val text = value?.lowercase(Locale.US) ?: return 0
+    val hours = Regex("""(\d+)\s*h""").find(text)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+    val minutes = Regex("""(\d+)\s*m""").find(text)?.groupValues?.get(1)?.toIntOrNull()
+    if (hours > 0 || minutes != null) return hours * 60 + (minutes ?: 0)
+    return Regex("""(\d+)""").find(text)?.groupValues?.get(1)?.toIntOrNull() ?: 0
+}
+
+private suspend fun fetchFacts(repository: MetaRepository, type: String, id: String, addon: String?): DxTitleFacts? {
+    val meta = withTimeoutOrNull(12_000L) {
+        repository.getMetaFromAllAddons(type, id, addon).first { it !is NetworkResult.Loading }
+    }.let { (it as? NetworkResult.Success)?.data } ?: return null
+    val today = LocalDate.now()
+    val movie = isMovieType(type)
+    val watchable = if (movie) emptyList() else meta.watchableEpisodes()
+    val episodeRuntimes = meta.videos.mapNotNull { v -> v.runtime?.takeIf { it in 5..300 } }
+    val episodeRuntime = when {
+        movie -> 0
+        episodeRuntimes.isNotEmpty() -> episodeRuntimes.average().roundToInt()
+        else -> parseRuntimeMinutes(meta.runtime)
+    }
+    val upcoming: List<DxUpcomingRef> = if (movie) {
+        parseDate(meta.released ?: meta.releaseInfo)?.takeIf { !it.isBefore(today) }
+            ?.let { listOf(DxUpcomingRef(it.toString(), null, null)) }.orEmpty()
+    } else {
+        meta.videos.mapNotNull { v ->
+            if ((v.season ?: 1) <= 0) return@mapNotNull null
+            val date = parseDate(v.released)?.takeIf { !it.isBefore(today) } ?: return@mapNotNull null
+            DxUpcomingRef(date.toString(), v.season, v.episode)
+        }.sortedBy { it.date }.take(3)
+    }
+    return DxTitleFacts(
+        genres = meta.genres.map { it.trim() }.filter { it.isNotEmpty() },
+        runtimeMin = if (movie) parseRuntimeMinutes(meta.runtime) else 0,
+        episodeRuntimeMin = episodeRuntime,
+        episodes = watchable.size,
+        upcoming = upcoming,
+        fetchedAt = System.currentTimeMillis(),
+    )
+}
+
+private suspend fun <T> Flow<List<T>>.firstOrEmpty(): List<T> =
+    withTimeoutOrNull(8_000L) { first() }.orEmpty()
+
+private const val FACTS_MAX_AGE_MS = 24L * 60L * 60L * 1000L
+private const val HYDRATE_CAP = 100
+
+/**
+ * Builds the insights from the repositories, then fetches the title details that are missing or
+ * stale (all of them when [force]) and rebuilds as they arrive. [onUpdate] gets every new result;
+ * [onProgress] gets "done of total" while details load and (0, 0) at the end.
+ */
+internal suspend fun loadDxInsights(
+    context: Context,
+    entry: DxInsightsEntryPoint,
+    force: Boolean,
+    onUpdate: (DxInsights) -> Unit,
+    onProgress: (Int, Int) -> Unit,
+) {
+    DxInsightsFactsStore.ensureLoaded(context)
+    val progress = entry.watchProgressRepository().allProgress.firstOrEmpty()
+    val continueWatching = entry.watchProgressRepository().continueWatching.firstOrEmpty()
+    val watched = entry.watchProgressRepository().watchedItems.firstOrEmpty()
+    val library = entry.libraryRepository().libraryItems.firstOrEmpty()
+    val weekSeconds = com.nuvio.tv.ui.screens.player.DxWatchStats.summary(context).week
+
+    fun rebuild() = onUpdate(
+        buildDxInsights(
+            progress, continueWatching, watched, library,
+            DxInsightsFactsStore.snapshot(), LocalDate.now(), weekSeconds,
+        )
+    )
+    rebuild()
+
+    // Titles to look up, library first (upcoming dates), then what is being watched, newest first.
+    class Target(val key: String, val type: String, val id: String, val addon: String?)
+    val targets = LinkedHashMap<String, Target>()
+    library.forEach { targets.putIfAbsent(dxFactsKey(it.type, it.id), Target(dxFactsKey(it.type, it.id), it.type, it.id, it.addonBaseUrl)) }
+    continueWatching.forEach { targets.putIfAbsent(dxFactsKey(it.contentType, it.contentId), Target(dxFactsKey(it.contentType, it.contentId), it.contentType, it.contentId, it.addonBaseUrl)) }
+    watched.sortedByDescending { it.watchedAt }.forEach {
+        targets.putIfAbsent(dxFactsKey(it.contentType, it.contentId), Target(dxFactsKey(it.contentType, it.contentId), it.contentType, it.contentId, null))
+    }
+    progress.sortedByDescending { it.lastWatched }.forEach {
+        targets.putIfAbsent(dxFactsKey(it.contentType, it.contentId), Target(dxFactsKey(it.contentType, it.contentId), it.contentType, it.contentId, it.addonBaseUrl))
+    }
+    val now = System.currentTimeMillis()
+    val todo = targets.values.take(HYDRATE_CAP).filter { t ->
+        val facts = DxInsightsFactsStore.get(t.key)
+        force || facts == null || now - facts.fetchedAt > FACTS_MAX_AGE_MS ||
+            facts.upcoming.any { (parseDate(it.date) ?: LocalDate.MAX).isBefore(LocalDate.now()) }
+    }
+    if (todo.isEmpty()) {
+        onProgress(0, 0)
+        return
+    }
+    val gate = Semaphore(4)
+    var done = 0
+    onProgress(0, todo.size)
+    withContext(Dispatchers.IO) {
+        coroutineScope {
+            todo.map { t ->
+                async {
+                    gate.withPermit {
+                        val facts = runCatching { fetchFacts(entry.metaRepository(), t.type, t.id, t.addon) }.getOrNull()
+                        if (facts != null) DxInsightsFactsStore.put(t.key, facts)
+                        val finished = synchronized(todo) { ++done }
+                        withContext(Dispatchers.Main) {
+                            onProgress(finished, todo.size)
+                            if (finished % 6 == 0) rebuild()
+                        }
+                    }
+                }
+            }.awaitAll()
+        }
+    }
+    DxInsightsFactsStore.save(context)
+    DxInsightsFactsStore.markUpdated(context, entry.profileManager().activeProfileId.value)
+    rebuild()
+    onProgress(0, 0)
+}
+
+private class Rec(
+    val id: String,
+    val type: String,
+    val title: String,
+    val poster: String?,
+    val season: Int?,
+    val episode: Int?,
+    val at: Long,
+)
+
+private fun episodeLine(season: Int?, episode: Int?): String? =
+    if (season != null && episode != null) "S${season}E$episode" else null
+
+private val monthDay: DateTimeFormatter get() = DateTimeFormatter.ofPattern("MMM d", Locale.getDefault())
+
+private fun dayOf(epochMs: Long): LocalDate = Instant.ofEpochMilli(epochMs).atZone(ZoneId.systemDefault()).toLocalDate()
+
+internal fun buildDxInsights(
+    progress: List<WatchProgress>,
+    continueWatching: List<WatchProgress>,
+    watched: List<WatchedItem>,
+    library: List<LibraryEntry>,
+    facts: Map<String, DxTitleFacts>,
+    today: LocalDate,
+    weekSeconds: Double,
+): DxInsights {
+    val recs = LinkedHashMap<String, Rec>()
+    fun add(rec: Rec) {
+        val key = if (rec.season != null && rec.episode != null) "${rec.id}|${rec.season}|${rec.episode}" else rec.id
+        val old = recs[key]
+        if (old == null || rec.at > old.at) recs[key] = rec
+    }
+    watched.forEach { add(Rec(it.contentId, it.contentType, it.title, it.poster, it.season, it.episode, it.watchedAt)) }
+    progress.filter { it.isCompleted() }.forEach {
+        add(Rec(it.contentId, it.contentType, it.name, it.poster, it.season, it.episode, it.lastWatched))
+    }
+    val movieRecs = recs.values.filter { it.season == null && isMovieType(it.type) }
+    val episodeRecs = recs.values.filter { it.season != null && it.episode != null }
+    val bySeries = episodeRecs.groupBy { it.id }
+
+    // Continue watching, one row per title.
+    val watching = continueWatching.sortedByDescending { it.lastWatched }.distinctBy { it.contentId }.map {
+        val pct = (it.progressPercentage * 100f).roundToInt()
+        DxInsightItem(
+            id = it.contentId, type = it.contentType, title = it.name,
+            subtitle = listOfNotNull(episodeLine(it.season, it.episode), "$pct%").joinToString(" • "),
+            poster = it.poster, addonBaseUrl = it.addonBaseUrl,
+        )
+    }
+    val saved = library.sortedByDescending { it.listedAt }.distinctBy { "${it.type}:${it.id}" }.map {
+        DxInsightItem(it.id, it.type, it.name, it.releaseInfo, it.poster, it.addonBaseUrl)
+    }
+    val upcoming = library.distinctBy { "${it.type}:${it.id}" }.mapNotNull { e ->
+        val ref = facts[dxFactsKey(e.type, e.id)]?.upcoming
+            ?.firstOrNull { (parseDate(it.date) ?: LocalDate.MIN) >= today } ?: return@mapNotNull null
+        val date = parseDate(ref.date) ?: return@mapNotNull null
+        date to DxInsightItem(
+            e.id, e.type, e.name,
+            listOfNotNull(date.format(monthDay), episodeLine(ref.season, ref.episode) ?: "Release").joinToString(" • "),
+            e.poster, e.addonBaseUrl,
+        )
+    }.sortedBy { it.first }.map { it.second }
+
+    val completed = ArrayList<Pair<Long, DxInsightItem>>()
+    val ongoing = ArrayList<Pair<Long, DxInsightItem>>()
+    bySeries.forEach { (id, list) ->
+        val latest = list.maxByOrNull { it.at } ?: return@forEach
+        val count = list.filter { (it.season ?: 0) > 0 }.map { it.season to it.episode }.distinct().size
+        val total = facts[dxFactsKey("series", id)]?.episodes ?: 0
+        val poster = list.sortedByDescending { it.at }.firstNotNullOfOrNull { it.poster }
+        val item = DxInsightItem(
+            id, latest.type, latest.title,
+            if (total > 0) "${minOf(count, total)} of $total episodes" else "$count episodes watched",
+            poster,
+        )
+        if (total > 0 && count >= total) completed.add(latest.at to item) else ongoing.add(latest.at to item)
+    }
+    continueWatching.filter { !isMovieType(it.contentType) && !bySeries.containsKey(it.contentId) }
+        .distinctBy { it.contentId }.forEach {
+            ongoing.add(it.lastWatched to DxInsightItem(it.contentId, it.contentType, it.name, "Just started", it.poster, it.addonBaseUrl))
+        }
+
+    val watchedMovies = movieRecs.sortedByDescending { it.at }.map {
+        DxInsightItem(it.id, it.type, it.title, "Watched " + dayOf(it.at).format(monthDay), it.poster)
+    }
+    val episodeItems = episodeRecs.sortedByDescending { it.at }.take(120).map {
+        DxInsightItem(it.id, it.type, it.title, listOfNotNull(episodeLine(it.season, it.episode), dayOf(it.at).format(monthDay)).joinToString(" • "), it.poster)
+    }
+
+    // Watch time from runtimes, plus the part of the unfinished items already watched.
+    val weights = HashMap<String, Long>()
+    var movieMs = 0L
+    var seriesMs = 0L
+    movieRecs.forEach {
+        val minutes = facts[dxFactsKey("movie", it.id)]?.runtimeMin?.takeIf { m -> m > 0 } ?: 110
+        val ms = minutes * 60_000L
+        movieMs += ms
+        weights.merge(dxFactsKey("movie", it.id), ms, Long::plus)
+    }
+    episodeRecs.forEach {
+        val minutes = facts[dxFactsKey("series", it.id)]?.episodeRuntimeMin?.takeIf { m -> m > 0 } ?: 42
+        val ms = minutes * 60_000L
+        seriesMs += ms
+        weights.merge(dxFactsKey("series", it.id), ms, Long::plus)
+    }
+    progress.filter { !it.isCompleted() && it.position > 0 }.forEach {
+        val ms = it.position
+        if (isMovieType(it.contentType)) movieMs += ms else seriesMs += ms
+        weights.merge(dxFactsKey(it.contentType, it.contentId), ms, Long::plus)
+    }
+    val total = movieMs + seriesMs
+    val movieShare = if (total > 0) movieMs.toFloat() / total.toFloat() else 0.5f
+
+    // Taste DNA: genres weighted by watch time.
+    val libraryGenres = library.associate { dxFactsKey(it.type, it.id) to it.genres }
+    val genreMs = HashMap<String, Long>()
+    var withGenres = 0
+    weights.forEach { (key, ms) ->
+        val genres = (facts[key]?.genres?.takeIf { it.isNotEmpty() } ?: libraryGenres[key].orEmpty())
+            .map { it.trim() }.filter { it.isNotEmpty() }.distinct()
+        if (genres.isEmpty()) return@forEach
+        withGenres++
+        genres.forEach { genreMs.merge(it, ms, Long::plus) }
+    }
+    val genreTotal = genreMs.values.sum().toFloat()
+    val sorted = genreMs.entries.sortedByDescending { it.value }
+    val top = sorted.take(5).map { DxGenreSlice(it.key, it.value / genreTotal) }
+    val otherFraction = sorted.drop(5).sumOf { it.value }.toFloat() / genreTotal
+    val genres = if (genreTotal <= 0f) emptyList() else if (otherFraction > 0.01f) top + DxGenreSlice("Others", otherFraction) else top
+
+    val titles = weights.size
+    val chips = ArrayList<String>()
+    if (titles < 3) {
+        chips.add("Learning")
+    } else {
+        chips.add(if (movieShare >= 0.6f) "Movie fan" else if (movieShare <= 0.4f) "Series fan" else "Balanced viewer")
+        if (episodeRecs.size >= 100) chips.add("Binge ready")
+        if (weekSeconds >= 10 * 3600) chips.add("Highly active")
+        if (saved.size >= 20) chips.add("Collector")
+        if (upcoming.size >= 3) chips.add("Release radar")
+        if (completed.size >= 5) chips.add("Completionist")
+    }
+
+    return DxInsights(
+        watching = watching,
+        saved = saved,
+        upcoming = upcoming,
+        completed = completed.sortedByDescending { it.first }.map { it.second },
+        ongoing = ongoing.sortedByDescending { it.first }.map { it.second },
+        watchedMovies = watchedMovies,
+        episodes = episodeItems,
+        episodeCount = episodeRecs.size,
+        watchTimeMs = total,
+        movieShare = movieShare,
+        genres = genres,
+        genreTitles = withGenres,
+        totalTitles = titles,
+        chips = chips,
+    )
+}
+
+internal fun dxDurationLabel(ms: Long): String {
+    val minutes = ms / 60_000L
+    val days = minutes / (24 * 60)
+    val hours = (minutes / 60) % 24
+    return when {
+        days > 0 -> "~${days}d ${hours}h"
+        minutes >= 60 -> "~${minutes / 60}h ${minutes % 60}m"
+        else -> "~${minutes}m"
+    }
+}
+
+internal fun dxUpdatedLabel(updatedAt: Long): String {
+    if (updatedAt <= 0L) return "Not refreshed yet"
+    val minutes = ((System.currentTimeMillis() - updatedAt) / 60_000L).coerceAtLeast(0L)
+    return when {
+        minutes < 1 -> "Updated just now"
+        minutes < 60 -> "Updated $minutes min ago"
+        minutes < 24 * 60 -> "Updated ${minutes / 60} h ago"
+        else -> "Updated ${minutes / (24 * 60)} d ago"
+    }
+}
