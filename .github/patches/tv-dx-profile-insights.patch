+/*
+ * Nuvio fork: the Profile page of Settings, modelled on NuvioMobile-Enhanced's profile insights and
+ * built for the D-pad. Avatar and name with Switch profile / Edit profile, rounded stat tiles that
+ * open a poster sheet, the Watch Time card and the Taste DNA section.
+ */
+
+private class DxSheet(val title: String, val items: List<DxInsightItem>)
+
+private val DxPalette = listOf(
+    Color(0xFF6C8CFF), Color(0xFFFF7A90), Color(0xFF4CD6A5),
+    Color(0xFFFFC857), Color(0xFFB07CFF), Color(0xFF8A8FA3),
+)
+
+@Composable
+private fun DxCard(
+    onClick: () -> Unit,
+    modifier: Modifier = Modifier,
+    radius: Int = 20,
+    container: Color = NuvioTheme.colors.BackgroundCard,
+    content: @Composable androidx.compose.foundation.layout.ColumnScope.() -> Unit,
+) {
+    val shape = RoundedCornerShape(radius.dp)
+    Card(
+        onClick = onClick,
+        modifier = modifier,
+        shape = CardDefaults.shape(shape = shape),
+        colors = CardDefaults.colors(
+            containerColor = container,
+            focusedContainerColor = NuvioTheme.colors.FocusBackground,
+        ),
+        border = CardDefaults.border(
+            border = Border(BorderStroke(1.dp, NuvioTheme.colors.Border), shape),
+            focusedBorder = Border(NuvioTheme.focusRing.border(NuvioTheme.spacing.xxs), shape),
+        ),
+        scale = CardDefaults.scale(focusedScale = 1.03f),
+        content = content,
+    )
+}
+
+@Composable
+private fun DxPill(text: String, onClick: () -> Unit, modifier: Modifier = Modifier) {
+    DxCard(onClick = onClick, modifier = modifier, radius = 40) {
+        Text(
+            text = text,
+            style = MaterialTheme.typography.titleMedium,
+            color = NuvioTheme.colors.TextPrimary,
+            modifier = Modifier.padding(horizontal = 28.dp, vertical = 14.dp),
+        )
+    }
+}
+
+@Composable
+private fun DxStatTile(value: String, label: String, onClick: () -> Unit, modifier: Modifier = Modifier) {
+    DxCard(onClick = onClick, modifier = modifier) {
+        Column(
+            modifier = Modifier.fillMaxWidth().padding(vertical = 18.dp, horizontal = 12.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+        ) {
+            Text(
+                text = value,
+                style = MaterialTheme.typography.headlineMedium,
+                fontWeight = FontWeight.Bold,
+                color = NuvioTheme.colors.TextPrimary,
+            )
+            Text(
+                text = label,
+                style = MaterialTheme.typography.bodyLarge,
+                color = NuvioTheme.colors.TextSecondary,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+        }
+    }
+}
+
+@Composable
+internal fun DxProfileInsightsPage(
+    onManageProfiles: () -> Unit,
+    onOpenDetail: (id: String, type: String, addonBaseUrl: String?) -> Unit,
+    initialFocusRequester: FocusRequester? = null,
+) {
+    val context = LocalContext.current
+    val entry = remember(context) {
+        EntryPointAccessors.fromApplication(context.applicationContext, DxInsightsEntryPoint::class.java)
+    }
+    val scope = androidx.compose.runtime.rememberCoroutineScope()
+    val profiles by entry.profileManager().profiles.collectAsState()
+    val activeId by entry.profileManager().activeProfileId.collectAsState()
+    val profile = profiles.firstOrNull { it.id == activeId }
+
+    var avatarUrl by remember { mutableStateOf<String?>(null) }
+    LaunchedEffect(profile?.id, profile?.avatarId, profile?.avatarUrl) {
+        avatarUrl = profile?.avatarUrl ?: profile?.avatarId?.let { id ->
+            runCatching {
+                withTimeoutOrNull(6_000L) {
+                    val repo = entry.avatarRepository()
+                    repo.getAvatarImageUrl(id, repo.getAvatarCatalog())
+                }
+            }.getOrNull()
+        }
+    }
+
+    var insights by remember { mutableStateOf<DxInsights?>(null) }
+    var loading by remember { mutableStateOf<Pair<Int, Int>?>(null) }
+    var updatedAt by remember { mutableStateOf(0L) }
+    var refreshTick by remember { mutableIntStateOf(0) }
+    LaunchedEffect(activeId, refreshTick) {
+        if (refreshTick == 0) insights = null
+        delay(400)
+        updatedAt = DxInsightsFactsStore.lastUpdated(context, activeId)
+        runCatching {
+            loadDxInsights(
+                context = context,
+                entry = entry,
+                force = refreshTick > 0,
+                onUpdate = { insights = it },
+                onProgress = { done, total -> loading = if (total > 0) done to total else null },
+            )
+        }
+        loading = null
+        updatedAt = DxInsightsFactsStore.lastUpdated(context, activeId)
+    }
+
+    var sheet by remember { mutableStateOf<DxSheet?>(null) }
+    var showSwitch by remember { mutableStateOf(false) }
+    val data = insights
+    val stats = remember(insights) { DxWatchStats.summary(context) }
+
+    LazyColumn(
+        modifier = Modifier.fillMaxSize(),
+        contentPadding = PaddingValues(bottom = 48.dp),
+        verticalArrangement = Arrangement.spacedBy(20.dp),
+    ) {
+        item(key = "header") {
+            Column(
+                modifier = Modifier.fillMaxWidth().padding(top = 8.dp),
+                horizontalAlignment = Alignment.CenterHorizontally,
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                ProfileAvatarCircle(
+                    name = profile?.name ?: "?",
+                    colorHex = profile?.avatarColorHex ?: "#1E88E5",
+                    size = 132.dp,
+                    avatarImageUrl = avatarUrl,
+                )
+                Text(
+                    text = profile?.name ?: "Profile",
+                    style = MaterialTheme.typography.headlineLarge,
+                    fontWeight = FontWeight.Bold,
+                    color = NuvioTheme.colors.TextPrimary,
+                )
+                Text(
+                    text = "Activity, library and taste insights",
+                    style = MaterialTheme.typography.bodyLarge,
+                    color = NuvioTheme.colors.TextSecondary,
+                )
+                Row(horizontalArrangement = Arrangement.spacedBy(20.dp)) {
+                    DxPill(
+                        text = "Switch profile",
+                        onClick = { showSwitch = true },
+                        modifier = if (initialFocusRequester != null) Modifier.focusRequester(initialFocusRequester) else Modifier,
+                    )
+                    DxPill(text = "Edit profile", onClick = onManageProfiles)
+                }
+            }
+        }
+
+        item(key = "updated") {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.SpaceBetween,
+                verticalAlignment = Alignment.CenterVertically,
+            ) {
+                Column {
+                    Text(
+                        text = dxUpdatedLabel(updatedAt),
+                        style = MaterialTheme.typography.titleMedium,
+                        color = NuvioTheme.colors.TextPrimary,
+                    )
+                    val progressLine = loading?.let { "Loading title details · ${it.first} of ${it.second}" }
+                    if (progressLine != null) {
+                        Text(
+                            text = progressLine,
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.TextSecondary,
+                        )
+                    }
+                }
+                DxPill(
+                    text = if (loading != null) "Refreshing…" else "Refresh",
+                    onClick = { if (loading == null) refreshTick++ },
+                )
+            }
+        }
+
+        item(key = "tiles") {
+            val i = data
+            fun open(title: String, list: List<DxInsightItem>?) {
+                sheet = DxSheet(title, list.orEmpty())
+            }
+            Column(verticalArrangement = Arrangement.spacedBy(14.dp)) {
+                Row(horizontalArrangement = Arrangement.spacedBy(14.dp)) {
+                    DxStatTile((i?.watching?.size ?: 0).toString(), "Watching", { open("Continue Watching", i?.watching) }, Modifier.weight(1f))
+                    DxStatTile((i?.saved?.size ?: 0).toString(), "Saved", { open("Saved in Library", i?.saved) }, Modifier.weight(1f))
+                    DxStatTile((i?.upcoming?.size ?: 0).toString(), "Upcoming", { open("Upcoming", i?.upcoming) }, Modifier.weight(1f))
+                    DxStatTile((i?.completed?.size ?: 0).toString(), "Completed", { open("Completed series", i?.completed) }, Modifier.weight(1f))
+                }
+                Row(horizontalArrangement = Arrangement.spacedBy(14.dp)) {
+                    DxStatTile((i?.ongoing?.size ?: 0).toString(), "Ongoing", { open("Ongoing series", i?.ongoing) }, Modifier.weight(1f))
+                    DxStatTile((i?.episodeCount ?: 0).toString(), "Episodes", { open("Watched episodes", i?.episodes) }, Modifier.weight(1f))
+                    DxStatTile((i?.watchedMovies?.size ?: 0).toString(), "Watched", { open("Watched movies", i?.watchedMovies) }, Modifier.weight(1f))
+                }
+            }
+        }
+
+        item(key = "watchtime") {
+            DxCard(onClick = {}, modifier = Modifier.fillMaxWidth(), radius = 24) {
+                Column(
+                    modifier = Modifier.fillMaxWidth().padding(28.dp),
+                    verticalArrangement = Arrangement.spacedBy(6.dp),
+                ) {
+                    Text("Watch Time", style = MaterialTheme.typography.titleLarge, color = NuvioTheme.colors.TextSecondary)
+                    Text(
+                        text = data?.let { dxDurationLabel(it.watchTimeMs) } ?: "—",
+                        fontSize = 56.sp,
+                        fontWeight = FontWeight.Bold,
+                        color = NuvioTheme.colors.TextPrimary,
+                    )
+                    Text(
+                        text = "Approximate time from title runtimes",
+                        style = MaterialTheme.typography.bodyLarge,
+                        color = NuvioTheme.colors.TextTertiary,
+                    )
+                    if (stats.total > 0.0) {
+                        Spacer(Modifier.height(6.dp))
+                        Text(
+                            text = "Tracked on this device: today ${dxShortHours(stats.today)}, 7 days ${dxShortHours(stats.week)}, streak ${stats.currentStreak} d",
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.TextSecondary,
+                        )
+                    }
+                }
+            }
+        }
+
+        item(key = "taste") {
+            DxCard(onClick = {}, modifier = Modifier.fillMaxWidth(), radius = 24) {
+                Column(
+                    modifier = Modifier.fillMaxWidth().padding(28.dp),
+                    verticalArrangement = Arrangement.spacedBy(18.dp),
+                ) {
+                    Text("Taste DNA", style = MaterialTheme.typography.titleLarge, color = NuvioTheme.colors.TextPrimary)
+                    val genres = data?.genres.orEmpty()
+                    if (genres.isEmpty()) {
+                        Text(
+                            text = if (loading != null) "Learning your taste…" else "Watch a few titles and your genres show up here",
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.TextSecondary,
+                        )
+                    } else {
+                        Row(
+                            modifier = Modifier.fillMaxWidth(),
+                            horizontalArrangement = Arrangement.spacedBy(36.dp),
+                            verticalAlignment = Alignment.CenterVertically,
+                        ) {
+                            Canvas(modifier = Modifier.size(200.dp)) {
+                                val stroke = 34.dp.toPx()
+                                var start = -90f
+                                genres.forEachIndexed { index, slice ->
+                                    val sweep = slice.fraction * 360f
+                                    drawArc(
+                                        color = DxPalette[index % DxPalette.size],
+                                        startAngle = start,
+                                        sweepAngle = (sweep - 2f).coerceAtLeast(1f),
+                                        useCenter = false,
+                                        topLeft = Offset(stroke / 2, stroke / 2),
+                                        size = Size(size.width - stroke, size.height - stroke),
+                                        style = Stroke(width = stroke),
+                                    )
+                                    start += sweep
+                                }
+                            }
+                            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                                genres.forEachIndexed { index, slice ->
+                                    Row(verticalAlignment = Alignment.CenterVertically) {
+                                        Box(
+                                            Modifier.size(16.dp).clip(CircleShape)
+                                                .background(DxPalette[index % DxPalette.size])
+                                        )
+                                        Spacer(Modifier.width(12.dp))
+                                        Text(
+                                            text = "${slice.name}  ${(slice.fraction * 100f).toInt()}%",
+                                            style = MaterialTheme.typography.titleMedium,
+                                            color = NuvioTheme.colors.TextPrimary,
+                                        )
+                                    }
+                                }
+                            }
+                        }
+                        Text(
+                            text = "Based on ${data?.genreTitles ?: 0} of ${data?.totalTitles ?: 0} titles",
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.TextTertiary,
+                        )
+                    }
+
+                    if (data != null && data.watchTimeMs > 0L) {
+                        val movie = data.movieShare.coerceIn(0.03f, 0.97f)
+                        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                                Text(
+                                    "Movies ${(data.movieShare * 100f).toInt()}%",
+                                    style = MaterialTheme.typography.bodyLarge,
+                                    color = NuvioTheme.colors.TextSecondary,
+                                )
+                                Text(
+                                    "Series ${100 - (data.movieShare * 100f).toInt()}%",
+                                    style = MaterialTheme.typography.bodyLarge,
+                                    color = NuvioTheme.colors.TextSecondary,
+                                )
+                            }
+                            Row(Modifier.fillMaxWidth().height(14.dp).clip(RoundedCornerShape(7.dp))) {
+                                Box(Modifier.weight(movie).fillMaxHeight().background(DxPalette[0]))
+                                Box(Modifier.weight(1f - movie).fillMaxHeight().background(DxPalette[1]))
+                            }
+                        }
+                    }
+
+                    val chips = data?.chips.orEmpty()
+                    if (chips.isNotEmpty()) {
+                        FlowRow(
+                            horizontalArrangement = Arrangement.spacedBy(12.dp),
+                            verticalArrangement = Arrangement.spacedBy(12.dp),
+                        ) {
+                            chips.forEach { chip ->
+                                Text(
+                                    text = chip,
+                                    style = MaterialTheme.typography.titleMedium,
+                                    color = NuvioTheme.colors.TextPrimary,
+                                    modifier = Modifier
+                                        .clip(RoundedCornerShape(30.dp))
+                                        .background(NuvioTheme.colors.BackgroundElevated)
+                                        .padding(horizontal = 20.dp, vertical = 10.dp),
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    sheet?.let { current ->
+        DxPosterSheet(
+            sheet = current,
+            onDismiss = { sheet = null },
+            onPick = { item ->
+                sheet = null
+                onOpenDetail(item.id, item.type, item.addonBaseUrl)
+            },
+        )
+    }
+
+    if (showSwitch) {
+        val locked by remember(entry) { entry.profileLockStateDataStore().pinEnabled }
+            .collectAsState(initial = emptyMap())
+        NuvioDialog(
+            onDismiss = { showSwitch = false },
+            title = "Switch profile",
+            subtitle = "Choose who is watching",
+            width = 560.dp,
+        ) {
+            val firstFocus = remember { FocusRequester() }
+            LaunchedEffect(Unit) {
+                delay(120)
+                runCatching { firstFocus.requestFocus() }
+            }
+            profiles.forEachIndexed { index, p ->
+                val isActive = p.id == activeId
+                val isLocked = !isActive && locked[p.id] == true
+                DxCard(
+                    onClick = {
+                        when {
+                            isActive -> showSwitch = false
+                            isLocked -> Toast.makeText(
+                                context,
+                                "This profile has a PIN. Use Edit profile to open it.",
+                                Toast.LENGTH_LONG,
+                            ).show()
+                            else -> {
+                                showSwitch = false
+                                scope.launch { entry.profileManager().setActiveProfile(p.id) }
+                            }
+                        }
+                    },
+                    modifier = Modifier.fillMaxWidth().let { if (index == 0) it.focusRequester(firstFocus) else it },
+                    radius = 18,
+                ) {
+                    Row(
+                        modifier = Modifier.fillMaxWidth().padding(16.dp),
+                        verticalAlignment = Alignment.CenterVertically,
+                        horizontalArrangement = Arrangement.spacedBy(16.dp),
+                    ) {
+                        ProfileAvatarCircle(
+                            name = p.name,
+                            colorHex = p.avatarColorHex,
+                            size = 52.dp,
+                            avatarImageUrl = p.avatarUrl,
+                        )
+                        Text(
+                            text = p.name,
+                            style = MaterialTheme.typography.titleLarge,
+                            color = NuvioTheme.colors.TextPrimary,
+                            modifier = Modifier.weight(1f),
+                        )
+                        if (isActive || isLocked) {
+                            Text(
+                                text = if (isActive) "Active" else "PIN protected",
+                                style = MaterialTheme.typography.bodyLarge,
+                                color = NuvioTheme.colors.TextSecondary,
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+private fun dxShortHours(seconds: Double): String {
+    val minutes = (seconds / 60.0).toLong()
+    return if (minutes >= 60) "${minutes / 60}h ${minutes % 60}m" else "${minutes}m"
+}
+
+@Composable
+private fun DxPosterSheet(sheet: DxSheet, onDismiss: () -> Unit, onPick: (DxInsightItem) -> Unit) {
+    Dialog(
+        onDismissRequest = onDismiss,
+        properties = DialogProperties(usePlatformDefaultWidth = false),
+    ) {
+        Box(
+            modifier = Modifier.fillMaxSize().background(Color(0x99000000)),
+            contentAlignment = Alignment.CenterEnd,
+        ) {
+            Column(
+                modifier = Modifier
+                    .width(760.dp)
+                    .fillMaxHeight()
+                    .clip(RoundedCornerShape(topStart = 28.dp, bottomStart = 28.dp))
+                    .background(NuvioTheme.colors.BackgroundElevated)
+                    .padding(32.dp),
+                verticalArrangement = Arrangement.spacedBy(18.dp),
+            ) {
+                Text(
+                    text = sheet.title,
+                    style = MaterialTheme.typography.headlineMedium,
+                    fontWeight = FontWeight.Bold,
+                    color = NuvioTheme.colors.TextPrimary,
+                )
+                if (sheet.items.isEmpty()) {
+                    val empty = remember { FocusRequester() }
+                    LaunchedEffect(Unit) {
+                        delay(120)
+                        runCatching { empty.requestFocus() }
+                    }
+                    DxCard(onClick = onDismiss, modifier = Modifier.focusRequester(empty), radius = 30) {
+                        Text(
+                            text = "Nothing here yet. Press to close.",
+                            style = MaterialTheme.typography.titleMedium,
+                            color = NuvioTheme.colors.TextSecondary,
+                            modifier = Modifier.padding(horizontal = 28.dp, vertical = 16.dp),
+                        )
+                    }
+                } else {
+                    val first = remember { FocusRequester() }
+                    LaunchedEffect(Unit) {
+                        delay(120)
+                        runCatching { first.requestFocus() }
+                    }
+                    LazyVerticalGrid(
+                        columns = GridCells.Fixed(3),
+                        modifier = Modifier.fillMaxSize(),
+                        contentPadding = PaddingValues(8.dp),
+                        horizontalArrangement = Arrangement.spacedBy(18.dp),
+                        verticalArrangement = Arrangement.spacedBy(18.dp),
+                    ) {
+                        items(sheet.items, key = { "${it.type}:${it.id}:${it.subtitle}" }) { item ->
+                            Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                                DxCard(
+                                    onClick = { onPick(item) },
+                                    modifier = Modifier
+                                        .fillMaxWidth()
+                                        .let { if (item === sheet.items.first()) it.focusRequester(first) else it },
+                                    radius = 14,
+                                ) {
+                                    Box(
+                                        modifier = Modifier.fillMaxWidth().aspectRatio(2f / 3f)
+                                            .background(NuvioTheme.colors.Surface)
+                                    ) {
+                                        if (!item.poster.isNullOrBlank()) {
+                                            AsyncImage(
+                                                model = item.poster,
+                                                contentDescription = item.title,
+                                                modifier = Modifier.fillMaxSize(),
+                                                contentScale = ContentScale.Crop,
+                                            )
+                                        }
+                                    }
+                                }
+                                Text(
+                                    text = item.title,
+                                    style = MaterialTheme.typography.titleMedium,
+                                    color = NuvioTheme.colors.TextPrimary,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                    textAlign = TextAlign.Start,
+                                )
+                                if (!item.subtitle.isNullOrBlank()) {
+                                    Text(
+                                        text = item.subtitle,
+                                        style = MaterialTheme.typography.bodyMedium,
+                                        color = NuvioTheme.colors.TextSecondary,
+                                        maxLines = 1,
+                                        overflow = TextOverflow.Ellipsis,
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
