+    /** Sets (or, with a null [rating], removes) the user's 1-10 rating of a whole movie or series. False when not connected. */
+    suspend fun setTitleRating(imdbId: String, isMovie: Boolean, rating: Int?): Boolean {
+        if (!mutableState.value.isConnected) return false
+        val item = JSONObject().put("ids", JSONObject().put("imdb", imdbId))
+        rating?.let { item.put("rating", it.coerceIn(1, 10)) }
+        val document = JSONObject().put(if (isMovie) "movies" else "shows", JSONArray().put(item))
+        val response = writeMutex.withLock {
+            authorizedPost(if (rating == null) "/sync/ratings/remove" else "/sync/ratings", document)
+        } ?: return false
+        return response.status in 200..299
+    }
