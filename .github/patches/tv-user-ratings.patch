+package com.nuvio.tv.core.ratings
+
+import android.content.Context
+import com.nuvio.tv.data.mdblist.MdbListApiClient
+import com.nuvio.tv.data.mdblist.MdbListAuthStore
+import com.nuvio.tv.data.simkl.SimklApiClient
+import com.nuvio.tv.data.simkl.SimklApiRequest
+import com.nuvio.tv.data.simkl.SimklAuthRepository
+import com.nuvio.tv.data.simkl.SimklHttpMethod
+import com.nuvio.tv.data.simkl.SimklRetryPolicy
+import com.nuvio.tv.data.wetrakr.WeTrakrService
+import dagger.hilt.android.qualifiers.ApplicationContext
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * Your own 1-10 rating of a title (ported idea from NuvioMobile-Enhanced). A rating is sent to every connected
+ * account that can store one (Simkl, MDBList, WeTrakr); the value shown in the app is kept on this device.
+ */
+@Singleton
+class UserRatingsRepository @Inject constructor(
+    @ApplicationContext context: Context,
+    private val simklClient: SimklApiClient,
+    private val simklAuth: SimklAuthRepository,
+    private val mdbListApi: MdbListApiClient,
+    private val mdbListStore: MdbListAuthStore,
+    private val weTrakr: WeTrakrService,
+) {
+    private val prefs = context.getSharedPreferences("user_ratings", Context.MODE_PRIVATE)
+    private val _ratings = MutableStateFlow(load())
+    val ratings: StateFlow<Map<String, Int>> = _ratings.asStateFlow()
+
+    /** True when at least one connected account can store a rating. */
+    fun canRate(): Boolean =
+        simklAuth.state.value.isAuthenticated ||
+            mdbListStore.state.value.isAuthenticated ||
+            weTrakr.state.value.isConnected
+
+    /**
+     * Rates the movie or series [imdbId]; a null [rating] removes the rating. True when at least one
+     * account took it.
+     */
+    suspend fun rate(imdbId: String, isMovie: Boolean, rating: Int?): Boolean {
+        var saved = false
+        if (simklAuth.state.value.isAuthenticated) saved = attempt { simkl(imdbId, isMovie, rating) } || saved
+        if (mdbListStore.state.value.isAuthenticated) saved = attempt { mdbList(imdbId, isMovie, rating) } || saved
+        if (weTrakr.state.value.isConnected) saved = attempt { weTrakr.setTitleRating(imdbId, isMovie, rating) } || saved
+        if (saved) store(imdbId, rating)
+        return saved
+    }
+
+    private suspend fun attempt(block: suspend () -> Boolean): Boolean = try {
+        block()
+    } catch (cancel: CancellationException) {
+        throw cancel
+    } catch (_: Exception) {
+        false
+    }
+
+    private fun ratedBody(imdbId: String, isMovie: Boolean, rating: Int?): String {
+        val item = JSONObject().put("ids", JSONObject().put("imdb", imdbId))
+        rating?.let { item.put("rating", it) }
+        return JSONObject().put(if (isMovie) "movies" else "shows", JSONArray().put(item)).toString()
+    }
+
+    private suspend fun simkl(imdbId: String, isMovie: Boolean, rating: Int?): Boolean {
+        val response = simklClient.execute(
+            SimklApiRequest(
+                method = SimklHttpMethod.POST,
+                path = if (rating == null) "/sync/ratings/remove" else "/sync/ratings",
+                body = ratedBody(imdbId, isMovie, rating),
+                retryPolicy = SimklRetryPolicy.SYNC_WRITE
+            )
+        )
+        return response.status in 200..299
+    }
+
+    private suspend fun mdbList(imdbId: String, isMovie: Boolean, rating: Int?): Boolean {
+        val response = mdbListApi.post(
+            if (rating == null) "/sync/ratings/remove" else "/sync/ratings",
+            ratedBody(imdbId, isMovie, rating)
+        )
+        return response.status in 200..299
+    }
+
+    private fun store(imdbId: String, rating: Int?) {
+        val next = _ratings.value.toMutableMap()
+        if (rating == null) next.remove(imdbId) else next[imdbId] = rating
+        _ratings.value = next
+        prefs.edit().putString(KEY, JSONObject(next as Map<*, *>).toString()).apply()
+    }
+
+    private fun load(): Map<String, Int> {
+        val raw = prefs.getString(KEY, null) ?: return emptyMap()
+        return runCatching {
+            val json = JSONObject(raw)
+            json.keys().asSequence().associateWith { json.getInt(it) }
+        }.getOrDefault(emptyMap())
+    }
+
+    private companion object {
+        const val KEY = "ratings_by_imdb_id"
+    }
+}
