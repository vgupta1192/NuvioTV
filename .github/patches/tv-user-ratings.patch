+package com.nuvio.tv.ui.screens.detail
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import androidx.tv.material3.Button
+import androidx.tv.material3.ButtonDefaults
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.core.ratings.UserRatingsRepository
+import com.nuvio.tv.ui.components.NuvioDialog
+import com.nuvio.tv.ui.theme.NuvioTheme
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.launch
+
+@HiltViewModel
+class UserRatingViewModel @Inject constructor(
+    private val repository: UserRatingsRepository
+) : ViewModel() {
+    val ratings: StateFlow<Map<String, Int>> = repository.ratings
+
+    fun canRate(): Boolean = repository.canRate()
+
+    fun rate(imdbId: String, isMovie: Boolean, rating: Int?, onResult: (Boolean) -> Unit) {
+        viewModelScope.launch { onResult(repository.rate(imdbId, isMovie, rating)) }
+    }
+}
+
+/** The IMDb id a title can be rated under: the meta id or its IMDb id, when it is a "tt" id. */
+internal fun ratingImdbId(metaId: String, imdbId: String?): String? =
+    sequenceOf(imdbId, metaId.substringBefore(':'))
+        .firstOrNull { !it.isNullOrBlank() && it.startsWith("tt") }
+
+/** Rating picker (ported idea from NuvioMobile-Enhanced): 1 to 10, or remove the current rating. */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun UserRatingDialog(
+    current: Int?,
+    onDismiss: () -> Unit,
+    onSelect: (Int?) -> Unit,
+) {
+    val focusRequester = remember { FocusRequester() }
+    LaunchedEffect(Unit) { runCatching { focusRequester.requestFocus() } }
+
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = stringResource(R.string.user_rating_title),
+        width = 640.dp,
+    ) {
+        listOf(1..5, 6..10).forEach { range ->
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp), modifier = Modifier.fillMaxWidth()) {
+                range.forEach { value ->
+                    Button(
+                        onClick = { onSelect(value) },
+                        modifier = Modifier.then(
+                            if (value == (current ?: 8)) Modifier.focusRequester(focusRequester) else Modifier
+                        ),
+                        colors = ButtonDefaults.colors(
+                            containerColor = if (value == current) NuvioTheme.colors.SurfaceVariant else NuvioTheme.colors.BackgroundCard,
+                            contentColor = NuvioTheme.colors.TextPrimary,
+                        )
+                    ) {
+                        Text(value.toString())
+                    }
+                }
+            }
+        }
+        if (current != null) {
+            Button(
+                onClick = { onSelect(null) },
+                modifier = Modifier.fillMaxWidth(),
+                colors = ButtonDefaults.colors(
+                    containerColor = NuvioTheme.colors.BackgroundCard,
+                    contentColor = NuvioTheme.colors.TextPrimary,
+                )
+            ) {
+                Text(stringResource(R.string.user_rating_remove))
+            }
+        }
+    }
+}
