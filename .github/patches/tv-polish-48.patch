index 000000000..fc7de62dc
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/player/PlaybackFrameLog.kt
@@ -0,0 +1,199 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import androidx.media3.common.Format
+import androidx.media3.common.PlaybackException
+import androidx.media3.common.Player
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.analytics.AnalyticsListener
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * Nuvio fork: a per-second record of dropped video frames while ExoPlayer plays, to find what makes a device drop
+ * frames. Each line has the playback position, frames dropped and rendered in that second, the buffer ahead and the
+ * decoder. Events that could cause a hitch (Custom Stretch frame grabs, seeks, audio underruns, state changes) are
+ * written between them, so the log shows what happened just before each drop. It lives in memory only (latest lines),
+ * holds no links or titles, and is read from Settings through the debug-log QR page.
+ */
+internal object PlaybackFrameLog {
+    private const val MAX_LINES = 2_400
+    private const val CONTEXT_EVERY_SECONDS = 10
+
+    private val lines = ArrayDeque<String>()
+    private val time = SimpleDateFormat("HH:mm:ss", Locale.US)
+    private val handler = Handler(Looper.getMainLooper())
+    @Volatile private var active = false
+
+    private var player: ExoPlayer? = null
+    private var listener: AnalyticsListener? = null
+    private var ticker: Runnable? = null
+    private var lastDropped = 0L
+    private var lastRendered = 0L
+    private var secondsSinceContext = 0
+    private var droppedTotal = 0L
+    private var videoDecoder = "?"
+    private var videoLabel = "?"
+
+    /** Starts logging for [exo]; any earlier player is detached first. Call on the main thread. */
+    fun attach(exo: ExoPlayer) {
+        detach()
+        player = exo
+        active = true
+        lastDropped = 0L
+        lastRendered = 0L
+        secondsSinceContext = 0
+        droppedTotal = 0L
+        videoDecoder = "?"
+        videoLabel = "?"
+        add("--- player attached ---")
+        val analytics = object : AnalyticsListener {
+            override fun onVideoDecoderInitialized(
+                eventTime: AnalyticsListener.EventTime,
+                decoderName: String,
+                initializedTimestampMs: Long,
+                initializationDurationMs: Long,
+            ) {
+                videoDecoder = decoderName
+                add("video decoder $decoderName (${initializationDurationMs} ms to start)")
+            }
+
+            override fun onAudioDecoderInitialized(
+                eventTime: AnalyticsListener.EventTime,
+                decoderName: String,
+                initializedTimestampMs: Long,
+                initializationDurationMs: Long,
+            ) {
+                add("audio decoder $decoderName")
+            }
+
+            override fun onVideoInputFormatChanged(
+                eventTime: AnalyticsListener.EventTime,
+                format: Format,
+                decoderReuseEvaluation: androidx.media3.exoplayer.DecoderReuseEvaluation?,
+            ) {
+                videoLabel = "${format.width}x${format.height}" +
+                    (format.frameRate.takeIf { it > 0f }?.let { " ${"%.1f".format(Locale.US, it)}fps" } ?: "") +
+                    (format.sampleMimeType?.let { " ${it.substringAfter('/')}" } ?: "")
+                add("video format $videoLabel")
+            }
+
+            override fun onPlaybackStateChanged(eventTime: AnalyticsListener.EventTime, state: Int) {
+                val name = when (state) {
+                    Player.STATE_IDLE -> "idle"
+                    Player.STATE_BUFFERING -> "buffering"
+                    Player.STATE_READY -> "ready"
+                    Player.STATE_ENDED -> "ended"
+                    else -> state.toString()
+                }
+                add("state $name at ${position(eventTime.currentPlaybackPositionMs)}")
+            }
+
+            override fun onPositionDiscontinuity(
+                eventTime: AnalyticsListener.EventTime,
+                oldPosition: Player.PositionInfo,
+                newPosition: Player.PositionInfo,
+                reason: Int,
+            ) {
+                if (reason == Player.DISCONTINUITY_REASON_SEEK || reason == Player.DISCONTINUITY_REASON_SEEK_ADJUSTMENT) {
+                    add("seek to ${position(newPosition.positionMs)}")
+                }
+            }
+
+            override fun onAudioUnderrun(
+                eventTime: AnalyticsListener.EventTime,
+                bufferSize: Int,
+                bufferSizeMs: Long,
+                elapsedSinceLastFeedMs: Long,
+            ) {
+                add("audio underrun (${elapsedSinceLastFeedMs} ms since last audio feed)")
+            }
+
+            override fun onDroppedVideoFrames(
+                eventTime: AnalyticsListener.EventTime,
+                droppedFrames: Int,
+                elapsedMs: Long,
+            ) {
+                add("DROPPED $droppedFrames frames in ${elapsedMs} ms at ${position(eventTime.currentPlaybackPositionMs)}")
+            }
+
+            override fun onPlayerError(eventTime: AnalyticsListener.EventTime, error: PlaybackException) {
+                add("player error ${error.errorCodeName}")
+            }
+        }
+        listener = analytics
+        exo.addAnalyticsListener(analytics)
+        val tick = object : Runnable {
+            override fun run() {
+                sample()
+                if (active) handler.postDelayed(this, 1_000L)
+            }
+        }
+        ticker = tick
+        handler.postDelayed(tick, 1_000L)
+    }
+
+    fun detach() {
+        if (!active && player == null) return
+        active = false
+        ticker?.let { handler.removeCallbacks(it) }
+        ticker = null
+        player?.let { exo -> listener?.let { runCatching { exo.removeAnalyticsListener(it) } } }
+        listener = null
+        player = null
+        add("--- player detached, $droppedTotal frames dropped in total ---")
+    }
+
+    /** A named moment worth lining up with drops, such as a Custom Stretch frame grab. */
+    fun mark(event: String) {
+        if (active) add(event)
+    }
+
+    private fun sample() {
+        val exo = player ?: return
+        val counters = exo.videoDecoderCounters ?: return
+        counters.ensureUpdated()
+        val dropped = (counters.droppedBufferCount + counters.skippedOutputBufferCount).toLong()
+        val rendered = counters.renderedOutputBufferCount.toLong()
+        val droppedNow = (dropped - lastDropped).coerceAtLeast(0L)
+        val renderedNow = (rendered - lastRendered).coerceAtLeast(0L)
+        lastDropped = dropped
+        lastRendered = rendered
+        droppedTotal = dropped
+        secondsSinceContext++
+        if (droppedNow > 0L || secondsSinceContext >= CONTEXT_EVERY_SECONDS) {
+            secondsSinceContext = 0
+            val bufferMs = (exo.bufferedPosition - exo.currentPosition).coerceAtLeast(0L)
+            add(
+                "${position(exo.currentPosition)} drop=$droppedNow rendered=$renderedNow " +
+                    "buffer=${bufferMs / 100 / 10.0}s playing=${exo.isPlaying} speed=${exo.playbackParameters.speed}",
+            )
+        }
+    }
+
+    private fun position(ms: Long): String {
+        val total = (ms / 1000).coerceAtLeast(0L)
+        return "%d:%02d:%02d".format(Locale.US, total / 3600, total / 60 % 60, total % 60)
+    }
+
+    private fun add(message: String) {
+        val line = "${time.format(Date())} $message"
+        synchronized(lines) {
+            lines.addLast(line)
+            while (lines.size > MAX_LINES) lines.removeFirst()
+        }
+    }
+
+    fun text(): String {
+        val header = "Nuvio playback frame log · ${Build.MANUFACTURER} ${Build.MODEL} · Android ${Build.VERSION.RELEASE}" +
+            "\nOne line per second that dropped frames, plus a status line every $CONTEXT_EVERY_SECONDS s. " +
+            "Lines such as 'stretch capture' mark Custom Stretch frame grabs."
+        return synchronized(lines) {
+            if (lines.isEmpty()) "$header\n\nNo video has played yet. Play something with ExoPlayer, then open this again."
+            else (listOf(header) + lines).joinToString("\n")
+        }
+    }
+}
