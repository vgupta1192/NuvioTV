diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerRuntimeControllerSkipTimes.kt b/app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerRuntimeControllerSkipTimes.kt
new file mode 100644
index 00000000..f2ca7adb
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerRuntimeControllerSkipTimes.kt
@@ -0,0 +1,144 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.util.Log
+import com.nuvio.tv.core.player.skiptimes.CreditsDetector
+import com.nuvio.tv.core.player.skiptimes.MediaChapter
+import com.nuvio.tv.core.player.skiptimes.SkipFrameGrabber
+import com.nuvio.tv.core.player.skiptimes.SkipTimeFitter
+import com.nuvio.tv.data.repository.SkipInterval
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeoutOrNull
+
+/** Local (no-API) skip detection's state: what the remote databases gave, and what the file's own pictures gave. */
+internal class LocalSkipTimesState {
+    /** The remote databases' result for the current stream; cleared when the stream changes. */
+    var remote: List<SkipInterval> = emptyList()
+    /** Credits found in the current stream's pictures, or null while none. */
+    var found: SkipInterval? = null
+    /** The stream the search ran (or was given up) for: it runs once per stream. */
+    var searchedFor: String? = null
+    var job: Job? = null
+    /** The playback setting; off (default) because the search decodes pictures of its own. */
+    var enabled: Boolean = false
+}
+
+/** Between two pictures, so the retriever and the network stay free for playback and scrubbing. */
+private const val LOCAL_SKIP_GRAB_PACE_MS = 250L
+/** One picture at most this long; a stream the retriever hangs on gives up that look, not the search. */
+private const val LOCAL_SKIP_GRAB_TIMEOUT_MS = 12_000L
+/** Credits are searched this long before the stretch they could start in, which leaves time to finish. */
+private const val LOCAL_SKIP_SEARCH_LEAD_MS = 5 * 60_000L
+
+/**
+ * The remote databases' result applied and merged with what the file itself has said. Every path that used to
+ * assign [PlayerRuntimeController.skipIntervals] directly goes through here, so the local fallback (when the
+ * databases had nothing) and the chapter/credits sharpening see each result.
+ */
+internal fun PlayerRuntimeController.applyRemoteSkipTimes(times: List<SkipInterval>) {
+    localSkipTimes.remote = times
+    refreshSkipIntervals()
+}
+
+/** [PlayerRuntimeController.skipIntervals] again, from the remote times and what the file has said so far. */
+internal fun PlayerRuntimeController.refreshSkipIntervals() {
+    if (!skipIntroEnabled) return
+    val next = SkipTimeFitter.combine(
+        remote = localSkipTimes.remote,
+        durationMs = currentPlaybackDurationMs().coerceAtLeast(0L),
+        movie = contentType.equals("movie", ignoreCase = true),
+        chapters = currentMediaChapters(),
+        credits = localSkipTimes.found
+    )
+    if (next == skipIntervals) return
+    skipIntervals = next
+    Log.i(
+        PlayerRuntimeController.TAG,
+        "SKIP_TIMES: " + next.joinToString { "${it.type} ${it.startTime}-${it.endTime} (${it.provider})" }
+            .ifEmpty { "none" }
+    )
+}
+
+/** The playing file's chapters, with each one's end set to the next chapter's start. */
+private fun PlayerRuntimeController.currentMediaChapters(): List<MediaChapter>? {
+    val chapters = _uiState.value.chapters
+    if (chapters.isEmpty()) return null
+    return chapters.mapIndexed { i, chapter ->
+        MediaChapter(chapter.startMs, chapters.getOrNull(i + 1)?.startMs, chapter.title.orEmpty())
+    }
+}
+
+/** Turning local detection off stops its search and drops what it found. */
+internal fun PlayerRuntimeController.stopLocalSkipTimes() {
+    localSkipTimes.job?.cancel()
+    localSkipTimes.job = null
+    localSkipTimes.searchedFor = null
+    localSkipTimes.found = null
+    refreshSkipIntervals()
+}
+
+/** A new episode or source: its times start over. */
+internal fun PlayerRuntimeController.resetSkipTimesForSourceChange() {
+    localSkipTimes.job?.cancel()
+    localSkipTimes.job = null
+    localSkipTimes.remote = emptyList()
+    localSkipTimes.searchedFor = null
+    localSkipTimes.found = null
+}
+
+/**
+ * On every position tick: starts the credits search of the file playing once the remote databases have answered and
+ * had nothing, the position is near the stretch the credits could start in, and the search hasn't run for this
+ * stream yet. The pictures come from the stream itself ([SkipFrameGrabber]), not the player's surface.
+ */
+internal fun PlayerRuntimeController.ensureLocalSkipDetection(positionMs: Long) {
+    val state = localSkipTimes
+    if (!state.enabled || !skipIntroEnabled || !playerSettingsInitialized) return
+    if (state.job?.isActive == true || state.searchedFor == currentStreamUrl) return
+    if (_playbackTimeline.value.isLive) return
+    // Only a fallback: the remote path has to have run and come back empty first.
+    if (skipIntroFetchedKey == null || skipIntervals.isNotEmpty()) return
+    val durationMs = currentPlaybackDurationMs().takeIf { it > 0 && !isShortPlaceholderDuration(it) } ?: return
+    val url = currentStreamUrl.takeIf { it.isNotBlank() } ?: return
+    val movie = contentType.equals("movie", ignoreCase = true)
+    if (positionMs < durationMs - CreditsDetector.windowMs(movie) - LOCAL_SKIP_SEARCH_LEAD_MS) return
+    // Don't compete with the network while playback is still finding its feet.
+    if (_uiState.value.isBuffering) return
+    state.searchedFor = url
+    state.job = scope.launch { findLocalSkipTimes(url, durationMs, movie) }
+}
+
+private suspend fun PlayerRuntimeController.findLocalSkipTimes(url: String, durationMs: Long, movie: Boolean) {
+    Log.i(
+        PlayerRuntimeController.TAG,
+        "LOCAL_SKIP_TIMES: searching credits (${if (movie) "movie" else "episode"}, ${durationMs / 1000}s)"
+    )
+    val request = PlayerMediaSourceFactory.normalizePlaybackRequest(url, currentHeaders)
+    // Opening the retriever reads the stream header: off the main thread, like every grab.
+    val grabber = withContext(Dispatchers.IO) { SkipFrameGrabber(context, request.url, request.headers) }
+    try {
+        val found = CreditsDetector.find(
+            durationMs = durationMs,
+            movie = movie,
+            grab = { positionMs ->
+                delay(LOCAL_SKIP_GRAB_PACE_MS)
+                withTimeoutOrNull(LOCAL_SKIP_GRAB_TIMEOUT_MS) {
+                    withContext(Dispatchers.IO) { grabber.grab(positionMs) }
+                }?.let { bitmap ->
+                    withContext(Dispatchers.Default) {
+                        CreditsDetector.stats(bitmap).also { bitmap.recycle() }
+                    }
+                }
+            },
+            log = { Log.i(PlayerRuntimeController.TAG, "LOCAL_SKIP_TIMES: $it") }
+        )
+        if (currentStreamUrl != url) return
+        localSkipTimes.found = found
+        refreshSkipIntervals()
+    } finally {
+        grabber.release()
+    }
+}
