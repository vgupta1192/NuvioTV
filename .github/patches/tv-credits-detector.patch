+++ b/app/src/main/java/com/nuvio/tv/core/player/skiptimes/SkipFrameGrabber.kt
@@ -0,0 +1,87 @@
+package com.nuvio.tv.core.player.skiptimes
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.media.MediaMetadataRetriever
+import android.net.Uri
+import android.os.Build
+import kotlin.math.roundToInt
+
+/**
+ * Decodes a small keyframe picture at an arbitrary time of the stream the credits are looked for in, without
+ * touching the player: its own [MediaMetadataRetriever] session, one per search, each picture scaled to
+ * [FRAME_WIDTH] (Intro Skipper's thresholds are thumbnail-scale, where lettering blurs into grey).
+ *
+ * A stream whose container the retriever can't seek (HLS, for one) gives no pictures at all — the detector treats
+ * them as missing and finds nothing. Best-effort, as [com.nuvio.tv.ui.screens.player.MatroskaChapterLoader] is.
+ */
+internal class SkipFrameGrabber(
+    context: Context,
+    url: String,
+    headers: Map<String, String>
+) {
+    private val retriever = MediaMetadataRetriever()
+    private var opened = false
+    private var released = false
+
+    init {
+        // setDataSource with a header map needs the framework http source; anything it refuses means no pictures.
+        runCatching {
+            retriever.setDataSource(context, Uri.parse(url), headers)
+            opened = true
+        }.onFailure {
+            runCatching { retriever.release() }
+            released = true
+        }
+    }
+
+    /**
+     * The keyframe at or just before [positionMs], [FRAME_WIDTH] wide (aspect kept), or null. Blocking; call off
+     * the main thread, one grab at a time (the retriever isn't thread-safe).
+     */
+    fun grab(positionMs: Long): Bitmap? {
+        if (released || !opened) return null
+        return runCatching {
+            val frame = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O_MR1) {
+                retriever.getScaledFrameAtTime(
+                    positionMs * 1000,
+                    MediaMetadataRetriever.OPTION_CLOSEST_SYNC,
+                    FRAME_WIDTH,
+                    FRAME_HEIGHT
+                )
+            } else {
+                val full = retriever.getFrameAtTime(
+                    positionMs * 1000,
+                    MediaMetadataRetriever.OPTION_CLOSEST_SYNC
+                ) ?: return null
+                val scale = FRAME_WIDTH.toFloat() / full.width.coerceAtLeast(1)
+                val scaled = Bitmap.createScaledBitmap(
+                    full,
+                    FRAME_WIDTH,
+                    (full.height * scale).roundToInt().coerceAtLeast(1),
+                    true
+                )
+                if (scaled !== full) full.recycle()
+                scaled
+            }
+            // getScaledFrameAtTime can hand back a frame larger than asked when it can't scale down.
+            if (frame.width > FRAME_WIDTH * 2) {
+                val scaled = Bitmap.createScaledBitmap(frame, FRAME_WIDTH, FRAME_HEIGHT, true)
+                frame.recycle()
+                scaled
+            } else frame
+        }.getOrNull()
+    }
+
+    fun release() {
+        if (released) return
+        released = true
+        runCatching { retriever.release() }
+    }
+
+    companion object {
+        /** A keyframe this wide reads like a seek thumbnail, which the detector's shares were tuned for. */
+        const val FRAME_WIDTH = 320
+        const val FRAME_HEIGHT = 180
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/player/skiptimes/SkipTimeFitter.kt b/app/src/main/java/com/nuvio/tv/core/player/skiptimes/SkipTimeFitter.kt
new file mode 100644
index 00000000..c39b46b5
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/player/skiptimes/SkipTimeFitter.kt
@@ -0,0 +1,181 @@
+package com.nuvio.tv.core.player.skiptimes
+
+import com.nuvio.tv.data.repository.SkipInterval
+import kotlin.math.abs
+
+/** A chapter of the file playing, as its container lists it. [endMs] is the next chapter's start when known. */
+data class MediaChapter(val startMs: Long, val endMs: Long?, val title: String)
+
+/**
+ * Turns the databases' skip times into ones for the file that plays, from what that file says about itself: its
+ * chapter names (exact for this release), its chapter starts (where its cuts really are) and credits found in its
+ * pictures ([CreditsDetector]). The chapter-name patterns follow Intro Skipper's (GPL-3.0, as this app is), with
+ * Western "Main Titles" added.
+ *
+ * The databases' times arrive already merged best-of by [com.nuvio.tv.data.repository.SkipIntroRepository], so
+ * unlike Echo's original there is no judging between providers here: chapter names win over the databases, database
+ * edges snap onto chapter starts, and the pictures' credits fill a missing ending or sharpen the database's one.
+ */
+internal object SkipTimeFitter {
+    private val PREVIEW = Regex(
+        """(^|\s)(Preview|PV|Sneak\s?Peek|Coming\s?(Up|Soon)|Next\s+(time|on|episode)|Extra|Teaser|Trailer)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE
+    )
+    /** The title sequence by name; wins over a plain "Intro", which in anime releases is the cold open before the OP. */
+    private val OPENING = Regex(
+        """(^|\s)(OP|Opening|Main\s+Titles?|Title\s+Sequence)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE
+    )
+    private val INTRO = Regex("""(^|\s)(Intro|Introduction)(?![\s:]+End)(\s|:|$)""", RegexOption.IGNORE_CASE)
+    private val RECAP = Regex(
+        """(^|\s)(Re?cap|Sum{1,2}ary|Prev(ious(ly)?)?|(Last|Earlier)(\s\w+)?|Catch[ -]up)(?![\s:]+End)(\s|:|$)""",
+        RegexOption.IGNORE_CASE
+    )
+    private val CREDITS = Regex("""(^|\s)(Credits?|ED|Ending|Outro)(?![\s:]+End)(\s|:|$)""", RegexOption.IGNORE_CASE)
+
+    /** An edge moves onto a chapter start this close. */
+    private const val CHAPTER_SNAP_S = 5.0
+    /** Credits found in the pictures this close to a database's take their start from the pictures. */
+    private const val CREDITS_AGREE_S = 60.0
+
+    private const val KIND_OPENING = "opening"
+    private const val KIND_RECAP = "recap"
+    private const val KIND_ENDING = "ending"
+    private const val KIND_MOVIE_CREDITS = "movie-credits"
+    private val KINDS = listOf(KIND_OPENING, KIND_RECAP, KIND_ENDING, KIND_MOVIE_CREDITS)
+
+    /**
+     * The skip times for a file [durationMs] long: the databases' [remote] with what the file has said so far —
+     * named chapters ([chapters], when the file lists any) and [credits] found in its pictures.
+     */
+    fun combine(
+        remote: List<SkipInterval>,
+        durationMs: Long,
+        movie: Boolean,
+        chapters: List<MediaChapter>?,
+        credits: SkipInterval?
+    ): List<SkipInterval> {
+        val named = fromChapters(chapters.orEmpty(), durationMs, movie)
+        val marks = chapters?.let(::chapterMarks) ?: DoubleArray(0)
+        val out = ArrayList<SkipInterval>()
+        for (kind in KINDS) {
+            val ofKind = { interval: SkipInterval -> category(interval.type) == kind }
+            var chosen = named.firstOrNull(ofKind)
+                ?: remote.firstOrNull(ofKind)?.let { snap(it, marks, durationMs) }
+            if (kind == KIND_ENDING || kind == KIND_MOVIE_CREDITS) {
+                chosen = withCredits(chosen, credits?.takeIf(ofKind), durationMs)
+            }
+            chosen?.let(out::add)
+        }
+        // What has no kind (a movie's post-credits scene) passes through.
+        val scenes = remote.filter { category(it.type) == null }
+        // Skipping credits must not also skip the post-credits scene behind them.
+        val scene = scenes.minByOrNull { it.startTime }
+        val clamped = if (scene != null && scene.startTime.isFinite()) {
+            out.map { interval ->
+                val clampedEnd = minOf(interval.endTime, scene.startTime)
+                if (clampedEnd < interval.endTime && clampedEnd > interval.startTime) {
+                    interval.copy(endTime = clampedEnd)
+                } else interval
+            }
+        } else out
+        return (clamped + scenes).sortedBy { it.startTime }
+    }
+
+    /**
+     * Segments the file's chapter names give, the first of each kind (an opening by name before a plain "Intro"); a
+     * movie's chapters only give its credits.
+     */
+    fun fromChapters(chapters: List<MediaChapter>, durationMs: Long, movie: Boolean): List<SkipInterval> {
+        if (chapters.isEmpty() || durationMs <= 0) return emptyList()
+        val found = LinkedHashMap<String, SkipInterval>()
+        val namedOpening = !movie && chapters.any { OPENING.containsMatchIn(it.title) && !PREVIEW.containsMatchIn(it.title) }
+        chapters.forEachIndexed { i, chapter ->
+            val title = chapter.title
+            if (title.isBlank() || PREVIEW.containsMatchIn(title)) return@forEachIndexed
+            val type = when {
+                movie -> if (CREDITS.containsMatchIn(title)) "movie-credits" else null
+                OPENING.containsMatchIn(title) -> "intro"
+                INTRO.containsMatchIn(title) -> if (namedOpening) null else "intro"
+                RECAP.containsMatchIn(title) -> "recap"
+                CREDITS.containsMatchIn(title) -> "outro"
+                else -> null
+            } ?: return@forEachIndexed
+            val kind = category(type) ?: return@forEachIndexed
+            if (kind in found) return@forEachIndexed
+            val endMs = (chapter.endMs ?: chapters.getOrNull(i + 1)?.startMs ?: durationMs).coerceAtMost(durationMs)
+            val interval = SkipInterval(chapter.startMs / 1000.0, endMs / 1000.0, type, "chapters")
+            if (lengthFits(interval, kind) && plausible(interval, durationMs)) found[kind] = interval
+        }
+        return found.values.toList()
+    }
+
+    private fun lengthFits(interval: SkipInterval, kind: String): Boolean {
+        val length = interval.endTime - interval.startTime
+        return when (kind) {
+            KIND_OPENING -> length in 10.0..180.0
+            KIND_RECAP -> length in 5.0..240.0
+            KIND_ENDING -> length in 10.0..600.0
+            else -> length in 10.0..1200.0
+        }
+    }
+
+    /** A chapter segment within the file and not covering it whole; the same sanity the databases' are given. */
+    private fun plausible(interval: SkipInterval, durationMs: Long): Boolean {
+        if (!interval.startTime.isFinite() || !interval.endTime.isFinite()) return false
+        if (interval.startTime < 0.0 || interval.endTime <= interval.startTime) return false
+        return durationMs <= 0 || interval.endTime <= durationMs / 1000.0
+    }
+
+    /** Chapter starts (s), the file's start left out: every cut a chapter marks. */
+    private fun chapterMarks(chapters: List<MediaChapter>): DoubleArray =
+        chapters.map { it.startMs / 1000.0 }.filter { it > 0.5 }.distinct().sorted().toDoubleArray()
+
+    /** Edges onto a chapter start close by. */
+    private fun snap(interval: SkipInterval, marks: DoubleArray, durationMs: Long): SkipInterval {
+        if (marks.isEmpty()) return interval
+        fun onChapter(edge: Double): Double? = nearest(marks, edge)?.takeIf { abs(it - edge) <= CHAPTER_SNAP_S }
+        val length = if (durationMs > 0) durationMs / 1000.0 else Double.MAX_VALUE
+        val start = onChapter(interval.startTime) ?: interval.startTime
+        var end = interval.endTime
+        if (end.isFinite() && end < length) end = onChapter(end) ?: end
+        if (end <= start) return interval
+        return if (start == interval.startTime && end == interval.endTime) interval
+        else interval.copy(startTime = start, endTime = end)
+    }
+
+    /**
+     * The database's ending, its start set by the credits found in the pictures when the two are close; the pictures'
+     * credits alone when no database has an ending.
+     */
+    private fun withCredits(db: SkipInterval?, found: SkipInterval?, durationMs: Long): SkipInterval? {
+        if (found == null || db?.provider == "chapters") return db
+        if (db == null) return found
+        if (abs(found.startTime - db.startTime) > CREDITS_AGREE_S) return db
+        val fileEnd = if (durationMs > 0) durationMs / 1000.0 else Double.MAX_VALUE
+        // The database knows how the credits end, unless it runs past this file or the pictures agree anyway.
+        val end = if (db.endTime > fileEnd || abs(found.endTime - db.endTime) <= CREDITS_AGREE_S) found.endTime else db.endTime
+        return db.copy(startTime = found.startTime, endTime = maxOf(end, found.startTime + 1.0))
+    }
+
+    private fun category(type: String): String? = when (type.trim().lowercase()) {
+        "intro", "op", "opening", "mixed-op" -> KIND_OPENING
+        "recap" -> KIND_RECAP
+        "outro", "ed", "ending", "mixed-ed", "credits" -> KIND_ENDING
+        "movie-credits" -> KIND_MOVIE_CREDITS
+        else -> null
+    }
+
+    private fun nearest(sorted: DoubleArray, value: Double): Double? {
+        if (sorted.isEmpty()) return null
+        var lo = 0
+        var hi = sorted.size - 1
+        while (lo < hi) {
+            val mid = (lo + hi) ushr 1
+            if (sorted[mid] < value) lo = mid + 1 else hi = mid
+        }
+        val after = sorted[lo]
+        val before = if (lo > 0) sorted[lo - 1] else after
+        return if (abs(before - value) <= abs(after - value)) before else after
+    }
+}
