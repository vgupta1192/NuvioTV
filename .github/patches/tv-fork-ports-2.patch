+private const val PROMPT_VISIBLE_MS = 8_000L
+
+private fun segmentLabel(type: String): String = when (type.trim().lowercase()) {
+    "intro", "op", "mixed-op", "opening" -> "intro"
+    "recap" -> "recap"
+    "outro", "ed", "mixed-ed", "credits", "ending", "movie-credits" -> "credits"
+    "preview" -> "preview"
+    else -> "segment"
+}
+
+private fun formatSeconds(sec: Double): String {
+    val total = sec.toLong().coerceAtLeast(0L)
+    val h = total / 3600
+    val m = (total % 3600) / 60
+    val s = total % 60
+    return if (h > 0) "%d:%02d:%02d".format(h, m, s) else "%d:%02d".format(m, s)
+}
+
+/**
+ * Small prompt about 4 s after a manual skip lands: "Skipped the intro right?" with Good / Wrong and
+ * close, gone after 8 seconds. Wrong opens a nudge panel to move the start and end before saving.
+ * Never pauses playback.
+ */
+@Composable
+fun ForkTvSkipFeedbackPrompt(
+    interval: SkipInterval,
+    nudging: Boolean,
+    durationSec: Double,
+    onGood: () -> Unit,
+    onWrong: () -> Unit,
+    onRewind: () -> Unit,
+    onSave: (Double, Double) -> Unit,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val firstFocus = remember(nudging) { FocusRequester() }
+    LaunchedEffect(interval, nudging) {
+        runCatching { firstFocus.requestFocus() }
+    }
+    if (!nudging) {
+        LaunchedEffect(interval) {
+            delay(PROMPT_VISIBLE_MS)
+            onDismiss()
+        }
+    }
+    val panel = modifier
+        .clip(RoundedCornerShape(NuvioTheme.radii.md))
+        .background(Color.Black.copy(alpha = 0.78f))
+    val label = segmentLabel(interval.type)
+    if (!nudging) {
+        Row(
+            modifier = panel.padding(horizontal = 14.dp, vertical = 10.dp),
+            verticalAlignment = Alignment.CenterVertically,
+            horizontalArrangement = Arrangement.spacedBy(10.dp),
+        ) {
+            Text("Skipped the $label right?", color = Color.White, fontSize = 14.sp)
+            PromptChip("Good", onGood, Modifier.focusRequester(firstFocus))
+            PromptChip("Wrong", onWrong)
+            PromptChip("Close", onDismiss)
+        }
+        return
+    }
+    var start by remember(interval) { mutableStateOf(interval.startTime.coerceAtLeast(0.0)) }
+    var end by remember(interval) { mutableStateOf(interval.endTime) }
+    val maxSec = if (durationSec > 0) durationSec else Double.MAX_VALUE
+    Column(
+        modifier = panel.widthIn(max = 460.dp).padding(14.dp),
+        verticalArrangement = Arrangement.spacedBy(10.dp),
+    ) {
+        Text("Fix the $label", color = Color.White, fontSize = 16.sp, fontWeight = FontWeight.Bold)
+        NudgeRow("Start", start, Modifier.focusRequester(firstFocus)) { delta ->
+            start = (start + delta).coerceIn(0.0, (end - 1.0).coerceAtLeast(0.0))
+        }
+        NudgeRow("End", end, Modifier) { delta ->
+            end = (end + delta).coerceIn(start + 1.0, maxSec)
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+            PromptChip("Rewind 5s", onRewind)
+            PromptChip("Cancel", onDismiss)
+            PromptChip("Save", { if (end > start) onSave(start, end) })
+        }
+    }
+}
+
+@Composable
+private fun NudgeRow(label: String, valueSec: Double, firstChipModifier: Modifier, onNudge: (Double) -> Unit) {
+    Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+        Text(
+            "$label ${formatSeconds(valueSec)}",
+            color = Color.White,
+            fontSize = 14.sp,
+            modifier = Modifier.widthIn(min = 100.dp),
+        )
+        listOf(-5.0, -1.0, 1.0, 5.0).forEachIndexed { index, delta ->
+            PromptChip(
+                text = if (delta > 0) "+${delta.toInt()}s" else "${delta.toInt()}s",
+                onClick = { onNudge(delta) },
+                modifier = if (index == 0) firstChipModifier else Modifier,
+            )
+        }
+    }
+}
+
+@Composable
+private fun PromptChip(text: String, onClick: () -> Unit, modifier: Modifier = Modifier) {
+    Card(
+        onClick = onClick,
+        modifier = modifier,
+        colors = CardDefaults.colors(
+            containerColor = Color.White.copy(alpha = 0.16f),
+            focusedContainerColor = NuvioTheme.colors.Secondary,
+        ),
+        shape = CardDefaults.shape(shape = RoundedCornerShape(10.dp)),
+    ) {
+        Text(
+            text = text,
+            color = Color.White,
+            fontSize = 14.sp,
+            fontWeight = FontWeight.SemiBold,
+            modifier = Modifier.padding(horizontal = 14.dp, vertical = 8.dp),
+        )
+    }
+}
