+
+/** dx.bi picture enhancement choices. Auto picks [DxEnhanceKind.ANIME] for anime and [DxEnhanceKind.SHARPEN] otherwise. */
+enum class DxEnhanceMode(val id: String, val label: String) {
+    OFF("off", "Off"),
+    AUTO("auto", "Auto"),
+    ANIME("anime", "Anime"),
+    SHARPEN("sharpen", "Sharpen");
+
+    companion object {
+        fun fromId(id: String?): DxEnhanceMode = values().firstOrNull { it.id == id } ?: OFF
+    }
+}
+
+/** What the engine actually applies for a title. */
+enum class DxEnhanceKind { NONE, SHARPEN, ANIME }
+
+internal object DxEnhance {
+    private const val PREFS = "nuvio_tv_dx_enhance"
+    private val _mode = MutableStateFlow(DxEnhanceMode.OFF)
+    val mode: StateFlow<DxEnhanceMode> = _mode.asStateFlow()
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private val _anime = MutableStateFlow(false)
+    private val _kind = MutableStateFlow(DxEnhanceKind.NONE)
+    val kind: StateFlow<DxEnhanceKind> = _kind.asStateFlow()
+    private var loaded = false
+    private var appContext: Context? = null
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        val app = context.applicationContext
+        appContext = app
+        val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        _mode.value = DxEnhanceMode.fromId(prefs.getString("mode", null))
+        _enabled.value = prefs.getBoolean("enabled", true)
+        recompute()
+    }
+
+    private fun recompute() {
+        _kind.value = if (!_enabled.value) {
+            DxEnhanceKind.NONE
+        } else when (_mode.value) {
+            DxEnhanceMode.OFF -> DxEnhanceKind.NONE
+            DxEnhanceMode.ANIME -> DxEnhanceKind.ANIME
+            DxEnhanceMode.SHARPEN -> DxEnhanceKind.SHARPEN
+            DxEnhanceMode.AUTO -> if (_anime.value) DxEnhanceKind.ANIME else DxEnhanceKind.SHARPEN
+        }
+    }
+
+    fun currentKind(): DxEnhanceKind = _kind.value
+
+    fun setMode(next: DxEnhanceMode) {
+        _mode.value = next
+        appContext?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()?.putString("mode", next.id)?.apply()
+        recompute()
+    }
+
+    fun setEnabled(on: Boolean) {
+        _enabled.value = on
+        appContext?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()?.putBoolean("enabled", on)?.apply()
+        recompute()
+    }
+
+    /** Auto looks at the content id: kitsu, mal, anilist and anidb ids are anime. */
+    fun setTitle(contentId: String?) {
+        val id = contentId.orEmpty()
+        _anime.value = listOf("kitsu:", "mal:", "anilist:", "anidb:").any { id.startsWith(it, ignoreCase = true) }
+        recompute()
+    }
+
+    /** libmpv `sharpen` value for the current kind (0 when off). */
+    fun mpvSharpen(): Double = when (_kind.value) {
+        DxEnhanceKind.NONE -> 0.0
+        DxEnhanceKind.SHARPEN -> 0.5
+        DxEnhanceKind.ANIME -> 0.8
+    }
+}
+
+/**
+ * dx.bi picture enhancement as one GL pass. Sharpen is an unsharp mask. Anime is a reduced take on Anime4K: it pulls
+ * line pixels toward the darkest neighbour (thinner, darker lines) and adds a stronger sharpen. There is no neural
+ * upscaling, which would be too heavy for TV boxes.
+ */
+internal class DxEnhanceEffect(private val anime: Boolean) : GlEffect {
+    override fun toGlShaderProgram(context: Context, useHdr: Boolean): GlShaderProgram =
+        DxEnhanceProgram(useHdr, anime)
+}
+
+private class DxEnhanceProgram(useHdr: Boolean, private val anime: Boolean) : BaseGlShaderProgram(useHdr, 1) {
+    private val glProgram: GlProgram
+
+    init {
+        try {
+            glProgram = GlProgram(VERTEX_SHADER, FRAGMENT_SHADER)
+            glProgram.setBufferAttribute(
+                "aFramePosition",
+                GlUtil.getNormalizedCoordinateBounds(),
+                GlUtil.HOMOGENEOUS_COORDINATE_VECTOR_SIZE,
+            )
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e)
+        }
+    }
+
+    override fun configure(inputWidth: Int, inputHeight: Int): Size {
+        glProgram.setFloatsUniform("uTexel", floatArrayOf(1f / inputWidth, 1f / inputHeight))
+        return Size(inputWidth, inputHeight)
+    }
+
+    override fun drawFrame(inputTexId: Int, presentationTimeUs: Long) {
+        try {
+            glProgram.use()
+            glProgram.setSamplerTexIdUniform("uTexSampler", inputTexId, 0)
+            glProgram.setFloatUniform("uThin", if (anime) 0.55f else 0f)
+            glProgram.setFloatUniform("uSharpen", if (anime) 0.6f else 0.45f)
+            glProgram.bindAttributesAndUniforms()
+            GLES20.glDrawArrays(GLES20.GL_TRIANGLE_STRIP, 0, 4)
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e, presentationTimeUs)
+        }
+    }
+
+    override fun release() {
+        super.release()
+        try {
+            glProgram.delete()
+        } catch (e: GlUtil.GlException) {
+            throw VideoFrameProcessingException(e)
+        }
+    }
+
+    private companion object {
+        const val VERTEX_SHADER = """
+attribute vec4 aFramePosition;
+varying vec2 vTexSamplingCoord;
+void main() {
+  gl_Position = aFramePosition;
+  vTexSamplingCoord = vec2(aFramePosition.x * 0.5 + 0.5, aFramePosition.y * 0.5 + 0.5);
+}
+"""
+
+        const val FRAGMENT_SHADER = """
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+uniform sampler2D uTexSampler;
+uniform vec2 uTexel;
+uniform float uThin;
+uniform float uSharpen;
+varying vec2 vTexSamplingCoord;
+
+float luma(vec3 c) {
+  return dot(c, vec3(0.299, 0.587, 0.114));
+}
+
+void main() {
+  vec2 uv = vTexSamplingCoord;
+  vec4 src = texture2D(uTexSampler, uv);
+  vec3 col = src.rgb;
+  vec3 n = texture2D(uTexSampler, uv + vec2(0.0, uTexel.y)).rgb;
+  vec3 s = texture2D(uTexSampler, uv - vec2(0.0, uTexel.y)).rgb;
+  vec3 e = texture2D(uTexSampler, uv + vec2(uTexel.x, 0.0)).rgb;
+  vec3 w = texture2D(uTexSampler, uv - vec2(uTexel.x, 0.0)).rgb;
+  if (uThin > 0.0) {
+    vec3 darkest = n;
+    if (luma(s) < luma(darkest)) { darkest = s; }
+    if (luma(e) < luma(darkest)) { darkest = e; }
+    if (luma(w) < luma(darkest)) { darkest = w; }
+    float edge = smoothstep(0.04, 0.25, luma(col) - luma(darkest));
+    col = mix(col, darkest, edge * uThin);
+  }
+  if (uSharpen > 0.0) {
+    vec3 blur = (n + s + e + w) * 0.25;
+    col += (col - blur) * uSharpen;
+  }
+  gl_FragColor = vec4(clamp(col, 0.0, 1.0), src.a);
+}
+"""
+    }
+}
+
+/** Off, Auto, Anime and Sharpen as D-pad cards in the audio overlay's picture block. */
+@Composable
+internal fun DxEnhanceCards(rightFocusRequester: FocusRequester) {
+    DxEnhance.ensureLoaded(LocalContext.current)
+    val enabled by DxEnhance.enabled.collectAsStateWithLifecycle()
+    val mode by DxEnhance.mode.collectAsStateWithLifecycle()
+    if (!enabled) return
+    Column {
+        Text(
+            text = "Enhance",
+            style = MaterialTheme.typography.titleLarge,
+            color = Color.White,
+            modifier = Modifier.padding(top = NuvioTheme.spacing.md, bottom = NuvioTheme.spacing.xs),
+        )
+        DxEnhanceMode.values().forEach { option ->
+            VideoQualityCard(
+                label = if (option == DxEnhanceMode.AUTO) "Auto (Anime for anime, else Sharpen)" else option.label,
+                isSelected = mode == option,
+                onClick = { DxEnhance.setMode(option) },
+                rightFocusRequester = rightFocusRequester,
+            )
+        }
+    }
+}
+
+/** Settings rows in Playback > Picture & Sound. */
+@Composable
+internal fun DxEnhanceSettingsRows() {
+    DxEnhance.ensureLoaded(LocalContext.current)
+    val enabled by DxEnhance.enabled.collectAsStateWithLifecycle()
+    val mode by DxEnhance.mode.collectAsStateWithLifecycle()
+    SettingsToggleRow(
+        title = "Anime and Sharpen enhancement",
+        subtitle = "Adds enhance choices to the player's audio panel. Off removes them and the effect.",
+        checked = enabled,
+        onToggle = { DxEnhance.setEnabled(!enabled) },
+    )
+    SettingsActionRow(
+        title = "Enhance mode",
+        subtitle = "Auto uses Anime for anime and Sharpen for everything else. Press to change.",
+        value = mode.label,
+        enabled = enabled,
+        onClick = {
+            val all = DxEnhanceMode.values()
+            DxEnhance.setMode(all[(mode.ordinal + 1) % all.size])
+        },
+    )
+}
