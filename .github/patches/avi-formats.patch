+    }
+
+    override fun seek(position: Long, timeUs: Long) {
+        audioTracks.forEach { it.reset() }
+        delegate.seek(position, timeUs)
+    }
+
+    override fun release() = delegate.release()
+    override fun getUnderlyingImplementation(): Extractor = delegate
