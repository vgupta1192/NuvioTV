+        }
+
+        private fun tag(data: ByteArray, at: Int) = String(data, at, 4, Charsets.ISO_8859_1)
+    }
+
+    @Throws(IOException::class)
+    private fun peekUpTo(input: ExtractorInput, target: ByteArray): Int {
+        var length = 0
