+/**
+ * dx.bi port: a stream stats overlay that works for both engines (ExoPlayer and libmpv). The player's More row gets a
+ * button that opens it; the Settings switch hides the button. It is separate from the upstream stats HUD.
+ */
+internal object DxStreamStats {
+    private const val PREFS = "nuvio_tv_dx_stats"
+    private val _buttonEnabled = MutableStateFlow(true)
+    val buttonEnabled: StateFlow<Boolean> = _buttonEnabled.asStateFlow()
+    private val _visible = MutableStateFlow(false)
+    val visible: StateFlow<Boolean> = _visible.asStateFlow()
+    private var loaded = false
+    private var appContext: Context? = null
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        val app = context.applicationContext
+        appContext = app
+        _buttonEnabled.value = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean("button", true)
+    }
+
+    fun setButtonEnabled(on: Boolean) {
+        _buttonEnabled.value = on
+        if (!on) _visible.value = false
+        appContext?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()?.putBoolean("button", on)?.apply()
+    }
+
+    fun toggle() {
+        _visible.value = !_visible.value
+    }
+
+    fun formatRate(bytesPerSecond: Double): String = when {
+        bytesPerSecond >= 1_048_576.0 -> String.format(Locale.US, "%.1f MB/s", bytesPerSecond / 1_048_576.0)
+        bytesPerSecond >= 1024.0 -> String.format(Locale.US, "%.0f KB/s", bytesPerSecond / 1024.0)
+        else -> String.format(Locale.US, "%.0f B/s", bytesPerSecond)
+    }
+
+    fun formatBitrate(bitsPerSecond: Long): String = when {
+        bitsPerSecond >= 1_000_000L -> String.format(Locale.US, "%.1f Mbps", bitsPerSecond / 1_000_000.0)
+        bitsPerSecond > 0L -> String.format(Locale.US, "%d kbps", bitsPerSecond / 1000L)
+        else -> "unknown"
+    }
+}
+
+internal val dxStatsIcon: ImageVector
+    get() = Icons.Default.BarChart
+
+/** Null when the button is switched off in Settings; otherwise the click action for the More row. */
+@Composable
+internal fun dxStatsButtonAction(): (() -> Unit)? {
+    DxStreamStats.ensureLoaded(LocalContext.current)
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    return if (enabled) DxStreamStats::toggle else null
+}
+
+/** Collects the numbers once a second while open and draws them top right. Nothing runs while closed. */
+@androidx.annotation.OptIn(UnstableApi::class)
+@Composable
+internal fun DxStreamStatsOverlay(viewModel: PlayerViewModel) {
+    val context = LocalContext.current
+    DxStreamStats.ensureLoaded(context)
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    val visible by DxStreamStats.visible.collectAsStateWithLifecycle()
+    var rows by remember { mutableStateOf<List<Pair<String, String>>>(emptyList()) }
+    LaunchedEffect(visible, enabled) {
+        if (!visible || !enabled) return@LaunchedEffect
+        var lastBytes = runCatching { TrafficStats.getUidRxBytes(Process.myUid()) }.getOrDefault(-1L)
+        var lastAt = SystemClock.elapsedRealtime()
+        var speed = -1.0
+        while (true) {
+            val now = SystemClock.elapsedRealtime()
+            val bytes = runCatching { TrafficStats.getUidRxBytes(Process.myUid()) }.getOrDefault(-1L)
+            if (bytes >= 0L && lastBytes >= 0L && now > lastAt) {
+                speed = (bytes - lastBytes).coerceAtLeast(0L) * 1000.0 / (now - lastAt)
+            }
+            lastBytes = bytes
+            lastAt = now
+            rows = runCatching { collectRows(context, viewModel, speed) }.getOrDefault(emptyList())
+            delay(1_000L)
+        }
+    }
+    if (!visible || !enabled) return
+    Box(modifier = Modifier.fillMaxSize().padding(end = 48.dp, top = 88.dp), contentAlignment = Alignment.TopEnd) {
+        Column(
+            modifier = Modifier
+                .background(Color.Black.copy(alpha = 0.72f), RoundedCornerShape(10.dp))
+                .padding(horizontal = 16.dp, vertical = 12.dp),
+        ) {
+            Text("Stream stats", color = Color.White, fontSize = 16.sp, modifier = Modifier.padding(bottom = 6.dp))
+            if (rows.isEmpty()) {
+                Text("collecting...", color = Color(0xFFBBBBBB), fontSize = 14.sp)
+            }
+            rows.forEach { (label, value) ->
+                Row(horizontalArrangement = Arrangement.spacedBy(16.dp)) {
+                    Text(label, color = Color(0xFFBBBBBB), fontSize = 14.sp, modifier = Modifier.padding(end = 8.dp))
+                    Text(value, color = Color.White, fontSize = 14.sp, fontFamily = FontFamily.Monospace)
+                }
+            }
+        }
+    }
+}
+
+@androidx.annotation.OptIn(UnstableApi::class)
+private fun collectRows(context: Context, viewModel: PlayerViewModel, downloadBytesPerSecond: Double): List<Pair<String, String>> {
+    val rows = ArrayList<Pair<String, String>>()
+    val download = if (downloadBytesPerSecond >= 0.0) DxStreamStats.formatRate(downloadBytesPerSecond) else "unknown"
+    val exo = viewModel.exoPlayer
+    if (exo != null) {
+        val video = exo.videoFormat
+        if (video != null) {
+            val fps = video.frameRate.takeIf { it > 0f }?.let { String.format(Locale.US, " @ %.2f fps", it) }.orEmpty()
+            rows += "Resolution" to "${video.width}x${video.height}$fps"
+            val codec = video.sampleMimeType?.substringAfter('/')?.uppercase(Locale.US) ?: "video"
+            rows += "Video codec" to listOfNotNull(codec, video.codecs?.takeIf { it.isNotBlank() }).joinToString(" ")
+            val hdr = buildList {
+                if (video.sampleMimeType == MimeTypes.VIDEO_DOLBY_VISION) add("DV")
+                when (video.colorInfo?.colorTransfer) {
+                    C.COLOR_TRANSFER_ST2084 -> add("HDR10")
+                    C.COLOR_TRANSFER_HLG -> add("HLG")
+                }
+            }
+            rows += "HDR" to if (hdr.isEmpty()) "SDR" else hdr.joinToString(" + ")
+            val bitrate = video.averageBitrate.takeIf { it > 0 } ?: video.bitrate
+            rows += "Video bitrate" to DxStreamStats.formatBitrate(bitrate.toLong().coerceAtLeast(0L))
+        } else {
+            rows += "Resolution" to "waiting for video"
+        }
+        exo.audioFormat?.let { audio ->
+            val codec = audio.sampleMimeType?.substringAfter('/')?.uppercase(Locale.US) ?: "audio"
+            val channels = audio.channelCount.takeIf { it > 0 }?.let { " ${it}ch" }.orEmpty()
+            val rate = audio.sampleRate.takeIf { it > 0 }?.let { " ${it / 1000} kHz" }.orEmpty()
+            rows += "Audio" to codec + channels + rate
+        }
+        val bufferedMs = (exo.bufferedPosition - exo.currentPosition).coerceAtLeast(0L)
+        rows += "Buffer" to String.format(Locale.US, "%.1f s", bufferedMs / 1000.0)
+        exo.videoDecoderCounters?.let { counters ->
+            counters.ensureUpdated()
+            val dropped = counters.droppedBufferCount + counters.skippedOutputBufferCount
+            rows += "Dropped frames" to "$dropped of ${counters.renderedOutputBufferCount + dropped}"
+        }
+        val estimate = runCatching { DefaultBandwidthMeter.getSingletonInstance(context).bitrateEstimate }
+            .getOrDefault(C.LENGTH_UNSET.toLong())
+        val estimateText = if (estimate > 0L) " (est. ${DxStreamStats.formatBitrate(estimate)})" else ""
+        rows += "Download" to download + estimateText
+        return rows
+    }
+    val mpv = viewModel.controller.mpvView ?: return rows
+    fun p(name: String): String? = mpv.dxProperty(name)
+    val width = p("video-params/w")?.toIntOrNull()
+    val height = p("video-params/h")?.toIntOrNull()
+    val fps = p("estimated-vf-fps")?.toDoubleOrNull() ?: p("container-fps")?.toDoubleOrNull()
+    rows += "Resolution" to if (width != null && height != null) {
+        "${width}x$height" + (fps?.let { String.format(Locale.US, " @ %.2f fps", it) } ?: "")
+    } else {
+        "waiting for video"
+    }
+    p("current-tracks/video/codec")?.let { codec ->
+        val decoder = p("hwdec-current")?.takeIf { it.isNotBlank() && it != "no" }
+        rows += "Video codec" to codec.uppercase(Locale.US) + (decoder?.let { " ($it)" } ?: " (software)")
+    }
+    val hdr = buildList {
+        if (!p("current-tracks/video/dolby-vision-profile").isNullOrBlank()) add("DV")
+        when (p("video-params/gamma")) {
+            "pq" -> add("HDR10")
+            "hlg" -> add("HLG")
+        }
+    }
+    rows += "HDR" to if (hdr.isEmpty()) "SDR" else hdr.joinToString(" + ")
+    p("video-bitrate")?.toDoubleOrNull()?.let { rows += "Video bitrate" to DxStreamStats.formatBitrate(it.toLong()) }
+    p("current-tracks/audio/codec")?.let { codec ->
+        val channels = p("audio-params/channel-count")?.toIntOrNull()?.let { " ${it}ch" }.orEmpty()
+        rows += "Audio" to codec.uppercase(Locale.US) + channels
+    }
+    p("demuxer-cache-duration")?.toDoubleOrNull()?.let { rows += "Buffer" to String.format(Locale.US, "%.1f s", it) }
+    val dropped = (p("frame-drop-count")?.toLongOrNull() ?: 0L) + (p("decoder-frame-drop-count")?.toLongOrNull() ?: 0L)
+    rows += "Dropped frames" to dropped.toString()
+    rows += "Download" to download
+    return rows
+}
+
+/** Settings row in Playback > Player. */
+@Composable
+internal fun DxStreamStatsSettingsRows() {
+    DxStreamStats.ensureLoaded(LocalContext.current)
+    val enabled by DxStreamStats.buttonEnabled.collectAsStateWithLifecycle()
+    SettingsToggleRow(
+        title = "Stream stats button",
+        subtitle = "Adds a stats button to the player's More row. It shows resolution, codecs, HDR, bitrate, buffer, dropped frames and download speed for both players.",
+        checked = enabled,
+        onToggle = { DxStreamStats.setButtonEnabled(!enabled) },
+    )
+}
