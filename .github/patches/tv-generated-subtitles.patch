@@ -0,0 +1,168 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.util.Log
+import android.widget.Toast
+import androidx.media3.common.C
+import androidx.media3.extractor.text.CuesWithTiming
+import com.nuvio.tv.domain.model.Subtitle
+import com.nuvio.tv.ui.screens.player.generated.GeneratedSubtitleSession
+import java.util.WeakHashMap
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+/*
+ * Nuvio fork: generated subtitles in the TV player. The session (ported from Nuvio Mobile) reads
+ * the stream's audio ahead of the playhead and pushes English cues into ExoPlayer's sidecar
+ * subtitle; this file connects it to the player controller. libmpv has no sidecar, so generated
+ * subtitles need the ExoPlayer engine.
+ */
+
+/** The sidecar operations the generated-subtitle session needs, as on Mobile. */
+internal interface SidecarSubtitleController {
+    fun startSidecarAddonSubtitle(url: String, rawBodyLoader: (suspend () -> String)?): Boolean
+    fun currentGenerationFor(url: String): Long?
+    val sidecarTimedCues: List<CuesWithTiming>
+    fun commitPreparedSidecarSubtitle(
+        expectedCurrentUrl: String,
+        newUrl: String,
+        cues: List<CuesWithTiming>,
+        expectedGeneration: Long?,
+    ): Boolean
+}
+
+private class ControllerSidecar(private val controller: PlayerRuntimeController) : SidecarSubtitleController {
+    override fun startSidecarAddonSubtitle(url: String, rawBodyLoader: (suspend () -> String)?): Boolean {
+        val subtitle = GeneratedSubtitles.entries().firstOrNull { it.url == url }
+            ?: Subtitle(id = url, url = url, lang = "en", addonName = "Nuvio", addonLogo = null)
+        return controller.startSidecarAddonSubtitle(subtitle, rawBodyLoader)
+    }
+
+    override fun currentGenerationFor(url: String): Long? = controller.currentSidecarGenerationFor(url)
+
+    override val sidecarTimedCues: List<CuesWithTiming> get() = controller.sidecarTimedCues
+
+    override fun commitPreparedSidecarSubtitle(
+        expectedCurrentUrl: String,
+        newUrl: String,
+        cues: List<CuesWithTiming>,
+        expectedGeneration: Long?,
+    ): Boolean = controller.commitPreparedSidecarSubtitle(expectedCurrentUrl, newUrl, cues, expectedGeneration)
+}
+
+private val generatedSessions = WeakHashMap<PlayerRuntimeController, GeneratedSubtitleSession>()
+
+/** The playing title/episode, in the same form as Nuvio Mobile's video id (cache key part). */
+private fun PlayerRuntimeController.generatedContentId(): String? =
+    currentVideoId?.takeIf { it.isNotBlank() } ?: contentId?.let { id ->
+        val season = currentSeason
+        val episode = currentEpisode
+        if (season != null && episode != null) "$id:$season:$episode" else id
+    }
+
+/**
+ * Handles picking a generated subtitle entry; false for any other subtitle. On libmpv it only
+ * explains that the ExoPlayer engine is needed.
+ */
+internal fun PlayerRuntimeController.selectGeneratedSubtitleIfNeeded(subtitle: Subtitle): Boolean {
+    if (!GeneratedSubtitles.isGenerated(subtitle.url)) return false
+    GeneratedSubtitles.ensureLoaded(context)
+    if (isUsingMpvEngine()) {
+        Toast.makeText(
+            context,
+            "Generated subtitles need the ExoPlayer engine (Settings › Playback › Player engine)",
+            Toast.LENGTH_LONG,
+        ).show()
+        return true
+    }
+    val player = _exoPlayer ?: return true
+    generatedSessions.remove(this)?.stop()
+    cancelAutomaticSubtitleSync() // AutoSync has nothing to check: the lines come from the audio
+    disableSubtitles()
+    pendingAddonSubtitleLanguage = null
+    pendingAddonSubtitleTrackId = null
+    pendingAudioSelectionAfterSubtitleRefresh = null
+    _uiState.update { it.copy(selectedAddonSubtitle = subtitle, selectedSubtitleTrackIndex = -1) }
+    GeneratedSubtitles.contentId = generatedContentId()
+    GeneratedSubtitleSync.initialize(context)
+    val session = GeneratedSubtitleSession(
+        context = context,
+        scope = scope,
+        player = player,
+        sidecar = ControllerSidecar(this),
+        sourceUrl = currentStreamUrl,
+        sourceAudioUrl = null,
+        dataSourceFactory = PlayerPlaybackNetworking.createDataSourceFactory(context, currentHeaders),
+    )
+    if (session.start(subtitle.url)) {
+        generatedSessions[this] = session
+    } else {
+        Log.w(PlayerRuntimeController.TAG, "generated subtitles: could not attach the sidecar subtitle")
+    }
+    return true
+}
+
+/** Stops generating when the player is released. */
+internal fun PlayerRuntimeController.stopGeneratedSubtitles() {
+    generatedSessions.remove(this)?.stop()
+}
+
+/** Adds the generated entries to the subtitle list shown in the player. */
+internal fun withGeneratedSubtitleEntries(subtitles: List<Subtitle>): List<Subtitle> =
+    GeneratedSubtitles.withEntry(subtitles)
+
+/**
+ * Picks the generated subtitle by itself when the user chose so in Settings: "always" once the
+ * addon subtitles have loaded, "when none found" only when no subtitle in a preferred language
+ * exists and nothing is shown. Once per stream; the user's own choice always wins.
+ */
+internal fun PlayerRuntimeController.startGeneratedSubtitleAutoPick(viewModelScope: CoroutineScope) {
+    GeneratedSubtitles.ensureLoaded(context)
+    viewModelScope.launch {
+        var handledStream: String? = null
+        while (true) {
+            delay(AUTO_PICK_POLL_MS)
+            val stream = currentStreamUrl
+            if (stream.isBlank() || stream == handledStream) continue
+            val mode = GeneratedSubtitles.mode.value
+            if (mode == GeneratedSubtitles.MODE_OFF) continue
+            val state = _uiState.value
+            if (state.isLoadingAddonSubtitles || _exoPlayer == null || isUsingMpvEngine()) continue
+            val duration = _exoPlayer?.duration ?: C.TIME_UNSET
+            if (duration == C.TIME_UNSET || duration <= 0L) continue
+            val entry = GeneratedSubtitles.entries().firstOrNull() ?: continue
+            if (GeneratedSubtitles.isGenerated(state.selectedAddonSubtitle?.url)) {
+                handledStream = stream
+                continue
+            }
+            if (isUserExplicitSubtitleSelection || subtitleDisabledByPersistedPreference) {
+                handledStream = stream
+                continue
+            }
+            val pick = when (mode) {
+                GeneratedSubtitles.MODE_ALWAYS -> true
+                else -> {
+                    // Give Nuvio's own pick a moment, then only fill the gap.
+                    delay(AUTO_PICK_SETTLE_MS)
+                    val now = _uiState.value
+                    val nothingShown = now.selectedAddonSubtitle == null && now.selectedSubtitleTrackIndex < 0
+                    val targets = subtitleLanguageTargets()
+                    val hasPreferred = targets.isNotEmpty() && (
+                        now.addonSubtitles.any { s -> targets.any { PlayerSubtitleUtils.matchesLanguageCode(s.lang, it) } } ||
+                            now.subtitleTracks.any { t -> targets.any { PlayerSubtitleUtils.matchesLanguageCode(t.language, it) } }
+                        )
+                    nothingShown && !hasPreferred
+                }
+            }
+            handledStream = stream
+            if (pick && currentStreamUrl == stream) {
+                Log.i(PlayerRuntimeController.TAG, "generated subtitles: picked automatically (mode=$mode)")
+                selectGeneratedSubtitleIfNeeded(entry)
+            }
+        }
+    }
+}
+
+private const val AUTO_PICK_POLL_MS = 1_000L
+private const val AUTO_PICK_SETTLE_MS = 4_000L
