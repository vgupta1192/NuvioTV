+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import io.github.jan.supabase.postgrest.Postgrest
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * Generated subtitles saved to the user's Nuvio account (table generated_subtitles on the
+ * self-hosted backend, one row per title key), shared with Nuvio Mobile: same RPCs, same keys,
+ * same JSON payload. Failures (signed out, offline) return null / false; the local copy still works.
+ */
+object GeneratedSubtitleSync {
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface GeneratedSubtitleSyncEntryPoint {
+        fun postgrest(): Postgrest
+    }
+
+    @Volatile
+    private var appContext: Context? = null
+
+    fun initialize(context: Context) {
+        appContext = context.applicationContext
+    }
+
+    internal fun postgrest(): Postgrest? = appContext?.let { context ->
+        runCatching {
+            EntryPointAccessors.fromApplication(context, GeneratedSubtitleSyncEntryPoint::class.java).postgrest()
+        }.getOrNull()
+    }
+
+    suspend fun pull(key: String): String? = runCatching {
+        val result = postgrest()?.rpc(
+            "generated_subtitles_pull",
+            buildJsonObject { put("p_key", key) },
+        ) ?: return null
+        result.data.trim().takeUnless { it.isEmpty() || it == "null" }
+    }.getOrNull()
+
+    suspend fun push(key: String, contentId: String?, payload: String): Boolean = runCatching {
+        val postgrest = postgrest() ?: return false
+        postgrest.rpc(
+            "generated_subtitles_push",
+            buildJsonObject {
+                put("p_key", key)
+                put("p_content_id", contentId)
+                put("p_payload", Json.parseToJsonElement(payload))
+            },
+        )
+        true
+    }.getOrDefault(false)
+}
diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/player/GeneratedSubtitles.kt b/app/src/main/java/com/nuvio/tv/ui/screens/player/GeneratedSubtitles.kt
