+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import com.nuvio.tv.domain.model.Subtitle
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * English subtitles generated from the audio (Nuvio fork, ported from Nuvio Mobile). Offered as
+ * extra entries in the subtitle list: "Generated online" (Groq Whisper large-v3, with the user's
+ * Groq key) and, when the user turns on on-device models, "Generated from the audio (on this TV)"
+ * (SenseVoice or Whisper small; Whisper medium is too slow for TVs and is never used here).
+ *
+ * Lines are cached per title and shared through the Nuvio account with the same keys as Mobile,
+ * so subtitles generated on the phone show up here and the other way round.
+ */
+object GeneratedSubtitles {
+    /** Pseudo address of the generated subtitle; the ".srt" ending lets it use the sidecar path. */
+    const val URL = "nuvio-generated://subtitles/english.srt"
+    /** The online variant: Whisper large-v3 on Groq (the user's key). */
+    const val ONLINE_URL = "nuvio-generated://groq/english.srt"
+    private const val SCHEME = "nuvio-generated://"
+
+    /** Spoken languages the recogniser can be told to expect; [AUTO] follows the audio track's tag. */
+    const val AUTO = "auto"
+    val spokenLanguages: List<Pair<String, String>> = listOf(
+        AUTO to "Auto (audio track tag, else detected)",
+        "zh" to "Chinese",
+        "yue" to "Cantonese",
+        "ja" to "Japanese",
+        "ko" to "Korean",
+        "en" to "English",
+        "hi" to "Hindi",
+        "ur" to "Urdu",
+        "bn" to "Bengali",
+        "ta" to "Tamil",
+        "te" to "Telugu",
+        "ml" to "Malayalam",
+        "kn" to "Kannada",
+        "mr" to "Marathi",
+        "gu" to "Gujarati",
+        "pa" to "Punjabi",
+        "th" to "Thai",
+        "id" to "Indonesian",
+        "ms" to "Malay",
+        "tl" to "Filipino (Tagalog)",
+        "vi" to "Vietnamese",
+        "tr" to "Turkish",
+        "ar" to "Arabic",
+        "fa" to "Persian",
+        "ru" to "Russian",
+        "uk" to "Ukrainian",
+        "pl" to "Polish",
+        "es" to "Spanish",
+        "pt" to "Portuguese",
+        "fr" to "French",
+        "de" to "German",
+        "it" to "Italian",
+        "nl" to "Dutch",
+        "sv" to "Swedish",
+        "el" to "Greek",
+        "he" to "Hebrew",
+    )
+
+    /** When Nuvio picks the generated subtitle by itself. */
+    const val MODE_OFF = "off"
+    const val MODE_MISSING = "missing"
+    const val MODE_ALWAYS = "always"
+    val modes: List<Pair<String, String>> = listOf(
+        MODE_OFF to "Never (pick it by hand from the subtitle list)",
+        MODE_MISSING to "When no subtitle in your language is found",
+        MODE_ALWAYS to "Always, even when subtitles exist",
+    )
+
+    /** The playing title/episode (e.g. "tt2907640:1:3"); generated lines are saved per title. */
+    @Volatile
+    var contentId: String? = null
+
+    /** Generation runs on ExoPlayer's sidecar subtitles; always true on Android TV. */
+    var supported: Boolean = true
+
+    /** Model download/delete, registered by the models code. */
+    var modelActions: GeneratedSubtitleModelActions? = null
+
+    private val _mode = MutableStateFlow(MODE_OFF)
+    val mode: StateFlow<String> = _mode.asStateFlow()
+
+    private val _spokenLanguage = MutableStateFlow(AUTO)
+    val spokenLanguage: StateFlow<String> = _spokenLanguage.asStateFlow()
+
+    private val _onDevice = MutableStateFlow(false)
+    /** TV: the on-device entry (SenseVoice / Whisper small downloads) is opt-in. */
+    val onDevice: StateFlow<Boolean> = _onDevice.asStateFlow()
+
+    fun setOnDevice(value: Boolean) {
+        _onDevice.value = value
+        save(KEY_ON_DEVICE, value.toString())
+    }
+
+    private val _fastAsianModel = MutableStateFlow(false)
+    /** Faster models (SenseVoice / Dolphin + ML Kit) instead of Whisper; lower quality. */
+    val fastAsianModel: StateFlow<Boolean> = _fastAsianModel.asStateFlow()
+
+    fun setFastAsianModel(value: Boolean) {
+        _fastAsianModel.value = value
+        save(KEY_FAST_ASIAN, value.toString())
+    }
+
+    /** Whisper medium is never used on TV: too slow for TV chips. Kept for the shared session code. */
+    val highQuality: StateFlow<Boolean> = MutableStateFlow(false).asStateFlow()
+
+    private val _groqKey = MutableStateFlow("")
+    /** The user's Groq API key; when set, the subtitle list offers the online generated subtitle. */
+    val groqKey: StateFlow<String> = _groqKey.asStateFlow()
+
+    fun setGroqKey(value: String) {
+        _groqKey.value = value.trim()
+        save(KEY_GROQ, value.trim())
+    }
+
+    private val _deeplKey = MutableStateFlow("")
+    /** The user's DeepL API key; when set, speech is written down in its language and DeepL translates. */
+    val deeplKey: StateFlow<String> = _deeplKey.asStateFlow()
+
+    fun setDeeplKey(value: String) {
+        _deeplKey.value = value.trim()
+        save(KEY_DEEPL, value.trim())
+    }
+
+    private val _models = MutableStateFlow("")
+    /** One-line summary of the downloaded models, for Settings. */
+    val models: StateFlow<String> = _models.asStateFlow()
+
+    @Volatile
+    private var appContext: Context? = null
+
+    /** Loads the settings once; call before reading them. */
+    fun ensureLoaded(context: Context) {
+        if (appContext != null) return
+        synchronized(this) {
+            if (appContext != null) return
+            val prefs = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            _mode.value = prefs.getString(KEY_MODE, null)?.takeIf { code -> modes.any { it.first == code } } ?: MODE_OFF
+            _onDevice.value = prefs.getBoolean(KEY_ON_DEVICE, false)
+            _fastAsianModel.value = prefs.getString(KEY_FAST_ASIAN, null) == "true"
+            _deeplKey.value = prefs.getString(KEY_DEEPL, null).orEmpty()
+            _groqKey.value = prefs.getString(KEY_GROQ, null).orEmpty()
+            _spokenLanguage.value = prefs.getString(KEY_LANGUAGE, null)
+                ?.takeIf { code -> spokenLanguages.any { it.first == code } } ?: AUTO
+            appContext = context.applicationContext
+        }
+        com.nuvio.tv.ui.screens.player.generated.GeneratedSpeechModel.initialize(context.applicationContext)
+    }
+
+    private fun save(key: String, value: String) {
+        val context = appContext ?: return
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit()
+        if (key == KEY_ON_DEVICE) prefs.putBoolean(key, value == "true") else prefs.putString(key, value)
+        prefs.apply()
+    }
+
+    fun cycleMode() {
+        val index = modes.indexOfFirst { it.first == _mode.value }
+        _mode.value = modes[(index + 1) % modes.size].first
+        save(KEY_MODE, _mode.value)
+    }
+
+    fun modeLabel(code: String = _mode.value): String = modes.firstOrNull { it.first == code }?.second ?: code
+
+    fun setSpokenLanguage(code: String) {
+        _spokenLanguage.value = code
+        save(KEY_LANGUAGE, code)
+    }
+
+    fun spokenLanguageLabel(code: String = _spokenLanguage.value): String =
+        spokenLanguages.firstOrNull { it.first == code }?.second ?: code
+
+    fun publishModels(summary: String) {
+        _models.value = summary
+    }
+
+    fun isGenerated(url: String?): Boolean = url?.startsWith(SCHEME) == true
+
+    val entry: Subtitle
+        get() = Subtitle(
+            id = "nuvio-generated-english",
+            url = URL,
+            lang = "en",
+            addonName = "Generated from the audio (on this TV)",
+            addonLogo = null,
+        )
+
+    val onlineEntry: Subtitle
+        get() = Subtitle(
+            id = "nuvio-generated-english-online",
+            url = ONLINE_URL,
+            lang = "en",
+            addonName = "Generated online (Groq Whisper large-v3)",
+            addonLogo = null,
+        )
+
+    /** The generated entries offered right now: online first (needs a Groq key), then on-device. */
+    fun entries(): List<Subtitle> = buildList {
+        if (!supported) return@buildList
+        if (_groqKey.value.isNotBlank()) add(onlineEntry)
+        if (_onDevice.value) add(entry)
+    }
+
+    /** [subtitles] plus the generated entries, last so a real subtitle always comes first. */
+    fun withEntry(subtitles: List<Subtitle>): List<Subtitle> {
+        val extra = entries()
+        if (extra.isEmpty()) return subtitles
+        return subtitles.filterNot { isGenerated(it.url) } + extra
+    }
+
+    private const val PREFS = "nuvio_generated_subtitles"
+    private const val KEY_MODE = "auto_mode"
+    private const val KEY_LANGUAGE = "spoken_language"
+    private const val KEY_ON_DEVICE = "on_device"
+    private const val KEY_FAST_ASIAN = "fast_asian_model"
+    private const val KEY_DEEPL = "deepl_key"
+    private const val KEY_GROQ = "groq_key"
+}
+
+interface GeneratedSubtitleModelActions {
+    fun deleteModels()
+}
diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/player/GeneratedSubtitlesPlayerHooks.kt b/app/src/main/java/com/nuvio/tv/ui/screens/player/GeneratedSubtitlesPlayerHooks.kt
