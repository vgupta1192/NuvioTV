+/**
+ * Generates English subtitles for the playing stream from its audio, ahead of the playhead:
+ * the stream's audio is read [LOOKAHEAD_MS] ahead over its own connection (single files and HLS
+ * playlists), cut into spoken lines by Silero VAD, recognised on the device (SenseVoice for
+ * Chinese/Cantonese/Japanese/Korean/English, Whisper small for Hindi, which translates by itself)
+ * and translated to English with ML Kit. Cues are pushed into the attached sidecar subtitle as
+ * they are ready; status lines ("Downloading speech model…") show in the subtitle itself.
+ */
+internal class GeneratedSubtitleSession(
+    context: Context,
+    private val scope: CoroutineScope,
+    private val player: ExoPlayer,
+    private val sidecar: SidecarSubtitleController,
+    sourceUrl: String,
+    sourceAudioUrl: String?,
+    private val dataSourceFactory: DataSource.Factory,
+) {
+    private val appContext = context.applicationContext
+    private val audioUrl = sourceAudioUrl?.takeIf { it.isNotBlank() } ?: sourceUrl
+    private val uri: Uri? = runCatching { Uri.parse(audioUrl) }.getOrNull()
+        ?.takeIf { it.scheme == "http" || it.scheme == "https" || it.scheme == "file" }
+
+    private class Run(val url: String) {
+        @Volatile
+        var stopped = false
+
+        @Volatile
+        var generation = 0L
+        var ticker: Job? = null
+        var worker: Thread? = null
+
+        // Written by the main-thread ticker, read by the worker.
+        @Volatile
+        var positionMs = 0L
+
+        @Volatile
+        var durationMs = 0L
+
+        @Volatile
+        var audioFormat: Format? = null
+
+        /** Shown at the playhead while no generated line covers it. */
+        @Volatile
+        var status: String? = "Generating subtitles from the audio…"
+
+        val cues = ArrayList<CuesWithTiming>()
+
+        @Volatile
+        var cuesVersion = 0
+    }
+
+    @Volatile
+    private var active: Run? = null
+
+    /** Attaches the generated subtitle [url] and starts generating; false if it can't be shown. */
+    fun start(url: String): Boolean {
+        stop()
+        if (uri == null) {
+            SyncLog.w("generated subtitles: stream address not supported")
+        }
+        val attached = sidecar.startSidecarAddonSubtitle(url = url, rawBodyLoader = { PLACEHOLDER_SRT })
+        if (!attached) return false
+        val current = Run(url)
+        current.generation = sidecar.currentGenerationFor(url) ?: return false
+        active = current
+        running = true
+        SyncLog.i("generated subtitles: started")
+        current.ticker = scope.launch { tick(current) }
+        current.worker = Thread({ work(current) }, "NuvioGeneratedSubs").apply {
+            isDaemon = true
+            start()
+        }
+        return true
+    }
+
+    fun stop() {
+        val current = active ?: return
+        active = null
+        running = false
+        current.stopped = true
+        current.ticker?.cancel()
+        current.worker?.interrupt()
+        SyncLog.i("generated subtitles: stopped")
+    }
+
+    /** Main thread: follows the player, notices when the subtitle is replaced, pushes cues. */
+    private suspend fun tick(current: Run) {
+        // The placeholder is parsed asynchronously; committing before that would be overwritten.
+        while (scope.isActive && !current.stopped && sidecar.sidecarTimedCues.isEmpty()) {
+            if (sidecar.currentGenerationFor(current.url) != current.generation) break
+            delay(TICK_MS)
+        }
+        var committedVersion = -1
+        var committedStatus: String? = null
+        var statusAtMs = Long.MIN_VALUE
+        while (scope.isActive && !current.stopped) {
+            if (sidecar.currentGenerationFor(current.url) != current.generation) {
+                if (active === current) stop()
+                return
+            }
+            current.positionMs = player.currentPosition.coerceAtLeast(0L)
+            current.durationMs = player.duration.takeIf { it != C.TIME_UNSET && it > 0 } ?: 0L
+            current.audioFormat = player.currentTracks.selectedAudioFormat()
+            val status = current.status?.takeIf { !hasCueNear(current, current.positionMs) }
+            val statusMoved = status != null && kotlin.math.abs(current.positionMs - statusAtMs) > 1_000L
+            if (current.cuesVersion != committedVersion || status != committedStatus || statusMoved) {
+                val list = synchronized(current.cues) { ArrayList(current.cues) }
+                if (status != null) {
+                    statusAtMs = current.positionMs
+                    list += cue((statusAtMs - 200L).coerceAtLeast(0L), statusAtMs + STATUS_SHOW_MS, status)
+                    list.sortBy { it.startTimeUs }
+                }
+                if (list.isNotEmpty()) {
+                    sidecar.commitPreparedSidecarSubtitle(
+                        expectedCurrentUrl = current.url,
+                        newUrl = current.url,
+                        cues = list,
+                        expectedGeneration = current.generation,
+                    )
+                }
+                committedVersion = current.cuesVersion
+                committedStatus = status
+            }
+            delay(TICK_MS)
+        }
+    }
+
+    private fun hasCueNear(current: Run, positionMs: Long): Boolean = synchronized(current.cues) {
+        val fromUs = (positionMs - 1_500L) * 1_000L
+        val toUs = (positionMs + 4_000L) * 1_000L
+        current.cues.any { it.startTimeUs < toUs && it.startTimeUs + it.durationUs > fromUs }
+    }
+
+    // ---- worker thread ----
+
+    private fun work(current: Run) {
+        Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
+        var recognizer: GeneratedRecognizer? = null
+        val translator = GeneratedTranslator()
+        try {
+            val source = uri ?: run {
+                current.status = "Subtitles can't be generated for this stream"
+                return
+            }
+            val language = spokenLanguage(current)
+            // Lines made earlier for this title and stream come back at once; only the rest is
+            // generated (and, online, paid for).
+            repeat(40) {
+                if (current.durationMs > 0 || current.stopped) return@repeat
+                Thread.sleep(250L)
+            }
+            val covered = ArrayList<LongArray>()
+            val cache = cacheKey(current, language, online = current.url == GeneratedSubtitles.ONLINE_URL)
+            cache?.let { loadCache(it, current, covered, otherKey = cacheKey(current, language, online = current.url != GeneratedSubtitles.ONLINE_URL)) }
+            // Whisper translates from the audio itself, which reads far better than recognising
+            // first and translating text; the faster models are opt-in. English needs no translation.
+            val fast = GeneratedSubtitles.fastAsianModel.value
+            val whisperModel = if (GeneratedSubtitles.highQuality.value) {
+                GeneratedSpeechModel.WHISPER_MEDIUM
+            } else {
+                GeneratedSpeechModel.WHISPER_SMALL
+            }
+            val model = when {
+                language == "en" -> GeneratedSpeechModel.SENSE_VOICE
+                fast && language in SENSE_VOICE_LANGUAGES -> GeneratedSpeechModel.SENSE_VOICE
+                fast && language in DOLPHIN_LANGUAGES -> GeneratedSpeechModel.DOLPHIN
+                else -> whisperModel
+            }
+            // With a DeepL key, Whisper writes the spoken language down and DeepL translates whole
+            // lines with context; without one (or if DeepL stops working) Whisper translates itself.
+            // The online entry: Whisper large-v3 on Groq hears the speech instead of a model here.
+            val groq = GeneratedSubtitles.groqKey.value.trim()
+                .takeIf { it.isNotEmpty() && current.url == GeneratedSubtitles.ONLINE_URL }
+                ?.let(::GroqWhisperClient)
+            var deepl: DeepLTranslator? = GeneratedSubtitles.deeplKey.value.trim().takeIf { it.isNotEmpty() }
+                ?.takeIf { groq != null || model == whisperModel }
+                ?.let(::DeepLTranslator)
+            SyncLog.i(
+                "generated subtitles: spoken language=$language model=" +
+                    (if (groq != null) "Groq Whisper large-v3" else model.label) +
+                    if (deepl != null) " translation=DeepL" else "",
+            )
+            lateinit var asr: GeneratedRecognizer
+            if (groq == null) {
+                asr = prepareRecognizer(current, model, language, translate = deepl == null) ?: return
+                recognizer = asr
+            }
+            deeplContext = ""
+            val weights = appContext.resources.openRawResource(R.raw.silero_vad_v5_16k).use { SileroVadWeights.read(it) }
+            // Playlists and manifests also hide behind other addresses: the first bytes tell.
+            val kind = HlsAudioSpotSampler.manifestKind(source, dataSourceFactory)
+            SyncLog.i("generated subtitles: reading the stream as ${kind?.uppercase()?.plus(" manifest") ?: "a single file"}")
+            val hlsSampler = kind?.let {
+                HlsAudioSpotSampler(
+                    source,
+                    dataSourceFactory,
+                    MAX_WINDOW_BYTES,
+                    dash = it == HlsAudioSpotSampler.KIND_DASH,
+                    preferredLanguage = current.audioFormat?.language,
+                )
+            }
+            current.status = "Generating subtitles from the audio…"
+            var switchedToWhisper = false
+            var deeplFailures = 0
+            var failures = 0
+            while (!current.stopped) {
+                val positionMs = current.positionMs
+                val fromMs = nextUncovered(covered, positionMs)
+                val durationMs = current.durationMs
+                if (fromMs >= positionMs + LOOKAHEAD_MS || (durationMs > 0 && fromMs >= durationMs)) {
+                    Thread.sleep(500L)
+                    continue
+                }
+                // A short first window gets lines on screen quickly; later ones are longer.
+                val windowMs = if (fromMs - positionMs < FIRST_WINDOW_MS) FIRST_WINDOW_MS else WINDOW_MS
+                val toMs = if (durationMs > 0) minOf(fromMs + windowMs, durationMs) else fromMs + windowMs
+                if (!hasCueNear(current, positionMs) && fromMs <= positionMs + 2_000L) {
+                    current.status = "Generating subtitles from the audio…"
+                }
+                val startedAt = System.currentTimeMillis()
+                cancelledWindow = false
+                val segments = readWindow(current, source, hlsSampler, weights, fromMs, toMs)
+                if (current.stopped) return
+                if (cancelledWindow) continue
+                if (segments == null) {
+                    failures++
+                    if (failures >= MAX_FAILURES) {
+                        current.status = "Couldn't read this stream's audio for generated subtitles"
+                        return
+                    }
+                    Thread.sleep(2_000L)
+                    continue
+                }
+                failures = 0
+                addCovered(covered, fromMs, toMs)
+                var lines = 0
+                // Whole sentences recognise and translate better than the pieces between short pauses.
+                val sentences = mergeSentences(segments)
+                // Lines written in the spoken language, translated together by DeepL below.
+                val forDeepL = ArrayList<Triple<Long, Long, String>>()
+                var deeplSource: String? = null
+                if (groq != null) {
+                    val added = try {
+                        generateOnline(current, groq, deepl.takeUnless { onlineDeeplOff }, sentences, language)
+                    } catch (failure: GroqWhisperClient.Failure) {
+                        current.status = if (failure.permanent) {
+                            "${failure.message}: check the Groq key in Settings"
+                        } else {
+                            "${failure.message}, retrying…"
+                        }
+                        if (failure.permanent) return
+                        removeCovered(covered, fromMs, toMs)
+                        Thread.sleep(maxOf(failure.retryAfterMs, 5_000L))
+                        continue
+                    }
+                    lines += added
+                }
+                for ((startMs, samples) in if (groq != null) emptyList() else sentences) {
+                    if (current.stopped) return
+                    // Whisper invents words for very short sounds; such bits rarely carry a line.
+                    if (asr.whisper && samples.size < MIN_WHISPER_SAMPLES) continue
+                    val heard = asr.recognize(samples)
+                    val text = cleanText(heard.text) ?: continue
+                    if (asr.whisper && isWhisperFiller(text)) continue
+                    if (deepl != null && !asr.translatesToEnglish) {
+                        val endMs = startMs + samples.size * 1_000L / SileroVad.SAMPLE_RATE
+                        forDeepL += Triple(startMs, endMs, text)
+                        if (deeplSource == null) deeplSource = DeepLTranslator.sourceCode(heard.language.ifEmpty { language })
+                        continue
+                    }
+                    val english = if (asr.translatesToEnglish || heard.language == "en") {
+                        text
+                    } else {
+                        // The script tells the written language apart (Hindi vs Urdu, etc.).
+                        val from = languageOfScript(text, heard.language.ifEmpty { language })
+                        translator.translate(text, from) { message -> current.status = message } ?: run {
+                            // No translation here at all: Whisper translates by itself.
+                            if (translator.unavailable(from) && !switchedToWhisper) {
+                                switchedToWhisper = true
+                                SyncLog.w("generated subtitles: no translation for $from, switching to Whisper")
+                                current.status = "Translation unavailable, switching to Whisper…"
+                                asr.close()
+                                recognizer = null
+                                asr = prepareRecognizer(current, whisperModel, from, translate = true) ?: return
+                                recognizer = asr
+                            }
+                            null
+                        } ?: continue
+                    }
+                    // Untranslated or garbled output is not English: leave the line out.
+                    if (!looksEnglish(english)) {
+                        SyncLog.d("generated subtitles: dropped a line that is not English after translation")
+                        continue
+                    }
+                    val endMs = startMs + samples.size * 1_000L / SileroVad.SAMPLE_RATE
+                    addLine(current, startMs, endMs, english)
+                    lines++
+                }
+                val deeplNow = deepl
+                if (forDeepL.isNotEmpty() && deeplNow != null) {
+                    try {
+                        val english = deeplNow.translate(forDeepL.map { it.third }, deeplSource, deeplContext)
+                        forDeepL.zip(english).forEach { (line, text) ->
+                            if (text.isNotEmpty() && looksEnglish(text) && !isWhisperFiller(text)) {
+                                addLine(current, line.first, line.second, text)
+                                lines++
+                            }
+                        }
+                        deeplContext = forDeepL.takeLast(DEEPL_CONTEXT_LINES).joinToString("\n") { it.third }
+                        deeplFailures = 0
+                    } catch (failure: DeepLTranslator.Failure) {
+                        if (failure.permanent || ++deeplFailures >= MAX_FAILURES) {
+                            // Whisper translates by itself from here on; this stretch is read again.
+                            current.status = "${failure.message}: Whisper translates instead"
+                            deepl = null
+                            asr.close()
+                            recognizer = null
+                            asr = prepareRecognizer(current, whisperModel, language, translate = true) ?: return
+                            recognizer = asr
+                        }
+                        removeCovered(covered, fromMs, toMs)
+                        if (deepl != null) Thread.sleep(3_000L)
+                        continue
+                    }
+                }
+                if (current.status?.startsWith("Downloading translation") == true || hasCueNear(current, current.positionMs)) {
+                    current.status = null
+                }
+                SyncLog.i(
+                    "generated subtitles: ${fromMs / 1_000}-${toMs / 1_000}s → $lines lines from ${segments.size} " +
+                        "speech segments in ${(System.currentTimeMillis() - startedAt) / 1_000}s",
+                )
+                cache?.let { saveCache(it, current, covered) }
+            }
+        } catch (_: InterruptedException) {
+        } catch (error: Throwable) {
+            SyncLog.w("generated subtitles failed: ${error.message}")
+            if (!current.stopped) current.status = "Generated subtitles stopped: ${error.message ?: error.javaClass.simpleName}"
+        } finally {
+            recognizer?.close()
+            translator.close()
+        }
+    }
+
+    /** Downloads [model] if needed (Wi-Fi only) and loads it; null when it can't be used. */
+    private fun prepareRecognizer(
+        current: Run,
+        model: GeneratedSpeechModel,
+        language: String,
+        translate: Boolean = true,
+    ): GeneratedRecognizer? {
+        if (!model.isReady(appContext)) {
+            while (!current.stopped && !AsrModel.isUnmetered(appContext)) {
+                current.status = "Connect to Wi-Fi to download the ${model.sizeMb} MB speech model for generated subtitles"
+                Thread.sleep(3_000L)
+            }
+            if (current.stopped) return null
+            val failure = model.download(appContext, isCancelled = { current.stopped }) { progress ->
+                current.status = "Downloading speech model ${(progress * 100).toInt()}% (${model.sizeMb} MB, once)"
+            }
+            GeneratedSpeechModel.publish(appContext)
+            if (failure != null) {
+                if (!current.stopped) current.status = "Speech model download failed: $failure"
+                return null
+            }
+        }
+        current.status = "Loading speech model…"
+        return when (model) {
+            GeneratedSpeechModel.WHISPER_SMALL, GeneratedSpeechModel.WHISPER_MEDIUM -> GeneratedRecognizer.whisper(
+                appContext,
+                language.takeUnless { it == GeneratedSubtitles.AUTO }.orEmpty(),
+                WHISPER_THREADS,
+                model = model,
+                translate = translate,
+            )
+            GeneratedSpeechModel.SENSE_VOICE -> GeneratedRecognizer.senseVoice(appContext, language, THREADS)
+            GeneratedSpeechModel.DOLPHIN -> GeneratedRecognizer.dolphin(appContext, language, THREADS)
+        }
+    }
+
+    /** The language to recognise: the user's choice, else the audio track's tag ([GeneratedSubtitles.AUTO] if none). */
+    private fun spokenLanguage(current: Run): String {
+        val chosen = GeneratedSubtitles.spokenLanguage.value
+        if (chosen != GeneratedSubtitles.AUTO) return chosen
+        // The ticker publishes the track shortly after start.
+        repeat(20) {
+            if (current.audioFormat != null || current.stopped) return@repeat
+            Thread.sleep(100L)
+        }
+        val tag = current.audioFormat?.language?.lowercase()?.substringBefore('-')?.substringBefore('_').orEmpty()
+        val code = THREE_LETTER_CODES[tag] ?: tag
+        return code.takeIf { known -> GeneratedSubtitles.spokenLanguages.any { it.first == known } }
+            ?: GeneratedSubtitles.AUTO
+    }
+
+    /**
+     * Reads [fromMs]..[toMs] of the stream's audio and returns its speech segments (start in ms,
+     * 16 kHz samples), or null when the audio couldn't be read.
+     */
+    private fun readWindow(
+        current: Run,
+        source: Uri,
+        hlsSampler: HlsAudioSpotSampler?,
+        weights: SileroVadWeights,
+        fromMs: Long,
+        toMs: Long,
+    ): List<Pair<Long, FloatArray>>? {
+        val analyzer = SpeechAnalyzer(SileroVad(weights), SpeechTimeline())
+        val segments = ArrayList<Pair<Long, FloatArray>>()
+        val segmenter = SpeechSegmenter { startFrame, samples ->
+            synchronized(segments) {
+                segments += startFrame.toLong() * SpeechTimeline.FRAME_DURATION_US / 1_000L to samples
+            }
+        }
+        analyzer.chunkListener = segmenter
+        val decoder = AudioSyncDecoder(analyzer, analyzer, allowVendorDecoders = false)
+        val sink = WindowSink(current, decoder, anyAudio = hlsSampler != null)
+        val isCancelled = { current.stopped || seekedAway(current, fromMs, toMs) }
+        try {
+            val result = if (hlsSampler != null) {
+                hlsSampler.run(listOf(fromMs), toMs - fromMs, listOf(sink), isCancelled) { _, _ -> }
+            } else {
+                AudioSpotSampler(source, dataSourceFactory, MAX_WINDOW_BYTES, MAX_WINDOW_BYTES, 0L, EARLY_SEEK_MS).run(
+                    spotsMs = listOf(fromMs),
+                    spotMs = toMs - fromMs,
+                    maxWorkers = 1,
+                    newWorker = { AudioSyncExtractorsFactory(DefaultExtractorsFactory(), sink) },
+                    mayAddConnection = { false },
+                    isCancelled = isCancelled,
+                ) { _, _ -> }
+            }
+            if (result.sampled == 0 && result.failure == null && seekedAway(current, fromMs, toMs)) {
+                return emptyList<Pair<Long, FloatArray>>().also { cancelledWindow = true }
+            }
+            if (result.sampled == 0) {
+                SyncLog.w("generated subtitles: reading ${fromMs / 1_000}-${toMs / 1_000}s failed: ${result.failure}")
+                return null
+            }
+            decoder.awaitDrained(DRAIN_TIMEOUT_MS)
+            Thread.sleep(DECODE_SETTLE_MS)
+            segmenter.flush()
+        } finally {
+            decoder.release()
+        }
+        return synchronized(segments) { segments.sortedBy { it.first } }
+    }
+
+    /**
+     * The key of this title's generated lines, the same on every device: title/episode (or stream
+     * address), stream duration (different releases are timed differently), online or on-device,
+     * and spoken language. Null until the duration is known.
+     */
+    private fun cacheKey(current: Run, language: String, online: Boolean): String? {
+        val durationSec = current.durationMs.takeIf { it > 0 }?.let { (it + 500L) / 1_000L } ?: return null
+        val content = GeneratedSubtitles.contentId?.takeIf { it.isNotBlank() } ?: audioUrl.substringBefore('?')
+        val key = "$content|$durationSec|${if (online) "online" else "device"}|$language"
+        return MessageDigest.getInstance("SHA-1").digest(key.toByteArray()).joinToString("") { "%02x".format(it) }
+    }
+
+    private fun cacheFile(key: String): File = File(appContext.filesDir, "$CACHE_DIR/$key.json")
+
+    /**
+     * Loads saved lines: this device's copy, merged with the copy in the Nuvio account (made on any
+     * device). With neither, lines made the other way (online / on this device) are reused.
+     */
+    private fun loadCache(key: String, current: Run, covered: MutableList<LongArray>, otherKey: String?) {
+        val local = cacheFile(key).takeIf { it.isFile }?.let { runCatching { it.readText() }.getOrNull() }
+        val remote = runBlocking { withTimeoutOrNull(SYNC_TIMEOUT_MS) { GeneratedSubtitleSync.pull(key) } }
+        var payloads = listOfNotNull(local, remote)
+        if (payloads.isEmpty() && otherKey != null) {
+            payloads = listOfNotNull(
+                cacheFile(otherKey).takeIf { it.isFile }?.let { runCatching { it.readText() }.getOrNull() },
+                runBlocking { withTimeoutOrNull(SYNC_TIMEOUT_MS) { GeneratedSubtitleSync.pull(otherKey) } },
+            )
+        }
+        payloads.forEach { applyPayload(it, current, covered) }
+        if (remote != null) SyncLog.i("generated subtitles: lines from your Nuvio account found")
+    }
+
+    private fun applyPayload(payload: String, current: Run, covered: MutableList<LongArray>) {
+        try {
+            val json = JSONObject(payload)
+            val lines = json.getJSONArray("cues")
+            val loaded = ArrayList<CuesWithTiming>(lines.length())
+            for (index in 0 until lines.length()) {
+                val line = lines.getJSONArray(index)
+                loaded += cue(line.getLong(0), line.getLong(1), line.getString(2))
+            }
+            val ranges = json.getJSONArray("covered")
+            for (index in 0 until ranges.length()) {
+                val range = ranges.getJSONArray(index)
+                addCovered(covered, range.getLong(0), range.getLong(1))
+            }
+            synchronized(current.cues) {
+                val known = current.cues.mapTo(HashSet()) { it.startTimeUs }
+                current.cues += loaded.filter { it.startTimeUs !in known }
+                current.cues.sortBy { it.startTimeUs }
+                current.cuesVersion++
+            }
+            SyncLog.i("generated subtitles: ${loaded.size} saved lines reused, ${covered.sumOf { it[1] - it[0] } / 1_000}s already done")
+        } catch (error: Exception) {
+            SyncLog.w("generated subtitles: saved lines unreadable: ${error.message}")
+        }
+    }
+
+    private fun saveCache(key: String, current: Run, covered: List<LongArray>) {
+        val file = cacheFile(key)
+        try {
+            val cues = JSONArray()
+            synchronized(current.cues) {
+                for (entry in current.cues) {
+                    val text = entry.cues.joinToString("\n") { it.text?.toString().orEmpty() }
+                    val startMs = entry.startTimeUs / 1_000L
+                    cues.put(JSONArray().put(startMs).put(startMs + entry.durationUs / 1_000L).put(text))
+                }
+            }
+            val ranges = JSONArray()
+            covered.forEach { ranges.put(JSONArray().put(it[0]).put(it[1])) }
+            file.parentFile?.mkdirs()
+            val partial = File(file.parentFile, file.name + ".part")
+            val payload = JSONObject().put("cues", cues).put("covered", ranges).toString()
+            partial.writeText(payload)
+            partial.renameTo(file)
+            // The Nuvio account copy, for the other devices.
+            val pushed = runBlocking {
+                withTimeoutOrNull(SYNC_TIMEOUT_MS) { GeneratedSubtitleSync.push(key, GeneratedSubtitles.contentId, payload) }
+            }
+            if (pushed != true) SyncLog.d("generated subtitles: not saved to the Nuvio account (signed out or offline)")
+            // Keep the newest titles only.
+            file.parentFile?.listFiles { candidate -> candidate.name.endsWith(".json") }
+                ?.sortedByDescending { it.lastModified() }
+                ?.drop(MAX_CACHED_TITLES)
+                ?.forEach { it.delete() }
+        } catch (error: Exception) {
+            SyncLog.w("generated subtitles: couldn't save lines: ${error.message}")
+        }
+    }
+
+    /** The previous lines sent to DeepL, as context for the next request. */
+    @Volatile
+    private var deeplContext = ""
+
+    /** DeepL stopped working for the online entry: Groq translates by itself. */
+    @Volatile
+    private var onlineDeeplOff = false
+
+    /**
+     * Sends the speech of one window ([sentences], joined with short gaps) to Groq and adds the
+     * lines it hears at their place on the timeline. Returns the number of lines added.
+     */
+    private fun generateOnline(
+        current: Run,
+        groq: GroqWhisperClient,
+        deepl: DeepLTranslator?,
+        sentences: List<Pair<Long, FloatArray>>,
+        language: String,
+    ): Int {
+        if (sentences.isEmpty()) return 0
+        val rate = SileroVad.SAMPLE_RATE
+        val gap = rate * 4 / 10
+        // (start and end in the upload in seconds, start on the timeline in ms) per sentence.
+        val parts = ArrayList<Triple<Double, Double, Long>>()
+        val audio = FloatArray(sentences.sumOf { it.second.size } + gap * (sentences.size - 1))
+        var at = 0
+        for ((startMs, samples) in sentences) {
+            samples.copyInto(audio, at)
+            parts += Triple(at.toDouble() / rate, (at + samples.size).toDouble() / rate, startMs)
+            at += samples.size + gap
+        }
+        fun timelineMs(sec: Double): Long {
+            val part = parts.lastOrNull { it.first <= sec + 0.05 } ?: parts.first()
+            return part.third + ((sec.coerceIn(part.first, part.second) - part.first) * 1_000).toLong()
+        }
+        val hint = language.takeUnless { it == GeneratedSubtitles.AUTO }.orEmpty()
+        var heard = groq.recognize(audio, rate, translate = deepl == null, language = hint)
+        var english: List<String>? = null
+        if (deepl != null) {
+            val texts = heard.map { cleanText(it.text) ?: "" }
+            try {
+                english = deepl.translate(texts, DeepLTranslator.sourceCode(heard.firstOrNull()?.language?.let { whisperCode(it) } ?: hint), deeplContext)
+                deeplContext = texts.filter { it.isNotEmpty() }.takeLast(DEEPL_CONTEXT_LINES).joinToString("\n")
+            } catch (failure: DeepLTranslator.Failure) {
+                if (failure.permanent) {
+                    onlineDeeplOff = true
+                    current.status = "${failure.message}: Groq translates instead"
+                }
+                heard = groq.recognize(audio, rate, translate = true, language = hint)
+            }
+        }
+        var added = 0
+        heard.forEachIndexed { index, line ->
+            val text = (english?.getOrNull(index) ?: line.text).let(::cleanText) ?: return@forEachIndexed
+            if (isWhisperFiller(text) || !looksEnglish(text)) return@forEachIndexed
+            val startMs = timelineMs(line.startSec)
+            val endMs = maxOf(timelineMs(line.endSec), startMs + MIN_CUE_MS)
+            addLine(current, startMs, endMs, text)
+            added++
+        }
+        return added
+    }
+
+    /** Set when the last window was dropped because the user seeked away (not a failure). */
+    @Volatile
+    private var cancelledWindow = false
+
+    /** The playhead moved so far that [fromMs]..[toMs] is no longer worth reading now. */
+    private fun seekedAway(current: Run, fromMs: Long, toMs: Long): Boolean {
+        val positionMs = current.positionMs
+        return fromMs > positionMs + LOOKAHEAD_MS + WINDOW_MS || positionMs > toMs + SEEK_AWAY_MS
+    }
+
+    /** Feeds the playing audio track (or, for HLS segments, the first audio track) to [decoder]. */
+    private class WindowSink(
+        private val current: Run,
+        private val decoder: AudioSyncDecoder,
+        private val anyAudio: Boolean,
+    ) : AudioSampleSink {
+        @Volatile
+        private var taken: String? = null
+
+        override fun wantsSamples(format: Format): Boolean {
+            if (current.stopped) return false
+            val playing = current.audioFormat
+            if (!anyAudio && playing != null) return sameTrack(format, playing)
+            val track = format.id ?: format.sampleMimeType ?: return false
+            return track == (taken ?: track.also { taken = it })
+        }
+
+        override fun onSample(format: Format, timeUs: Long, data: ByteArray, offset: Int, size: Int) {
+            while (!decoder.offer(format, timeUs, data, offset, size)) {
+                if (current.stopped || !decoder.accepts(format)) return
+                Thread.sleep(5L)
+            }
+        }
+
+        override fun onDiscontinuity() {
+            decoder.awaitDrained(DRAIN_TIMEOUT_MS)
+            decoder.discontinuity()
+        }
+    }
+
+    private fun addLine(current: Run, startMs: Long, endMs: Long, text: String) {
+        val pieces = splitForScreen(text)
+        val totalChars = pieces.sumOf { it.length }.coerceAtLeast(1)
+        val spanMs = (endMs - startMs).coerceAtLeast(MIN_CUE_MS)
+        var atMs = startMs
+        val added = pieces.map { piece ->
+            val pieceMs = (spanMs * piece.length / totalChars).coerceAtLeast(MIN_CUE_MS / pieces.size)
+            cue(atMs, atMs + pieceMs + if (piece === pieces.last()) LINGER_MS else 0L, piece).also { atMs += pieceMs }
+        }
+        synchronized(current.cues) {
+            current.cues.removeAll { existing -> added.any { it.startTimeUs == existing.startTimeUs } }
+            current.cues += added
+            current.cues.sortBy { it.startTimeUs }
+            // A line stays until the next one starts, never on top of it.
+            for (index in 0 until current.cues.size - 1) {
+                val entry = current.cues[index]
+                val nextStart = current.cues[index + 1].startTimeUs
+                if (entry.startTimeUs + entry.durationUs > nextStart && nextStart > entry.startTimeUs) {
+                    current.cues[index] = CuesWithTiming(entry.cues, entry.startTimeUs, nextStart - entry.startTimeUs)
+                }
+            }
+            current.cuesVersion++
+        }
+    }
+
+    companion object {
+        /** Whether a session is generating (models must not be deleted meanwhile). */
+        @Volatile
+        var running = false
+
+        private const val PLACEHOLDER_SRT = "1\n00:00:00,000 --> 00:00:00,100\n…\n"
+        private const val TICK_MS = 250L
+        private const val STATUS_SHOW_MS = 2_500L
+        private const val LOOKAHEAD_MS = 120_000L
+        private const val FIRST_WINDOW_MS = 20_000L
+        private const val WINDOW_MS = 60_000L
+        private const val SEEK_AWAY_MS = 60_000L
+        private const val MERGE_GAP_MS = 800L
+        private const val DEEPL_CONTEXT_LINES = 4
+        private const val CACHE_DIR = "generated-subtitles/cache"
+        private const val MAX_CACHED_TITLES = 200
+        private const val SYNC_TIMEOUT_MS = 10_000L
+        private const val MERGE_MAX_MS = 12_000L
+        /** Files with a sparse index seek well before the target; reading from there is fine. */
+        private const val EARLY_SEEK_MS = 180_000L
+        private const val MAX_WINDOW_BYTES = 400L * 1_000_000L
+        private const val MAX_FAILURES = 4
+        private const val DRAIN_TIMEOUT_MS = 15_000L
+        private const val DECODE_SETTLE_MS = 300L
+        private const val MIN_CUE_MS = 1_200L
+        private const val LINGER_MS = 400L
+        private const val MAX_LINE_CHARS = 42
+        private const val THREADS = 2
+        private val WHISPER_THREADS = (Runtime.getRuntime().availableProcessors() / 2).coerceIn(2, 4)
+        private const val MIN_WHISPER_SAMPLES = SileroVad.SAMPLE_RATE * 6 / 10
+        private val SENSE_VOICE_LANGUAGES = setOf("zh", "yue", "ja", "ko", "en")
+
+        /** Dolphin languages ML Kit can also translate (Punjabi can't be, so Whisper keeps it). */
+        private val DOLPHIN_LANGUAGES = setOf(
+            "hi", "ur", "bn", "ta", "te", "gu", "mr", "th", "id", "ms", "vi", "tl", "ar", "fa", "ru",
+        )
+
+        /** ISO 639-2 audio tags (as in Matroska) to the codes in [GeneratedSubtitles.spokenLanguages]. */
+        private val THREE_LETTER_CODES = mapOf(
+            "zho" to "zh", "chi" to "zh", "cmn" to "zh", "jpn" to "ja", "kor" to "ko", "eng" to "en",
+            "hin" to "hi", "urd" to "ur", "ben" to "bn", "tam" to "ta", "tel" to "te", "mal" to "ml",
+            "kan" to "kn", "mar" to "mr", "guj" to "gu", "pan" to "pa", "tha" to "th", "ind" to "id",
+            "msa" to "ms", "may" to "ms", "tgl" to "tl", "fil" to "tl", "vie" to "vi", "tur" to "tr",
+            "ara" to "ar", "fas" to "fa", "per" to "fa", "rus" to "ru", "ukr" to "uk", "pol" to "pl",
+            "spa" to "es", "por" to "pt", "fra" to "fr", "fre" to "fr", "deu" to "de", "ger" to "de",
+            "ita" to "it", "nld" to "nl", "dut" to "nl", "swe" to "sv", "ell" to "el", "gre" to "el",
+            "heb" to "he", "iw" to "he", "in" to "id",
+        )
+
+        /** Lines Whisper is known to produce from music, noise or silence. */
+        private val WHISPER_FILLERS = setOf(
+            "thank you", "thanks", "thank you very much", "thanks for watching", "thank you for watching",
+            "you", "bye", "okay", "ok", "please subscribe", "subscribe", "music", "applause", "laughter",
+            "subtitles by the amara.org community", "so", "oh", "hmm", "uh", "um",
+            // The same, as Whisper writes them down in the spoken language.
+            "ご視聴ありがとうございました", "ありがとうございました", "字幕", "谢谢观看", "謝謝觀看",
+            "感谢观看", "시청해주셔서 감사합니다", "구독과 좋아요", "धन्यवाद", "शुक्रिया",
+        )
+
+        private fun isWhisperFiller(text: String): Boolean {
+            val plain = text.lowercase().replace(Regex("[^\\p{L}\\p{N} ]"), "").trim().replace(Regex("\\s+"), " ")
+            return plain.isEmpty() || plain in WHISPER_FILLERS ||
+                (text.trim().startsWith("[") && text.trim().endsWith("]")) ||
+                (text.trim().startsWith("(") && text.trim().endsWith(")")) ||
+                text.contains('♪')
+        }
+
+        private fun cue(startMs: Long, endMs: Long, text: String) = CuesWithTiming(
+            listOf(Cue.Builder().setText(text).build()),
+            startMs * 1_000L,
+            (endMs - startMs).coerceAtLeast(1L) * 1_000L,
+        )
+
+        /**
+         * Joins speech segments separated by short pauses (under [MERGE_GAP_MS]) into one, up to
+         * [MERGE_MAX_MS], with a little silence between them, so the recogniser hears sentences.
+         */
+        private fun mergeSentences(segments: List<Pair<Long, FloatArray>>): List<Pair<Long, FloatArray>> {
+            val rate = SileroVad.SAMPLE_RATE
+            val gapSamples = FloatArray(rate / 5)
+            val merged = ArrayList<Pair<Long, FloatArray>>()
+            var startMs = -1L
+            var endMs = 0L
+            val parts = ArrayList<FloatArray>()
+            fun close() {
+                if (parts.isEmpty()) return
+                val total = parts.sumOf { it.size } + gapSamples.size * (parts.size - 1)
+                val out = FloatArray(total)
+                var at = 0
+                parts.forEachIndexed { index, part ->
+                    if (index > 0) at += gapSamples.size
+                    part.copyInto(out, at)
+                    at += part.size
+                }
+                merged += startMs to out
+                parts.clear()
+            }
+            for ((segmentStartMs, samples) in segments) {
+                val segmentEndMs = segmentStartMs + samples.size * 1_000L / rate
+                val joins = parts.isNotEmpty() && segmentStartMs - endMs < MERGE_GAP_MS &&
+                    segmentEndMs - startMs <= MERGE_MAX_MS
+                if (!joins) {
+                    close()
+                    startMs = segmentStartMs
+                }
+                parts += samples
+                endMs = segmentEndMs
+            }
+            close()
+            return merged
+        }
+
+        /** Where the playhead's covered stretch ends, or (a little before) the playhead itself. */
+        private fun nextUncovered(covered: List<LongArray>, positionMs: Long): Long {
+            val probe = (positionMs - 2_000L).coerceAtLeast(0L)
+            var at = probe
+            var moved = true
+            while (moved) {
+                moved = false
+                for (range in covered) {
+                    if (at >= range[0] && at < range[1]) {
+                        at = range[1]
+                        moved = true
+                    }
+                }
+            }
+            return at
+        }
+
+        private fun removeCovered(covered: MutableList<LongArray>, fromMs: Long, toMs: Long) {
+            val kept = ArrayList<LongArray>()
+            for (range in covered) {
+                if (range[1] <= fromMs || range[0] >= toMs) {
+                    kept += range
+                } else {
+                    if (range[0] < fromMs) kept += longArrayOf(range[0], fromMs)
+                    if (range[1] > toMs) kept += longArrayOf(toMs, range[1])
+                }
+            }
+            covered.clear()
+            covered += kept
+        }
+
+        private fun addCovered(covered: MutableList<LongArray>, fromMs: Long, toMs: Long) {
+            covered += longArrayOf(fromMs, toMs)
+            covered.sortBy { it[0] }
+            val merged = ArrayList<LongArray>()
+            for (range in covered) {
+                val last = merged.lastOrNull()
+                if (last != null && range[0] <= last[1]) last[1] = maxOf(last[1], range[1]) else merged += range.copyOf()
+            }
+            covered.clear()
+            covered += merged
+        }
+
+        private fun sameTrack(a: Format, b: Format): Boolean {
+            if (a.sampleMimeType != b.sampleMimeType) return false
+            val periodPrefix = Regex("^(\\d+:)+")
+            val aId = a.id?.replace(periodPrefix, "")
+            val bId = b.id?.replace(periodPrefix, "")
+            if (!aId.isNullOrEmpty() && !bId.isNullOrEmpty()) return aId == bId
+            return a.language == b.language && a.channelCount == b.channelCount && a.sampleRate == b.sampleRate
+        }
+
+        /**
+         * The language to translate [text] from, judged by its script; [expected] when the script
+         * doesn't decide (Latin, or a script used by several languages the user didn't pick).
+         */
+        private fun languageOfScript(text: String, expected: String): String {
+            val counts = HashMap<Character.UnicodeScript, Int>()
+            for (char in text) {
+                if (!char.isLetter()) continue
+                val script = runCatching { Character.UnicodeScript.of(char.code) }.getOrNull() ?: continue
+                counts[script] = (counts[script] ?: 0) + 1
+            }
+            val script = counts.maxByOrNull { it.value }?.key ?: return expected
+            return when (script) {
+                Character.UnicodeScript.DEVANAGARI -> if (expected == "mr") "mr" else "hi"
+                Character.UnicodeScript.ARABIC -> when (expected) {
+                    "ar", "fa", "ur" -> expected
+                    "hi" -> "ur"
+                    else -> expected.takeIf { it == "ar" } ?: "ar"
+                }
+                Character.UnicodeScript.BENGALI -> "bn"
+                Character.UnicodeScript.TAMIL -> "ta"
+                Character.UnicodeScript.TELUGU -> "te"
+                Character.UnicodeScript.GUJARATI -> "gu"
+                Character.UnicodeScript.THAI -> "th"
+                Character.UnicodeScript.HANGUL -> "ko"
+                Character.UnicodeScript.HIRAGANA, Character.UnicodeScript.KATAKANA -> "ja"
+                Character.UnicodeScript.HAN -> if (expected == "ja" || expected == "yue") expected else "zh"
+                Character.UnicodeScript.CYRILLIC -> if (expected == "uk") "uk" else "ru"
+                else -> expected
+            }
+        }
+
+        /** Groq names the language in English ("japanese"); the codes here are ISO 639-1. */
+        private fun whisperCode(name: String): String = when (name.lowercase()) {
+            "japanese" -> "ja"; "chinese" -> "zh"; "cantonese" -> "yue"; "korean" -> "ko"; "hindi" -> "hi"
+            "urdu" -> "ur"; "bengali" -> "bn"; "tamil" -> "ta"; "telugu" -> "te"; "malayalam" -> "ml"
+            "kannada" -> "kn"; "marathi" -> "mr"; "gujarati" -> "gu"; "punjabi" -> "pa"; "thai" -> "th"
+            "indonesian" -> "id"; "malay" -> "ms"; "tagalog" -> "tl"; "vietnamese" -> "vi"; "turkish" -> "tr"
+            "arabic" -> "ar"; "persian" -> "fa"; "russian" -> "ru"; "ukrainian" -> "uk"; "polish" -> "pl"
+            "spanish" -> "es"; "portuguese" -> "pt"; "french" -> "fr"; "german" -> "de"; "italian" -> "it"
+            "dutch" -> "nl"; "swedish" -> "sv"; "greek" -> "el"; "hebrew" -> "he"; "english" -> "en"
+            else -> name.takeIf { it.length in 2..3 }.orEmpty()
+        }
+
+        /** Mostly Latin letters: what an English line looks like. */
+        private fun looksEnglish(text: String): Boolean {
+            var letters = 0
+            var latin = 0
+            for (char in text) {
+                if (!char.isLetter()) continue
+                letters++
+                if (char.code < 0x250) latin++
+            }
+            return letters > 0 && latin * 10 >= letters * 8
+        }
+
+        /** Drops empty or punctuation-only results (music, sighs). */
+        private fun cleanText(text: String): String? {
+            // Model tags: SenseVoice "<|zh|>", Dolphin "<hi><IN>".
+            val trimmed = text.replace(Regex("<\\|[^|]*\\|>"), "").replace(Regex("<[A-Za-z_-]{1,12}>"), "").trim()
+            return trimmed.takeIf { value -> value.any { it.isLetterOrDigit() } }
+        }
+
+        /** Breaks a long line into on-screen pieces of at most two lines each. */
+        private fun splitForScreen(text: String): List<String> {
+            val words = text.split(Regex("\\s+")).filter { it.isNotEmpty() }
+            if (words.isEmpty()) return listOf(text)
+            val lines = ArrayList<String>()
+            val line = StringBuilder()
+            for (word in words) {
+                if (line.isNotEmpty() && line.length + 1 + word.length > MAX_LINE_CHARS) {
+                    lines += line.toString()
+                    line.setLength(0)
+                }
+                if (line.isNotEmpty()) line.append(' ')
+                line.append(word)
+            }
+            if (line.isNotEmpty()) lines += line.toString()
+            return lines.chunked(2) { it.joinToString("\n") }
+        }
+    }
+}
