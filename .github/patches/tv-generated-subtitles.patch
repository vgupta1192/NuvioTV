+ * DeepL keys (typed on a phone through a QR code), the spoken language, and the opt-in on-device
+ * models. Keys stay on this TV; they are never part of the app.
+ */
+@Composable
+internal fun generatedSubtitleSettingsRows(enabled: Boolean) {
+    val context = LocalContext.current
+    GeneratedSubtitles.ensureLoaded(context)
+    val mode by GeneratedSubtitles.mode.collectAsStateWithLifecycle()
+    val groqKey by GeneratedSubtitles.groqKey.collectAsStateWithLifecycle()
+    val deeplKey by GeneratedSubtitles.deeplKey.collectAsStateWithLifecycle()
+    val language by GeneratedSubtitles.spokenLanguage.collectAsStateWithLifecycle()
+    val onDevice by GeneratedSubtitles.onDevice.collectAsStateWithLifecycle()
+    val fast by GeneratedSubtitles.fastAsianModel.collectAsStateWithLifecycle()
+    val models by GeneratedSubtitles.models.collectAsStateWithLifecycle()
+    var dialog by remember { mutableStateOf<String?>(null) }
+    val keySet = stringResource(R.string.generated_subs_key_set)
+    val keyNotSet = stringResource(R.string.generated_subs_key_not_set)
+
+    SettingsActionRow(
+        title = stringResource(R.string.generated_subs_groq_title),
+        subtitle = stringResource(R.string.generated_subs_groq_description),
+        value = if (groqKey.isBlank()) keyNotSet else keySet,
+        onClick = { dialog = "groq" },
+        enabled = enabled,
+    )
+    SettingsActionRow(
+        title = stringResource(R.string.generated_subs_deepl_title),
+        subtitle = stringResource(R.string.generated_subs_deepl_description),
+        value = if (deeplKey.isBlank()) keyNotSet else keySet,
+        onClick = { dialog = "deepl" },
