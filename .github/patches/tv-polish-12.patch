+    val httpFactory = remember { DefaultHttpDataSource.Factory().setAllowCrossProtocolRedirects(true) }
+    val player = remember {
+        ExoPlayer.Builder(context)
+            .setMediaSourceFactory(DefaultMediaSourceFactory(context).setDataSourceFactory(httpFactory))
+            .build()
+    }
+
+    fun goTo(newIndex: Int) {
+        val list = latestItems
+        if (newIndex !in list.indices) return
+        currentId = list[newIndex].videoId
+        message = null
+        if (newIndex >= list.size - 4) latestNearEnd()
+    }
+
+    val goNext = rememberUpdatedState {
+        val i = latestItems.indexOfFirst { it.videoId == currentId }
+        if (i < latestItems.lastIndex) goTo(i + 1)
+        else {
+            latestNearEnd()
+            player.seekTo(0)
+            player.play()
+        }
+    }
+
+    DisposableEffect(Unit) {
+        view.keepScreenOn = true
+        com.nuvio.tv.LiveTvPlayerSidebarGate.playerActive = true
+        val listener = object : Player.Listener {
+            override fun onPlaybackStateChanged(state: Int) {
+                loading = state == Player.STATE_BUFFERING
+                if (state == Player.STATE_ENDED && YouTubeSettings.shortsAutoscroll(context)) goNext.value()
+            }
+
+            override fun onIsPlayingChanged(isPlaying: Boolean) {
+                playing = isPlaying
+            }
+
+            override fun onPlayerError(error: PlaybackException) {
+                loading = false
+                message = "Couldn't play this short"
+            }
+        }
+        player.addListener(listener)
+        onDispose {
+            player.removeListener(listener)
+            player.release()
+            view.keepScreenOn = false
+            com.nuvio.tv.LiveTvPlayerSidebarGate.playerActive = false
+        }
+    }
+
+    // Repeat the short unless auto-scroll is going to move on; keep sound and speed as chosen.
+    LaunchedEffect(autoscroll) {
+        player.repeatMode = if (autoscroll) Player.REPEAT_MODE_OFF else Player.REPEAT_MODE_ONE
+    }
+    LaunchedEffect(muted) { player.volume = if (muted) 0f else 1f }
+    LaunchedEffect(speed) { player.setPlaybackSpeed(speed) }
+
+    // Load the stream for whichever short is showing, and warm up the ones after it.
+    LaunchedEffect(currentId) {
+        val item = latestItems.firstOrNull { it.videoId == currentId } ?: return@LaunchedEffect
+        loading = true
+        message = null
+        progress = 0f
+        viewModel.prefetch(item, latestItems.dropWhile { it !== item }.drop(1))
+        viewModel.shortPlayable(item).fold(
+            onSuccess = { v ->
+                httpFactory.setDefaultRequestProperties(v.headers)
+                val media = MediaItem.Builder().setUri(v.url).apply {
+                    if (v.url.endsWith(".mpd")) setMimeType(MimeTypes.APPLICATION_MPD)
+                }.build()
+                player.setMediaItem(media)
+                player.prepare()
+                player.setPlaybackSpeed(speed)
+                player.playWhenReady = true
+            },
+            onFailure = {
+                loading = false
+                message = it.message ?: "Couldn't play this short"
+                // Skip one that won't play when it is going to scroll on anyway.
+                if (YouTubeSettings.shortsAutoscroll(context)) {
+                    delay(1500)
+                    goNext.value()
+                }
+            }
+        )
+    }
+
+    LaunchedEffect(Unit) {
+        while (true) {
+            val d = player.duration
+            progress = if (d > 0) (player.currentPosition.toFloat() / d).coerceIn(0f, 1f) else 0f
+            delay(250)
+        }
+    }
+    LaunchedEffect(Unit) {
+        delay(5_000)
+        hint = false
+    }
+    LaunchedEffect(barOpen, barTick) {
+        if (barOpen) {
+            delay(BAR_HIDE_MS)
+            barOpen = false
+        }
+    }
+
+    val labels: List<String> = listOf(
+        if (playing) "Pause" else "Play",
+        if (autoscroll) "Auto-scroll: On" else "Auto-scroll: Off",
+        if (muted) "Sound: Off" else "Sound: On",
+        "Speed ${speedLabel(speed)}",
+        if (showInfo) "Info: On" else "Info: Off",
+        "Channel",
+        "Close"
+    )
+
+    fun activate(i: Int) {
+        when (i) {
+            0 -> if (player.isPlaying) player.pause() else player.play()
+            1 -> {
+                autoscroll = !autoscroll
+                YouTubeSettings.setShortsAutoscroll(context, autoscroll)
+            }
+            2 -> {
+                muted = !muted
+                YouTubeSettings.setShortsMuted(context, muted)
+            }
+            3 -> {
+                speed = SPEEDS[(SPEEDS.indexOfFirst { it >= speed - 0.01f }.let { if (it < 0) 0 else it } + 1) % SPEEDS.size]
+                YouTubeSettings.setShortsSpeed(context, speed)
+            }
+            4 -> {
+                showInfo = !showInfo
+                YouTubeSettings.setShortsInfo(context, showInfo)
+            }
+            5 -> current?.let(onOpenChannel)
+            6 -> onClose()
+        }
+    }
+
+    BackHandler {
+        if (barOpen) barOpen = false else onClose()
+    }
+
+    val focus = remember { FocusRequester() }
+    LaunchedEffect(Unit) { runCatching { focus.requestFocus() } }
+
+    Box(
+        Modifier
+            .fillMaxSize()
+            .background(Color.Black)
+            .focusRequester(focus)
+            .focusable()
+            .onPreviewKeyEvent { e ->
+                if (e.type != KeyEventType.KeyDown) {
+                    // Swallow the matching key-up so nothing underneath reacts to it.
+                    return@onPreviewKeyEvent e.key in HANDLED_KEYS
+                }
+                hint = false
+                barTick++
+                when (e.key) {
+                    Key.DirectionUp, Key.ChannelUp, Key.MediaPrevious -> {
+                        goTo(index - 1)
+                        true
+                    }
+                    Key.DirectionDown, Key.ChannelDown, Key.MediaNext -> {
+                        goNext.value()
+                        true
+                    }
+                    Key.DirectionLeft -> {
+                        if (barOpen) barIndex = (barIndex - 1).coerceAtLeast(0)
+                        else player.seekTo((player.currentPosition - SEEK_MS).coerceAtLeast(0))
+                        true
+                    }
+                    Key.DirectionRight -> {
+                        if (barOpen) barIndex = (barIndex + 1).coerceAtMost(labels.lastIndex)
+                        else {
+                            val d = player.duration
+                            val to = player.currentPosition + SEEK_MS
+                            player.seekTo(if (d > 0) to.coerceAtMost(d - 500) else to)
+                        }
+                        true
+                    }
+                    Key.DirectionCenter, Key.Enter, Key.NumPadEnter -> {
+                        if (barOpen) activate(barIndex)
+                        else {
+                            barIndex = 0
+                            barOpen = true
+                        }
+                        true
+                    }
+                    Key.Menu -> {
+                        barOpen = !barOpen
+                        true
+                    }
+                    Key.MediaPlayPause, Key.MediaPlay, Key.MediaPause -> {
+                        if (player.isPlaying) player.pause() else player.play()
+                        true
+                    }
+                    else -> false
+                }
+            }
+    ) {
+        AndroidView(
+            modifier = Modifier.fillMaxSize(),
+            factory = { ctx ->
+                PlayerView(ctx).apply {
+                    useController = false
+                    resizeMode = AspectRatioFrameLayout.RESIZE_MODE_FIT
+                    setShutterBackgroundColor(android.graphics.Color.BLACK)
+                    this.player = player
+                }
+            }
+        )
+
+        if (loading && message == null) {
+            CircularProgressIndicator(color = ShortsRed, modifier = Modifier.align(Alignment.Center))
+        }
+        message?.let {
+            Text(
+                it,
+                color = Color.White,
+                fontSize = 18.sp,
+                modifier = Modifier
+                    .align(Alignment.Center)
+                    .clip(RoundedCornerShape(12.dp))
+                    .background(Color(0xCC000000))
+                    .padding(horizontal = 20.dp, vertical = 12.dp)
+            )
+        }
+
+        if (showInfo && current != null) {
+            Column(
+                Modifier
+                    .align(Alignment.BottomStart)
+                    .fillMaxWidth()
+                    .background(Brush.verticalGradient(listOf(Color.Transparent, Color(0xCC000000))))
+                    .padding(start = 32.dp, end = 32.dp, top = 40.dp, bottom = 22.dp)
+            ) {
+                Text(
+                    current.title,
+                    color = Color.White,
+                    fontSize = 18.sp,
+                    fontWeight = FontWeight.SemiBold,
+                    maxLines = 2,
+                    overflow = TextOverflow.Ellipsis,
+                    modifier = Modifier.width(560.dp)
+                )
+                Text(
+                    listOfNotNull(current.author, "${index + 1} / ${items.size}").joinToString("  ·  "),
+                    color = Color(0xFFCCCCCC),
+                    fontSize = 14.sp,
+                    modifier = Modifier.padding(top = 4.dp)
+                )
+            }
+        }
+
+        // Where you are in the short.
+        Box(
+            Modifier
+                .align(Alignment.BottomStart)
+                .fillMaxWidth()
+                .height(4.dp)
+                .background(Color(0x55FFFFFF))
+        ) {
+            Box(Modifier.fillMaxWidth(progress).height(4.dp).background(ShortsRed))
+        }
+
+        if (barOpen) {
+            Row(
+                Modifier
+                    .align(Alignment.BottomCenter)
+                    .padding(bottom = 64.dp),
+                horizontalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                labels.forEachIndexed { i, label ->
+                    Text(
+                        label,
+                        color = Color.White,
+                        fontSize = 15.sp,
+                        fontWeight = if (i == barIndex) FontWeight.Bold else FontWeight.Normal,
+                        modifier = Modifier
+                            .clip(RoundedCornerShape(20.dp))
+                            .background(if (i == barIndex) ShortsRed else ShortsChipBg)
+                            .border(2.dp, if (i == barIndex) Color.White else Color.Transparent, RoundedCornerShape(20.dp))
+                            .padding(horizontal = 16.dp, vertical = 9.dp)
+                    )
+                }
+            }
+        } else if (hint) {
+            Text(
+                "Up / Down: next short   ·   Left / Right: seek   ·   OK: options",
+                color = Color.White,
+                fontSize = 14.sp,
+                modifier = Modifier
+                    .align(Alignment.TopCenter)
+                    .padding(top = 20.dp)
+                    .clip(RoundedCornerShape(16.dp))
+                    .background(Color(0xAA000000))
+                    .padding(horizontal = 16.dp, vertical = 8.dp)
+            )
+        }
+    }
+}
+
+private fun speedLabel(speed: Float): String =
+    if (speed == speed.toInt().toFloat()) "${speed.toInt()}x" else "${speed}x"
+
+private val HANDLED_KEYS = setOf(
+    Key.DirectionUp, Key.DirectionDown, Key.DirectionLeft, Key.DirectionRight,
+    Key.DirectionCenter, Key.Enter, Key.NumPadEnter, Key.Menu,
+    Key.ChannelUp, Key.ChannelDown, Key.MediaNext, Key.MediaPrevious,
+    Key.MediaPlayPause, Key.MediaPlay, Key.MediaPause
+)
