+@Composable
+private fun sweepVerdictText(result: StreamSweepEngine.SweepResult): String {
+    when (result.errorKind) {
+        StreamSweepEngine.ErrorKind.CONNECTION ->
+            return stringResource(R.string.stream_test_error_connection)
+        StreamSweepEngine.ErrorKind.UNEXPECTED ->
+            return stringResource(R.string.network_sweep_error_unexpected, result.errorDetail ?: "")
+        null -> {}
+    }
+    val rec = result.recommendation
+    return when (result.verdictKind) {
+        StreamSweepEngine.VerdictKind.LEAVE_PARALLEL_OFF ->
+            stringResource(
+                R.string.network_sweep_verdict_leave_off,
+                "%.1f Mbps".format(result.baselineMbps)
+            )
+        StreamSweepEngine.VerdictKind.RECOMMEND_CONFIG ->
+            stringResource(
+                R.string.network_sweep_verdict_recommend,
+                rec?.connections ?: 0,
+                rec?.chunkMb ?: 0,
+                "%.1f Mbps".format(rec?.mbps ?: 0.0)
+            )
+        StreamSweepEngine.VerdictKind.MARGINAL, StreamSweepEngine.VerdictKind.CANNOT_SUSTAIN -> {
+            val titleMbps = (result.targetMbps ?: 0.0) / StreamSweepEngine.TARGET_BITRATE_MULTIPLE
+            stringResource(
+                if (result.verdictKind == StreamSweepEngine.VerdictKind.MARGINAL) {
+                    R.string.network_sweep_verdict_marginal
+                } else {
+                    R.string.network_sweep_verdict_cannot_sustain
+                },
+                rec?.connections ?: 0,
+                rec?.chunkMb ?: 0,
+                "%.1f Mbps".format(rec?.mbps ?: 0.0),
+                "%.1f Mbps".format(titleMbps)
+            )
+        }
+        StreamSweepEngine.VerdictKind.FASTEST_NO_BITRATE ->
+            stringResource(
+                R.string.network_sweep_verdict_fastest_nobitrate,
+                rec?.connections ?: 0,
+                rec?.chunkMb ?: 0,
+                "%.1f Mbps".format(rec?.mbps ?: 0.0)
+            )
+        StreamSweepEngine.VerdictKind.NONE ->
+            stringResource(R.string.network_sweep_verdict_none)
+    }
+}
