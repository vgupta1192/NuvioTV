@@ -0,0 +1,79 @@
+package com.nuvio.tv.core.cloud
+
+import android.content.Context
+import org.json.JSONArray
+import org.json.JSONObject
+
+/** Last good cloud library listing per provider, so a failed refresh still shows the previous items. */
+internal object CloudLibraryCache {
+    private const val PREFS = "nuvio_cloud_library_cache"
+
+    fun save(context: Context, providerId: String, items: List<CloudLibraryItem>) {
+        val array = JSONArray()
+        items.forEach { item ->
+            val files = JSONArray()
+            item.files.forEach { file ->
+                files.put(
+                    JSONObject()
+                        .put("id", file.id ?: JSONObject.NULL)
+                        .put("name", file.name)
+                        .put("size", file.sizeBytes ?: JSONObject.NULL)
+                        .put("mime", file.mimeType ?: JSONObject.NULL)
+                        .put("playable", file.playable)
+                        .put("url", file.playbackUrl ?: JSONObject.NULL)
+                )
+            }
+            array.put(
+                JSONObject()
+                    .put("providerId", item.providerId)
+                    .put("providerName", item.providerName)
+                    .put("id", item.id)
+                    .put("type", item.type.name)
+                    .put("name", item.name)
+                    .put("status", item.status ?: JSONObject.NULL)
+                    .put("size", item.sizeBytes ?: JSONObject.NULL)
+                    .put("progress", item.progressFraction?.toDouble() ?: JSONObject.NULL)
+                    .put("files", files)
+            )
+        }
+        runCatching {
+            prefs(context).edit().putString(providerId, array.toString()).apply()
+        }
+    }
+
+    fun load(context: Context, providerId: String): List<CloudLibraryItem> = runCatching {
+        val raw = prefs(context).getString(providerId, null) ?: return emptyList()
+        val array = JSONArray(raw)
+        (0 until array.length()).mapNotNull { index ->
+            val o = array.optJSONObject(index) ?: return@mapNotNull null
+            val type = runCatching { CloudLibraryItemType.valueOf(o.optString("type")) }.getOrNull()
+                ?: return@mapNotNull null
+            val filesArray = o.optJSONArray("files")
+            val files = (0 until (filesArray?.length() ?: 0)).mapNotNull { fileIndex ->
+                val f = filesArray?.optJSONObject(fileIndex) ?: return@mapNotNull null
+                CloudLibraryFile(
+                    id = f.takeUnless { it.isNull("id") }?.optString("id"),
+                    name = f.optString("name"),
+                    sizeBytes = f.takeUnless { it.isNull("size") }?.optLong("size"),
+                    mimeType = f.takeUnless { it.isNull("mime") }?.optString("mime"),
+                    playable = f.optBoolean("playable", true),
+                    playbackUrl = f.takeUnless { it.isNull("url") }?.optString("url")
+                )
+            }
+            CloudLibraryItem(
+                providerId = o.optString("providerId"),
+                providerName = o.optString("providerName"),
+                id = o.optString("id"),
+                type = type,
+                name = o.optString("name"),
+                status = o.takeUnless { it.isNull("status") }?.optString("status"),
+                sizeBytes = o.takeUnless { it.isNull("size") }?.optLong("size"),
+                progressFraction = o.takeUnless { it.isNull("progress") }?.optDouble("progress")?.toFloat(),
+                files = files
+            )
+        }
+    }.getOrDefault(emptyList())
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+}
