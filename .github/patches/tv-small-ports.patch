@@ -0,0 +1,51 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import android.os.SystemClock
+
+/** Fork player prefs: subtitles start off, and a one-shot sleep timer. */
+object TvForkPlayerPrefs {
+    private const val FILE = "tv_fork_player_prefs"
+    private const val KEY_SUBS_OFF = "subtitles_start_off"
+
+    @Volatile var subtitlesStartOff: Boolean = false
+        private set
+
+    @Volatile var sleepDeadlineMs: Long = 0L
+        private set
+
+    val sleepOptionsMin = listOf(0, 15, 30, 45, 60, 90)
+
+    fun load(context: Context) {
+        subtitlesStartOff = context.getSharedPreferences(FILE, Context.MODE_PRIVATE)
+            .getBoolean(KEY_SUBS_OFF, false)
+    }
+
+    fun setSubtitlesStartOff(context: Context, value: Boolean) {
+        subtitlesStartOff = value
+        context.getSharedPreferences(FILE, Context.MODE_PRIVATE).edit().putBoolean(KEY_SUBS_OFF, value).apply()
+    }
+
+    fun sleepMinutesLeft(): Int {
+        if (sleepDeadlineMs == 0L) return 0
+        val left = sleepDeadlineMs - SystemClock.elapsedRealtime()
+        return if (left <= 0) 0 else ((left + 59_999) / 60_000).toInt()
+    }
+
+    fun setSleepMinutes(minutes: Int) {
+        sleepDeadlineMs = if (minutes <= 0) 0L else SystemClock.elapsedRealtime() + minutes * 60_000L
+    }
+
+    fun nextSleepMinutes(): Int {
+        val left = sleepMinutesLeft()
+        val idx = sleepOptionsMin.indexOfFirst { it > left }
+        return if (idx < 0) 0 else sleepOptionsMin[idx]
+    }
+
+    /** True once when the deadline has passed; clears it. */
+    fun consumeExpired(): Boolean {
+        if (sleepDeadlineMs == 0L || SystemClock.elapsedRealtime() < sleepDeadlineMs) return false
+        sleepDeadlineMs = 0L
+        return true
+    }
+}
