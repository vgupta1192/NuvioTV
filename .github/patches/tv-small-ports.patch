+import java.net.URL
+import java.net.URLEncoder
+
+private data class FillerResult(val filler: List<Int>, val recap: List<Int>)
+
+private val fillerCache = mutableMapOf<String, FillerResult?>()
+
+internal fun isFillerGuideCandidate(apiType: String, genres: List<String>): Boolean {
+    if (apiType.equals("movie", ignoreCase = true)) return false
+    return genres.any { it.equals("Anime", ignoreCase = true) || it.equals("Animation", ignoreCase = true) }
+}
+
+private fun jikanGet(url: String): String {
+    val connection = URL(url).openConnection() as HttpURLConnection
+    connection.connectTimeout = 10_000
+    connection.readTimeout = 15_000
+    return try {
+        connection.inputStream.bufferedReader().use { it.readText() }
+    } finally {
+        connection.disconnect()
+    }
+}
+
+private suspend fun loadFiller(title: String): FillerResult? {
+    synchronized(fillerCache) { if (fillerCache.containsKey(title)) return fillerCache[title] }
+    val result = withContext(Dispatchers.IO) {
+        try {
+            val query = URLEncoder.encode(title, "UTF-8")
+            val search = JSONObject(jikanGet("https://api.jikan.moe/v4/anime?q=$query&limit=1&type=tv"))
+                .optJSONArray("data")?.optJSONObject(0)
+            val malId = search?.optInt("mal_id", 0)?.takeIf { it > 0 }
+            if (malId == null) {
+                null
+            } else {
+                val filler = mutableListOf<Int>()
+                val recap = mutableListOf<Int>()
+                var page = 1
+                while (page <= 12) {
+                    if (page > 1) delay(400)
+                    val root = JSONObject(jikanGet("https://api.jikan.moe/v4/anime/$malId/episodes?page=$page"))
+                    val data = root.optJSONArray("data")
+                    if (data != null) {
+                        for (i in 0 until data.length()) {
+                            val ep = data.optJSONObject(i) ?: continue
+                            val number = ep.optInt("mal_id", 0).takeIf { it > 0 } ?: continue
+                            if (ep.optBoolean("filler", false)) filler += number
+                            if (ep.optBoolean("recap", false)) recap += number
+                        }
+                    }
+                    if (root.optJSONObject("pagination")?.optBoolean("has_next_page", false) != true) break
+                    page++
+                }
+                FillerResult(filler, recap)
+            }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            null
+        }
+    }
+    synchronized(fillerCache) { fillerCache[title] = result }
+    return result
+}
+
+private fun List<Int>.asRanges(): String {
+    if (isEmpty()) return "none"
+    val sorted = distinct().sorted()
+    val parts = mutableListOf<String>()
+    var start = sorted.first()
+    var prev = start
+    for (n in sorted.drop(1)) {
+        if (n == prev + 1) {
+            prev = n
+            continue
+        }
+        parts += if (start == prev) "$start" else "$start-$prev"
+        start = n
+        prev = n
+    }
+    parts += if (start == prev) "$start" else "$start-$prev"
+    return parts.joinToString(", ")
+}
+
+@Composable
+internal fun FillerGuideTv(metaId: String, title: String, modifier: Modifier = Modifier) {
+    val enabled by com.nuvio.tv.data.repository.ForkTvPreferences.fillerGuide.value.collectAsStateWithLifecycle()
+    val context = androidx.compose.ui.platform.LocalContext.current
+    LaunchedEffect(Unit) { com.nuvio.tv.data.repository.ForkTvPreferences.fillerGuide.ensureLoaded(context) }
+    if (!enabled) return
+    var state by remember(metaId) { mutableStateOf<FillerResult?>(null) }
+    var done by remember(metaId) { mutableStateOf(false) }
+    LaunchedEffect(metaId) {
+        state = loadFiller(title)
+        done = true
+    }
+    val result = state
+    if (!done || result == null || (result.filler.isEmpty() && result.recap.isEmpty())) return
+    Column(
+        modifier = modifier.fillMaxWidth().padding(horizontal = 48.dp, vertical = 12.dp),
+        verticalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        Text(text = "Filler guide", fontSize = 18.sp, color = NuvioTheme.colors.TextPrimary)
+        Text(
+            text = "Filler episodes: ${result.filler.asRanges()}",
+            fontSize = 14.sp,
+            color = NuvioTheme.colors.TextPrimary,
+        )
+        if (result.recap.isNotEmpty()) {
+            Text(
+                text = "Recap episodes: ${result.recap.asRanges()}",
+                fontSize = 14.sp,
+                color = NuvioTheme.colors.TextSecondary,
+            )
+        }
+        Text(
+            text = "Numbers follow MyAnimeList and count from the first episode of the show.",
+            fontSize = 12.sp,
+            color = NuvioTheme.colors.TextSecondary,
+        )
+    }
+}
