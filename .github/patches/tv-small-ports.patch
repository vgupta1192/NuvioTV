+        "quality" to "Video quality",
+        "chapters" to "Chapters",
+        "sources" to "Sources",
+        "episodes" to "Episodes",
+        "speed" to "Playback speed",
+        "aspect" to "Aspect ratio",
+        "engine" to "Switch player engine",
+        "info" to "Stream info"
+    )
+
+    private val _hidden = MutableStateFlow<Set<String>>(emptySet())
+    val hidden: StateFlow<Set<String>> = _hidden.asStateFlow()
+
+    @Volatile
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        synchronized(this) {
+            if (loaded) return
+            _hidden.value = prefs(context).getStringSet("hidden", emptySet()).orEmpty().toSet()
+            loaded = true
+        }
+    }
+
+    fun setVisible(context: Context, id: String, visible: Boolean) {
+        ensureLoaded(context)
+        val next = if (visible) _hidden.value - id else _hidden.value + id
+        _hidden.value = next
+        prefs(context).edit().putStringSet("hidden", next).apply()
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("nuvio_fork_tv_settings", Context.MODE_PRIVATE)
+}
