+package com.nuvio.tv.data.repository
+
+import android.content.Context
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** The user's own OMDb API key, used only as a fallback source for episode ratings. */
+object OmdbKeyPreferences {
+    private const val PREFS = "nuvio_omdb_settings"
+    private const val KEY_API_KEY = "api_key"
+
+    private val _key = MutableStateFlow("")
+    val key: StateFlow<String> = _key.asStateFlow()
+
+    @Volatile
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        synchronized(this) {
+            if (loaded) return
+            _key.value = prefs(context).getString(KEY_API_KEY, null).orEmpty()
+            loaded = true
+        }
+    }
+
+    fun setKey(context: Context, value: String) {
+        val trimmed = value.trim()
+        _key.value = trimmed
+        loaded = true
+        prefs(context).edit().putString(KEY_API_KEY, trimmed).apply()
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+}
