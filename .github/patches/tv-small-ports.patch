@@ -0,0 +1,33 @@
+package com.nuvio.tv.core.network
+
+import android.content.Context
+
+/** Fork feature: resolve host names through DNS over HTTPS instead of the system resolver. */
+enum class DohProvider(val id: String, val label: String, val endpoint: String?) {
+    OFF("off", "System DNS", null),
+    CLOUDFLARE("cloudflare", "Cloudflare (1.1.1.1)", "https://1.1.1.1/dns-query"),
+    GOOGLE("google", "Google (8.8.8.8)", "https://8.8.8.8/resolve"),
+}
+
+object DohSetting {
+    private const val PREFS = "nuvio_tv_doh"
+
+    @Volatile
+    var provider: DohProvider = DohProvider.OFF
+        private set
+
+    fun init(context: Context) {
+        val id = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getString("provider", null)
+        provider = DohProvider.values().firstOrNull { it.id == id } ?: DohProvider.OFF
+    }
+
+    fun set(context: Context, value: DohProvider) {
+        provider = value
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putString("provider", value.id).apply()
+    }
+
+    fun next(current: DohProvider): DohProvider {
+        val all = DohProvider.values()
+        return all[(all.indexOf(current) + 1) % all.size]
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/network/IPv4FirstDns.kt b/app/src/main/java/com/nuvio/tv/core/network/IPv4FirstDns.kt
