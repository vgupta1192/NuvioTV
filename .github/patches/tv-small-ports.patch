+    val autoAddTorbox = ForkTvBoolPref("auto_add_torbox", false)
+    val homeUpNextTonight = ForkTvBoolPref("home_up_next_tonight", true)
+    val homeAiringWeek = ForkTvBoolPref("home_airing_week", true)
