+package com.nuvio.tv.data.repository
+
+import android.util.Log
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+
+internal object OmdbEpisodeRatingsClient {
+    private const val TAG = "OmdbEpisodeRatings"
+
+    suspend fun fetch(imdbId: String, apiKey: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.IO) {
+        if (apiKey.isBlank()) return@withContext emptyMap()
+        val out = mutableMapOf<Pair<Int, Int>, Double>()
+        try {
+            val head = JSONObject(get("https://www.omdbapi.com/?i=$imdbId&apikey=$apiKey"))
+            val totalSeasons = head.optString("totalSeasons").toIntOrNull() ?: return@withContext emptyMap()
+            for (season in 1..minOf(totalSeasons, 40)) {
+                val root = JSONObject(get("https://www.omdbapi.com/?i=$imdbId&Season=$season&apikey=$apiKey"))
+                val episodes = root.optJSONArray("Episodes") ?: continue
+                for (i in 0 until episodes.length()) {
+                    val ep = episodes.getJSONObject(i)
+                    val number = ep.optString("Episode").toIntOrNull() ?: continue
+                    val rating = ep.optString("imdbRating").toDoubleOrNull() ?: continue
+                    if (rating > 0.0) out[season to number] = rating
+                }
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "OMDb episode ratings failed for $imdbId", e)
+        }
+        out
+    }
+
+    private fun get(url: String): String {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        connection.connectTimeout = 10_000
+        connection.readTimeout = 15_000
+        return try {
+            connection.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
