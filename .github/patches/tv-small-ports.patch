+
+private fun forkRow(id: String, name: String, entries: List<LibraryEntry>) = CatalogRow(
+    addonId = "fork.library",
+    addonName = "Library",
+    addonBaseUrl = "fork://library",
+    catalogId = id,
+    catalogName = name,
+    type = ContentType.SERIES,
+    rawType = "series",
+    items = entries.map { it.toMetaPreview() },
+    isLoading = false,
+    hasMore = false
+)
+
+/** Extra Home rows from the saved library: up next tonight and airing this week. */
+@Composable
+internal fun rememberForkLibraryHomeRows(viewModel: HomeViewModel): List<CatalogRow> {
+    val context = LocalContext.current
+    ForkTvPreferences.homeUpNextTonight.ensureLoaded(context)
+    ForkTvPreferences.homeAiringWeek.ensureLoaded(context)
+    val showTonight by ForkTvPreferences.homeUpNextTonight.value.collectAsStateWithLifecycle()
+    val showWeek by ForkTvPreferences.homeAiringWeek.value.collectAsStateWithLifecycle()
+    val library by viewModel.libraryRepository.libraryItems.collectAsStateWithLifecycle(initialValue = emptyList())
+    var rows by remember { mutableStateOf<List<CatalogRow>>(emptyList()) }
+
+    val series = library.filter { it.type.trim().lowercase() in setOf("series", "show", "tv") }
+    LaunchedEffect(series.map { it.id }, showTonight, showWeek) {
+        if ((!showTonight && !showWeek) || series.isEmpty()) {
+            rows = emptyList()
+            return@LaunchedEffect
+        }
+        val events = runCatching { loadLibraryCalendar(context, series) }.getOrDefault(emptyList())
+            .filter { it.entry.type.trim().lowercase() in setOf("series", "show", "tv") }
+        val today = LocalDate.now()
+        val tonight = events.filter { it.date == today }.map { it.entry }.distinctBy { it.id }
+        val week = events.filter { it.date.isAfter(today) && !it.date.isAfter(today.plusDays(7)) }
+            .sortedBy { it.date }.map { it.entry }.distinctBy { it.id }
+        rows = buildList {
+            if (showTonight && tonight.isNotEmpty()) add(forkRow("up_next_tonight", "Up next tonight", tonight))
+            if (showWeek && week.isNotEmpty()) add(forkRow("airing_this_week", "Airing this week", week))
+        }
+    }
+    return if (showTonight || showWeek) rows else emptyList()
+}
+
+internal fun HomeUiState.withForkRows(extra: List<CatalogRow>): HomeUiState {
+    if (extra.isEmpty()) return this
+    return copy(
+        catalogRows = extra + catalogRows,
+        homeRows = if (homeRows.isNotEmpty()) extra.map { HomeRow.Catalog(it) } + homeRows else homeRows
+    )
+}
