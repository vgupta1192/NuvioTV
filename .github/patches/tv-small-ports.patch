+@file:OptIn(androidx.tv.material3.ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import com.nuvio.tv.ui.screens.player.TvForkPlayerPrefs
+
+@Composable
+internal fun TvForkPlayerSettingsCard() {
+    val context = LocalContext.current
+    var subsOff by remember { mutableStateOf(TvForkPlayerPrefs.subtitlesStartOff) }
+    var sleepLeft by remember { mutableStateOf(TvForkPlayerPrefs.sleepMinutesLeft()) }
+    SettingsGroupCard(modifier = Modifier.fillMaxWidth(), title = "Player extras") {
+        SettingsToggleRow(
+            title = "Subtitles start off",
+            subtitle = "Do not auto-select a subtitle track. Pick one by hand when needed.",
+            checked = subsOff,
+            onToggle = {
+                subsOff = !subsOff
+                TvForkPlayerPrefs.setSubtitlesStartOff(context, subsOff)
+            },
+        )
+        SettingsActionRow(
+            title = "Sleep timer",
+            subtitle = "Pause playback after the chosen time. Click to cycle 15, 30, 45, 60, 90 minutes, then off.",
+            value = if (sleepLeft == 0) "Off" else "$sleepLeft min",
+            onClick = {
+                TvForkPlayerPrefs.setSleepMinutes(TvForkPlayerPrefs.nextSleepMinutes())
+                sleepLeft = TvForkPlayerPrefs.sleepMinutesLeft()
+            },
+        )
+    }
+}
