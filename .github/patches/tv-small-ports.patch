+    var provider by remember { mutableStateOf(DohSetting.provider) }
+    SettingsGroupCard(modifier = Modifier.fillMaxWidth(), title = "Network") {
+        SettingsActionRow(
+            title = "DNS over HTTPS",
+            subtitle = "Resolve host names through a secure DNS server. Applies to new connections. Click to switch.",
+            value = provider.label,
+            onClick = {
+                val next = DohSetting.next(provider)
+                DohSetting.set(context, next)
+                provider = next
+            },
+        )
+    }
+}
