+package com.nuvio.tv.data.publicmetadb
+
+import android.content.Context
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.core.profile.ProtectedProfilePreferences
+import com.nuvio.tv.core.tracking.TrackingHistoryItem
+import com.nuvio.tv.core.tracking.TrackingMediaKind
+import com.nuvio.tv.core.tracking.TrackingMediaReference
+import com.nuvio.tv.core.tracking.TrackingMutationResult
+import com.nuvio.tv.core.tracking.TrackingScrobbleAction
+import com.nuvio.tv.core.tracking.TrackingScrobbleEvent
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.net.URLEncoder
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+
+data class PublicMetaDbUiState(
+    val isConnected: Boolean = false,
+    val busy: Boolean = false,
+    val error: String? = null
+)
+
+/**
+ * PublicMetaDB account for the fork (compact port of the NuvioMobile PublicMetaDB tracker): API-key sign in,
+ * live resume points while playing and watched-history writes. Library, list and rating reads stay Mobile-only.
+ */
+@Singleton
+class PublicMetaDbService @Inject constructor(
+    @ApplicationContext context: Context,
+    private val http: OkHttpClient,
+    private val profiles: ProfileManager
+) {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val store = ProtectedProfilePreferences(context, "publicmetadb_auth", "com.nuvio.tv.publicmetadb.credentials.v1")
+    private val writeMutex = Mutex()
+    private val resolved = ConcurrentHashMap<String, Long>()
+    private var activeProfile = profiles.activeProfileId.value
+    @Volatile private var lastRequestAt = 0L
+
+    private val mutableState = MutableStateFlow(PublicMetaDbUiState(isConnected = readKey(activeProfile) != null))
+    val state: StateFlow<PublicMetaDbUiState> = mutableState.asStateFlow()
+
+    init {
+        scope.launch {
+            profiles.activeProfileId.collect { profileId ->
+                if (profileId == activeProfile) return@collect
+                activeProfile = profileId
+                mutableState.value = PublicMetaDbUiState(isConnected = readKey(profileId) != null)
+            }
+        }
+    }
+
+    /** Checks the key against the API and stores it when valid. */
+    fun connect(apiKey: String) {
+        val key = apiKey.trim()
+        if (key.isEmpty() || mutableState.value.busy) return
+        val profileId = activeProfile
+        mutableState.value = mutableState.value.copy(busy = true, error = null)
+        scope.launch {
+            val error = try {
+                val response = send("GET", "/api/external/lists", listOf("page" to "1", "perPage" to "1"), null, key)
+                when {
+                    response.status in 200..299 -> null
+                    response.status == 401 || response.status == 403 -> "PublicMetaDB rejected this API key."
+                    response.status == 429 -> "PublicMetaDB is rate limiting requests, try again shortly."
+                    else -> "PublicMetaDB is unavailable (${response.status})."
+                }
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                error.message ?: "PublicMetaDB request failed"
+            }
+            if (error == null) {
+                store.write(profileId, key)
+                if (profileId == activeProfile) mutableState.value = PublicMetaDbUiState(isConnected = true)
+            } else if (profileId == activeProfile) {
+                mutableState.value = PublicMetaDbUiState(error = error)
+            }
+        }
+    }
+
+    fun disconnect() {
+        store.write(activeProfile, null)
+        mutableState.value = PublicMetaDbUiState()
+    }
+
+    fun clearError() {
+        mutableState.value = mutableState.value.copy(error = null)
+    }
+
+    /** Playing a title is not reported; pausing or stopping saves a resume point, or marks it watched past 80%. */
+    suspend fun scrobble(action: TrackingScrobbleAction, event: TrackingScrobbleEvent) {
+        if (action == TrackingScrobbleAction.START) return
+        if (!mutableState.value.isConnected || !event.progressPercent.isFinite()) return
+        val media = event.media
+        val target = resolveTarget(media) ?: return
+        val percent = event.progressPercent.coerceIn(0.0, 100.0)
+        writeMutex.withLock {
+            when {
+                percent >= COMPLETE_PERCENT -> {
+                    postWatched(target, media, null)
+                    deleteResume(target)
+                }
+                percent >= MIN_RESUME_PERCENT -> {
+                    val runtime = if (target.isMovie) DEFAULT_MOVIE_RUNTIME_MS else DEFAULT_EPISODE_RUNTIME_MS
+                    saveResume(target, (runtime * percent / 100.0).toLong(), runtime)
+                }
+            }
+        }
+    }
+
+    suspend fun addToHistory(items: Collection<TrackingHistoryItem>): TrackingMutationResult {
+        if (!mutableState.value.isConnected) return TrackingMutationResult(0)
+        var notFound = 0
+        writeMutex.withLock {
+            items.forEach { item ->
+                if (item.isWholeSeriesMark) {
+                    notFound++
+                    return@forEach
+                }
+                val target = resolveTarget(item.media)
+                if (target == null) {
+                    notFound++
+                } else {
+                    postWatched(target, item.media, item.watchedAtEpochMs)
+                    deleteResume(target)
+                }
+            }
+        }
+        return TrackingMutationResult(items.size, notFound)
+    }
+
+    suspend fun removeFromHistory(items: Collection<TrackingMediaReference>): TrackingMutationResult {
+        if (!mutableState.value.isConnected) return TrackingMutationResult(0)
+        var notFound = 0
+        writeMutex.withLock {
+            items.forEach { media ->
+                val target = if (media.kind != TrackingMediaKind.MOVIE && media.episode == null) null else resolveTarget(media)
+                if (target == null) {
+                    notFound++
+                    return@forEach
+                }
+                val query = mutableListOf("tmdb_id" to target.tmdbId.toString(), "media_type" to target.mediaType)
+                if (!target.isMovie) {
+                    query += "season" to target.season.toString()
+                    query += "episode" to target.episode.toString()
+                }
+                call("DELETE", "/api/external/watched", query, null, allowStatuses = setOf(404))
+            }
+        }
+        return TrackingMutationResult(items.size, notFound)
+    }
+
+    // --- writes ---
+
+    private data class Target(val tmdbId: Long, val isMovie: Boolean, val season: Int, val episode: Int) {
+        val mediaType: String get() = if (isMovie) "movie" else "tv"
+    }
+
+    private suspend fun postWatched(target: Target, media: TrackingMediaReference, watchedAt: Long?) {
+        val body = JSONObject()
+            .put("tmdb_id", target.tmdbId)
+            .put("media_type", target.mediaType)
+            .put("watched_at", isoTimestamp(watchedAt ?: System.currentTimeMillis()))
+        if (!target.isMovie) body.put("season", target.season).put("episode", target.episode)
+        media.ids.imdb?.takeIf(String::isNotBlank)?.let { body.put("id_type", "imdb").put("id_value", it) }
+        call("POST", "/api/external/watched", listOf("dedupe" to "true"), body, allowStatuses = setOf(409))
+    }
+
+    private suspend fun saveResume(target: Target, positionMs: Long, runtimeMs: Long) {
+        val body = JSONObject()
+            .put("tmdb_id", target.tmdbId)
+            .put("media_type", target.mediaType)
+            .put("season", if (target.isMovie) 0 else target.season)
+            .put("episode", if (target.isMovie) 0 else target.episode)
+            .put("position_ms", positionMs)
+            .put("runtime_ms", runtimeMs)
+        val first = call("POST", "/api/external/resume", emptyList(), body, allowStatuses = setOf(409))
+        if (first?.status == 409) {
+            findResumeId(target)?.let { call("DELETE", "/api/external/resume/${encode(it)}", emptyList(), null, allowStatuses = setOf(404)) }
+            call("POST", "/api/external/resume", emptyList(), body, allowStatuses = setOf(409))
+        }
+    }
+
+    private suspend fun deleteResume(target: Target) {
+        val id = findResumeId(target) ?: return
+        call("DELETE", "/api/external/resume/${encode(id)}", emptyList(), null, allowStatuses = setOf(404))
+    }
+
+    private suspend fun findResumeId(target: Target): String? {
+        for (page in 1..RESUME_LOOKUP_MAX_PAGES) {
+            val response = call(
+                "GET", "/api/external/resume",
+                listOf("page" to page.toString(), "perPage" to RESUME_LOOKUP_PAGE_SIZE.toString()),
+                null, allowStatuses = setOf(404)
+            ) ?: return null
+            if (response.status == 404) return null
+            val rows = response.items()
+            for (i in 0 until rows.length()) {
+                val row = rows.optJSONObject(i) ?: continue
+                val type = row.optString("media_type").ifBlank { row.optString("mediaType") }
+                val isMovie = if (type.isBlank()) target.isMovie else type.equals("movie", ignoreCase = true)
+                val tmdb = row.optLong("tmdb_id", row.optLong("tmdbId", -1L))
+                val sameEpisode = target.isMovie ||
+                    (row.optInt("season", row.optInt("season_number", -1)) == target.season &&
+                        row.optInt("episode", row.optInt("episode_number", -1)) == target.episode)
+                if (isMovie == target.isMovie && tmdb == target.tmdbId && sameEpisode) {
+                    row.optString("id").takeIf(String::isNotBlank)?.let { return it }
+                }
+            }
+            val totalPages = runCatching { JSONObject(response.body).let { it.optInt("totalPages", it.optInt("total_pages", 1)) } }.getOrDefault(1)
+            if (rows.length() == 0 || page >= totalPages) return null
+        }
+        return null
+    }
+
+    // --- id resolution ---
+
+    private suspend fun resolveTarget(media: TrackingMediaReference): Target? {
+        val isMovie = media.kind == TrackingMediaKind.MOVIE
+        val episode = media.episode
+        if (!isMovie && episode == null) return null
+        val tmdbId = media.ids.tmdb ?: lookupTmdb(media, isMovie) ?: return null
+        return Target(tmdbId, isMovie, episode?.season ?: 1, episode?.number ?: 1)
+    }
+
+    private suspend fun lookupTmdb(media: TrackingMediaReference, isMovie: Boolean): Long? {
+        val candidates = listOfNotNull(
+            media.ids.imdb?.takeIf(String::isNotBlank)?.let { "imdb" to it },
+            media.ids.tvdb?.takeIf(String::isNotBlank)?.let { "tvdb" to it },
+            media.ids.anilist?.let { "anilist" to it.toString() },
+            media.ids.mal?.let { "mal" to it.toString() },
+            media.ids.anidb?.let { "anidb" to it.toString() },
+            media.ids.trakt?.let { "trakt" to it.toString() }
+        )
+        val mediaType = if (isMovie) "movie" else "tv"
+        for ((type, value) in candidates) {
+            val cacheKey = "$mediaType:$type:$value"
+            resolved[cacheKey]?.let { return it }
+            val response = call(
+                "GET", "/api/external/mappings/lookup",
+                listOf("id_type" to type, "id_value" to value, "media_type" to mediaType),
+                null, allowStatuses = setOf(404)
+            ) ?: continue
+            if (response.status == 404) continue
+            val rows = response.items()
+            var best: Long? = null
+            var bestVotes = -1
+            for (i in 0 until rows.length()) {
+                val row = rows.optJSONObject(i) ?: continue
+                val tmdb = row.optLong("tmdb_id", row.optLong("tmdbId", -1L)).takeIf { it > 0L } ?: continue
+                val votes = row.optInt("votes", 0)
+                if (votes > bestVotes) {
+                    best = tmdb
+                    bestVotes = votes
+                }
+            }
+            if (best != null) {
+                resolved[cacheKey] = best
+                return best
+            }
+        }
+        return null
+    }
+
+    // --- http ---
+
+    private data class Response(val status: Int, val body: String) {
+        fun items(): JSONArray = runCatching {
+            val trimmed = body.trim()
+            if (trimmed.startsWith("[")) return JSONArray(trimmed)
+            val root = JSONObject(trimmed)
+            listOf("items", "results", "data", "watched_history", "lists", "ratings")
+                .firstNotNullOfOrNull { root.optJSONArray(it) } ?: JSONArray()
+        }.getOrDefault(JSONArray())
+    }
+
+    /** Authorized call with 429 back-off; null when no key is stored. Statuses in [allowStatuses] are returned, other failures throw. */
+    private suspend fun call(
+        method: String,
+        path: String,
+        query: List<Pair<String, String>>,
+        body: JSONObject?,
+        allowStatuses: Set<Int> = emptySet()
+    ): Response? {
+        val profileId = activeProfile
+        val key = readKey(profileId) ?: return null
+        var attempt = 0
+        while (true) {
+            val response = send(method, path, query, body, key)
+            when {
+                response.status in 200..299 || response.status in allowStatuses -> return response
+                response.status == 401 -> {
+                    store.write(profileId, null)
+                    if (profileId == activeProfile) mutableState.value = PublicMetaDbUiState(error = "PublicMetaDB rejected the API key. Enter it again.")
+                    return null
+                }
+                response.status == 429 && ++attempt < MAX_ATTEMPTS -> delay(RETRY_AFTER_MS * attempt)
+                else -> throw IllegalStateException("PublicMetaDB $path failed (${response.status})")
+            }
+        }
+    }
+
+    private suspend fun send(
+        method: String,
+        path: String,
+        query: List<Pair<String, String>>,
+        body: JSONObject?,
+        key: String
+    ): Response = withContext(Dispatchers.IO) {
+        val wait = MIN_SPACING_MS - (System.currentTimeMillis() - lastRequestAt)
+        if (wait > 0) delay(wait)
+        lastRequestAt = System.currentTimeMillis()
+        val url = buildString {
+            append(BASE_URL).append(path)
+            if (query.isNotEmpty()) append('?').append(query.joinToString("&") { (k, v) -> "${encode(k)}=${encode(v)}" })
+        }
+        val request = Request.Builder()
+            .url(url)
+            .header("Accept", "application/json")
+            .header("User-Agent", USER_AGENT)
+            .header("Authorization", "Bearer $key")
+            .method(method, if (method == "GET" || method == "DELETE") null else (body?.toString() ?: "{}").toRequestBody(JSON))
+            .build()
+        http.newCall(request).execute().use { Response(it.code, it.body?.string().orEmpty()) }
+    }
+
+    private fun readKey(profileId: Int): String? = store.read(profileId)?.takeIf(String::isNotBlank)
+
+    private fun encode(value: String): String = URLEncoder.encode(value, "UTF-8").replace("+", "%20")
+
+    private fun isoTimestamp(epochMs: Long): String =
+        SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US)
+            .apply { timeZone = TimeZone.getTimeZone("UTC") }
+            .format(Date(epochMs))
+
+    private companion object {
+        const val BASE_URL = "https://publicmetadb.com"
+        const val USER_AGENT = "NuvioTV"
+        const val COMPLETE_PERCENT = 80.0
+        const val MIN_RESUME_PERCENT = 1.0
+        const val DEFAULT_MOVIE_RUNTIME_MS = 7_200_000L
+        const val DEFAULT_EPISODE_RUNTIME_MS = 2_700_000L
+        const val RESUME_LOOKUP_PAGE_SIZE = 100
+        const val RESUME_LOOKUP_MAX_PAGES = 5
+        const val MIN_SPACING_MS = 60L
+        const val RETRY_AFTER_MS = 2_000L
+        const val MAX_ATTEMPTS = 3
+        val JSON = "application/json".toMediaType()
+    }
+}
