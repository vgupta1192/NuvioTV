+private fun getConnectionType(context: android.content.Context): NetworkConnectionKind {
+    val cm = context.getSystemService<ConnectivityManager>() ?: return NetworkConnectionKind.Offline
+    return runCatching {
+        fun transportsOf(network: android.net.Network): Set<NetworkTransport>? {
+            val caps = cm.getNetworkCapabilities(network) ?: return null
+            return buildSet {
+                if (caps.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET)) add(NetworkTransport.Ethernet)
+                if (caps.hasTransport(NetworkCapabilities.TRANSPORT_WIFI)) add(NetworkTransport.Wifi)
+                if (caps.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR)) add(NetworkTransport.Cellular)
+                if (caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) add(NetworkTransport.Vpn)
+            }
+        }
+        val active = cm.activeNetwork
+        networkConnectionKind(
+            active = active?.let { transportsOf(it) },
+            others = { cm.allNetworks.filter { it != active }.mapNotNull { transportsOf(it) } }
+        )
+    }.getOrDefault(NetworkConnectionKind.Offline)
 }
 
