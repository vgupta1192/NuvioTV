diff --git a/app/src/main/java/com/nuvio/tv/core/diagnostics/ForkStability.kt b/app/src/main/java/com/nuvio/tv/core/diagnostics/ForkStability.kt
new file mode 100644
index 000000000..bdc623ea2
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/diagnostics/ForkStability.kt
@@ -0,0 +1,171 @@
+package com.nuvio.tv.core.diagnostics
+
+import android.app.ActivityManager
+import android.app.Activity
+import android.app.Application
+import android.content.ComponentCallbacks2
+import android.content.Context
+import android.content.res.Configuration
+import android.os.Bundle
+import android.os.Debug
+import android.os.Handler
+import android.os.Looper
+import android.util.Log
+import java.io.File
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.Executors
+
+/**
+ * Nuvio TV fork: stability diagnostics, local only.
+ *
+ * - Breadcrumbs: a small rolling text file with app events (activity lifecycle, memory trim
+ *   levels, memory snapshots, Live TV player events, freezes). It survives the process being
+ *   killed, so the crash reports saved at the next start can include it.
+ * - Freeze watchdog: if the main thread does not answer for 2 seconds, the main thread stack is
+ *   saved at once to a "Crash report" file, before Android can kill the app for being
+ *   unresponsive.
+ */
+object ForkStability {
+    private const val TAG = "NuvioStability"
+    private const val FILE_NAME = "fork-breadcrumbs.log"
+    private const val MAX_BYTES = 200_000L
+    private const val TICK_MS = 500L
+    private const val FREEZE_MS = 2_000L
+    private const val MEMORY_EVERY_MS = 20_000L
+    private val dumpAfterMs = longArrayOf(2_000L, 4_000L, 8_000L)
+
+    @Volatile private var breadcrumbFile: File? = null
+    private val writer = Executors.newSingleThreadExecutor { r -> Thread(r, "NuvioBreadcrumbs").apply { isDaemon = true } }
+    @Volatile private var lastTick = System.currentTimeMillis()
+    private var installed = false
+
+    fun install(app: Application) {
+        if (installed) return
+        installed = true
+        breadcrumbFile = File(app.filesDir, FILE_NAME)
+        note("app start pid=${android.os.Process.myPid()} maxHeapMb=${Runtime.getRuntime().maxMemory() shr 20}")
+
+        app.registerActivityLifecycleCallbacks(object : Application.ActivityLifecycleCallbacks {
+            override fun onActivityCreated(activity: Activity, savedInstanceState: Bundle?) = note("activity created ${activity.javaClass.simpleName}")
+            override fun onActivityStarted(activity: Activity) = note("activity started ${activity.javaClass.simpleName}")
+            override fun onActivityResumed(activity: Activity) = note("activity resumed ${activity.javaClass.simpleName}")
+            override fun onActivityPaused(activity: Activity) = note("activity paused ${activity.javaClass.simpleName}")
+            override fun onActivityStopped(activity: Activity) = note("activity stopped ${activity.javaClass.simpleName}")
+            override fun onActivitySaveInstanceState(activity: Activity, outState: Bundle) = Unit
+            override fun onActivityDestroyed(activity: Activity) = note("activity destroyed ${activity.javaClass.simpleName}")
+        })
+        app.registerComponentCallbacks(object : ComponentCallbacks2 {
+            override fun onTrimMemory(level: Int) = note("trim memory level=$level ${memoryLine(app)}")
+            override fun onLowMemory() = note("LOW MEMORY ${memoryLine(app)}")
+            override fun onConfigurationChanged(newConfig: Configuration) = Unit
+        })
+
+        val mainHandler = Handler(Looper.getMainLooper())
+        val tick = object : Runnable {
+            override fun run() { lastTick = System.currentTimeMillis() }
+        }
+        Thread({ watchLoop(app, mainHandler, tick) }, "NuvioFreezeWatchdog").apply { isDaemon = true; priority = Thread.NORM_PRIORITY + 1 }.start()
+    }
+
+    fun note(message: String) {
+        val file = breadcrumbFile ?: return
+        val line = "${stamp(System.currentTimeMillis())} $message\n"
+        runCatching {
+            writer.execute {
+                runCatching {
+                    if (file.length() > MAX_BYTES) {
+                        val kept = file.readText().takeLast((MAX_BYTES / 2).toInt())
+                        file.writeText(kept.substringAfter('\n', kept))
+                    }
+                    file.appendText(line)
+                }
+            }
+        }
+    }
+
+    fun tail(lines: Int = 150): String = runCatching {
+        breadcrumbFile?.takeIf(File::exists)?.readLines()?.takeLast(lines)?.joinToString("\n").orEmpty()
+    }.getOrDefault("")
+
+    private fun watchLoop(app: Application, handler: Handler, tick: Runnable) {
+        var freezeStart = 0L
+        var dumps = 0
+        var freezeFile: File? = null
+        var lastMemory = 0L
+        while (true) {
+            runCatching {
+                handler.post(tick)
+                Thread.sleep(TICK_MS)
+                val now = System.currentTimeMillis()
+                val blockedFor = now - lastTick
+                if (blockedFor >= FREEZE_MS) {
+                    if (freezeStart == 0L) {
+                        freezeStart = now - blockedFor
+                        dumps = 0
+                        freezeFile = null
+                        note("FREEZE started, main thread blocked ${blockedFor}ms")
+                    }
+                    if (dumps < dumpAfterMs.size && blockedFor >= dumpAfterMs[dumps]) {
+                        dumps++
+                        freezeFile = saveFreeze(app, freezeFile, blockedFor)
+                    }
+                } else if (freezeStart != 0L) {
+                    note("FREEZE ended after ~${now - freezeStart}ms")
+                    freezeStart = 0L
+                }
+                if (now - lastMemory >= MEMORY_EVERY_MS) {
+                    lastMemory = now
+                    note(memoryLine(app))
+                }
+            }
+        }
+    }
+
+    private fun saveFreeze(app: Application, existing: File?, blockedFor: Long): File? = runCatching {
+        val directory = File(app.cacheDir, "autosync-debug").apply { mkdirs() }
+        val file = existing ?: File(directory, "autosync-crash-freeze-${System.currentTimeMillis()}.txt")
+        val text = buildString {
+            appendLine("Main thread freeze (not yet an ANR if under 5 s)")
+            appendLine("blockedFor=${blockedFor}ms at=${stamp(System.currentTimeMillis())}")
+            appendLine(memoryLine(app))
+            appendLine()
+            appendLine("--- main thread stack ---")
+            Looper.getMainLooper().thread.stackTrace.forEach { appendLine("  at $it") }
+            appendLine()
+            appendLine("--- other threads (top frames) ---")
+            Thread.getAllStackTraces().entries
+                .filter { it.key != Looper.getMainLooper().thread && it.value.isNotEmpty() }
+                .take(40)
+                .forEach { (thread, frames) ->
+                    appendLine("\"${thread.name}\" ${thread.state}")
+                    frames.take(8).forEach { appendLine("  at $it") }
+                }
+            appendLine()
+            appendLine("--- breadcrumbs ---")
+            appendLine(tail(80))
+        }
+        file.writeText(text)
+        directory.listFiles { f -> f.name.startsWith("autosync-crash-") }
+            .orEmpty()
+            .sortedByDescending(File::lastModified)
+            .drop(10)
+            .forEach(File::delete)
+        file
+    }.onFailure { Log.w(TAG, "freeze report failed: ${it.message}") }.getOrNull()
+
+    private fun memoryLine(context: Context): String = runCatching {
+        val runtime = Runtime.getRuntime()
+        val usedMb = (runtime.totalMemory() - runtime.freeMemory()) shr 20
+        val maxMb = runtime.maxMemory() shr 20
+        val nativeMb = Debug.getNativeHeapAllocatedSize() shr 20
+        val info = ActivityManager.MemoryInfo()
+        (context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager).getMemoryInfo(info)
+        "mem javaMb=$usedMb/$maxMb nativeMb=$nativeMb systemFreeMb=${info.availMem shr 20} " +
+            "lowMemory=${info.lowMemory} threads=${Thread.activeCount()}"
+    }.getOrDefault("mem unavailable")
+
+    private fun stamp(time: Long): String =
+        SimpleDateFormat("MM-dd HH:mm:ss.SSS", Locale.US).format(Date(time))
+}
