+package com.nuvio.tv.core.diagnostics
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.State
+import androidx.compose.runtime.produceState
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/** Computes [compute] on a background thread so big list work never blocks the main thread. */
+@Composable
+fun <T> rememberOffMain(initial: T, key1: Any?, key2: Any? = null, compute: () -> T): State<T> =
+    produceState(initialValue = initial, key1, key2) {
+        value = withContext(Dispatchers.Default) { compute() }
+    }
