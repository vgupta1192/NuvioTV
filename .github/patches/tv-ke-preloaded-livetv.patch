+    private fun parseFreeCatalog(text: String): Map<String, List<FreeCatalogEntry>> {
+        val groups = LinkedHashMap<String, MutableList<FreeCatalogEntry>>()
+        var attrs: Map<String, String> = emptyMap()
+        var name: String? = null
+        for (raw in text.lineSequence()) {
