+/** Subtitle of a source row: "Free channels · N countries · M channels" for free-catalog sources. */
+@Composable
+private fun freeSourceSummary(source: IptvSource, countries: List<IptvFreeCountry>): String {
+    if (source.kind != IptvKind.FREE) return source.kindLabel
+    val counts = remember(countries) { countries.associate { it.name to it.channelCount } }
+    return if (counts.isEmpty()) {
+        stringResource(R.string.iptv_free_source_summary_short, source.countries.size)
+    } else {
+        stringResource(
+            R.string.iptv_free_source_summary,
+            source.countries.size,
+            source.countries.sumOf { counts[it] ?: 0 },
+        )
+    }
 }
 
