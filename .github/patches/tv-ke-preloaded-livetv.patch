+    /** Like [httpGet] but refuses bodies over [maxBytes] — the free catalog playlist is several MiB. */
+    private fun httpGetCapped(url: String, headers: Map<String, String>, maxBytes: Long): String {
+        val request = Request.Builder().url(url).apply { headers.forEach { (k, v) -> header(k, v) } }.build()
+        http.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) error("HTTP ${response.code} from ${request.url.host}")
+            val body = response.body ?: return ""
+            val declared = body.contentLength()
+            if (declared > maxBytes) error("Free channels playlist is $declared bytes, over the ${maxBytes / (1024 * 1024)} MB cap")
+            val output = ByteArrayOutputStream(if (declared > 0) minOf(declared.toLong(), maxBytes).toInt() else 256 * 1024)
+            val buffer = ByteArray(64 * 1024)
+            var total = 0L
+            body.byteStream().use { input ->
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read == -1) break
+                    total += read
+                    if (total > maxBytes) error("Free channels playlist exceeds the ${maxBytes / (1024 * 1024)} MB fetch cap")
+                    output.write(buffer, 0, read)
+                }
+            }
+            return output.toString("UTF-8")
+        }
+    }
