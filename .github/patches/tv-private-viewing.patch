+package com.nuvio.tv.core.privacy
+
+import android.content.Context
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Private viewing (ported idea from NuvioMobile-Enhanced): while on, playback is not saved to watch
+ * progress / Continue Watching and is not scrobbled to Trakt, Simkl, MDBList and the like.
+ * Per device. Repositories inject this class so the stored value is loaded at app start; the
+ * settings row uses the static state below.
+ */
+object PrivateViewingState {
+    private const val PREFS = "nuvio_private_viewing"
+    private const val KEY = "enabled"
+
+    private val _enabled = MutableStateFlow(false)
+
+    @Volatile
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        synchronized(this) {
+            if (loaded) return
+            _enabled.value = prefs(context).getBoolean(KEY, false)
+            loaded = true
+        }
+    }
+
+    fun enabled(context: Context): StateFlow<Boolean> {
+        ensureLoaded(context)
+        return _enabled.asStateFlow()
+    }
+
+    fun isEnabled(): Boolean = _enabled.value
+
+    fun setEnabled(context: Context, value: Boolean) {
+        _enabled.value = value
+        loaded = true
+        prefs(context).edit().putBoolean(KEY, value).apply()
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+}
+
+@Singleton
+class PrivateViewing @Inject constructor(
+    @ApplicationContext context: Context,
+) {
+    init {
+        PrivateViewingState.ensureLoaded(context)
+    }
+
+    val isEnabled: Boolean
+        get() = PrivateViewingState.isEnabled()
+}
