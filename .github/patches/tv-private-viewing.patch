+@file:OptIn(androidx.tv.material3.ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.tv.R
+import com.nuvio.tv.core.privacy.PrivateViewingState
+
+/** "Private viewing" row under Playback > Player interface (fork feature). */
+@Composable
+internal fun privateViewingSettingsRow(enabled: Boolean) {
+    val context = LocalContext.current
+    val checked by PrivateViewingState.enabled(context).collectAsStateWithLifecycle()
+    SettingsToggleRow(
+        title = stringResource(R.string.settings_private_viewing),
+        subtitle = stringResource(R.string.settings_private_viewing_description),
+        checked = checked,
+        onToggle = { PrivateViewingState.setEnabled(context, !checked) },
+        enabled = enabled,
+    )
+}
