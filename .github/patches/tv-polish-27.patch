+/** Nuvio fork: tiny Range request so DNS, TLS and redirects are warm before autoplay. */
+private fun PlayerRuntimeController.warmStreamLink(url: String) {
+    scope.launch(kotlinx.coroutines.Dispatchers.IO) {
+        runCatching {
+            val request = okhttp3.Request.Builder()
+                .url(url)
+                .header("Range", "bytes=0-0")
+                .build()
+            PlayerPlaybackNetworking.playbackHttpClient.newCall(request).execute().close()
+        }
     }
 }
 
