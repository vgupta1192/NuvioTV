@@ -0,0 +1,54 @@
+package com.nuvio.tv.ui.screens.stream
+
+import androidx.compose.foundation.layout.padding
+import androidx.tv.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableLongStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.unit.dp
+import androidx.tv.material3.Text
+import kotlinx.coroutines.delay
+
+/**
+ * Nuvio fork: one line that shows the stream auto refresh is alive. It says whether the screen is
+ * waiting for the first load, checking the addons now, or idle, how long ago the last check ended,
+ * how many rounds ran and how many new links they added in total.
+ */
+@Composable
+internal fun ForkStreamRefreshStatus(
+    phase: Int,
+    rounds: Int,
+    added: Int,
+    lastAtMs: Long,
+    lastOk: Boolean,
+    manualLoading: Boolean,
+) {
+    var now by remember { mutableLongStateOf(System.currentTimeMillis()) }
+    LaunchedEffect(Unit) {
+        while (true) {
+            delay(1000)
+            now = System.currentTimeMillis()
+        }
+    }
+    val text = when {
+        manualLoading || phase == 0 -> "Auto refresh: waiting for the load to finish"
+        phase == 1 -> "Auto refresh: checking addons now · round ${rounds + 1} · +$added links so far"
+        else -> {
+            val ago = ((now - lastAtMs) / 1000).coerceAtLeast(0)
+            val result = if (lastOk) "ok" else "timed out"
+            "Auto refresh: last check ${ago}s ago ($result) · $rounds rounds · +$added links added"
+        }
+    }
+    val color = if (phase == 2 && !lastOk) Color(0xFFFFB74D) else Color.White.copy(alpha = 0.6f)
+    Text(
+        text = text,
+        style = MaterialTheme.typography.labelSmall,
+        color = color,
+        modifier = Modifier.padding(bottom = 6.dp)
+    )
+}
