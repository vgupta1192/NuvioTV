diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/settings/NetworkSettingsScreen.kt b/app/src/main/java/com/nuvio/tv/ui/screens/settings/NetworkSettingsScreen.kt
index e41fa7e4e6..9c8fdb32f9 100644
--- a/app/src/main/java/com/nuvio/tv/ui/screens/settings/NetworkSettingsScreen.kt
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/settings/NetworkSettingsScreen.kt
@@ -745,8 +745,23 @@ fun AdvancedSettingsContent(
                             else -> stringResource(R.string.stream_test_btn_running)
                         }
                     } else null,
-                    enabled = hasStream && !localStream && !isStreamRunning,
-                    onClick = { if (hasStream && !localStream && !isStreamRunning) runStreamDiagnostics() }
+                    enabled = hasStream && !localStream && !isStreamRunning && !deepTestRunning,
+                    onClick = { if (hasStream && !localStream && !isStreamRunning && !deepTestRunning) runStreamDiagnostics() }
+                )
+                // Deep test: the adaptive sweep (StreamSweepEngine). Gated on an
+                // open playback session — the sweep hammers the same host the
+                // player is streaming from, so it must never run concurrently.
+                val deepGateOpen = hasStream && !isStreamRunning && !deepTestRunning && !playerSessionOpen
+                SettingsActionRow(
+                    title = stringResource(R.string.network_sweep_card_title),
+                    subtitle = when {
+                        playerSessionOpen -> stringResource(R.string.network_sweep_playback_active)
+                        hasStream -> stringResource(R.string.network_sweep_card_subtitle)
+                        else -> stringResource(R.string.stream_test_no_stream)
+                    },
+                    value = if (deepTestRunning) stringResource(R.string.network_sweep_btn_running) else null,
+                    enabled = deepGateOpen,
+                    onClick = { if (deepGateOpen) runDeepSweep() }
                 )
             }
         }
