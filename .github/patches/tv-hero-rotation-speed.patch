+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import com.nuvio.tv.ui.screens.settings.SettingsActionRow
+import com.nuvio.tv.ui.screens.settings.SettingsPickerOption
+import com.nuvio.tv.ui.screens.settings.SettingsSingleChoiceDialog
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Nuvio fork: how fast the Home hero carousel rotates. 0 = off (no automatic rotation). Kept in SharedPreferences. */
+internal object DxHeroRotation {
+    private const val PREFS = "nuvio_tv_dx_hero_rotation"
+    private const val KEY = "interval_ms"
+    const val DEFAULT_MS = 10_000L
+    val choices: List<Pair<Long, String>> = listOf(
+        0L to "Off",
+        5_000L to "5 seconds",
+        8_000L to "8 seconds",
+        10_000L to "10 seconds (default)",
+        15_000L to "15 seconds",
+    )
+    private val _intervalMs = MutableStateFlow(DEFAULT_MS)
+    val intervalMs: StateFlow<Long> = _intervalMs.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        _intervalMs.value = context.applicationContext
+            .getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getLong(KEY, DEFAULT_MS)
+    }
+
+    fun set(context: Context, ms: Long) {
+        _intervalMs.value = ms
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putLong(KEY, ms).apply()
+    }
+}
+
+/** Layout > Home row under "Show hero": pick the rotation speed. */
+@Composable
+internal fun DxHeroRotationSettingsRow() {
+    val context = LocalContext.current
+    DxHeroRotation.ensureLoaded(context)
+    val current by DxHeroRotation.intervalMs.collectAsStateWithLifecycle()
+    var show by remember { mutableStateOf(false) }
+    val label = DxHeroRotation.choices.firstOrNull { it.first == current }?.second ?: "${current / 1000} seconds"
+    SettingsActionRow(
+        title = "Hero rotation speed",
+        subtitle = "How often the Home hero moves to the next title. It pauses while the hero is focused.",
+        value = label,
+        onClick = { show = true },
+    )
+    if (show) {
+        SettingsSingleChoiceDialog(
+            title = "Hero rotation speed",
+            options = DxHeroRotation.choices.map { SettingsPickerOption(it.first, it.second) },
+            selectedValue = current,
+            onOptionSelected = {
+                DxHeroRotation.set(context, it)
+                show = false
+            },
+            onDismiss = { show = false },
+        )
+    }
+}
