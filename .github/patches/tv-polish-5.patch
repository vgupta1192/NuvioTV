+    // Nuvio fork: shed cached bitmaps under memory pressure so low-RAM TVs keep headroom for playback.
+    override fun onTrimMemory(level: Int) {
+        super.onTrimMemory(level)
+        runCatching {
+            val cache = SingletonImageLoader.get(this).memoryCache ?: return@runCatching
+            when {
+                level >= TRIM_MEMORY_COMPLETE -> cache.clear()
+                level >= TRIM_MEMORY_RUNNING_LOW -> cache.trimToSize(cache.maxSize / 2)
+            }
+        }
+    }
