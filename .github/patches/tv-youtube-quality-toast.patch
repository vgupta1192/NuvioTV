--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/screens/player/QualityToast.kt
@@ -0,0 +1,47 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import android.util.Log
+import android.widget.Toast
+import androidx.media3.common.Format
+import androidx.media3.exoplayer.DecoderReuseEvaluation
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.media3.exoplayer.analytics.AnalyticsListener
+import com.nuvio.tv.youtube.YouTubeSettings
+
+/**
+ * Nuvio TV fork: shows the video quality when playback starts and whenever adaptive
+ * streaming moves up or down. The toast can be switched off in the YouTube settings;
+ * the log line is always written.
+ */
+internal object QualityToast {
+    private const val TAG = "NuvioQuality"
+
+    fun attach(player: ExoPlayer, context: Context) {
+        val app = context.applicationContext
+        player.addAnalyticsListener(object : AnalyticsListener {
+            private var lastHeight = 0
+            private var toast: Toast? = null
+
+            override fun onVideoInputFormatChanged(
+                eventTime: AnalyticsListener.EventTime,
+                format: Format,
+                decoderReuseEvaluation: DecoderReuseEvaluation?
+            ) {
+                val height = format.height
+                Log.d(TAG, "video ${format.width}x$height ${format.bitrate / 1000}k")
+                if (height <= 0 || height == lastHeight) return
+                val previous = lastHeight
+                lastHeight = height
+                if (!YouTubeSettings.qualityToast(app)) return
+                val message = when {
+                    previous == 0 -> "Quality: ${height}p"
+                    height > previous -> "Quality up: ${height}p"
+                    else -> "Quality down: ${height}p"
+                }
+                toast?.cancel()
+                toast = Toast.makeText(app, message, Toast.LENGTH_SHORT).also { it.show() }
+            }
+        })
+    }
+}
