+@EntryPoint
+@InstallIn(SingletonComponent::class)
+internal interface ForkTvKidsEntryPoint {
+    fun profileManager(): ProfileManager
+}
+
+/** Nuvio fork: age cap for the profile in use. Applies after the next Home refresh. */
+@Composable
+internal fun forkKidsModeRow() {
+    val context = LocalContext.current
+    val entry = remember(context) {
+        EntryPointAccessors.fromApplication(context.applicationContext, ForkTvKidsEntryPoint::class.java)
+    }
+    val profileId by entry.profileManager().activeProfileId.collectAsState()
+    var show by remember { mutableStateOf(false) }
+    var cap by remember(profileId) { mutableIntStateOf(ForkTvKids.cap(context, profileId)) }
+    SettingsActionRow(
+        title = "Kids mode (this profile)",
+        subtitle = "Hide titles rated above an age cap, and close detail pages that are. Titles with no rating stay visible.",
+        value = ForkTvKids.capLabels.firstOrNull { it.first == cap }?.second ?: "Off",
+        onClick = { show = true },
+    )
+    if (show) {
+        NuvioDialog(
+            onDismiss = { show = false },
+            title = "Kids mode",
+            subtitle = "Applies to the profile in use. Pull Home to refresh after a change.",
+            width = 620.dp,
+        ) {
+            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                ForkTvKids.capLabels.forEach { (level, label) ->
+                    Button(onClick = {
+                        ForkTvKids.setCap(context, profileId, level)
+                        cap = level
+                        show = false
+                    }) {
+                        Text((if (level == cap) "✓ " else "") + label, style = MaterialTheme.typography.bodyLarge)
+                    }
+                }
+            }
+        }
+    }
+}
