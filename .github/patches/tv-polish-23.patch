@@ -0,0 +1,47 @@
+package com.nuvio.tv.data.repository
+
+import android.content.Context
+
+/**
+ * Kids mode: a per-profile age cap. Items whose age rating is known and above the cap are hidden
+ * from Home rows, and a detail page above the cap closes at once. Items with no rating cannot be
+ * judged, so they stay visible.
+ */
+object ForkTvKids {
+    /** Cap levels: 0 off, 1 = G / TV-Y / TV-G, 2 = up to PG / TV-PG, 3 = up to PG-13 / TV-14. */
+    val capLabels: List<Pair<Int, String>> = listOf(
+        0 to "Off",
+        1 to "Little kids (G, TV-Y, TV-G)",
+        2 to "Kids (up to PG, TV-PG)",
+        3 to "Teens (up to PG-13, TV-14)",
+    )
+
+    fun cap(context: Context, profileId: Int): Int =
+        prefs(context).getInt("kids_cap_$profileId", 0)
+
+    fun setCap(context: Context, profileId: Int, cap: Int) {
+        prefs(context).edit().putInt("kids_cap_$profileId", cap).apply()
+    }
+
+    /** Level of a rating text, or null when it is not a known rating. */
+    fun levelOf(rating: String?): Int? {
+        val r = rating?.trim()?.uppercase()?.replace(" ", "")?.takeIf { it.isNotEmpty() } ?: return null
+        return when (r) {
+            "G", "TV-Y", "TVY", "TV-G", "TVG", "U", "0", "ALL" -> 1
+            "TV-Y7", "TV-Y7-FV", "TVY7", "PG", "TV-PG", "TVPG", "7" -> 2
+            "PG-13", "PG13", "TV-14", "TV14", "12", "13", "14" -> 3
+            "R", "NC-17", "NC17", "TV-MA", "TVMA", "X", "18", "16", "17", "21" -> 4
+            else -> null
+        }
+    }
+
+    fun allows(context: Context, profileId: Int, rating: String?): Boolean {
+        val cap = cap(context, profileId)
+        if (cap == 0) return true
+        val level = levelOf(rating) ?: return true
+        return level <= cap
+    }
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences("nuvio_fork_tv_settings", Context.MODE_PRIVATE)
+}
