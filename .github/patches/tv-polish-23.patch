+@EntryPoint
+@InstallIn(SingletonComponent::class)
+internal interface ForkTvHealthEntryPoint {
+    fun addonRepository(): AddonRepository
+}
+
+private data class AddonHealth(val name: String, val ok: Boolean, val detail: String)
+
+private fun dirSize(file: File): Long =
+    if (file.isFile) file.length() else file.listFiles()?.sumOf { dirSize(it) } ?: 0L
+
+private fun mb(bytes: Long): String = "%.1f MB".format(bytes / (1024.0 * 1024.0))
+
+private fun checkAddon(addon: Addon): AddonHealth {
+    val name = addon.displayName.ifBlank { addon.baseUrl }
+    val url = addon.baseUrl.trimEnd('/') + "/manifest.json"
+    val start = System.currentTimeMillis()
+    return runCatching {
+        val conn = (URL(url).openConnection() as HttpURLConnection).apply {
+            connectTimeout = 5000
+            readTimeout = 5000
+            requestMethod = "GET"
+        }
+        val code = conn.responseCode
+        conn.disconnect()
+        val ms = System.currentTimeMillis() - start
+        AddonHealth(name, code in 200..299, if (code in 200..299) "$ms ms" else "HTTP $code")
+    }.getOrElse { AddonHealth(name, false, it.javaClass.simpleName) }
+}
+
+/** Nuvio fork: Settings health screen with memory, storage, cache sizes and addon reachability. */
+@Composable
+internal fun forkHealthRow() {
+    var show by remember { mutableStateOf(false) }
+    SettingsActionRow(
+        title = "App health",
+        subtitle = "Memory, storage, cache sizes and whether every addon answers.",
+        onClick = { show = true },
+    )
+    if (show) ForkTvHealthDialog(onDismiss = { show = false })
+}
+
+@Composable
+private fun ForkTvHealthDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    val entry = remember {
+        EntryPointAccessors.fromApplication(context.applicationContext, ForkTvHealthEntryPoint::class.java)
+    }
+    var lines by remember { mutableStateOf<List<String>>(emptyList()) }
+    var addons by remember { mutableStateOf<List<AddonHealth>?>(null) }
+    var nonce by remember { mutableStateOf(0) }
+
+    LaunchedEffect(nonce) {
+        lines = withContext(Dispatchers.IO) { systemLines(context) }
+        addons = null
+        val installed = runCatching { entry.addonRepository().getInstalledAddons().first() }.getOrDefault(emptyList())
+        addons = withContext(Dispatchers.IO) {
+            coroutineScope { installed.filter { it.enabled }.map { async { checkAddon(it) } }.awaitAll() }
+        }
+    }
+
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = "App health",
+        subtitle = "Read-only checks. Addons are asked for their manifest with a 5 second limit.",
+        width = 760.dp,
+        contentSpacing = 8.dp,
+    ) {
+        LazyColumn(
+            modifier = Modifier.fillMaxWidth().heightIn(max = 300.dp),
+            verticalArrangement = Arrangement.spacedBy(4.dp),
+        ) {
+            items(lines) { line ->
+                Text(text = line, style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextPrimary)
+            }
+            item {
+                Text(
+                    text = if (addons == null) "Addons: checking..." else {
+                        val bad = addons.orEmpty().count { !it.ok }
+                        "Addons: ${addons.orEmpty().size - bad} answer, $bad do not"
+                    },
+                    style = MaterialTheme.typography.titleSmall,
+                    color = NuvioTheme.colors.TextPrimary,
+                    modifier = Modifier.padding(top = 6.dp),
+                )
+            }
+            items(addons.orEmpty()) { a ->
+                Text(
+                    text = (if (a.ok) "OK  " else "FAIL  ") + a.name + "  (" + a.detail + ")",
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = if (a.ok) NuvioTheme.colors.TextPrimary else NuvioTheme.colors.TextSecondary,
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+        Row(horizontalArrangement = Arrangement.spacedBy(10.dp), modifier = Modifier.padding(top = 4.dp)) {
+            Button(onClick = { nonce++ }) { Text("Check again") }
+            Button(onClick = {
+                scope.launch(Dispatchers.IO) {
+                    File(context.cacheDir, "fork_home_rows").deleteRecursively()
+                    nonce++
+                }
+            }) { Text("Clear Home row cache") }
+            Button(onClick = onDismiss) { Text("Close") }
+        }
+    }
+}
+
+private fun systemLines(context: Context): List<String> {
+    val rt = Runtime.getRuntime()
+    val am = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+    val mi = ActivityManager.MemoryInfo().also { am.getMemoryInfo(it) }
+    val dataFree = context.filesDir.usableSpace
+    return listOf(
+        "App memory: ${mb(rt.totalMemory() - rt.freeMemory())} used of ${mb(rt.maxMemory())}",
+        "Device memory: ${mb(mi.availMem)} free of ${mb(mi.totalMem)}" + if (mi.lowMemory) " (low)" else "",
+        "Low-RAM mode: " + if (com.nuvio.tv.data.repository.ForkTvLowRam.active(context)) "on" else "off",
+        "Free storage: ${mb(dataFree)}",
+        "Cache folder: ${mb(dirSize(context.cacheDir))}",
+        "Home row cache: ${mb(dirSize(File(context.cacheDir, "fork_home_rows")))}",
+        "Saved data: ${mb(dirSize(context.filesDir))}",
+    )
+}
