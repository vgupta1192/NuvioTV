+package com.nuvio.tv.ui.screens.home
+
+import android.content.Context
+import com.nuvio.tv.domain.model.CatalogRow
+import com.nuvio.tv.domain.model.ContentType
+import com.nuvio.tv.domain.model.MetaPreview
+import com.nuvio.tv.domain.model.PosterShape
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * Nuvio fork: disk cache for the first page of every Home catalog row, so Home shows content
+ * at once on start and the network refresh replaces it. Only the fields the cards need are kept.
+ */
+internal object ForkTvHomeCache {
+    private const val DIR = "fork_home_rows"
+    private const val MAX_ITEMS = 40
+    private const val MAX_AGE_MS = 7L * 24 * 60 * 60 * 1000
+
+    private fun fileFor(context: Context, key: String): File {
+        val dir = File(context.cacheDir, DIR).apply { mkdirs() }
+        return File(dir, key.hashCode().toUInt().toString(16) + ".json")
+    }
+
+    fun save(context: Context, key: String, row: CatalogRow) {
+        if (row.items.isEmpty()) return
+        runCatching {
+            val items = JSONArray()
+            row.items.take(MAX_ITEMS).forEach { m ->
+                items.put(
+                    JSONObject()
+                        .put("id", m.id)
+                        .put("type", m.apiType)
+                        .put("name", m.name)
+                        .put("poster", m.poster)
+                        .put("shape", m.posterShape.name)
+                        .put("background", m.background)
+                        .put("logo", m.logo)
+                        .put("description", m.description)
+                        .put("releaseInfo", m.releaseInfo)
+                        .put("imdbRating", m.imdbRating?.toDouble())
+                        .put("genres", JSONArray(m.genres))
+                        .put("landscape", m.landscapePoster)
+                        .put("imdbId", m.imdbId)
+                        .put("rawPoster", m.rawPosterUrl)
+                )
+            }
+            val obj = JSONObject()
+                .put("savedAt", System.currentTimeMillis())
+                .put("key", key)
+                .put("addonId", row.addonId)
+                .put("addonName", row.addonName)
+                .put("addonBaseUrl", row.addonBaseUrl)
+                .put("catalogId", row.catalogId)
+                .put("catalogName", row.catalogName)
+                .put("rawType", row.apiType)
+                .put("supportsSkip", row.supportsSkip)
+                .put("skipStep", row.skipStep)
+                .put("items", items)
+            fileFor(context, key).writeText(obj.toString())
+        }
+    }
+
+    fun load(context: Context, key: String): CatalogRow? = runCatching {
+        val f = fileFor(context, key)
+        if (!f.exists()) return null
+        val obj = JSONObject(f.readText())
+        if (obj.optString("key") != key) return null
+        if (System.currentTimeMillis() - obj.optLong("savedAt") > MAX_AGE_MS) return null
+        val arr = obj.getJSONArray("items")
+        val items = (0 until arr.length()).map { i ->
+            val o = arr.getJSONObject(i)
+            val rawType = o.optString("type")
+            MetaPreview(
+                id = o.getString("id"),
+                type = ContentType.fromString(rawType),
+                rawType = rawType,
+                name = o.optString("name"),
+                poster = o.optStringOrNull("poster"),
+                posterShape = PosterShape.fromString(o.optString("shape")),
+                background = o.optStringOrNull("background"),
+                logo = o.optStringOrNull("logo"),
+                description = o.optStringOrNull("description"),
+                releaseInfo = o.optStringOrNull("releaseInfo"),
+                imdbRating = if (o.isNull("imdbRating")) null else o.optDouble("imdbRating").toFloat(),
+                genres = o.optJSONArray("genres")?.let { g -> (0 until g.length()).map { g.getString(it) } }.orEmpty(),
+                landscapePoster = o.optStringOrNull("landscape"),
+                imdbId = o.optStringOrNull("imdbId"),
+                rawPosterUrl = o.optStringOrNull("rawPoster"),
+            )
+        }
+        if (items.isEmpty()) return null
+        val rawType = obj.optString("rawType")
+        CatalogRow(
+            addonId = obj.getString("addonId"),
+            addonName = obj.optString("addonName"),
+            addonBaseUrl = obj.optString("addonBaseUrl"),
+            catalogId = obj.getString("catalogId"),
+            catalogName = obj.optString("catalogName"),
+            type = ContentType.fromString(rawType),
+            rawType = rawType,
+            items = items,
+            isLoading = false,
+            hasMore = obj.optBoolean("supportsSkip"),
+            currentPage = 0,
+            supportsSkip = obj.optBoolean("supportsSkip"),
+            skipStep = obj.optInt("skipStep", 100),
+            nextSkip = items.size,
+        )
+    }.getOrNull()
+
+    private fun JSONObject.optStringOrNull(name: String): String? =
+        if (isNull(name)) null else optString(name).ifBlank { null }
+}
