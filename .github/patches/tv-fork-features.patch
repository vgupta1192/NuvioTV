+package com.nuvio.tv.core.sync
+
+import android.content.Context
+import android.content.SharedPreferences
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.booleanOrNull
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.floatOrNull
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.longOrNull
+import kotlinx.serialization.json.put
+
+/**
+ * Nuvio TV fork: the fork's own settings (home rows, player extras, sounds, DoH) live in plain
+ * SharedPreferences files, not in the per-profile DataStores that the profile settings blob
+ * covers. This adds them to the blob under the extra feature key "fork_settings" so a second
+ * device gets the same setup. Mobile ignores the key. State that is not a setting (watch stats,
+ * remembered volume, insight facts, crash markers) is not synced.
+ */
+internal object ForkSettingsSync {
+    const val FEATURE = "fork_settings"
+
+    private val files = listOf(
+        "nuvio_fork_tv_settings",
+        "nuvio_tv_dx_remember",
+        "nuvio_tv_dx_sub2",
+        "nuvio_tv_dx_sound",
+        "nuvio_tv_dx_enhance",
+        "nuvio_tv_dx_hero_rotation",
+        "nuvio_tv_dx_sounds",
+        "nuvio_tv_doh",
+    )
+
+    // Per-device state that sits next to the settings in the same files.
+    private val deviceStateKeys = setOf("speed", "volume")
+
+    private fun prefs(context: Context, file: String): SharedPreferences =
+        context.applicationContext.getSharedPreferences(file, Context.MODE_PRIVATE)
+
+    fun export(context: Context): JsonObject = buildJsonObject {
+        files.forEach { file ->
+            val all = prefs(context, file).all
+            put(
+                file,
+                buildJsonObject {
+                    all.forEach { (key, value) ->
+                        if (key in deviceStateKeys) return@forEach
+                        when (value) {
+                            is Boolean -> put(key, JsonPrimitive(value))
+                            is Int -> put(key, JsonPrimitive(value))
+                            is Long -> put(key, JsonPrimitive(value))
+                            is Float -> put(key, JsonPrimitive(value))
+                            is String -> put(key, JsonPrimitive(value))
+                        }
+                    }
+                },
+            )
+        }
+    }
+
+    /** Applies a remote export. Returns true when any stored value changed. */
+    fun apply(context: Context, remote: JsonObject): Boolean {
+        var changed = false
+        files.forEach { file ->
+            val section = remote[file] as? JsonObject ?: return@forEach
+            val target = prefs(context, file)
+            val current = target.all
+            val editor = target.edit()
+            section.forEach { (key, element) ->
+                if (key in deviceStateKeys) return@forEach
+                val primitive = runCatching { element.jsonPrimitive }.getOrNull() ?: return@forEach
+                val existing = current[key]
+                when (existing) {
+                    is Boolean -> primitive.booleanOrNull?.let { if (it != existing) { editor.putBoolean(key, it); changed = true } }
+                    is Int -> primitive.intOrNull?.let { if (it != existing) { editor.putInt(key, it); changed = true } }
+                    is Long -> primitive.longOrNull?.let { if (it != existing) { editor.putLong(key, it); changed = true } }
+                    is Float -> primitive.floatOrNull?.let { if (it != existing) { editor.putFloat(key, it); changed = true } }
+                    is String -> primitive.contentOrNull?.let { if (it != existing) { editor.putString(key, it); changed = true } }
+                    else -> {
+                        // New key on this device: infer the type from the JSON value.
+                        val bool = primitive.booleanOrNull
+                        val num = primitive.longOrNull
+                        val float = primitive.floatOrNull
+                        when {
+                            primitive.isString -> editor.putString(key, primitive.content)
+                            bool != null -> editor.putBoolean(key, bool)
+                            num != null && !primitive.content.contains('.') -> editor.putLong(key, num)
+                            float != null -> editor.putFloat(key, float)
+                            else -> return@forEach
+                        }
+                        changed = true
+                    }
+                }
+            }
+            editor.apply()
+        }
+        return changed
+    }
+
+    /** Calls [onChange] when any synced fork file changes. Keep the returned handle to unregister. */
+    fun watch(context: Context, onChange: () -> Unit): List<Pair<SharedPreferences, SharedPreferences.OnSharedPreferenceChangeListener>> =
+        files.map { file ->
+            val p = prefs(context, file)
+            val listener = SharedPreferences.OnSharedPreferenceChangeListener { _, key ->
+                if (key !in deviceStateKeys) onChange()
+            }
+            p.registerOnSharedPreferenceChangeListener(listener)
+            p to listener
+        }
+}
