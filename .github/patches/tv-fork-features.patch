+@file:OptIn(ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.unit.dp
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import com.nuvio.tv.ui.theme.NuvioTheme
+
+/** Nuvio fork: one Settings page that gathers the fork's own features, like Mobile's Features hub. */
+@Composable
+internal fun ForkFeaturesPane(
+    initialFocusRequester: FocusRequester?,
+    modifier: Modifier = Modifier
+) {
+    LazyColumn(
+        modifier = modifier
+            .fillMaxSize()
+            .padding(end = NuvioTheme.spacing.md),
+        verticalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.lg)
+    ) {
+        item {
+            SettingsDetailHeader(
+                title = "Features",
+                subtitle = "Extra features added by this fork, in one place."
+            )
+        }
+        item {
+            SettingsGroupCard(title = "Home") {
+                forkHomeVideoOnlyRow()
+                forkHomeLibraryRowsRows()
+            }
+        }
+        item {
+            SettingsGroupCard(title = "Details") {
+                forkFillerGuideRow()
+            }
+        }
+        item {
+            SettingsGroupCard(title = "Player") {
+                forkPlayerButtonsRow()
+                forkAutoAddTorboxRow()
+            }
+        }
+        item {
+            SettingsGroupCard(title = "Maintenance") {
+                forkClearImageCacheRow()
+                forkWhatsNewRow()
+            }
+        }
+    }
+}
