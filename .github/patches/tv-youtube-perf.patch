+    /** Video MIME types this device decodes in hardware, from the platform codec list. */
+    private val hardwareMimes: Set<String> by lazy {
+        runCatching {
+            val found = HashSet<String>()
+            android.media.MediaCodecList(android.media.MediaCodecList.REGULAR_CODECS).codecInfos
+                .filter { !it.isEncoder }
+                .forEach { info ->
+                    val hardware = if (android.os.Build.VERSION.SDK_INT >= 29) {
+                        info.isHardwareAccelerated && !info.isSoftwareOnly
+                    } else {
+                        !info.name.startsWith("OMX.google.") && !info.name.startsWith("c2.android.")
+                    }
+                    if (!hardware) return@forEach
+                    info.supportedTypes.forEach { type ->
+                        when (type.lowercase()) {
+                            "video/avc", "video/x-vnd.on2.vp9", "video/av01" -> found.add(type.lowercase())
+                        }
+                    }
+                }
+            found.toSet()
+        }.getOrDefault(emptySet())
