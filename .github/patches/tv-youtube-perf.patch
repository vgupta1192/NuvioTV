--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/youtube/YouTubeFirstChunkCache.kt
@@ -0,0 +1,149 @@
+package com.nuvio.tv.youtube
+
+import android.net.Uri
+import android.util.Log
+import android.util.Xml
+import androidx.media3.common.MimeTypes
+import org.xmlpull.v1.XmlPullParser
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.Executors
+
+/**
+ * The first bytes of a YouTube video and audio stream, downloaded while the card is still highlighted.
+ * The chunked data source serves a request that starts inside these bytes from memory, so the player
+ * has its init segment and first media data for the first frame without a network round trip.
+ */
+object YouTubeFirstChunkCache {
+    class Entry(val bytes: ByteArray, val requested: Int)
+
+    private const val TAG = "YouTubeStart"
+    private const val MAX_ENTRIES = 8
+    private const val VIDEO_BYTES = 3 * 1024 * 1024
+    private const val AUDIO_BYTES = 512 * 1024
+
+    private val entries = object : LinkedHashMap<String, Entry>(16, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<String, Entry>?): Boolean = size > MAX_ENTRIES
+    }
+    private val inFlight = HashSet<String>()
+    private val executor = Executors.newFixedThreadPool(2) { runnable ->
+        Thread(runnable, "yt-first-chunk").apply { isDaemon = true }
+    }
+
+    fun get(url: String): Entry? = synchronized(entries) { entries[url] }
+
+    private class Rep(val video: Boolean, val height: Int, val bandwidth: Long, val codecs: String, val url: String)
+
+    /**
+     * Reads the manifest, picks the video size and audio the player will most likely start with, and
+     * downloads their first bytes in the background. [codecOrder] is the MIME order from the settings.
+     */
+    fun prefetchFromMpd(mpd: ByteArray, userAgent: String?, preferredHeight: Int, codecOrder: List<String>) {
+        val reps = runCatching { parse(mpd) }.getOrDefault(emptyList())
+        val videos = reps.filter { it.video && it.url.contains("googlevideo.com") }
+        val audios = reps.filter { !it.video && it.url.contains("googlevideo.com") }
+        if (videos.isNotEmpty()) {
+            val heights = videos.map { it.height }.distinct().sorted()
+            val target = if (preferredHeight > 0) {
+                heights.lastOrNull { it <= preferredHeight } ?: heights.first()
+            } else {
+                heights.lastOrNull { it <= 1080 } ?: heights.first()
+            }
+            val best = videos.filter { it.height == target }.minWithOrNull(
+                compareBy<Rep> { rep ->
+                    val mime = MimeTypes.getVideoMediaMimeType(rep.codecs)
+                    codecOrder.indexOf(mime).let { if (it < 0) codecOrder.size else it }
+                }.thenByDescending { it.bandwidth }
+            )
+            best?.let { prefetch(it.url, VIDEO_BYTES, userAgent) }
+        }
+        audios.maxByOrNull { it.bandwidth }?.let { prefetch(it.url, AUDIO_BYTES, userAgent) }
+    }
+
+    private fun parse(mpd: ByteArray): List<Rep> {
+        val parser = Xml.newPullParser()
+        parser.setInput(ByteArrayInputStream(mpd), null)
+        val out = ArrayList<Rep>()
+        var setVideo = false
+        var video = false
+        var height = 0
+        var bandwidth = 0L
+        var codecs = ""
+        var inRep = false
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (event == XmlPullParser.START_TAG) {
+                when (parser.name) {
+                    "AdaptationSet" -> {
+                        val kind = parser.getAttributeValue(null, "contentType")
+                            ?: parser.getAttributeValue(null, "mimeType").orEmpty()
+                        setVideo = kind.startsWith("video")
+                    }
+                    "Representation" -> {
+                        inRep = true
+                        val mime = parser.getAttributeValue(null, "mimeType")
+                        video = if (mime != null) mime.startsWith("video") else setVideo
+                        height = parser.getAttributeValue(null, "height")?.toIntOrNull() ?: 0
+                        bandwidth = parser.getAttributeValue(null, "bandwidth")?.toLongOrNull() ?: 0L
+                        codecs = parser.getAttributeValue(null, "codecs").orEmpty()
+                    }
+                    "BaseURL" -> if (inRep) {
+                        val text = parser.nextText().trim()
+                        if (text.startsWith("http")) out.add(Rep(video, height, bandwidth, codecs, text))
+                    }
+                }
+            } else if (event == XmlPullParser.END_TAG && parser.name == "Representation") {
+                inRep = false
+            }
+            event = parser.next()
+        }
+        return out
+    }
+
+    private fun prefetch(rawUrl: String, bytes: Int, userAgent: String?) {
+        // Same normalisation as the data source, which looks the entry up by Uri.toString().
+        val url = Uri.parse(rawUrl).toString()
+        synchronized(entries) {
+            if (entries.containsKey(url) || !inFlight.add(url)) return
+        }
+        executor.execute {
+            try {
+                val data = download(url, bytes, userAgent)
+                if (data != null) synchronized(entries) { entries[url] = Entry(data, bytes) }
+                Log.i(TAG, "first-bytes prefetch ${data?.size ?: 0} of $bytes")
+            } finally {
+                synchronized(entries) { inFlight.remove(url) }
+            }
+        }
+    }
+
+    private fun download(url: String, bytes: Int, userAgent: String?): ByteArray? {
+        var conn: HttpURLConnection? = null
+        return try {
+            val ranged = Uri.parse(url).buildUpon().appendQueryParameter("range", "0-${bytes - 1}").build().toString()
+            conn = (URL(ranged).openConnection() as HttpURLConnection).apply {
+                connectTimeout = 8_000
+                readTimeout = 8_000
+                userAgent?.takeIf { it.isNotBlank() }?.let { setRequestProperty("User-Agent", it) }
+            }
+            if (conn.responseCode !in 200..299) return null
+            val out = ByteArrayOutputStream(bytes)
+            val buffer = ByteArray(64 * 1024)
+            conn.inputStream.use { input ->
+                while (out.size() < bytes) {
+                    val read = input.read(buffer, 0, minOf(buffer.size, bytes - out.size()))
+                    if (read < 0) break
+                    out.write(buffer, 0, read)
+                }
+            }
+            out.toByteArray().takeIf { it.isNotEmpty() }
+        } catch (e: Exception) {
+            Log.w(TAG, "first-bytes prefetch failed: ${e.message}")
+            null
+        } finally {
+            runCatching { conn?.disconnect() }
+        }
+    }
+}
