diff --git a/app/src/main/java/com/nuvio/tv/ui/newlook/GlassDrawing.kt b/app/src/main/java/com/nuvio/tv/ui/newlook/GlassDrawing.kt
new file mode 100644
index 00000000..f8223ea3
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/ui/newlook/GlassDrawing.kt
@@ -0,0 +1,139 @@
+package com.nuvio.tv.ui.newlook
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.staticCompositionLocalOf
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.drawWithCache
+import androidx.compose.ui.draw.shadow
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.graphics.Brush
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.Shape
+import androidx.compose.ui.graphics.drawOutline
+import androidx.compose.ui.graphics.drawscope.Stroke
+import androidx.compose.ui.unit.dp
+import com.nuvio.tv.domain.model.GlassIntensity
+
+/**
+ * Liquid glass surfaces, ported from the Echo fork's drawing set as plain layered
+ * Compose drawing: a translucent gray body, a rim that's brightest on the top and
+ * bottom curves, 1-dp specular glints along those edges and a soft drop shadow.
+ * No frosting filter and no blur library — everything is [drawWithCache] strokes
+ * and gradients, so it costs the same on every TV.
+ */
+
+/**
+ * How opaque glass surfaces are (Appearance): [GlassIntensity.OFF] draws nothing,
+ * [GlassIntensity.LOW] is the clear glass, [GlassIntensity.MID] and [GlassIntensity.HIGH]
+ * add a frosted veil so text on the glass stays readable. The tree provides it via
+ * [NuvioTheme][com.nuvio.tv.ui.theme.NuvioTheme].
+ */
+val LocalGlassIntensity = staticCompositionLocalOf { GlassIntensity.MID }
+
+/** True when glass surfaces draw at all (the intensity is not Off). */
+@Composable
+internal fun glassIntensityActive(): Boolean = LocalGlassIntensity.current != GlassIntensity.OFF
+
+/**
+ * Liquid glass at full transparency: layered drawing only. A gray body taken from the
+ * (near-black) page gradient, a rim that's brightest on the top and bottom curves and
+ * nearly clear down the sides, specular glints on those edges, and a soft drop shadow.
+ * Nothing is clipped, so content inside can draw past the sides.
+ *
+ * The glints are straight lines 1 dp in from the top and bottom, so they only suit a
+ * wide shape: on a narrow panel the rounded ends curve away from them and they show as
+ * white patches past the edge ([glints] off).
+ *
+ * [shadow] off for glass that lies flat with text scrolling inside it (a list panel):
+ * the shadow shows through the clear body, and on the TV it redrew as lighter blocks
+ * wherever the text inside changed.
+ *
+ * At [GlassIntensity.OFF] this modifier does nothing; [GlassIntensity.MID] and
+ * [GlassIntensity.HIGH] draw a frosted veil under the glass so text on it reads.
+ */
+@Composable
+internal fun Modifier.glassSurface(
+    shape: Shape,
+    glints: Boolean = true,
+    shadow: Boolean = true
+): Modifier {
+    val intensity = LocalGlassIntensity.current
+    if (intensity == GlassIntensity.OFF) return this
+    var modifier = this
+    if (intensity != GlassIntensity.LOW) {
+        modifier = modifier.glassFrost(shape, if (intensity == GlassIntensity.HIGH) 0.92f else 0.5f)
+    }
+    return modifier.then(glassSurfaceBody(shape, glints, shadow))
+}
+
+/** The clear-glass body: rim, glints and shadow, independent of the intensity setting. */
+private fun Modifier.glassSurfaceBody(shape: Shape, glints: Boolean, shadow: Boolean): Modifier = this
+    .then(
+        if (!shadow) Modifier else Modifier.shadow(
+            elevation = 14.dp,
+            shape = shape,
+            clip = false,
+            ambientColor = Color.Black.copy(alpha = 0.38f),
+            spotColor = Color.Black.copy(alpha = 0.38f)
+        )
+    )
+    .drawWithCache {
+        val outline = shape.createOutline(size, layoutDirection, this)
+        // A gray tint from the (near-black) page gradient, so the glass sits in the page.
+        val body = Brush.verticalGradient(
+            0f to Color(48, 48, 48, 82),
+            0.5f to Color(30, 30, 30, 66),
+            1f to Color(20, 20, 20, 77)
+        )
+        val rim = Brush.verticalGradient(
+            0f to Color(225, 225, 225, 107),
+            0.16f to Color(200, 200, 200, 26),
+            0.5f to Color(160, 160, 160, 13),
+            0.84f to Color(200, 200, 200, 20),
+            1f to Color(210, 210, 210, 77)
+        )
+        val glow = Brush.verticalGradient(
+            0f to Color.White.copy(alpha = 0.10f),
+            0.08f to Color.White.copy(alpha = 0.03f),
+            0.92f to Color.White.copy(alpha = 0.03f),
+            1f to Color.White.copy(alpha = 0.06f)
+        )
+        val stroke = 1.2.dp.toPx()
+        val glintStroke = 1.4.dp.toPx()
+        val left = size.width * 0.22f
+        val right = size.width * 0.78f
+        val topGlint = Brush.horizontalGradient(
+            listOf(Color.Transparent, Color.White.copy(alpha = 0.7f), Color.Transparent),
+            startX = left, endX = right
+        )
+        val bottomGlint = Brush.horizontalGradient(
+            listOf(Color.Transparent, Color.White.copy(alpha = 0.4f), Color.Transparent),
+            startX = left - size.width * 0.05f, endX = right - size.width * 0.05f
+        )
+        onDrawBehind {
+            drawOutline(outline, body)
+            drawOutline(outline, glow, style = Stroke(3.dp.toPx()))
+            drawOutline(outline, rim, style = Stroke(stroke))
+            if (!glints) return@onDrawBehind
+            drawLine(topGlint, Offset(left, 1.dp.toPx()), Offset(right, 1.dp.toPx()), strokeWidth = glintStroke)
+            drawLine(
+                bottomGlint,
+                Offset(left - size.width * 0.05f, size.height - 1.dp.toPx()),
+                Offset(right - size.width * 0.05f, size.height - 1.dp.toPx()),
+                strokeWidth = glintStroke
+            )
+        }
+    }
+
+/**
+ * Frosts the glass at Mid and High: a light gray veil clipped to the shape, which reads
+ * as frosted glass without blurring anything live. Goes before the glass body, so the
+ * glass's rim and glints sit on top.
+ */
+private fun Modifier.glassFrost(shape: Shape, strength: Float): Modifier = this
+    .drawWithCache {
+        val outline = shape.createOutline(size, layoutDirection, this)
+        onDrawBehind {
+            drawOutline(outline, Color(52, 52, 52), alpha = 0.85f * strength)
+        }
+    }
