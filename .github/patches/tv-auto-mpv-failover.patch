+package com.nuvio.tv.ui.screens.player
+
+/**
+ * Nuvio fork: loop guard for the automatic switch to mpv on a fatal ExoPlayer decoder or format error.
+ * Each stream URL gets one automatic switch; if mpv fails too (or the user switches back), the normal error
+ * screen with the manual "Switch to mpv" action is shown instead.
+ */
+internal object DxAutoMpvFailover {
+    private val tried = LinkedHashSet<String>()
+
+    @Synchronized
+    fun shouldTry(streamUrl: String): Boolean {
+        if (streamUrl.isBlank()) return false
+        if (!tried.add(streamUrl)) return false
+        while (tried.size > 50) tried.remove(tried.first())
+        return true
+    }
+}
