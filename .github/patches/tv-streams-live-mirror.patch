+        val refreshAdded: Int,
+        val refreshDryRounds: Int,
+        val refreshLastAtMs: Long,
+        val refreshLastOk: Boolean
     )
 
-    @Volatile private var entry: Entry? = null
+    private val _entry = MutableStateFlow<Entry?>(null)
+    val entry: StateFlow<Entry?> = _entry.asStateFlow()
 
-    fun put(type: String, videoId: String, season: Int?, episode: Int?, groups: List<AddonStreams>) {
-        entry = Entry(type, videoId, season, episode, groups, System.currentTimeMillis())
+    fun put(
+        type: String,
+        videoId: String,
+        season: Int?,
+        episode: Int?,
+        groups: List<AddonStreams>,
+        loading: Boolean,
+        refreshPhase: Int,
+        refreshRounds: Int,
+        refreshAdded: Int,
+        refreshDryRounds: Int,
+        refreshLastAtMs: Long,
+        refreshLastOk: Boolean
+    ) {
+        _entry.value = Entry(
+            type = type,
+            videoId = videoId,
+            season = season,
+            episode = episode,
+            groups = groups,
+            savedAtMs = System.currentTimeMillis(),
+            loading = loading,
+            refreshPhase = refreshPhase,
+            refreshRounds = refreshRounds,
+            refreshAdded = refreshAdded,
+            refreshDryRounds = refreshDryRounds,
+            refreshLastAtMs = refreshLastAtMs,
+            refreshLastOk = refreshLastOk
+        )
     }
 
-    fun find(type: String, videoId: String, season: Int?, episode: Int?): List<AddonStreams>? {
-        val e = entry ?: return null
-        if (e.type != type || e.videoId != videoId || e.season != season || e.episode != episode) return null
-        if (System.currentTimeMillis() - e.savedAtMs > MAX_AGE_MS) return null
-        return e.groups
+    /** Matching, non-stale entry or null. A one-shot read for the initial open. */
+    fun snapshot(type: String, videoId: String, season: Int?, episode: Int?): Entry? {
+        val e = _entry.value ?: return null
+        return if (matches(e, type, videoId, season, episode)) e else null
     }
 
     fun clear() {
-        entry = null
+        _entry.value = null
+    }
+
+    private fun matches(e: Entry, type: String, videoId: String, season: Int?, episode: Int?): Boolean {
+        if (e.type != type || e.videoId != videoId || e.season != season || e.episode != episode) return false
+        return System.currentTimeMillis() - e.savedAtMs <= MAX_AGE_MS
     }
 }
