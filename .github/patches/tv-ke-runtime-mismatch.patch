diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerRuntimeControllerRuntimeMismatch.kt b/app/src/main/java/com/nuvio/tv/ui/screens/player/PlayerRuntimeControllerRuntimeMismatch.kt
