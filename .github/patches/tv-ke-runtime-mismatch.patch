@@ -0,0 +1,86 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.util.Log
+import androidx.media3.common.Player
+import com.nuvio.tv.core.player.RuntimeMismatchPolicy
+import com.nuvio.tv.core.util.parseRuntimeMinutes
+import com.nuvio.tv.domain.model.Video
+import kotlinx.coroutines.flow.update
+
+/**
+ * Nuvio-KE port: judge the playing file's length against the title's metadata runtime once per
+ * stream, on the controller's progress tick (ExoPlayer branch; MPV has no equivalent tick and is
+ * not checked). A mismatch pauses on the first frame, rewinds to 0:00 and raises
+ * [PlayerUiState.runtimeMismatch]; the player screen shows the warning with "Pick another stream"
+ * / "Play anyway".
+ *
+ * Waits (without spending the one check) until the meta fetch supplies a runtime, but only for
+ * [RuntimeMismatchPolicy.MAX_WARN_POSITION_MS] of playback. The runtime comes from the player's
+ * own meta ([runtimeMismatchExpectedMinutes]), never from a Continue Watching route: the route
+ * carries the previous playback's duration, which a wrong file would have written itself.
+ */
+internal fun PlayerRuntimeController.checkRuntimeMismatch(player: Player, durationMs: Long) {
+    if (runtimeMismatchChecked || durationMs <= 0L) return
+    val positionMs = player.currentPosition.coerceAtLeast(0L)
+    val runtimeMinutes = runtimeMismatchExpectedMinutes(
+        videos = metaVideos,
+        videoId = currentVideoId,
+        season = currentSeason,
+        episode = currentEpisode,
+        metaRuntime = metaRuntime
+    )
+    if (runtimeMinutes == null && positionMs <= RuntimeMismatchPolicy.MAX_WARN_POSITION_MS) return
+    runtimeMismatchChecked = true
+    val mismatch = if (positionMs > RuntimeMismatchPolicy.MAX_WARN_POSITION_MS) {
+        null
+    } else {
+        RuntimeMismatchPolicy.evaluate(
+            durationMs = durationMs,
+            expectedRuntimeMs = runtimeMinutes?.let { it * 60_000L },
+            resumed = playbackResumedFromSavedPosition
+        )
+    }
+    Log.i(
+        PlayerRuntimeController.TAG,
+        "RUNTIME_MISMATCH warn=${mismatch != null} durationMs=$durationMs " +
+            "runtimeMin=${runtimeMinutes ?: -1} positionMs=$positionMs " +
+            "resumed=$playbackResumedFromSavedPosition"
+    )
+    if (mismatch == null) return
+    _uiState.update { it.copy(runtimeMismatch = mismatch) }
+    player.pause()
+    player.seekTo(0L)
+}
+
+/** The warning's buttons: Play anyway plays this stream; Pick another stream opens Sources.
+ *  Any other play (a media key, the MediaSession) clears the warning in onIsPlayingChanged. */
+internal fun PlayerRuntimeController.onRuntimeMismatchChoice(playAnyway: Boolean) {
+    _uiState.update { it.copy(runtimeMismatch = null) }
+    if (playAnyway) {
+        _exoPlayer?.play()
+    } else {
+        showSourcesPanel()
+    }
+}
+
+/**
+ * The runtime the mismatch check judges against, in minutes: the playing episode's own
+ * [Video.runtime], else (a movie, or an episode without its own) the meta's runtime text.
+ * Null when unknown.
+ */
+internal fun runtimeMismatchExpectedMinutes(
+    videos: List<Video>,
+    videoId: String?,
+    season: Int?,
+    episode: Int?,
+    metaRuntime: String?
+): Int? {
+    val video = videoId?.let { id -> videos.firstOrNull { it.id == id } }
+        ?: if (season != null && episode != null) {
+            videos.firstOrNull { it.season == season && it.episode == episode }
+        } else {
+            null
+        }
+    video?.runtime?.takeIf { it > 0 }?.let { return it }
+    return parseRuntimeMinutes(metaRuntime)?.takeIf { it > 0 }
+}
