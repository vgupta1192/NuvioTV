@@ -0,0 +1,53 @@
+package com.nuvio.tv.domain.model
+
+/**
+ * The TV-only bundled profile look (adapted from Nuvio-KE's ProfileLook): a bundled creature avatar
+ * chosen on this device, stored per profile and never synced as a pick. Unlike KE, this tree has no
+ * separate look fields on [UserProfile], so the pick is stored directly on the profile as the avatar
+ * id (`[BUNDLED_LOOK_PREFIX] + slug`) and [ProfileLookEntry] snapshots the synced avatar fields the
+ * pick replaced. The snapshot makes a remote change (avatar, or a profile deleted and recreated at
+ * the same index) win over the pick, and lets the pick survive the full profile pull when it does
+ * not — see `ProfileManager.replaceAllProfiles`.
+ */
+sealed interface ProfileLookPick {
+    /** A bundled creature avatar; [slug] is [com.nuvio.tv.ui.components.BundledCreatures]'s slug. */
+    data class Bundled(val slug: String) : ProfileLookPick
+}
+
+/** The prefix under which a bundled look is stored in [UserProfile.avatarId]. */
+const val BUNDLED_LOOK_PREFIX = "bundled:"
+
+/** The avatar id that stores the bundled look [slug] on a profile. */
+fun bundledLookId(slug: String): String = "$BUNDLED_LOOK_PREFIX$slug"
+
+/** The bundled slug when [avatarId] stores a bundled look, else null. */
+fun bundledLookSlug(avatarId: String?): String? =
+    avatarId?.takeIf { it.startsWith(BUNDLED_LOOK_PREFIX) }
+        ?.removePrefix(BUNDLED_LOOK_PREFIX)
+        ?.takeIf { it.isNotEmpty() }
+
+internal fun String?.normalizedLookField(): String? = this?.trim()?.takeIf { it.isNotEmpty() }
+
+/** The synced avatar fields a bundled pick replaces: the URL when non-blank, else the id (never both). */
+data class SyncedAvatar(val id: String?, val url: String?) {
+    /** The normalised value a remote avatar change is detected by. */
+    val lookKey: String? get() = url ?: id
+}
+
+/** The avatar fields profile sync pushes for [profile]: the URL when non-blank, else the id. */
+fun UserProfile.syncedAvatar(): SyncedAvatar = SyncedAvatar(
+    id = if (avatarUrl.normalizedLookField() == null) avatarId.normalizedLookField() else null,
+    url = avatarUrl.normalizedLookField()
+)
+
+/** One local choice and the synced [name] + avatar ([synced]) it was saved over. */
+data class ProfileLookChoice(
+    val pick: ProfileLookPick,
+    val name: String?,
+    val synced: SyncedAvatar
+)
+
+/** A profile's stored look entry; only the avatar part (this tree wires bundled avatars). */
+data class ProfileLookEntry(
+    val avatar: ProfileLookChoice? = null
+)
