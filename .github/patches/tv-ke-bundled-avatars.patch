index 000000000..1e2b77a79
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/data/local/ProfileLookStore.kt
@@ -0,0 +1,86 @@
+package com.nuvio.tv.data.local
+
+import android.util.Log
+import androidx.datastore.preferences.core.MutablePreferences
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringPreferencesKey
+import com.nuvio.tv.domain.model.ProfileLookChoice
+import com.nuvio.tv.domain.model.ProfileLookEntry
+import com.nuvio.tv.domain.model.ProfileLookPick
+import com.nuvio.tv.domain.model.SyncedAvatar
+import com.nuvio.tv.domain.model.bundledLookSlug
+import kotlinx.coroutines.flow.first
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Each profile's TV-only bundled look entry (adapted from Nuvio-KE's ProfileLookStore): its own
+ * file through [ProfileDataStoreFactory] (`profile_look`, `_p<id>` past profile 1), so profile
+ * deletion and sign-out sweep it with the other profile files, and it never enters the sync
+ * payload. The entry snapshots the synced avatar fields a bundled pick replaced — the pick itself
+ * lives on the profile's avatar id — so `ProfileManager` can restore the pick after a full profile
+ * pull while the remote still agrees with it.
+ */
+@Singleton
+class ProfileLookStore @Inject constructor(
+    private val factory: ProfileDataStoreFactory
+) {
+    /** Profile [profileId]'s entry, null when none; an unreadable file reads as none. */
+    suspend fun read(profileId: Int): ProfileLookEntry? = try {
+        val prefs = factory.get(profileId, FEATURE).data.first()
+        ProfileLookEntry(avatar = decodeChoice(prefs)).takeIf { it.avatar != null }
+    } catch (e: IOException) {
+        Log.w(TAG, "Profile look unreadable: ${e.javaClass.simpleName}")
+        null
+    }
+
+    /** Replaces profile [profileId]'s entry ([entry] null clears it). */
+    suspend fun write(profileId: Int, entry: ProfileLookEntry?) {
+        try {
+            factory.get(profileId, FEATURE).edit { prefs -> encode(prefs, entry) }
+        } catch (e: IOException) {
+            Log.w(TAG, "Profile look not saved: ${e.javaClass.simpleName}")
+        }
+    }
+
+    companion object {
+        private const val TAG = "ProfileLookStore"
+        const val FEATURE = "profile_look"
+
+        private val PICK = stringPreferencesKey("avatar_pick")
+        private val NAME = stringPreferencesKey("avatar_name")
+        private val SYNCED_ID = stringPreferencesKey("avatar_synced_id")
+        private val SYNCED_URL = stringPreferencesKey("avatar_synced_url")
+
+        private fun decodeChoice(prefs: Preferences): ProfileLookChoice? {
+            val slug = prefs[PICK]?.let(::bundledLookSlug) ?: return null
+            return ProfileLookChoice(
+                pick = ProfileLookPick.Bundled(slug),
+                name = prefs[NAME],
+                synced = SyncedAvatar(id = prefs[SYNCED_ID], url = prefs[SYNCED_URL])
+            )
+        }
+
+        private fun encode(prefs: MutablePreferences, entry: ProfileLookEntry?) {
+            val choice = entry?.avatar
+            if (choice == null) {
+                prefs.remove(PICK)
+                prefs.remove(NAME)
+                prefs.remove(SYNCED_ID)
+                prefs.remove(SYNCED_URL)
+                return
+            }
+            prefs[PICK] = (choice.pick as? ProfileLookPick.Bundled)?.slug ?: return
+            // An absent key reads back as null: the snapshot's null fields round-trip.
+            putOrRemove(prefs, NAME, choice.name)
+            putOrRemove(prefs, SYNCED_ID, choice.synced.id)
+            putOrRemove(prefs, SYNCED_URL, choice.synced.url)
+        }
+
+        private fun putOrRemove(prefs: MutablePreferences, key: Preferences.Key<String>, value: String?) {
+            if (value == null) prefs.remove(key) else prefs[key] = value
+        }
+    }
+}
