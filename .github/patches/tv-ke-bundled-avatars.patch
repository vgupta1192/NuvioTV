+package com.nuvio.tv.ui.components
+
+import androidx.annotation.DrawableRes
+import androidx.compose.runtime.Immutable
+import com.nuvio.tv.R
+
+/**
+ * A bundled avatar (ported from Nuvio-KE): a Microsoft Fluent Emoji 3D head (MIT, licence text in
+ * `assets/licenses/fluentui-emoji-LICENSE.txt`), a transparent 256 px WebP drawn on a disc in
+ * [colorHex]. [slug] is stored in the profile's avatar id (`bundled:<slug>`): never rename or
+ * reuse one.
+ */
+@Immutable
+data class BundledCreature(
+    val slug: String,
+    val displayName: String,
+    @param:DrawableRes val drawable: Int,
+    val colorHex: String
+)
