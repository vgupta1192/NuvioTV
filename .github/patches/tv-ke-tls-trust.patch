+
+/**
+ * Ported from Nuvio-KE (`ui/screens/addon/AddonCertificatePanel.kt`), reshaped onto this tree's
+ * [NuvioDialog] idiom (KE's Marquee panel components do not exist here).
+ *
+ * First trust: "Trust this addon server?" — the reason sentence, what Trust does, the full
+ * SHA-256 with its expiry, Trust this server + Cancel. Changed: this `host:port` had another
+ * pin — both fingerprints side by side, Trust the new certificate + Keep paused. Pinned: the
+ * server verifies, the device holds a pin — the fingerprint and Forget this server + Close.
+ * The safe button (Cancel / Keep paused / Close) takes focus; Back = the safe button.
+ */
+@Composable
+internal fun AddonCertificateDialog(
+    state: AddonCertificatePanelState,
+    onTrust: () -> Unit,
+    onForget: () -> Unit,
+    onDismiss: () -> Unit
+) {
+    val probed = state.probed
+    val pinned = state.pinned
+    when {
+        probed != null -> CertificateConsentDialog(
+            state = state,
+            probed = probed,
+            onTrust = onTrust,
+            onDismiss = onDismiss
+        )
+        pinned != null -> CertificatePinnedDialog(
+            pinned = pinned,
+            onForget = onForget,
+            onDismiss = onDismiss
+        )
+    }
+}
+
+@Composable
+private fun CertificateConsentDialog(
+    state: AddonCertificatePanelState,
+    probed: AddonCertProbeResult.Untrusted,
+    onTrust: () -> Unit,
+    onDismiss: () -> Unit
+) {
+    val label = addonServerLabel(probed.host, probed.port)
+    val safeFocus = rememberSafeFocus()
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = stringResource(
+            if (state.changed) R.string.addon_cert_changed_title else R.string.addon_cert_trust_title
+        ),
+        width = 560.dp
+    ) {
+        Text(
+            text = certificateBody(state, probed, label),
+            style = MaterialTheme.typography.bodyMedium,
+            color = NuvioTheme.colors.TextSecondary
+        )
+        if (state.changed) {
+            Row(
+                modifier = Modifier.fillMaxWidth(),
+                horizontalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.lg)
+            ) {
+                FingerprintColumn(
+                    caption = stringResource(
+                        R.string.addon_cert_trusted_on,
+                        certificateDate(probed.previousTrustedAtMs ?: 0L)
+                    ),
+                    lines = fingerprintLines(probed.previousSha256.orEmpty(), groupsPerLine = 4),
+                    modifier = Modifier.weight(1f)
+                )
+                FingerprintColumn(
+                    caption = stringResource(
+                        R.string.addon_cert_now_valid_until,
+                        certificateDate(probed.leaf.notAfter.time)
+                    ),
+                    lines = fingerprintLines(probed.sha256, groupsPerLine = 4),
+                    modifier = Modifier.weight(1f)
+                )
+            }
+        } else {
+            FingerprintColumn(
+                caption = stringResource(
+                    R.string.addon_cert_fingerprint_label,
+                    certificateDate(probed.leaf.notAfter.time)
+                ),
+                lines = fingerprintLines(probed.sha256, groupsPerLine = 8)
+            )
+        }
+        CertificateDialogActions(
+            primaryLabel = stringResource(
+                if (state.changed) R.string.addon_cert_trust_new else R.string.addon_cert_trust
+            ),
+            safeLabel = stringResource(
+                if (state.changed && state.addonName != null) R.string.addon_cert_keep_paused
+                else R.string.action_cancel
+            ),
+            onPrimary = onTrust,
+            onSafe = onDismiss,
+            safeFocus = safeFocus
+        )
+    }
+}
+
+@Composable
+private fun CertificatePinnedDialog(
+    pinned: AddonCertPinSummary,
+    onForget: () -> Unit,
+    onDismiss: () -> Unit
+) {
+    val label = addonServerLabel(pinned.host, pinned.port)
+    val safeFocus = rememberSafeFocus()
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = stringResource(R.string.addon_cert_pinned_title, label),
+        width = 560.dp
+    ) {
+        Text(
+            text = stringResource(R.string.addon_cert_pinned_note),
+            style = MaterialTheme.typography.bodyMedium,
+            color = NuvioTheme.colors.TextSecondary
+        )
+        FingerprintColumn(
+            caption = stringResource(
+                R.string.addon_cert_trusted_on,
+                certificateDate(pinned.trustedAtMs)
+            ),
+            lines = fingerprintLines(pinned.sha256, groupsPerLine = 8)
+        )
+        CertificateDialogActions(
+            primaryLabel = stringResource(R.string.addon_cert_forget),
+            safeLabel = stringResource(R.string.action_close),
+            onPrimary = onForget,
+            onSafe = onDismiss,
+            safeFocus = safeFocus
+        )
+    }
+}
+
+@Composable
+private fun CertificateDialogActions(
+    primaryLabel: String,
+    safeLabel: String,
+    onPrimary: () -> Unit,
+    onSafe: () -> Unit,
+    safeFocus: FocusRequester
+) {
+    Row(
+        modifier = Modifier.fillMaxWidth(),
+        horizontalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md, Alignment.End)
+    ) {
+        Button(
+            onClick = onPrimary,
+            modifier = Modifier.semantics { role = Role.Button }
+        ) {
+            Text(text = primaryLabel)
+        }
+        Button(
+            onClick = onSafe,
+            modifier = Modifier
+                .focusRequester(safeFocus)
+                .semantics { role = Role.Button }
+        ) {
+            Text(text = safeLabel)
+        }
+    }
+}
+
+@Composable
+private fun FingerprintColumn(
+    caption: String,
+    lines: String,
+    modifier: Modifier = Modifier
+) {
+    Column(
+        modifier = modifier
+            .fillMaxWidth()
+            .background(
+                NuvioTheme.colors.BackgroundCard,
+                RoundedCornerShape(NuvioTheme.radii.md)
+            )
+            .padding(horizontal = NuvioTheme.spacing.md, vertical = NuvioTheme.spacing.sm)
+    ) {
+        Text(
+            text = caption.uppercase(),
+            style = MaterialTheme.typography.labelSmall,
+            color = NuvioTheme.colors.TextTertiary
+        )
+        Text(
+            text = lines,
+            style = MaterialTheme.typography.bodySmall.copy(fontFamily = FontFamily.Monospace),
+            color = NuvioTheme.colors.TextPrimary
+        )
+    }
+}
+
+/** The body: the reason (or the change) and, after a blank line, what Trust does (or what a change means). */
+@Composable
+private fun certificateBody(
+    state: AddonCertificatePanelState,
+    probed: AddonCertProbeResult.Untrusted,
+    label: String
+): String {
+    if (state.changed) {
+        val trustedOn = certificateDate(probed.previousTrustedAtMs ?: 0L)
+        val change = if (state.addonName != null) {
+            stringResource(R.string.addon_cert_changed_body, label, trustedOn, state.addonName)
+        } else {
+            stringResource(R.string.addon_cert_changed_body_install, label, trustedOn)
+        }
+        return change + "\n\n" + stringResource(R.string.addon_cert_changed_note)
+    }
+    val reason = when (probed.reason) {
+        AddonCertProbeResult.Reason.SELF_SIGNED -> stringResource(R.string.addon_cert_reason_self_signed, label)
+        AddonCertProbeResult.Reason.UNKNOWN_ISSUER -> stringResource(R.string.addon_cert_reason_unknown_issuer, label)
+        AddonCertProbeResult.Reason.WRONG_NAME ->
+            stringResource(R.string.addon_cert_reason_wrong_name, label, probed.shownName ?: label)
+        AddonCertProbeResult.Reason.EXPIRED ->
+            stringResource(R.string.addon_cert_reason_expired, label, certificateDate(probed.leaf.notAfter.time))
+    }
+    return reason + "\n\n" + stringResource(R.string.addon_cert_trust_note, label)
+}
+
+/** "14 Mar 2027" in the device locale. */
+private fun certificateDate(epochMs: Long): String =
+    SimpleDateFormat("d MMM yyyy", Locale.getDefault()).format(Date(epochMs))
+
+/** The SHA-256 as 4-character groups, [groupsPerLine] groups per line (8 per line = 32 chars for a first-trust panel). */
+private fun fingerprintLines(sha256: String, groupsPerLine: Int): String =
+    sha256.uppercase(Locale.ROOT)
+        .chunked(4)
+        .chunked(groupsPerLine)
+        .joinToString("\n") { line -> line.joinToString(" ") }
+
+/** The safe button takes focus once the dialog is composed (same two-frame dance as the delete dialog). */
+@Composable
+private fun rememberSafeFocus(): FocusRequester {
+    val requester = remember { FocusRequester() }
+    LaunchedEffect(requester) {
+        repeat(2) { withFrameNanos { } }
+        runCatching { requester.requestFocus() }
+    }
+    return requester
+}
