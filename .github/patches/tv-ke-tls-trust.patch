+    fun reviewCertificate(addon: Addon) {
+        if (certificateJob?.isActive == true) return
+        certificateJob = viewModelScope.launch {
+            val probed = certProbe.probe(addon.baseUrl)
+            when (probed) {
+                is AddonCertProbeResult.Untrusted ->
+                    askTrust(AddonCertificatePanelState(probed = probed, addonName = addon.displayName))
+                AddonCertProbeResult.VerifiesNow -> {
+                    val server = addonServerOf(addon.baseUrl)
+                    val pin = server?.let { pinFor(it.host, it.port) }
+                    if (pin != null) {
+                        askTrust(AddonCertificatePanelState(pinned = pin, addonName = addon.displayName))
+                    } else {
+                        // Nothing pinned: the certificate verifies against the platform now.
+                        showCertificateLine(
+                            R.string.addon_cert_verifies_now,
+                            addonServerLabel(addon.baseUrl).orEmpty(),
+                            isError = false
+                        )
+                    }
+                }
+                AddonCertProbeResult.NoCertificate ->
+                    showCertificateLine(R.string.addon_cert_unreachable, addonServerLabel(addon.baseUrl).orEmpty(), isError = true)
+                AddonCertProbeResult.Inconsistent ->
+                    showCertificateLine(R.string.addon_cert_inconsistent, addonServerLabel(addon.baseUrl).orEmpty(), isError = true)
+            }
+        }
+    }
