@@ -0,0 +1,93 @@
+package com.nuvio.tv.core.network.tls
+
+import kotlinx.serialization.Serializable
+import okhttp3.HttpUrl
+import okhttp3.HttpUrl.Companion.toHttpUrlOrNull
+import java.security.MessageDigest
+import java.security.cert.X509Certificate
+import java.util.Locale
+
+/**
+ * Ported from Nuvio-KE (`core/network/tls/AddonCertPins.kt`).
+ *
+ * One leaf certificate the user trusted for one addon server, stored and shown per `host:port`.
+ * [sha256] is the leaf's DER SHA-256 in upper-case hex; [trustedAtMs] is shown in the
+ * certificate-changed dialog and doubles as the pin store's LRU clock.
+ */
+@Serializable
+data class AddonCertPin(
+    val host: String,
+    val port: Int,
+    val sha256: String,
+    val trustedAtMs: Long
+)
+
+/** An immutable view of every pin, the form the TLS checks read. */
+class AddonCertPins(val pins: List<AddonCertPin>) {
+    private val fingerprints: List<String> = pins.map { it.sha256 }
+
+    /**
+     * Host-blind: only lets a pinned leaf's handshake through. [AddonTrustManager] runs before the
+     * hostname is known, so the host-blind form is the only one it can use; [isPinnedForHost] then
+     * binds the pin to the right host in the hostname verifier.
+     */
+    fun containsFingerprint(sha256: String): Boolean =
+        fingerprints.any { fingerprintsEqual(it, sha256) }
+
+    /**
+     * The hostname verifier is never given the port, so a pin for this host on any port counts.
+     * Comparison is constant-time ([MessageDigest.isEqual]).
+     */
+    fun isPinnedForHost(host: String, sha256: String): Boolean {
+        val key = pinHost(host)
+        return pins.any { it.host == key && fingerprintsEqual(it.sha256, sha256) }
+    }
+
+    companion object {
+        val EMPTY = AddonCertPins(emptyList())
+    }
+}
+
+/** Constant-time fingerprint comparison: never a plain string `==` on secret-dependent input. */
+internal fun fingerprintsEqual(a: String, b: String): Boolean =
+    MessageDigest.isEqual(
+        a.toByteArray(Charsets.UTF_8),
+        b.toByteArray(Charsets.UTF_8)
+    )
+
+/**
+ * The one rule for storing a trusted [pin]: a port with no pin only gains one (another service on
+ * this host keeps its own); a port whose pin differs is a renewal, so its pin is replaced and other
+ * ports of this host holding the same old fingerprint go too. Trusting the fingerprint a port
+ * already holds refreshes its timestamp (the LRU clock and the shown "trusted on" date).
+ */
+internal fun List<AddonCertPin>.withTrusted(pin: AddonCertPin): List<AddonCertPin> {
+    val keyed = pin.copy(host = pinHost(pin.host))
+    val old = firstOrNull { it.host == keyed.host && it.port == keyed.port }
+    if (old == null) return this + keyed
+    if (old.sha256 == keyed.sha256) return map { if (it == old) keyed else it }
+    return filterNot { it.host == keyed.host && (it.port == keyed.port || it.sha256 == old.sha256) } + keyed
+}
+
+/**
+ * The server an addon URL's calls go to (`stremio://` read as `https://`), or null when it does not
+ * parse. Its `host` and `port` are the pin key and, as `host:port`, [com.nuvio.tv.core.network.AddonHostGuard]'s key.
+ */
+internal fun addonServerOf(url: String): HttpUrl? {
+    val trimmed = url.trim()
+    val rewritten = if (trimmed.startsWith("stremio://")) "https://" + trimmed.removePrefix("stremio://") else trimmed
+    return rewritten.takeIf { it.startsWith("http://") || it.startsWith("https://") }?.toHttpUrlOrNull()
+}
+
+/** How a server is named to the user: `host`, or `host:port` when the port is not 443. */
+internal fun addonServerLabel(host: String, port: Int): String = if (port == 443) host else "$host:$port"
+
+/** [addonServerLabel] of an addon URL (host only: never its path or query, which carry keys); null when it does not parse. */
+internal fun addonServerLabel(url: String): String? = addonServerOf(url)?.let { addonServerLabel(it.host, it.port) }
+
+/** The host form pins are keyed by: OkHttp's `HttpUrl.host` (already lower-case punycode), lower-cased again defensively. */
+internal fun pinHost(host: String): String = host.lowercase(Locale.ROOT)
+
+/** Upper-case hex SHA-256 of [cert]'s DER encoding: the pinned value. */
+internal fun leafSha256(cert: X509Certificate): String =
+    MessageDigest.getInstance("SHA-256").digest(cert.encoded).joinToString("") { "%02X".format(it) }
