+package com.nuvio.tv.core.network.tls
+
+import android.util.Log
+import dagger.Lazy
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import javax.inject.Inject
+import javax.inject.Named
+import javax.inject.Singleton
+
+private const val TAG = "AddonCertPinKeeper"
+
+/**
+ * Ported from Nuvio-KE (`core/network/tls/AddonCertPinKeeper.kt`), reduced to what this tree needs.
+ *
+ * Every change to the trusted addon certificates goes through here, under one mutex: Trust
+ * ([trust]), Forget ([forget]) and [clear]. Whenever a pin goes away (a renewal, a forget, or an
+ * LRU eviction), the addon client's idle pooled connections are evicted, so a connection that pin
+ * vouched for is not reused; a connection busy at that moment stays until its call ends (OkHttp's
+ * `evictAll`).
+ *
+ * Deviations from KE: no prune-on-open (this tree has no per-profile stored-addon sweep and the
+ * pin store is LRU-capped instead) and no install-exemption scope (nothing prunes while an
+ * install runs).
+ */
+@Singleton
+class AddonCertPinKeeper internal constructor(
+    private val store: AddonCertPinStore,
+    private val evictConnections: () -> Unit,
+    private val io: CoroutineDispatcher
+) {
+    @Inject
+    internal constructor(
+        store: AddonCertPinStore,
+        @Named("addonPermissive") addonClient: Lazy<OkHttpClient>
+    ) : this(
+        store = store,
+        evictConnections = { addonClient.get().connectionPool.evictAll() },
+        io = Dispatchers.IO
+    )
+
+    private val mutex = Mutex()
+
+    /** Observable pins (the Addons screen reads which servers are pinned). */
+    internal fun pinsFlow(): Flow<AddonCertPins> = store.pinsFlow
+
+    /** The pins, current when this returns (the panel reads the stored pin for a `host:port`). */
+    internal suspend fun currentPins(): AddonCertPins = store.current()
+
+    /** Stores the certificate the user trusted ([pin]); refreshes an existing pin's timestamp. */
+    internal suspend fun trust(pin: AddonCertPin) {
+        mutex.withLock { if (store.put(pin)) evict() }
+    }
+
+    /** The user forgot [host]:[port]'s pin; true when one was stored and is now gone. */
+    internal suspend fun forget(host: String, port: Int): Boolean = mutex.withLock {
+        val key = pinHost(host)
+        val removed = store.removeWhere { it.host == key && it.port == port }
+        if (removed) evict()
+        removed
+    }
+
+    /** Forgets every trusted certificate. */
+    suspend fun clear() {
+        mutex.withLock {
+            try {
+                store.clear()
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: Exception) {
+                Log.w(TAG, "Pin clear skipped: ${e.javaClass.simpleName}")
+            }
+            evict()
+        }
+    }
+
+    private suspend fun evict() = withContext(io) { evictConnections() }
+}
