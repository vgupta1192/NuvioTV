+package com.nuvio.tv.forklivetv
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+import okhttp3.FormBody
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import java.util.concurrent.TimeUnit
+
+/**
+ * Nuvio fork: Google Drive backup of the IPTV sources and the fork settings. Uses Google's device-code sign-in
+ * ("TVs and limited input devices" OAuth client that the user creates once) and the hidden Drive app-data folder,
+ * so the file never shows in the user's normal Drive and the app can only see its own file.
+ * Nothing here touches the Live TV player.
+ */
+object ForkDriveBackup {
+    private const val PREFS = "fork_drive_backup"
+    private const val FILE_NAME = "nuvio-tv-backup.json"
+    private const val SCOPE = "https://www.googleapis.com/auth/drive.file"
+    private val JSON = "application/json; charset=utf-8".toMediaType()
+
+    private val http = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(60, TimeUnit.SECONDS)
+        .build()
+
+    class SignInPrompt(val userCode: String, val url: String, val deviceCode: String, val expiresAtMs: Long, val intervalSec: Int)
+
+    private fun prefs(context: Context) = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    fun clientId(context: Context): String = prefs(context).getString("client_id", "").orEmpty()
+    fun clientSecret(context: Context): String = prefs(context).getString("client_secret", "").orEmpty()
+    fun isConfigured(context: Context) = clientId(context).isNotBlank() && clientSecret(context).isNotBlank()
+    fun isSignedIn(context: Context) = prefs(context).getString("refresh_token", "").orEmpty().isNotBlank()
+    fun lastBackupMs(context: Context): Long = prefs(context).getLong("last_backup", 0L)
+
+    fun saveClient(context: Context, id: String, secret: String) {
+        prefs(context).edit().putString("client_id", id.trim()).putString("client_secret", secret.trim()).apply()
+    }
+
+    fun signOut(context: Context) {
+        prefs(context).edit().remove("refresh_token").remove("last_backup").apply()
+    }
+
+    suspend fun beginSignIn(context: Context): SignInPrompt = withContext(Dispatchers.IO) {
+        val body = FormBody.Builder().add("client_id", clientId(context)).add("scope", SCOPE).build()
+        val json = post("https://oauth2.googleapis.com/device/code", body)
+        SignInPrompt(
+            userCode = json.getString("user_code"),
+            url = json.optString("verification_url").ifBlank { json.optString("verification_uri", "https://www.google.com/device") },
+            deviceCode = json.getString("device_code"),
+            expiresAtMs = System.currentTimeMillis() + json.optLong("expires_in", 900L) * 1000L,
+            intervalSec = json.optInt("interval", 5).coerceAtLeast(3),
+        )
+    }
+
+    /** Polls until the user approved the code on their phone. Returns normally once signed in, throws on denial or expiry. */
+    suspend fun finishSignIn(context: Context, prompt: SignInPrompt) {
+        while (System.currentTimeMillis() < prompt.expiresAtMs) {
+            delay(prompt.intervalSec * 1000L)
+            val result = withContext(Dispatchers.IO) {
+                val body = FormBody.Builder()
+                    .add("client_id", clientId(context))
+                    .add("client_secret", clientSecret(context))
+                    .add("device_code", prompt.deviceCode)
+                    .add("grant_type", "urn:ietf:params:oauth:grant-type:device_code")
+                    .build()
+                postRaw("https://oauth2.googleapis.com/token", body)
+            }
+            val refresh = result.optString("refresh_token")
+            if (refresh.isNotBlank()) {
+                prefs(context).edit().putString("refresh_token", refresh).apply()
+                return
+            }
+            when (result.optString("error")) {
+                "authorization_pending", "slow_down", "" -> Unit
+                "access_denied" -> throw IOException("Sign-in was denied.")
+                "expired_token" -> throw IOException("The code expired. Try again.")
+                else -> throw IOException(result.optString("error_description").ifBlank { result.optString("error") })
+            }
+        }
+        throw IOException("The code expired. Try again.")
+    }
+
+    suspend fun backUp(context: Context): String = withContext(Dispatchers.IO) {
+        val token = accessToken(context)
+        val payload = buildPayload(context).toString().toRequestBody(JSON)
+        val existing = findFileId(token)
+        if (existing == null) {
+            val meta = JSONObject().put("name", FILE_NAME)
+            val multipart = okhttp3.MultipartBody.Builder().setType("multipart/related".toMediaType())
+                .addPart(meta.toString().toRequestBody(JSON))
+                .addPart(payload)
+                .build()
+            val req = Request.Builder()
+                .url("https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart")
+                .header("Authorization", "Bearer $token")
+                .post(multipart)
+                .build()
+            http.newCall(req).execute().use { ensureOk(it) }
+        } else {
+            val req = Request.Builder()
+                .url("https://www.googleapis.com/upload/drive/v3/files/$existing?uploadType=media")
+                .header("Authorization", "Bearer $token")
+                .patch(payload)
+                .build()
+            http.newCall(req).execute().use { ensureOk(it) }
+        }
+        prefs(context).edit().putLong("last_backup", System.currentTimeMillis()).apply()
+        "Backed up ${summary(buildPayload(context))}."
+    }
+
+    suspend fun restore(context: Context): String = withContext(Dispatchers.IO) {
+        val token = accessToken(context)
+        val id = findFileId(token) ?: throw IOException("No backup found in this Google account yet.")
+        val req = Request.Builder()
+            .url("https://www.googleapis.com/drive/v3/files/$id?alt=media")
+            .header("Authorization", "Bearer $token")
+            .build()
+        val text = http.newCall(req).execute().use { ensureOk(it); it.body?.string().orEmpty() }
+        val json = JSONObject(text)
+        apply(context, json)
+        "Restored ${summary(json)}. Restart Nuvio to apply."
+    }
+
+    private fun summary(json: JSONObject): String {
+        val sources = runCatching { JSONArray(json.optString("iptvSources", "[]")).length() }.getOrDefault(0)
+        val settings = json.optJSONObject("forkSettings")?.length() ?: 0
+        return "$sources IPTV source(s) and $settings setting(s)"
+    }
+
+    private fun buildPayload(context: Context): JSONObject {
+        val app = context.applicationContext
+        val settings = JSONObject()
+        app.getSharedPreferences("nuvio_fork_tv_settings", Context.MODE_PRIVATE).all.forEach { (k, v) ->
+            when (v) {
+                is Boolean -> settings.put(k, JSONObject().put("t", "b").put("v", v))
+                is Int -> settings.put(k, JSONObject().put("t", "i").put("v", v))
+                is Long -> settings.put(k, JSONObject().put("t", "l").put("v", v))
+                is Float -> settings.put(k, JSONObject().put("t", "f").put("v", v.toDouble()))
+                is String -> settings.put(k, JSONObject().put("t", "s").put("v", v))
+            }
+        }
+        return JSONObject()
+            .put("version", 1)
+            .put("savedAt", System.currentTimeMillis())
+            .put("iptvSources", app.getSharedPreferences("nuvio_iptv", Context.MODE_PRIVATE).getString("sources", "[]"))
+            .put("forkSettings", settings)
+    }
+
+    private fun apply(context: Context, json: JSONObject) {
+        val app = context.applicationContext
+        if (json.has("iptvSources")) {
+            app.getSharedPreferences("nuvio_iptv", Context.MODE_PRIVATE).edit()
+                .putString("sources", json.getString("iptvSources")).apply()
+        }
+        val settings = json.optJSONObject("forkSettings") ?: return
+        val edit = app.getSharedPreferences("nuvio_fork_tv_settings", Context.MODE_PRIVATE).edit()
+        settings.keys().forEach { k ->
+            val e = settings.optJSONObject(k) ?: return@forEach
+            when (e.optString("t")) {
+                "b" -> edit.putBoolean(k, e.optBoolean("v"))
+                "i" -> edit.putInt(k, e.optInt("v"))
+                "l" -> edit.putLong(k, e.optLong("v"))
+                "f" -> edit.putFloat(k, e.optDouble("v").toFloat())
+                "s" -> edit.putString(k, e.optString("v"))
+            }
+        }
+        edit.apply()
+    }
+
+    private fun accessToken(context: Context): String {
+        val refresh = prefs(context).getString("refresh_token", "").orEmpty()
+        if (refresh.isBlank()) throw IOException("Sign in to Google first.")
+        val body = FormBody.Builder()
+            .add("client_id", clientId(context))
+            .add("client_secret", clientSecret(context))
+            .add("refresh_token", refresh)
+            .add("grant_type", "refresh_token")
+            .build()
+        val json = postRaw("https://oauth2.googleapis.com/token", body)
+        val token = json.optString("access_token")
+        if (token.isBlank()) {
+            if (json.optString("error") == "invalid_grant") signOut(context)
+            throw IOException(json.optString("error_description").ifBlank { "Google sign-in expired. Sign in again." })
+        }
+        return token
+    }
+
+    private fun findFileId(token: String): String? {
+        val url = okhttp3.HttpUrl.Builder().scheme("https").host("www.googleapis.com").addPathSegments("drive/v3/files")
+            .addQueryParameter("q", "name = '$FILE_NAME' and trashed = false")
+            .addQueryParameter("fields", "files(id,modifiedTime)")
+            .addQueryParameter("orderBy", "modifiedTime desc")
+            .build()
+        val req = Request.Builder().url(url).header("Authorization", "Bearer $token").build()
+        val text = http.newCall(req).execute().use { ensureOk(it); it.body?.string().orEmpty() }
+        val files = JSONObject(text).optJSONArray("files") ?: return null
+        return if (files.length() > 0) files.getJSONObject(0).getString("id") else null
+    }
+
+    private fun ensureOk(r: okhttp3.Response) {
+        if (r.isSuccessful) return
+        val text = r.body?.string().orEmpty()
+        val msg = runCatching { JSONObject(text).getJSONObject("error").optString("message") }.getOrNull()
+        throw IOException(if (msg.isNullOrBlank()) "Google Drive answered HTTP ${r.code}" else "Google Drive: $msg")
+    }
+
+    private fun post(url: String, body: FormBody): JSONObject {
+        val json = postRaw(url, body)
+        if (json.has("error")) throw IOException(json.optString("error_description").ifBlank { json.optString("error") })
+        return json
+    }
+
+    private fun postRaw(url: String, body: FormBody): JSONObject {
+        val req = Request.Builder().url(url).post(body).build()
+        http.newCall(req).execute().use { r ->
+            val text = r.body?.string().orEmpty()
+            return runCatching { JSONObject(text) }.getOrElse { throw IOException("Unexpected answer (HTTP ${r.code})") }
+        }
+    }
+}
