+package com.nuvio.tv.forklivetv
+
+import android.app.Notification
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.Service
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ServiceInfo
+import android.os.Build
+import android.os.IBinder
+import androidx.core.app.NotificationCompat
+
+/** Nuvio fork: keeps a Live TV recording alive while the app is in the background. Stops itself when the recording ends. */
+class ForkLiveRecordingService : Service() {
+    companion object {
+        const val EXTRA_URL = "url"
+        const val EXTRA_CHANNEL = "channel"
+        const val EXTRA_MINUTES = "minutes"
+        const val EXTRA_HEADERS = "headers"
+        private const val CHANNEL_ID = "fork_live_recording"
+        private const val NOTIFICATION_ID = 7421
+    }
+
+    @Volatile private var worker: Thread? = null
+
+    override fun onBind(intent: Intent?): IBinder? = null
+
+    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
+        val url = intent?.getStringExtra(EXTRA_URL)
+        if (intent == null || url.isNullOrBlank()) {
+            stopSelf()
+            return START_NOT_STICKY
+        }
+        val channel = intent.getStringExtra(EXTRA_CHANNEL).orEmpty().ifBlank { "channel" }
+        val minutes = intent.getIntExtra(EXTRA_MINUTES, 120)
+        val headers = intent.getStringArrayListExtra(EXTRA_HEADERS).orEmpty()
+            .mapNotNull { it.split('\n', limit = 2).takeIf { p -> p.size == 2 }?.let { p -> p[0] to p[1] } }
+            .toMap()
+        startAsForeground(channel)
+        if (worker?.isAlive == true) return START_NOT_STICKY
+        val app = applicationContext
+        worker = Thread {
+            try {
+                ForkLiveRecorder.run(app, url, headers, channel, minutes)
+            } finally {
+                stopForegroundCompat()
+                stopSelf()
+            }
+        }.also {
+            it.name = "fork-live-recorder"
+            it.start()
+        }
+        return START_NOT_STICKY
+    }
+
+    override fun onDestroy() {
+        ForkLiveRecorder.stop()
+        super.onDestroy()
+    }
+
+    private fun startAsForeground(channel: String) {
+        val nm = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        if (Build.VERSION.SDK_INT >= 26) {
+            nm.createNotificationChannel(
+                NotificationChannel(CHANNEL_ID, "Live TV recording", NotificationManager.IMPORTANCE_LOW)
+            )
+        }
+        val notification: Notification = NotificationCompat.Builder(this, CHANNEL_ID)
+            .setContentTitle("Recording $channel")
+            .setContentText("Live TV recording is running")
+            .setSmallIcon(android.R.drawable.ic_menu_save)
+            .setOngoing(true)
+            .build()
+        if (Build.VERSION.SDK_INT >= 29) {
+            startForeground(NOTIFICATION_ID, notification, ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK)
+        } else {
+            startForeground(NOTIFICATION_ID, notification)
+        }
+    }
+
+    @Suppress("DEPRECATION")
+    private fun stopForegroundCompat() {
+        if (Build.VERSION.SDK_INT >= 24) stopForeground(STOP_FOREGROUND_REMOVE) else stopForeground(true)
+    }
+}
