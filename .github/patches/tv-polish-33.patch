+package com.nuvio.tv.forklivetv
+
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+import com.nuvio.tv.ui.screens.player.PlayerMediaSourceFactory
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import okhttp3.Call
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import java.io.File
+import java.io.FileOutputStream
+import java.io.IOException
+import java.net.URI
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.TimeUnit
+
+/**
+ * Nuvio fork: Live TV recording. Fully separate from the Live TV player: it opens its own HTTP connection to the
+ * stream URL, never touches the shared ExoPlayer, and writes a plain MPEG-TS file that the Recordings screen can play.
+ * Direct TS streams are copied byte for byte. HLS playlists (TS segments) are followed and appended. Encrypted or
+ * fMP4 HLS is refused with a clear message instead of writing a broken file.
+ */
+object ForkLiveRecorder {
+    private const val TAG = "ForkLiveRecorder"
+    private const val MIN_FREE_BYTES = 400L * 1024 * 1024
+    private const val MAX_RECONNECTS = 6
+
+    data class Active(val channel: String, val file: File, val startedAt: Long, val untilMs: Long)
+
+    private val _active = MutableStateFlow<Active?>(null)
+    val active: StateFlow<Active?> = _active.asStateFlow()
+    private val _bytes = MutableStateFlow(0L)
+    val bytes: StateFlow<Long> = _bytes.asStateFlow()
+    private val _message = MutableStateFlow<String?>(null)
+    val message: StateFlow<String?> = _message.asStateFlow()
+
+    @Volatile private var stopRequested = false
+    @Volatile private var call: Call? = null
+
+    private val http: OkHttpClient = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(25, TimeUnit.SECONDS)
+        .followRedirects(true)
+        .followSslRedirects(true)
+        .build()
+
+    private val MINUTE_CHOICES = listOf(30, 60, 120, 240, 0)
+
+    fun maxMinutes(context: Context): Int =
+        context.applicationContext.getSharedPreferences("fork_live_rec", Context.MODE_PRIVATE).getInt("max_minutes", 120)
+
+    /** Cycles 30 / 60 / 120 / 240 minutes / until stopped; returns the new value. */
+    fun cycleMaxMinutes(context: Context): Int {
+        val next = MINUTE_CHOICES[(MINUTE_CHOICES.indexOf(maxMinutes(context)) + 1).mod(MINUTE_CHOICES.size)]
+        context.applicationContext.getSharedPreferences("fork_live_rec", Context.MODE_PRIVATE).edit().putInt("max_minutes", next).apply()
+        return next
+    }
+
+    fun recordingsDir(context: Context): File {
+        val base = context.getExternalFilesDir("recordings") ?: File(context.filesDir, "recordings")
+        base.mkdirs()
+        return base
+    }
+
+    fun list(context: Context): List<File> =
+        recordingsDir(context).listFiles { f -> f.isFile && f.name.endsWith(".ts") }
+            ?.sortedByDescending { it.lastModified() }.orEmpty()
+
+    fun start(context: Context, url: String, headers: Map<String, String>?, channel: String, maxMinutes: Int) {
+        if (_active.value != null) return
+        val intent = Intent(context, ForkLiveRecordingService::class.java)
+            .putExtra(ForkLiveRecordingService.EXTRA_URL, url)
+            .putExtra(ForkLiveRecordingService.EXTRA_CHANNEL, channel)
+            .putExtra(ForkLiveRecordingService.EXTRA_MINUTES, maxMinutes)
+            .putStringArrayListExtra(
+                ForkLiveRecordingService.EXTRA_HEADERS,
+                ArrayList(headers.orEmpty().map { "${it.key}\n${it.value}" })
+            )
+        _message.value = null
+        if (Build.VERSION.SDK_INT >= 26) context.startForegroundService(intent) else context.startService(intent)
+    }
+
+    fun stop() {
+        stopRequested = true
+        call?.cancel()
+    }
+
+    /** Blocking. Runs on the service's IO thread until stopped, the time limit, an error or the end of the stream. */
+    internal fun run(context: Context, rawUrl: String, rawHeaders: Map<String, String>, channel: String, maxMinutes: Int) {
+        stopRequested = false
+        // Same URL clean-up the Live TV player uses (user:pass@host becomes a Basic auth header).
+        val (url, mergedHeaders) = PlayerMediaSourceFactory.extractUserInfoAuth(rawUrl, rawHeaders)
+        val headers = PlayerMediaSourceFactory.sanitizeHeaders(mergedHeaders)
+        val stamp = SimpleDateFormat("yyyyMMdd-HHmm", Locale.US).format(Date())
+        val safe = channel.replace(Regex("[^A-Za-z0-9._-]+"), "_").trim('_').take(40).ifBlank { "channel" }
+        val file = File(recordingsDir(context), "${safe}_$stamp.ts")
+        val now = System.currentTimeMillis()
+        val until = if (maxMinutes > 0) now + maxMinutes * 60_000L else Long.MAX_VALUE
+        _bytes.value = 0L
+        _active.value = Active(channel, file, now, until)
+        try {
+            FileOutputStream(file, true).use { out ->
+                val sink = Sink(out, file, until)
+                var failures = 0
+                while (!sink.done()) {
+                    try {
+                        val kind = openAndRecord(url, headers, sink)
+                        if (kind == End.FINISHED || sink.done()) break
+                        failures++
+                    } catch (e: StopRecording) {
+                        break
+                    } catch (e: IOException) {
+                        if (sink.done()) break
+                        failures++
+                        Log.w(TAG, "stream error: ${e.message}")
+                    }
+                    if (failures > MAX_RECONNECTS) {
+                        _message.value = "Recording stopped: the stream kept dropping."
+                        break
+                    }
+                    Thread.sleep(2000)
+                }
+            }
+        } catch (e: StopRecording) {
+            // fall through, keep what was recorded
+        } catch (e: Exception) {
+            Log.w(TAG, "recording failed", e)
+            _message.value = "Recording failed: ${e.message}"
+        } finally {
+            call = null
+            if (file.exists() && file.length() < 64 * 1024) file.delete()
+            if (_message.value == null && file.exists()) _message.value = "Saved ${file.name}"
+            _active.value = null
+        }
+    }
+
+    private class StopRecording(msg: String) : RuntimeException(msg)
+    private enum class End { FINISHED, DROPPED }
+
+    private class Sink(val out: FileOutputStream, val file: File, val until: Long) {
+        fun done(): Boolean = stopRequested || System.currentTimeMillis() >= until
+        fun write(buf: ByteArray, len: Int) {
+            if (done()) throw StopRecording("stopped")
+            out.write(buf, 0, len)
+            _bytes.value = _bytes.value + len
+            if (file.usableSpace < MIN_FREE_BYTES) {
+                _message.value = "Recording stopped: storage is almost full."
+                throw StopRecording("disk full")
+            }
+        }
+    }
+
+    private fun request(url: String, headers: Map<String, String>): Request {
+        val b = Request.Builder().url(url).header("User-Agent", "Mozilla/5.0").header("Accept", "*/*")
+        headers.forEach { (k, v) -> runCatching { b.header(k, v) } }
+        return b.build()
+    }
+
+    private fun openAndRecord(url: String, headers: Map<String, String>, sink: Sink): End {
+        val c = http.newCall(request(url, headers))
+        call = c
+        c.execute().use { resp ->
+            if (!resp.isSuccessful) throw IOException("HTTP ${resp.code}")
+            val body = resp.body ?: throw IOException("empty response")
+            val type = resp.header("Content-Type").orEmpty().lowercase(Locale.US)
+            val looksHls = type.contains("mpegurl") || url.substringBefore('?').endsWith(".m3u8", true)
+            val source = body.source()
+            if (looksHls || (source.request(7) && source.peek().readUtf8(7) == "#EXTM3U")) {
+                val text = source.readUtf8()
+                return recordHls(resp.request.url.toString(), text, headers, sink)
+            }
+            val buf = ByteArray(64 * 1024)
+            val stream = body.byteStream()
+            while (true) {
+                val n = stream.read(buf)
+                if (n < 0) return End.DROPPED
+                sink.write(buf, n)
+            }
+        }
+    }
+
+    private fun fetch(url: String, headers: Map<String, String>): okhttp3.Response {
+        val c = http.newCall(request(url, headers))
+        call = c
+        val r = c.execute()
+        if (!r.isSuccessful) {
+            r.close()
+            throw IOException("HTTP ${r.code}")
+        }
+        return r
+    }
+
+    private fun resolve(base: String, ref: String): String = runCatching { URI(base).resolve(ref).toString() }.getOrDefault(ref)
+
+    private fun recordHls(firstUrl: String, firstText: String, headers: Map<String, String>, sink: Sink): End {
+        var playlistUrl = firstUrl
+        var text = firstText
+        if (text.contains("#EXT-X-STREAM-INF")) {
+            val lines = text.lines()
+            var best = -1L
+            var bestUrl: String? = null
+            for (i in lines.indices) {
+                if (!lines[i].startsWith("#EXT-X-STREAM-INF")) continue
+                val bw = Regex("BANDWIDTH=(\\d+)").find(lines[i])?.groupValues?.get(1)?.toLongOrNull() ?: 0L
+                val next = lines.drop(i + 1).firstOrNull { it.isNotBlank() && !it.startsWith("#") } ?: continue
+                if (bw > best) { best = bw; bestUrl = next.trim() }
+            }
+            playlistUrl = resolve(playlistUrl, bestUrl ?: throw IOException("playlist has no variants"))
+            text = fetch(playlistUrl, headers).use { it.body?.string().orEmpty() }
+        }
+        val seen = LinkedHashSet<String>()
+        var emptyRounds = 0
+        while (!sink.done()) {
+            if (text.contains("#EXT-X-MAP")) throw StopRecording("fMP4 HLS is not supported").also {
+                _message.value = "This channel uses fMP4 HLS, which cannot be recorded yet."
+            }
+            if (Regex("#EXT-X-KEY:.*METHOD=(?!NONE)").containsMatchIn(text)) {
+                _message.value = "This channel is encrypted and cannot be recorded."
+                throw StopRecording("encrypted")
+            }
+            val lines = text.lines()
+            val target = Regex("#EXT-X-TARGETDURATION:(\\d+)").find(text)?.groupValues?.get(1)?.toLongOrNull() ?: 6L
+            var added = 0
+            for (line in lines) {
+                if (line.isBlank() || line.startsWith("#")) continue
+                val seg = resolve(playlistUrl, line.trim())
+                if (!seen.add(seg)) continue
+                added++
+                fetch(seg, headers).use { r ->
+                    val buf = ByteArray(64 * 1024)
+                    val st = r.body?.byteStream() ?: throw IOException("empty segment")
+                    while (true) {
+                        val n = st.read(buf)
+                        if (n < 0) break
+                        sink.write(buf, n)
+                    }
+                }
+                if (seen.size > 400) seen.remove(seen.first())
+            }
+            if (text.contains("#EXT-X-ENDLIST")) return End.FINISHED
+            emptyRounds = if (added == 0) emptyRounds + 1 else 0
+            if (emptyRounds > 8) return End.DROPPED
+            var waited = 0L
+            val wait = (target * 500L).coerceIn(1000L, 5000L)
+            while (waited < wait && !sink.done()) { Thread.sleep(250); waited += 250 }
+            if (sink.done()) break
+            text = fetch(playlistUrl, headers).use { it.body?.string().orEmpty() }
+        }
+        return End.FINISHED
+    }
+}
