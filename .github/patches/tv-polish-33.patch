+    val signedIn = remember(tick, show) { ForkDriveBackup.isSignedIn(context) }
+    SettingsActionRow(
+        title = "Google Drive backup",
+        subtitle = "Back up IPTV sources and fork settings to your own Google Drive, and restore them.",
+        value = if (signedIn) "Signed in" else "Off",
+        onClick = { show = true },
+    )
+    if (show) ForkDriveDialog(onDismiss = { show = false; tick++ })
+}
+
+@Composable
+private fun ForkDriveDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val scope = rememberCoroutineScope()
+    var clientId by remember { mutableStateOf(ForkDriveBackup.clientId(context)) }
+    var clientSecret by remember { mutableStateOf(ForkDriveBackup.clientSecret(context)) }
+    var configured by remember { mutableStateOf(ForkDriveBackup.isConfigured(context)) }
+    var signedIn by remember { mutableStateOf(ForkDriveBackup.isSignedIn(context)) }
+    var prompt by remember { mutableStateOf<ForkDriveBackup.SignInPrompt?>(null) }
+    var status by remember { mutableStateOf<String?>(null) }
+    var busy by remember { mutableStateOf(false) }
+    var job by remember { mutableStateOf<Job?>(null) }
+
+    fun run(label: String, block: suspend () -> String) {
+        if (busy) return
+        busy = true
+        status = label
+        job = scope.launch {
+            status = try { block() } catch (e: Exception) { e.message ?: "Failed." }
+            signedIn = ForkDriveBackup.isSignedIn(context)
+            busy = false
+        }
+    }
+
+    NuvioDialog(
+        onDismiss = { job?.cancel(); onDismiss() },
+        title = "Google Drive backup",
+        subtitle = "Saves one small file named nuvio-tv-backup.json in your Drive. The app can only see files it created.",
+        width = 760.dp,
+    ) {
+        Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {
+            when {
+                !configured -> {
+                    Text(
+                        "One-time setup: in Google Cloud Console create an OAuth client of type \"TVs and limited input devices\", " +
+                            "enable the Google Drive API, then enter its client ID and secret here.",
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = NuvioTheme.colors.TextSecondary,
+                    )
+                    PhoneEntryButton(title = "OAuth client ID", secret = false, onValue = { clientId = it })
+                    Text(
+                        if (clientId.isBlank()) "Client ID: not set" else "Client ID: set",
+                        style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextPrimary,
+                    )
+                    PhoneEntryButton(title = "OAuth client secret", secret = true, onValue = { clientSecret = it })
+                    Text(
+                        if (clientSecret.isBlank()) "Client secret: not set" else "Client secret: set",
+                        style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextPrimary,
+                    )
+                    Button(
+                        onClick = {
+                            ForkDriveBackup.saveClient(context, clientId, clientSecret)
+                            configured = ForkDriveBackup.isConfigured(context)
+                        },
+                        enabled = clientId.isNotBlank() && clientSecret.isNotBlank(),
+                    ) { Text("Save client") }
+                }
+                !signedIn -> {
+                    val p = prompt
+                    if (p != null) {
+                        Text(
+                            "On your phone open ${p.url} and enter the code:",
+                            style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextPrimary,
+                        )
+                        Text(p.userCode, style = MaterialTheme.typography.headlineMedium, color = NuvioTheme.colors.TextPrimary)
+                    } else {
+                        Text(
+                            "Sign in with a code shown on this TV. You approve it on your phone.",
+                            style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextSecondary,
+                        )
+                    }
+                    Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        Button(
+                            enabled = !busy,
+                            onClick = {
+                                busy = true
+                                status = "Asking Google for a code..."
+                                job = scope.launch {
+                                    try {
+                                        val np = ForkDriveBackup.beginSignIn(context)
+                                        prompt = np
+                                        status = "Waiting for you to approve on your phone..."
+                                        ForkDriveBackup.finishSignIn(context, np)
+                                        prompt = null
+                                        signedIn = true
+                                        status = "Signed in."
+                                    } catch (e: Exception) {
+                                        prompt = null
+                                        status = e.message ?: "Sign-in failed."
+                                    }
+                                    busy = false
+                                }
+                            },
+                        ) { Text(if (prompt == null) "Sign in" else "Waiting...") }
+                        Button(onClick = {
+                            job?.cancel(); busy = false; prompt = null
+                            configured = false; signedIn = false
+                        }) { Text("Change client") }
+                    }
+                }
+                else -> {
+                    val last = ForkDriveBackup.lastBackupMs(context)
+                    Text(
+                        if (last > 0) "Last backup from this TV: " + DateFormat.format("d MMM yyyy HH:mm", Date(last))
+                        else "No backup made from this TV yet.",
+                        style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextPrimary,
+                    )
+                    Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                        Button(enabled = !busy, onClick = { run("Backing up...") { ForkDriveBackup.backUp(context) } }) { Text("Back up now") }
+                        Button(enabled = !busy, onClick = { run("Restoring...") { ForkDriveBackup.restore(context) } }) { Text("Restore") }
+                        Button(enabled = !busy, onClick = {
+                            ForkDriveBackup.signOut(context); signedIn = false; status = "Signed out."
+                        }) { Text("Sign out") }
+                    }
+                }
+            }
+            status?.let {
+                Text(it, style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextSecondary)
+            }
+            Row(modifier = Modifier.padding(top = 4.dp)) {
+                Button(onClick = { job?.cancel(); onDismiss() }) { Text("Close") }
+            }
+        }
+    }
+}
