+/** Nuvio fork: Settings > Features > Live TV rows (recordings list and Google Drive backup). */
+@Composable
+internal fun forkLiveRecordingsRow() {
+    val context = LocalContext.current
+    val active by ForkLiveRecorder.active.collectAsStateWithLifecycle()
+    var show by remember { mutableStateOf(false) }
+    SettingsActionRow(
+        title = "Live TV recordings",
+        subtitle = "Record from the Live TV options panel. Play, delete and set the length here.",
+        value = if (active != null) "Recording" else null,
+        onClick = { show = true },
+    )
+    if (show) ForkRecordingsDialog(onDismiss = { show = false })
+}
+
+@Composable
+private fun ForkRecordingsDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    val active by ForkLiveRecorder.active.collectAsStateWithLifecycle()
+    val bytes by ForkLiveRecorder.bytes.collectAsStateWithLifecycle()
+    val message by ForkLiveRecorder.message.collectAsStateWithLifecycle()
+    var nonce by remember { mutableStateOf(0) }
+    var maxMinutes by remember { mutableStateOf(ForkLiveRecorder.maxMinutes(context)) }
+    var playing by remember { mutableStateOf<File?>(null) }
+    val files = remember(nonce, active) { ForkLiveRecorder.list(context) }
+
+    NuvioDialog(onDismiss = onDismiss, title = "Live TV recordings", width = 760.dp) {
+        Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            val a = active
+            if (a != null) {
+                Text(
+                    text = "Recording ${a.channel}: ${Formatter.formatShortFileSize(context, bytes)}",
+                    style = MaterialTheme.typography.titleSmall,
+                    color = NuvioTheme.colors.TextPrimary,
+                )
+                Button(onClick = { ForkLiveRecorder.stop() }) { Text("Stop recording") }
+            }
+            if (!message.isNullOrBlank() && a == null) {
+                Text(message.orEmpty(), style = MaterialTheme.typography.bodyMedium, color = NuvioTheme.colors.TextSecondary)
+            }
+            LazyColumn(
+                modifier = Modifier.fillMaxWidth().heightIn(max = 300.dp),
+                verticalArrangement = Arrangement.spacedBy(6.dp),
+            ) {
+                if (files.isEmpty()) {
+                    item {
+                        Text(
+                            "No recordings yet. Open a channel, press OK for the options panel, then choose Start recording.",
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = NuvioTheme.colors.TextSecondary,
+                        )
+                    }
+                }
+                items(files, key = { it.absolutePath }) { f ->
+                    val live = a?.file?.absolutePath == f.absolutePath
+                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp), modifier = Modifier.fillMaxWidth()) {
+                        Button(onClick = { if (!live) playing = f }, enabled = !live, modifier = Modifier.weight(1f)) {
+                            Text(
+                                text = f.nameWithoutExtension.replace('_', ' ') + "  ·  " +
+                                    Formatter.formatShortFileSize(context, f.length()) +
+                                    if (live) "  ·  recording" else "",
+                                maxLines = 1,
+                                overflow = TextOverflow.Ellipsis,
+                            )
+                        }
+                        Button(onClick = { if (!live) { f.delete(); nonce++ } }, enabled = !live) { Text("Delete") }
+                    }
+                }
+            }
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp), modifier = Modifier.padding(top = 4.dp)) {
+                Button(onClick = { maxMinutes = ForkLiveRecorder.cycleMaxMinutes(context) }) {
+                    Text("Length: " + if (maxMinutes == 0) "until stopped" else "$maxMinutes min")
+                }
+                Button(onClick = { nonce++ }) { Text("Refresh") }
+                Button(onClick = onDismiss) { Text("Close") }
+            }
+        }
+    }
+    playing?.let { ForkRecordingPlayer(file = it, onClose = { playing = null }) }
+}
+
+@Composable
+private fun ForkRecordingPlayer(file: File, onClose: () -> Unit) {
+    val context = LocalContext.current
+    val exo = remember(file) {
+        ExoPlayer.Builder(context).build().apply {
+            setMediaItem(MediaItem.fromUri(android.net.Uri.fromFile(file)))
+            prepare()
+            playWhenReady = true
+        }
+    }
+    DisposableEffect(exo) { onDispose { exo.release() } }
+    Dialog(onDismissRequest = onClose, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Box(modifier = Modifier.fillMaxSize().background(Color.Black)) {
+            AndroidView(
+                modifier = Modifier.fillMaxSize(),
+                factory = { ctx ->
+                    PlayerView(ctx).apply {
+                        this.player = exo
+                        useController = true
+                        controllerShowTimeoutMs = 4000
+                        isFocusable = true
+                        isFocusableInTouchMode = true
+                        requestFocus()
+                    }
+                },
+            )
+        }
+    }
+}
