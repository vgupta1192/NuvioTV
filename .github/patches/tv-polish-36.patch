@@ -0,0 +1,68 @@
+package com.nuvio.tv.data.local
+
+import androidx.datastore.preferences.core.booleanPreferencesKey
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringSetPreferencesKey
+import com.nuvio.tv.core.profile.ProfileManager
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.map
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Nuvio fork: per-profile choices for the library release calendar and the sidebar pages.
+ * Hidden calendar titles are stored as "type:id" keys, hidden pages as nav route strings.
+ * The "fork_calendar_prefs" feature is part of the profile settings sync.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+@Singleton
+class ForkCalendarPrefsStore @Inject constructor(
+    private val factory: ProfileDataStoreFactory,
+    private val profileManager: ProfileManager
+) {
+    companion object {
+        const val FEATURE = "fork_calendar_prefs"
+        private val HIDDEN_TITLES = stringSetPreferencesKey("hidden_calendar_titles")
+        private val HIDDEN_PAGES = stringSetPreferencesKey("hidden_sidebar_pages")
+        private val CALENDAR_OFF = booleanPreferencesKey("library_calendar_off")
+    }
+
+    private fun store() = factory.get(profileManager.activeProfileId.value, FEATURE)
+
+    val hiddenTitles: Flow<Set<String>> = profileManager.activeProfileId.flatMapLatest { pid ->
+        factory.get(pid, FEATURE).data.map { it[HIDDEN_TITLES] ?: emptySet() }
+    }.distinctUntilChanged()
+
+    val hiddenPages: Flow<Set<String>> = profileManager.activeProfileId.flatMapLatest { pid ->
+        factory.get(pid, FEATURE).data.map { it[HIDDEN_PAGES] ?: emptySet() }
+    }.distinctUntilChanged()
+
+    val calendarEnabled: Flow<Boolean> = profileManager.activeProfileId.flatMapLatest { pid ->
+        factory.get(pid, FEATURE).data.map { !(it[CALENDAR_OFF] ?: false) }
+    }.distinctUntilChanged()
+
+    suspend fun setTitleHidden(key: String, hidden: Boolean) {
+        store().edit { prefs ->
+            val current = prefs[HIDDEN_TITLES] ?: emptySet()
+            prefs[HIDDEN_TITLES] = if (hidden) current + key else current - key
+        }
+    }
+
+    suspend fun clearHiddenTitles() {
+        store().edit { it.remove(HIDDEN_TITLES) }
+    }
+
+    suspend fun setPageHidden(route: String, hidden: Boolean) {
+        store().edit { prefs ->
+            val current = prefs[HIDDEN_PAGES] ?: emptySet()
+            prefs[HIDDEN_PAGES] = if (hidden) current + route else current - route
+        }
+    }
+
+    suspend fun setCalendarEnabled(enabled: Boolean) {
+        store().edit { it[CALENDAR_OFF] = !enabled }
+    }
+}
