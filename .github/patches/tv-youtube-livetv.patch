+    private val youTubeWatchLink =
+        Regex("""^https?://(?:www\.|m\.)?(?:youtube\.com/watch\?(?:[^#]*&)?v=|youtu\.be/)([A-Za-z0-9_-]{11})""")
+
+    /**
+     * YouTube rows (a ytId, or a watch-page link) carry no media address: resolve them on the
+     * device so the player gets a stream it can open. Null when the video can't be resolved.
+     */
+    private suspend fun resolveYouTubeStream(stream: Stream): Stream? {
+        var candidate = stream
+        if (candidate.url.isNullOrBlank()) {
+            val id = candidate.externalUrl?.let { youTubeWatchLink.find(it.trim())?.groupValues?.get(1) }
+            if (id != null) candidate = candidate.copy(ytId = id, externalUrl = null)
+        }
+        return youTubeStreamResolver.resolve(candidate)
+    }
