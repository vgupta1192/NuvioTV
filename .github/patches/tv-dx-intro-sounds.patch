+@file:OptIn(androidx.tv.material3.ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.tv.core.sound.DxSounds
+
+/** Advanced settings card (dx.bi port): startup intro and soft interface sounds. Both off by default. */
+@Composable
+internal fun DxSoundsSettingsCard() {
+    val context = LocalContext.current
+    remember { DxSounds.ensureLoaded(context); true }
+    val intro by DxSounds.introEnabled.collectAsStateWithLifecycle()
+    val sounds by DxSounds.uiSoundsEnabled.collectAsStateWithLifecycle()
+    SettingsGroupCard(modifier = Modifier.fillMaxWidth(), title = "Intro and sounds") {
+        SettingsToggleRow(
+            title = "Startup intro",
+            subtitle = "Plays a short cinematic intro with a sound when the app opens, once per launch. Press any key to skip. Sound follows the media volume.",
+            checked = intro,
+            onToggle = {
+                DxSounds.setIntroEnabled(context, !intro)
+                if (!intro) DxSounds.previewIntroSound()
+            },
+        )
+        SettingsToggleRow(
+            title = "Interface sounds",
+            subtitle = "A soft tick when you move with the D-pad outside the player. Follows the media volume.",
+            checked = sounds,
+            onToggle = { DxSounds.setUiSoundsEnabled(context, !sounds) },
+        )
+    }
+}
