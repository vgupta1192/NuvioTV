+
+/** Settings > Live TV: Netflix style for the Live TV screen (same preference as the chip on that screen). */
+@Composable
+internal fun TvLiveNetflixSettingsGroup(
+    viewModel: TvLiveNetflixSettingsViewModel = hiltViewModel()
+) {
+    val enabled by viewModel.enabled.collectAsStateWithLifecycle()
+    SettingsGroupCard(
+        modifier = Modifier.fillMaxWidth(),
+        title = stringResource(R.string.livetv_netflix_group_title),
+        subtitle = stringResource(R.string.livetv_netflix_group_sub)
+    ) {
+        SettingsToggleRow(
+            title = stringResource(R.string.livetv_netflix_toggle),
+            subtitle = stringResource(R.string.livetv_netflix_toggle_sub),
+            checked = enabled,
+            onToggle = { viewModel.set(!enabled) }
+        )
+    }
+}
