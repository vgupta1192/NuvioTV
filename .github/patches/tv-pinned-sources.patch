+package com.nuvio.tv.core.streams
+
+import android.content.Context
+import com.nuvio.tv.domain.model.Stream
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Pinned stream sources (ported idea from NuvioMobile-Enhanced): hold OK on a source chip to pin it.
+ * Pinned sources are listed first, in the chip row and in the stream list.
+ */
+object PinnedStreamSources {
+    private const val PREFS = "nuvio_pinned_stream_sources"
+    private const val KEY = "pinned"
+    private const val SEPARATOR = "\n"
+
+    private val _pinned = MutableStateFlow<List<String>>(emptyList())
+    val pinned: StateFlow<List<String>> = _pinned.asStateFlow()
+
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        _pinned.value = context.applicationContext
+            .getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getString(KEY, null)
+            ?.split(SEPARATOR)
+            ?.map(String::trim)
+            ?.filter { it.isNotEmpty() }
+            ?.distinct()
+            .orEmpty()
+    }
+
+    fun toggle(context: Context, sourceName: String) {
+        ensureLoaded(context)
+        val name = sourceName.trim()
+        if (name.isEmpty()) return
+        val current = _pinned.value
+        val updated = if (name in current) current - name else current + name
+        _pinned.value = updated
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putString(KEY, updated.joinToString(SEPARATOR)).apply()
+    }
+
+    /** Names with pinned ones first (in pin order); everything else keeps its order. */
+    fun sortNames(names: List<String>, pinned: List<String>): List<String> {
+        if (pinned.isEmpty()) return names
+        val rank = pinned.withIndex().associate { it.value to it.index }
+        return names.withIndex()
+            .sortedWith(compareBy({ rank[it.value] ?: Int.MAX_VALUE }, { it.index }))
+            .map { it.value }
+    }
+
+    /** Streams from pinned sources first (in pin order); the order inside a source is kept. */
+    fun sortStreams(streams: List<Stream>, pinned: List<String>): List<Stream> {
+        if (pinned.isEmpty()) return streams
+        val rank = pinned.withIndex().associate { it.value to it.index }
+        return streams.withIndex()
+            .sortedWith(compareBy({ rank[it.value.addonName] ?: Int.MAX_VALUE }, { it.index }))
+            .map { it.value }
+    }
+}
