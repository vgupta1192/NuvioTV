+import com.nuvio.tv.ui.components.NuvioDialog
+import com.nuvio.tv.ui.theme.NuvioTheme
+
+/**
+ * "Type on phone" for any text field: a button that opens a QR code. The phone opens a one-field
+ * page on the TV's local network, and what is typed there arrives in [onValue]. Typing with the
+ * remote is slow for keys, addresses and passwords, so every such field offers this.
+ */
+@Composable
+fun PhoneEntryButton(
+    title: String,
+    onValue: (String) -> Unit,
+    modifier: Modifier = Modifier,
+    secret: Boolean = false,
+) {
+    var open by remember { mutableStateOf(false) }
+    Button(onClick = { open = true }, modifier = modifier) {
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.Center) {
+            Icon(imageVector = Icons.Default.PhoneAndroid, contentDescription = null, modifier = Modifier.size(18.dp))
+            Spacer(modifier = Modifier.width(NuvioTheme.spacing.sm))
+            Text("Type on phone")
+        }
+    }
+    PhoneEntryDialog(open, { open = false }, title, secret, onValue)
+}
+
+/** Compact icon-only variant that sits beside a text field. */
+@Composable
+fun PhoneEntryIconButton(
+    title: String,
+    onValue: (String) -> Unit,
+    modifier: Modifier = Modifier,
+    secret: Boolean = false,
+) {
+    var open by remember { mutableStateOf(false) }
+    Button(onClick = { open = true }, modifier = modifier) {
+        Icon(imageVector = Icons.Default.PhoneAndroid, contentDescription = "Type on phone", modifier = Modifier.size(20.dp))
+    }
+    PhoneEntryDialog(open, { open = false }, title, secret, onValue)
+}
+
+@Composable
+private fun PhoneEntryDialog(
+    visible: Boolean,
+    onClose: () -> Unit,
+    title: String,
+    secret: Boolean,
+    onValue: (String) -> Unit,
+) {
+    if (visible) {
+        val page = remember(title, secret) {
+            PhoneEntryPage(
+                title = title,
+                subtitle = "Type or paste it here, then tap Send. The TV fills it in.",
+                fieldLabel = title,
+                send = "Send to TV",
+                sending = "Sending…",
+                sent = "Sent. Look at the TV.",
+                failed = "Could not send. Keep the phone on the same Wi-Fi as the TV.",
+                secret = secret,
+            )
+        }
+        NuvioDialog(
+            onDismiss = onClose,
+            title = "Type on your phone",
+            subtitle = "Scan the code with your phone camera. The phone must be on the same Wi-Fi as this TV.",
+            width = 520.dp,
+        ) {
+            PhoneEntryQr(
+                page = page,
+                instruction = "Scan, type, send",
+                onValue = { sent ->
+                    onClose()
+                    onValue(sent)
+                },
+            )
+            Button(onClick = onClose) { Text("Cancel") }
+        }
+    }
+}
