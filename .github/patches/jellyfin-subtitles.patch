+    /**
+     * External text subtitles Jellyfin found next to the file (e.g. `Movie.en.srt`). The static
+     * stream carries only the subtitles embedded in the container, so these go to the player as
+     * sidecar tracks. Image subtitles (PGS, VobSub) are skipped. Failures give an empty list.
+     */
+    fun withExternalSubtitles(item: JellyfinItem, onReady: (List<Subtitle>) -> Unit) {
+        scope.launch {
+            val subtitles = externalSubtitlesFor(item)
+            withContext(Dispatchers.Main) { onReady(subtitles) }
+        }
+    }
+
+    suspend fun externalSubtitlesFor(item: JellyfinItem): List<Subtitle> {
+        val session = _uiState.value.session ?: return emptyList()
+        return try {
+            withTimeoutOrNull(15_000L) {
+                withContext(Dispatchers.IO) {
+                    // Only the media streams: the full item (cast, images) can take seconds on a cold server.
+                    val root = call(
+                        session,
+                        "/Items",
+                        mapOf(
+                            "userId" to session.userId,
+                            "ids" to item.id,
+                            "fields" to "MediaSources",
+                            "enableImages" to "false",
+                            "enableUserData" to "false",
+                        ),
+                    )
+                    val found = root.array("Items")?.firstOrNull() as? JsonObject
+                    val source = found?.array("MediaSources")?.firstOrNull() as? JsonObject ?: return@withContext emptyList<Subtitle>()
+                    val sourceId = source.string("Id") ?: item.id
+                    source.array("MediaStreams").orEmpty().mapNotNull { element ->
+                        val stream = element as? JsonObject ?: return@mapNotNull null
+                        if (stream.string("Type") != "Subtitle") return@mapNotNull null
+                        if (stream["IsExternal"]?.jsonPrimitive?.booleanOrNull != true) return@mapNotNull null
+                        val index = stream.int("Index") ?: return@mapNotNull null
+                        val format = when (stream.string("Codec")?.lowercase()) {
+                            "srt", "subrip" -> "srt"
+                            "ass", "ssa" -> "ass"
+                            "vtt", "webvtt" -> "vtt"
+                            "ttml", "dfxp" -> "ttml"
+                            "pgs", "pgssub", "dvdsub", "dvbsub", "vobsub", "sub", "idx" -> return@mapNotNull null
+                            else -> "srt"
+                        }
+                        val label = stream.string("DisplayTitle") ?: stream.string("Title")
+                        Subtitle(
+                            id = "jellyfin-${item.id}-$index",
+                            url = "${session.serverUrl}/Videos/${item.id}/$sourceId/Subtitles/$index/0/Stream.$format" +
+                                "?api_key=${encodeQueryValue(session.accessToken)}",
+                            lang = stream.string("Language")?.takeIf { it.isNotBlank() } ?: "und",
+                            addonName = label?.let { "Jellyfin · $it" } ?: "Jellyfin",
+                            addonLogo = null,
+                            isStreamProvided = true,
+                        )
+                    }
+                }
+            }.orEmpty()
+        } catch (error: CancellationException) {
+            throw error
+        } catch (error: Throwable) {
+            emptyList()
+        }
+    }
