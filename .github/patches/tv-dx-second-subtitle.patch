+/**
+ * dx.bi port: a second subtitle language drawn at the top of the picture next to the normal subtitles (handy for
+ * learning a language). The lines come from the addon subtitles of the title, so the second language is any language
+ * an addon offers. Pick it in the player's Subtitles menu (style column); the choice is remembered.
+ */
+internal object DxSecondSubtitle {
+    private const val PREFS = "nuvio_tv_dx_sub2"
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private val _language = MutableStateFlow<String?>(null)
+    val language: StateFlow<String?> = _language.asStateFlow()
+    private val _available = MutableStateFlow<List<String>>(emptyList())
+    val available: StateFlow<List<String>> = _available.asStateFlow()
+    private var loaded = false
+    private var appContext: Context? = null
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        val app = context.applicationContext
+        appContext = app
+        val prefs = app.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        _enabled.value = prefs.getBoolean("enabled", true)
+        _language.value = prefs.getString("language", null)?.takeIf { it.isNotBlank() }
+    }
+
+    fun setEnabled(on: Boolean) {
+        _enabled.value = on
+        appContext?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()?.putBoolean("enabled", on)?.apply()
+    }
+
+    fun setLanguage(code: String?) {
+        _language.value = code?.takeIf { it.isNotBlank() }
+        appContext?.getSharedPreferences(PREFS, Context.MODE_PRIVATE)?.edit()
+            ?.putString("language", code.orEmpty())?.apply()
+    }
+
+    fun codeOf(subtitle: Subtitle): String = PlayerSubtitleUtils.normalizeLanguageCode(subtitle.lang)
+
+    fun setAvailable(subtitles: List<Subtitle>) {
+        _available.value = subtitles.map(::codeOf).filter { it.isNotBlank() }.distinct()
+    }
+
+    /** Off, then each available language, then Off again. */
+    fun cycle() {
+        val current = _language.value
+        val options = _available.value
+        val next = when {
+            current == null -> options.firstOrNull()
+            else -> options.getOrNull(options.indexOf(current) + 1)
+        }
+        setLanguage(next)
+    }
+
+    /** The addon subtitle to draw as the second line: the chosen language, never the one already playing. */
+    fun pick(language: String?, subtitles: List<Subtitle>, playingId: String?): Subtitle? {
+        val wanted = language ?: return null
+        return subtitles.firstOrNull { it.id != playingId && codeOf(it) == wanted }
+    }
+
+    fun cueAt(cues: List<SubtitleSyncCue>, timeMs: Long): String? {
+        for (index in cues.indices) {
+            val cue = cues[index]
+            if (cue.startTimeMs > timeMs) break
+            if (timeMs < cue.endTimeMs) return cue.text
+        }
+        return null
+    }
+}
+
+/** The second line itself, near the top of the picture in a warm yellow so it reads apart from the main subtitles. */
+@Composable
+internal fun DxSecondSubtitleOverlay(
+    controller: PlayerRuntimeController,
+    addonSubtitles: List<Subtitle>,
+    selectedAddonSubtitle: Subtitle?,
+    subtitleDelayMs: Int,
+) {
+    val context = LocalContext.current
+    DxSecondSubtitle.ensureLoaded(context)
+    LaunchedEffect(addonSubtitles) { DxSecondSubtitle.setAvailable(addonSubtitles) }
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    val language by DxSecondSubtitle.language.collectAsStateWithLifecycle()
+    if (!enabled || language == null) return
+    val pick = DxSecondSubtitle.pick(language, addonSubtitles, selectedAddonSubtitle?.id)
+    var cues by remember { mutableStateOf<List<SubtitleSyncCue>>(emptyList()) }
+    LaunchedEffect(pick?.url) {
+        val subtitle = pick
+        cues = emptyList()
+        if (subtitle == null) return@LaunchedEffect
+        cues = runCatching {
+            val body = controller.downloadSubtitleBody(subtitle.url, subtitle.lang, subtitle.headers)
+            PlayerSubtitleCueParser.parseFromText(body, subtitle.url).filter { it.text.isNotBlank() }
+        }.getOrDefault(emptyList())
+    }
+    if (cues.isEmpty()) return
+    val positionMs = controller.playbackTimeline.collectAsStateWithLifecycle().value.currentPosition
+    val text = DxSecondSubtitle.cueAt(cues, positionMs - subtitleDelayMs) ?: return
+    Box(modifier = Modifier.fillMaxSize()) {
+        Text(
+            text = text.replace(Regex("<[^>]+>"), ""),
+            color = Color(0xFFFFE39A),
+            textAlign = TextAlign.Center,
+            style = TextStyle(
+                fontSize = 26.sp,
+                fontWeight = FontWeight.SemiBold,
+                shadow = Shadow(color = Color.Black, offset = Offset(0f, 2f), blurRadius = 6f),
+            ),
+            modifier = Modifier
+                .align(Alignment.TopCenter)
+                .fillMaxWidth()
+                .padding(top = 36.dp, start = 96.dp, end = 96.dp),
+        )
+    }
+}
+
+/** D-pad card at the end of the Subtitles menu's style column. Press to step through Off and the available languages. */
+@Composable
+internal fun DxSecondSubtitleStyleItem(onMoveLeft: () -> Unit) {
+    DxSecondSubtitle.ensureLoaded(LocalContext.current)
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    val chosen by DxSecondSubtitle.language.collectAsStateWithLifecycle()
+    val available by DxSecondSubtitle.available.collectAsStateWithLifecycle()
+    if (!enabled || (available.isEmpty() && chosen == null)) return
+    val isRtl = LocalLayoutDirection.current == LayoutDirection.Rtl
+    val moveLeftKey = if (isRtl) android.view.KeyEvent.KEYCODE_DPAD_RIGHT else android.view.KeyEvent.KEYCODE_DPAD_LEFT
+    Card(
+        onClick = { DxSecondSubtitle.cycle() },
+        colors = CardDefaults.colors(
+            containerColor = Color.Transparent,
+            focusedContainerColor = Color.Transparent,
+        ),
+        shape = CardDefaults.shape(RoundedCornerShape(NuvioTheme.radii.md)),
+        border = CardDefaults.border(
+            border = Border(
+                border = BorderStroke(NuvioTheme.spacing.xxs, Color.Transparent),
+                shape = RoundedCornerShape(NuvioTheme.radii.md),
+            ),
+            focusedBorder = Border(
+                border = NuvioTheme.focusRing.border(NuvioTheme.spacing.xxs),
+                shape = RoundedCornerShape(NuvioTheme.radii.md),
+            ),
+        ),
+        scale = CardDefaults.scale(focusedScale = 1f, pressedScale = 1f),
+        modifier = Modifier
+            .fillMaxWidth()
+            .onPreviewKeyEvent { event ->
+                if (event.nativeKeyEvent.keyCode != moveLeftKey) return@onPreviewKeyEvent false
+                if (event.nativeKeyEvent.action == android.view.KeyEvent.ACTION_DOWN) onMoveLeft()
+                event.nativeKeyEvent.action == android.view.KeyEvent.ACTION_DOWN ||
+                    event.nativeKeyEvent.action == android.view.KeyEvent.ACTION_UP
+            },
+    ) {
+        Text(
+            text = "Second subtitle on top: " + (chosen?.let { languageCodeToName(it) } ?: "Off"),
+            style = MaterialTheme.typography.bodyMedium,
+            color = Color.White,
+            modifier = Modifier.padding(horizontal = NuvioTheme.spacing.md, vertical = 10.dp),
+        )
+    }
+}
+
+/** Settings row in Playback > Subtitles. */
+@Composable
+internal fun DxSecondSubtitleSettingsRows() {
+    DxSecondSubtitle.ensureLoaded(LocalContext.current)
+    val enabled by DxSecondSubtitle.enabled.collectAsStateWithLifecycle()
+    SettingsToggleRow(
+        title = "Second subtitle language",
+        subtitle = "Shows a second subtitle language at the top of the picture. Pick the language in the player's Subtitles menu. Off hides the picker and the extra line.",
+        checked = enabled,
+        onToggle = { DxSecondSubtitle.setEnabled(!enabled) },
+    )
+}
