 private const val SERVER_RESUME_TIMEOUT_MS = 2_000L
+
+private const val MAX_STREAM_FAILOVERS = 3
+private const val FAILOVER_LIST_WAIT_MS = 8_000L
+
+/**
+ * Last resort before the error screen: when the current link keeps failing, switch to the next
+ * playable link from the sources list (loading that list first when it is not there yet).
+ */
+internal fun PlayerRuntimeController.tryStreamFailover(): Boolean {
+    val failedUrl = currentStreamUrl
+    if (failedUrl.isBlank() || failoverFailedUrls.size >= MAX_STREAM_FAILOVERS) return false
+    failoverFailedUrls.add(failedUrl)
+    errorRetryJob?.cancel()
+    errorRetryJob = scope.launch {
+        showRecoveryOverlay()
+        if (_uiState.value.sourceAllStreams.isEmpty()) {
+            loadSourceStreams(forceRefresh = false)
+            var waited = 0L
+            while (_uiState.value.sourceAllStreams.isEmpty() && waited < FAILOVER_LIST_WAIT_MS) {
+                delay(250L)
+                waited += 250L
+            }
+        }
+        val all = _uiState.value.sourceAllStreams
+        val currentIndex = all.indexOfFirst { it.getStreamUrl() == failedUrl }
+        val candidates = all.drop(currentIndex + 1) + all.take(currentIndex.coerceAtLeast(0))
+        val next = candidates.firstOrNull { stream ->
+            val url = stream.getStreamUrl()
+            (!url.isNullOrBlank() && url !in failoverFailedUrls) || (url.isNullOrBlank() && stream.serverTarget != null)
+        }
+        if (next == null) {
+            _uiState.update {
+                it.copy(
+                    error = context.getString(R.string.player_error_play_stream_failed),
+                    isBuffering = false,
+                    showLoadingOverlay = false,
+                    showPauseOverlay = false
+                )
+            }
+            return@launch
+        }
+        Toast.makeText(context, "Link failed, trying the next one", Toast.LENGTH_SHORT).show()
+        switchToSourceStream(next)
+    }
+    return true
+}
