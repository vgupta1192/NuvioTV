+package com.nuvio.tv.ui.screens.detail
+
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.width
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.compositionLocalOf
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.layout.ContentScale
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.text.TextStyle
+import androidx.compose.ui.unit.Dp
+import androidx.compose.ui.unit.dp
+import androidx.tv.material3.Text
+import coil3.compose.AsyncImage
+import coil3.request.ImageRequest
+import com.nuvio.tv.R
+import com.nuvio.tv.data.repository.SimklIdResolver
+import com.nuvio.tv.data.simkl.SimklApiConfiguration
+import java.util.Locale
+import javax.inject.Inject
+import javax.inject.Named
+import javax.inject.Singleton
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONArray
+
+/** Per-source episode ratings ("Simkl", "Trakt") keyed by (season, episode), shown as logo badges on episode cards. */
+internal val LocalForkExtraEpisodeRatings =
+    compositionLocalOf<Map<String, Map<Pair<Int, Int>, Double>>> { emptyMap() }
+
+@Singleton
+class ForkTvExtraEpisodeRatings @Inject constructor(
+    @Named("simkl") private val simklClient: OkHttpClient,
+    @Named("trakt") private val traktClient: OkHttpClient,
+    private val simklConfig: SimklApiConfiguration,
+    private val simklIdResolver: SimklIdResolver
+) {
+    private val cache = HashMap<String, Map<String, Map<Pair<Int, Int>, Double>>>()
+
+    suspend fun fetch(imdbId: String): Map<String, Map<Pair<Int, Int>, Double>> {
+        cache[imdbId]?.let { return it }
+        val simkl = fetchSimkl(imdbId)
+        val trakt = fetchTrakt(imdbId)
+        val out = buildMap {
+            if (simkl.isNotEmpty()) put("Simkl", simkl)
+            if (trakt.isNotEmpty()) put("Trakt", trakt)
+        }
+        if (out.isNotEmpty()) cache[imdbId] = out
+        return out
+    }
+
+    private suspend fun fetchSimkl(imdbId: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.IO) {
+        if (simklConfig.clientId.isBlank()) return@withContext emptyMap()
+        try {
+            val ids = simklIdResolver.resolveIds("imdb", imdbId, "series") ?: return@withContext emptyMap()
+            val url = "${simklConfig.baseUrl}/${ids.type}/episodes/${ids.simklId}?extended=full" +
+                "&client_id=${simklConfig.clientId}&app-name=${simklConfig.appName}&app-version=${simklConfig.appVersion}"
+            val body = simklClient.newCall(Request.Builder().url(url).build()).execute().use { r ->
+                if (!r.isSuccessful) return@withContext emptyMap()
+                r.body?.string().orEmpty()
+            }
+            val arr = JSONArray(body)
+            val out = HashMap<Pair<Int, Int>, Double>()
+            for (i in 0 until arr.length()) {
+                val ep = arr.optJSONObject(i) ?: continue
+                if (ep.optString("type", "episode") != "episode") continue
+                val s = ep.optInt("season", -1)
+                val e = ep.optInt("episode", -1)
+                if (s < 0 || e < 0) continue
+                val rating = ep.optJSONObject("ratings")?.optJSONObject("simkl")?.optDouble("rating", 0.0)
+                    ?.takeIf { it > 0.0 }
+                    ?: ep.optDouble("rating", 0.0)
+                if (rating > 0.0) out[s to e] = rating
+            }
+            out
+        } catch (_: Exception) {
+            emptyMap()
+        }
+    }
+
+    private suspend fun fetchTrakt(imdbId: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.IO) {
+        try {
+            val url = "https://api.trakt.tv/shows/$imdbId/seasons?extended=episodes,full"
+            val body = traktClient.newCall(Request.Builder().url(url).build()).execute().use { r ->
+                if (!r.isSuccessful) return@withContext emptyMap()
+                r.body?.string().orEmpty()
+            }
+            val seasons = JSONArray(body)
+            val out = HashMap<Pair<Int, Int>, Double>()
+            for (i in 0 until seasons.length()) {
+                val season = seasons.optJSONObject(i) ?: continue
+                val s = season.optInt("number", -1)
+                val eps = season.optJSONArray("episodes") ?: continue
+                for (j in 0 until eps.length()) {
+                    val ep = eps.optJSONObject(j) ?: continue
+                    val e = ep.optInt("number", -1)
+                    val rating = ep.optDouble("rating", 0.0)
+                    if (s >= 0 && e >= 0 && rating > 0.0) out[s to e] = rating
+                }
+            }
+            out
+        } catch (_: Exception) {
+            emptyMap()
+        }
+    }
+}
+
+/** Logo plus value for one non-IMDb episode rating source. */
+@Composable
+internal fun ForkEpisodeSourceRating(
+    source: String,
+    rating: Double,
+    logoWidth: Dp,
+    logoHeight: Dp,
+    textStyle: TextStyle
+) {
+    val logo = when (source) {
+        "TMDB" -> R.raw.mdblist_tmdb
+        "Simkl" -> R.raw.simkl_tv_glyph
+        "Trakt" -> R.raw.trakt_tv_glyph
+        else -> null
+    }
+    val context = LocalContext.current
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(4.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        if (logo != null) {
+            val model = remember(context, logo) { ImageRequest.Builder(context).data(logo).build() }
+            AsyncImage(
+                model = model,
+                contentDescription = source,
+                modifier = Modifier.width(logoWidth).height(logoHeight),
+                contentScale = ContentScale.Fit
+            )
+        } else {
+            Text(text = source, style = textStyle, maxLines = 1)
+        }
+        Text(
+            text = String.format(Locale.US, "%.1f", rating),
+            style = textStyle,
+            maxLines = 1
+        )
+    }
+}
