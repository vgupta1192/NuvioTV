+    /**
+     * Whisper's line times are rough: a line often starts in the quiet before the words. This finds
+     * where the speech really starts and ends inside Whisper's span, from the loudness of the audio
+     * itself, so the line shows when the words are heard. [floorSec] keeps it off the previous line.
+     */
+    private fun refineSpan(audio: FloatArray, rate: Int, startSec: Double, endSec: Double, floorSec: Double): Pair<Double, Double> {
+        val frame = rate / 50 // 20 ms
+        val lo = (maxOf(floorSec, startSec - 0.25).coerceAtLeast(0.0) * rate).toInt()
+        val hi = minOf(audio.size.toDouble(), (endSec + 0.15) * rate).toInt()
+        val count = (hi - lo) / frame
+        if (count < 6) return startSec to endSec
+        val level = FloatArray(count) { i ->
+            var sum = 0f
+            val from = lo + i * frame
+            for (n in from until from + frame) sum += audio[n] * audio[n]
+            kotlin.math.sqrt(sum / frame)
+        }
+        val sorted = level.sortedArray()
+        val noise = sorted[(count * 0.15).toInt()]
+        val peak = sorted[(count * 0.95).toInt().coerceAtMost(count - 1)]
+        val threshold = maxOf(noise * 2.5f, peak * 0.18f, 0.003f)
+        fun loud(i: Int) = i in 0 until count && level[i] >= threshold
+        val first = (0 until count - 2).firstOrNull { loud(it) && loud(it + 1) && loud(it + 2) } ?: return startSec to endSec
+        val last = (count - 1 downTo 2).firstOrNull { loud(it) && loud(it - 1) && loud(it - 2) } ?: return startSec to endSec
+        val start = (lo + first * frame).toDouble() / rate - 0.04
+        val end = (lo + (last + 1) * frame).toDouble() / rate + 0.1
+        return if (end - start >= 0.3) maxOf(start, floorSec) to end else startSec to endSec
+    }
