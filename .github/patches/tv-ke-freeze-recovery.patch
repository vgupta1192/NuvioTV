@@ -0,0 +1,154 @@
+package com.nuvio.tv.ui.screens.player
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class PlayerFreezeRecoveryPolicyTest {
+
+    private fun input(
+        stalledForMs: Long = PlayerFreezeRecoveryPolicy.ACT_AFTER_MS,
+        nowMs: Long = 100_000L,
+        lastSeekAtMs: Long? = null,
+        seekCount: Int = 0,
+        failoverDone: Boolean = false,
+        errorShown: Boolean = false,
+    ) = PlayerFreezeRecoveryPolicy.Input(
+        stalledForMs = stalledForMs,
+        nowMs = nowMs,
+        lastSeekAtMs = lastSeekAtMs,
+        seekCount = seekCount,
+        failoverDone = failoverDone,
+        errorShown = errorShown,
+    )
+
+    @Test
+    fun `nothing happens below the act threshold`() {
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.NONE,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(stalledForMs = PlayerFreezeRecoveryPolicy.ACT_AFTER_MS - 1)
+            )
+        )
+    }
+
+    @Test
+    fun `the first freeze seeks`() {
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.SEEK,
+            PlayerFreezeRecoveryPolicy.evaluate(input())
+        )
+    }
+
+    @Test
+    fun `an error box or a spent failover silences the ladder`() {
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.NONE,
+            PlayerFreezeRecoveryPolicy.evaluate(input(errorShown = true))
+        )
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.NONE,
+            PlayerFreezeRecoveryPolicy.evaluate(input(failoverDone = true))
+        )
+    }
+
+    @Test
+    fun `a freeze that carried on through its own window escalates to failover`() {
+        val seekAt = 100_000L
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.NONE,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(lastSeekAtMs = seekAt, seekCount = 1, nowMs = seekAt + 1_000L)
+            )
+        )
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.FAILOVER,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(lastSeekAtMs = seekAt, seekCount = 1, nowMs = seekAt + PlayerFreezeRecoveryPolicy.ACT_AFTER_MS)
+            )
+        )
+    }
+
+    @Test
+    fun `a freeze outside the cure window spends another seek`() {
+        val seekAt = 100_000L
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.SEEK,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(
+                    lastSeekAtMs = seekAt,
+                    seekCount = 1,
+                    nowMs = seekAt + PlayerFreezeRecoveryPolicy.SEEK_CURE_WINDOW_MS + 1L
+                )
+            )
+        )
+    }
+
+    @Test
+    fun `past the seek cap a fresh freeze goes straight to failover`() {
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.FAILOVER,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(
+                    seekCount = PlayerFreezeRecoveryPolicy.MAX_RECOVERY_SEEKS,
+                    lastSeekAtMs = 100_000L,
+                    nowMs = 100_000L + PlayerFreezeRecoveryPolicy.SEEK_CURE_WINDOW_MS + 1L
+                )
+            )
+        )
+        assertEquals(
+            PlayerFreezeRecoveryPolicy.Decision.FAILOVER,
+            PlayerFreezeRecoveryPolicy.evaluate(
+                input(seekCount = PlayerFreezeRecoveryPolicy.MAX_RECOVERY_SEEKS)
+            )
+        )
+    }
+
+    // Mirrors the controller: one playback, freezes recurring further apart than the cure
+    // window, until the ladder exhausts rung 1 and declares the source dead exactly once.
+    @Test
+    fun `the ladder climbs seek by seek and fails over once`() {
+        var nowMs = 0L
+        var lastSeekAtMs: Long? = null
+        var seekCount = 0
+        var failoverDone = false
+        val decisions = mutableListOf<PlayerFreezeRecoveryPolicy.Decision>()
+
+        // Four freezes, 90 s apart: three seeks, then the failover.
+        repeat(4) {
+            nowMs += 90_000L
+            while (true) {
+                val decision = PlayerFreezeRecoveryPolicy.evaluate(
+                    PlayerFreezeRecoveryPolicy.Input(
+                        stalledForMs = PlayerFreezeRecoveryPolicy.ACT_AFTER_MS,
+                        nowMs = nowMs,
+                        lastSeekAtMs = lastSeekAtMs,
+                        seekCount = seekCount,
+                        failoverDone = failoverDone,
+                        errorShown = false
+                    )
+                )
+                if (decision == PlayerFreezeRecoveryPolicy.Decision.NONE) break
+                decisions.add(decision)
+                when (decision) {
+                    PlayerFreezeRecoveryPolicy.Decision.SEEK -> {
+                        lastSeekAtMs = nowMs
+                        seekCount += 1
+                    }
+                    PlayerFreezeRecoveryPolicy.Decision.FAILOVER -> failoverDone = true
+                    PlayerFreezeRecoveryPolicy.Decision.NONE -> Unit
+                }
+                if (decision == PlayerFreezeRecoveryPolicy.Decision.FAILOVER) break
+            }
+        }
+
+        assertEquals(
+            listOf(
+                PlayerFreezeRecoveryPolicy.Decision.SEEK,
+                PlayerFreezeRecoveryPolicy.Decision.SEEK,
+                PlayerFreezeRecoveryPolicy.Decision.SEEK,
+                PlayerFreezeRecoveryPolicy.Decision.FAILOVER
+            ),
+            decisions
+        )
+    }
+}
