@@ -0,0 +1,85 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.net.Uri
+import android.os.SystemClock
+import android.util.Log
+import androidx.media3.common.Player
+import com.nuvio.tv.R
+import kotlinx.coroutines.flow.update
+
+/**
+ * Nuvio-KE port: acts on a frozen picture from the progress tick, right after the analytics
+ * detector has taken this tick's snapshot. Rung 1 seeks [PlayerFreezeRecoveryPolicy.SEEK_BACK_MS]
+ * before the playhead; rung 2 is the dead-source failover, reusing the tree's link ladder
+ * [tryStreamFailover] (recovery overlay, sources-list load on demand, next playable link, its own
+ * toast). Composes with the existing watchdogs: the buffering stall watchdog covers
+ * STATE_BUFFERING and the first-frame watchdog covers pre-first-frame — this only sees READY and
+ * playing with a stuck position, which neither of them touches.
+ *
+ * ExoPlayer only: the caller lives in the progress loop's ExoPlayer branch, so MPV never reaches
+ * this (mpv exposes no equivalent stall snapshot here).
+ *
+ * @return true when a failover is under way: the caller ends its tick, the next stream restarts it.
+ */
+internal fun PlayerRuntimeController.maybeRecoverFrozenPicture(player: Player, positionMs: Long): Boolean {
+    val nowMs = SystemClock.elapsedRealtime()
+    val stalledForMs = playbackAnalyticsDiagnostics.currentPositionStallMs
+    val decision = PlayerFreezeRecoveryPolicy.evaluate(
+        PlayerFreezeRecoveryPolicy.Input(
+            stalledForMs = stalledForMs,
+            nowMs = nowMs,
+            lastSeekAtMs = freezeRecoverySeekAtMs,
+            seekCount = freezeRecoverySeekCount,
+            failoverDone = freezeFailoverDone,
+            errorShown = _uiState.value.error != null
+        )
+    )
+    return when (decision) {
+        PlayerFreezeRecoveryPolicy.Decision.NONE -> false
+        PlayerFreezeRecoveryPolicy.Decision.SEEK -> {
+            freezeRecoverySeekAtMs = nowMs
+            freezeRecoverySeekCount += 1
+            // Subtle by design: no toast, only this log line. The seek-back is past the
+            // detector's tolerance, so a cured seek also restarts its stall count.
+            val target = (positionMs - PlayerFreezeRecoveryPolicy.SEEK_BACK_MS).coerceAtLeast(0L)
+            Log.w(
+                PlayerRuntimeController.TAG,
+                "FREEZE_RECOVERY rung=seek seek=$freezeRecoverySeekCount/" +
+                    "${PlayerFreezeRecoveryPolicy.MAX_RECOVERY_SEEKS} stalledMs=$stalledForMs " +
+                    "pos=${positionMs}ms seekTo=${target}ms host=${currentStreamUrl.safeFreezeLogHost()}"
+            )
+            player.seekTo(target)
+            false
+        }
+        PlayerFreezeRecoveryPolicy.Decision.FAILOVER -> {
+            freezeFailoverDone = true
+            Log.w(
+                PlayerRuntimeController.TAG,
+                "FREEZE_RECOVERY rung=failover stalledMs=$stalledForMs " +
+                    "sinceSeekMs=${freezeRecoverySeekAtMs?.let { nowMs - it }} " +
+                    "host=${currentStreamUrl.safeFreezeLogHost()}"
+            )
+            if (tryStreamFailover()) {
+                true
+            } else {
+                // No source left to hand over to (or the link-ladder budget is spent): surface
+                // the generic error over the frozen picture, as the failover's own empty-list
+                // path does. Fatal for this playback — no auto-advance under the error.
+                cancelNextEpisodeAutoPlayOnFatalError()
+                _uiState.update {
+                    it.copy(
+                        error = context.getString(R.string.player_error_playback_fallback),
+                        isBuffering = false,
+                        showLoadingOverlay = false,
+                        showPauseOverlay = false
+                    )
+                }
+                false
+            }
+        }
+    }
+}
+
+private fun String.safeFreezeLogHost(): String {
+    return runCatching { Uri.parse(this).host ?: "unknown" }.getOrDefault("unknown")
+}
