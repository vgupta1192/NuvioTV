@@ -0,0 +1,65 @@
+package com.nuvio.tv.ui.screens.player
+
+/**
+ * Nuvio-KE port: what to do about a frozen picture — the position stuck while ExoPlayer is READY
+ * and playing ([PlayerPlaybackAnalyticsDiagnostics.currentPositionStallMs]). Rung 1 seeks back
+ * before the playhead; rung 2, when the seek did not cure it, is the dead-source failover
+ * (reusing the tree's link ladder, [PlayerRuntimeController.tryStreamFailover]). This tree's
+ * [PlayerStallWatchdogPolicy] handles the other stall shape — buffered edge stuck during
+ * STATE_BUFFERING — so the two compose: buffering stalls go to the watchdog, READY-but-frozen
+ * goes here. Pure, so JVM tests mirror production 1:1.
+ */
+internal object PlayerFreezeRecoveryPolicy {
+
+    /**
+     * How long the position must be stuck while READY+playing before the ladder acts. The
+     * analytics detector flags a stall at 5 s; we wait past that so brief decoder or demuxer
+     * hiccups that clear on their own never trigger a seek.
+     */
+    const val ACT_AFTER_MS = 10_000L
+
+    /**
+     * Rung 1's rollback. KE shipped 500 ms — just past its detector's 250 ms tolerance so the
+     * seek restarts the stall count; the port spec asks for ~2 s, which also cannot be skipped
+     * by Media3 landing the seek where the playhead already holds, and re-reads more source on
+     * a stuck demuxer.
+     */
+    const val SEEK_BACK_MS = 2_000L
+
+    /** A new freeze this soon after our seek means the seek did not cure it. */
+    const val SEEK_CURE_WINDOW_MS = 60_000L
+
+    /**
+     * Rung-1 attempts per playback. Past this, a fresh freeze escalates straight to rung 2:
+     * freezes that outlive three seeks point at the source, not at the decoder.
+     */
+    const val MAX_RECOVERY_SEEKS = 3
+
+    data class Input(
+        val stalledForMs: Long,
+        val nowMs: Long,
+        /** elapsedRealtime of this stream's last recovery seek; null when none. */
+        val lastSeekAtMs: Long?,
+        /** Rung-1 seeks already spent this playback. */
+        val seekCount: Int,
+        /** Rung 2 already ran (or found no source) for this stream. */
+        val failoverDone: Boolean,
+        val errorShown: Boolean,
+    )
+
+    enum class Decision { NONE, SEEK, FAILOVER }
+
+    fun evaluate(input: Input): Decision {
+        if (input.failoverDone || input.errorShown || input.stalledForMs < ACT_AFTER_MS) return Decision.NONE
+        val sinceSeekMs = input.lastSeekAtMs?.let { input.nowMs - it }
+        return when {
+            sinceSeekMs == null || sinceSeekMs > SEEK_CURE_WINDOW_MS ->
+                // No recent seek: try rung 1 while seeks remain, else hand over to rung 2.
+                if (input.seekCount < MAX_RECOVERY_SEEKS) Decision.SEEK else Decision.FAILOVER
+            // Give the seek its own full window: a freeze that carried on through it is only
+            // judged ACT_AFTER_MS after the seek, not on the next tick.
+            sinceSeekMs >= ACT_AFTER_MS -> Decision.FAILOVER
+            else -> Decision.NONE
+        }
+    }
+}
