+/** Ceiling for [recordSourceStreamFailure]: a session's dead links, oldest out. */
+private const val MAX_SOURCE_FAILURE_URLS = 64
+
+/**
+ * Nuvio-KE port: notes a link playback gave up on, for the failure marks on the sources list
+ * rows. Session-scoped (lost when the player goes away) and bounded: oldest url out at
+ * [MAX_SOURCE_FAILURE_URLS]. The mirror of KE's persistent failure memory is this set plus the
+ * tree's existing failover guard — there is no per-URL store to read back from.
+ */
+internal fun PlayerRuntimeController.recordSourceStreamFailure(url: String?) {
+    val key = url?.takeIf { it.isNotBlank() } ?: return
+    if (!sourceFailedUrls.add(key)) return
+    if (sourceFailedUrls.size > MAX_SOURCE_FAILURE_URLS) {
+        sourceFailedUrls.firstOrNull()?.let(sourceFailedUrls::remove)
+    }
+    _uiState.update { it.copy(sourceFailedStreamUrls = sourceFailedUrls.toSet()) }
+}
