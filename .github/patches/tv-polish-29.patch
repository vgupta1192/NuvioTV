+package com.nuvio.tv.ui.screens.player
+
+import androidx.annotation.OptIn
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.mediacodec.MediaCodecUtil
+
+/**
+ * Nuvio fork: query the device codec list once, in the background, after app start.
+ * Media3 keeps the result in a static cache, so the first player start skips the slow codec scan.
+ * This does not keep a player alive: no ExoPlayer, surface or audio session is created here.
+ */
+internal object ForkPlayerWarmup {
+    private val mimeTypes = listOf(
+        "video/avc",
+        "video/hevc",
+        "video/x-vnd.on2.vp9",
+        "video/av01",
+        "audio/mp4a-latm",
+        "audio/ac3",
+        "audio/eac3",
+    )
+
+    @OptIn(UnstableApi::class)
+    fun start() {
+        Thread({
+            mimeTypes.forEach { mime ->
+                runCatching { MediaCodecUtil.getDecoderInfos(mime, false, false) }
+            }
+        }, "fork-codec-warmup").apply {
+            priority = Thread.MIN_PRIORITY
+            isDaemon = true
+            start()
+        }
+    }
+}
