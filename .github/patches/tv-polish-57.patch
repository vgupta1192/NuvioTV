+    private fun diskCacheFile(): java.io.File = java.io.File(context.filesDir, "tv_channels_cache.json")
+
+    // Addon channels of the last complete load, so Live TV can open with them before the addons answer.
+    private fun writeDiskCache(selectedUrls: Set<String>, channels: List<TvChannelItem>) {
+        runCatching {
+            val items = org.json.JSONArray()
+            for (c in channels) {
+                if (c.iptvSourceId != null || c.directUrl != null) continue
+                items.put(
+                    org.json.JSONObject()
+                        .put("id", c.id).put("type", c.type).put("name", c.name)
+                        .put("poster", c.poster ?: org.json.JSONObject.NULL)
+                        .put("logo", c.logo ?: org.json.JSONObject.NULL)
+                        .put("genres", org.json.JSONArray(c.genres))
+                        .put("description", c.description ?: org.json.JSONObject.NULL)
+                        .put("addonName", c.addonName).put("addonManifestUrl", c.addonManifestUrl)
+                        .put("addonLogo", c.addonLogo ?: org.json.JSONObject.NULL)
+                        .put("catalogId", c.catalogId).put("catalogName", c.catalogName)
+                        .put("startEpochMs", c.startEpochMs ?: org.json.JSONObject.NULL)
+                )
+            }
+            val root = org.json.JSONObject()
+                .put("key", selectedUrls.sorted().joinToString("|"))
+                .put("items", items)
+            val tmp = java.io.File(context.filesDir, "tv_channels_cache.tmp")
+            tmp.writeText(root.toString())
+            tmp.renameTo(diskCacheFile())
+        }.onFailure { Log.w(TAG, "Could not save channel cache: ${it.message}") }
+    }
+
+    private fun readDiskCache(selectedUrls: Set<String>): List<TvChannelItem>? = runCatching {
+        val file = diskCacheFile()
+        if (!file.exists()) return@runCatching null
+        val root = org.json.JSONObject(file.readText())
+        if (root.optString("key") != selectedUrls.sorted().joinToString("|")) return@runCatching null
+        val items = root.getJSONArray("items")
+        fun str(o: org.json.JSONObject, k: String): String? = if (o.isNull(k)) null else o.getString(k)
+        List(items.length()) { i ->
+            val o = items.getJSONObject(i)
+            val g = o.getJSONArray("genres")
+            TvChannelItem(
+                id = o.getString("id"), type = o.getString("type"), name = o.getString("name"),
+                poster = str(o, "poster"), logo = str(o, "logo"),
+                genres = List(g.length()) { g.getString(it) },
+                description = str(o, "description"),
+                addonName = o.getString("addonName"), addonManifestUrl = o.getString("addonManifestUrl"),
+                addonLogo = str(o, "addonLogo"),
+                catalogId = o.getString("catalogId"), catalogName = o.getString("catalogName"),
+                startEpochMs = if (o.isNull("startEpochMs")) null else o.getLong("startEpochMs")
+            )
+        }
+    }.onFailure { Log.w(TAG, "Could not read channel cache: ${it.message}") }.getOrNull()
