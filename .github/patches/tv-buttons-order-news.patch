+
+    fun move(context: Context, id: String, delta: Int) {
+        ensureLoaded(context)
+        val list = _order.value.toMutableList()
+        val from = list.indexOf(id)
+        val to = from + delta
+        if (from < 0 || to < 0 || to >= list.size) return
+        list.add(to, list.removeAt(from))
+        _order.value = list
+        prefs(context).edit().putString("order", list.joinToString(",")).apply()
+    }
