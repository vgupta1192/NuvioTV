+import java.util.Locale
+
+/** Nuvio fork: season by episode rating grid, colored by score tier. */
+@Composable
+internal fun ForkTvRatingMapDialog(
+    episodes: List<Video>,
+    episodeRatings: Map<Pair<Int, Int>, Double>,
+    onDismiss: () -> Unit,
+) {
+    val seasons = episodes
+        .filter { (it.season ?: 0) > 0 && it.episode != null }
+        .groupBy { it.season!! }
+        .toSortedMap()
+    com.nuvio.tv.ui.components.NuvioDialog(
+        onDismiss = onDismiss,
+        title = "Episode rating map",
+        subtitle = "Green is 8 and up, yellow 7 to 8, orange 6 to 7, red below 6.",
+        suppressFirstKeyUp = false
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxWidth()
+                .heightIn(max = 380.dp)
+                .verticalScroll(rememberScrollState()),
+            verticalArrangement = Arrangement.spacedBy(10.dp)
+        ) {
+            seasons.forEach { (season, videos) ->
+                val scores = videos.sortedBy { it.episode }.map { v ->
+                    v.episode!! to (episodeRatings[season to v.episode!!] ?: v.rating?.toDouble())?.takeIf { it > 0.0 }
+                }
+                val rated = scores.mapNotNull { it.second }
+                val average = if (rated.isEmpty()) "-" else String.format(Locale.US, "%.1f", rated.average())
+                Text(text = "Season $season, average $average", color = Color.White, fontSize = 14.sp, fontWeight = FontWeight.SemiBold)
+                Row(
+                    modifier = Modifier.horizontalScroll(rememberScrollState()),
+                    horizontalArrangement = Arrangement.spacedBy(4.dp)
+                ) {
+                    scores.forEach { (ep, score) ->
+                        Box(
+                            modifier = Modifier
+                                .size(width = 46.dp, height = 40.dp)
+                                .clip(RoundedCornerShape(6.dp))
+                                .background(forkRatingTierColor(score)),
+                            contentAlignment = Alignment.Center
+                        ) {
+                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                                Text(text = "E$ep", color = Color.Black.copy(alpha = 0.6f), fontSize = 9.sp)
+                                Text(
+                                    text = score?.let { String.format(Locale.US, "%.1f", it) } ?: "-",
+                                    color = Color.Black,
+                                    fontSize = 12.sp,
+                                    fontWeight = FontWeight.Bold
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+            SettingsActionRow(title = "Close", subtitle = null, onClick = onDismiss, modifier = Modifier.padding(top = 4.dp))
+        }
+    }
+}
+
+private fun forkRatingTierColor(score: Double?): Color = when {
+    score == null -> Color(0xFF555555)
+    score >= 9.0 -> Color(0xFF3DB46D)
+    score >= 8.0 -> Color(0xFF7ACB8F)
+    score >= 7.0 -> Color(0xFFF2C94C)
+    score >= 6.0 -> Color(0xFFF2994A)
+    else -> Color(0xFFE5534B)
+}
