+package com.nuvio.tv.ui.screens.player
+
+import android.widget.Toast
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.ui.platform.LocalContext
+import kotlinx.coroutines.delay
+
+/** Nuvio fork: a long buffering stall shows a hint to pick another stream, once per stall. */
+@Composable
+internal fun TvStallHint(isBuffering: Boolean) {
+    val context = LocalContext.current
+    LaunchedEffect(isBuffering) {
+        if (!isBuffering) return@LaunchedEffect
+        delay(20_000L)
+        Toast.makeText(context, "Playback is stalling. Press Back and try another stream.", Toast.LENGTH_LONG).show()
+    }
+}
