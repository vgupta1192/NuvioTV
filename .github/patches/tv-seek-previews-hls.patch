diff --git a/app/src/main/java/com/nuvio/tv/ui/screens/player/seekpreview/local/StreamPreviewFiller.kt b/app/src/main/java/com/nuvio/tv/ui/screens/player/seekpreview/local/StreamPreviewFiller.kt
