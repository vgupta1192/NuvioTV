+                        val open = t.indexOf('>') + 1
+                        val text = t.substring(open, t.lastIndexOf("</desc>"))
+                        var cut = text.take(MAX_DESC_CHARS)
+                        val amp = cut.lastIndexOf('&')
+                        if (amp >= 0 && cut.indexOf(';', amp) < 0) cut = cut.substring(0, amp)
+                        cut = cut.trimEnd()
+                        out.append(t, 0, open).append(cut).append("</desc>\n")
+                        continue
+                    }
+                    out.append(raw).append('\n')
+                }
+            }
+            return out.toString()
+        }
