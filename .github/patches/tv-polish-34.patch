+@file:OptIn(ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Notifications
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.hilt.navigation.compose.hiltViewModel
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.lifecycle.viewModelScope
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import com.nuvio.tv.R
+import com.nuvio.tv.core.reminders.ReleaseReminderCoordinator
+import com.nuvio.tv.data.local.ReleaseReminder
+import com.nuvio.tv.data.local.ReleaseRemindersStore
+import com.nuvio.tv.data.local.TvChannelsDataStore
+import com.nuvio.tv.forklivetv.ForkLiveReminders
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.flow.SharingStarted
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.stateIn
+import kotlinx.coroutines.launch
+import javax.inject.Inject
+
+@HiltViewModel
+class TvLiveRemindersSettingsViewModel @Inject constructor(
+    private val store: ReleaseRemindersStore,
+    private val coordinator: ReleaseReminderCoordinator,
+    private val channelsDataStore: TvChannelsDataStore
+) : ViewModel() {
+    val reminders: StateFlow<List<ReleaseReminder>> = store.reminders
+        .map { list -> list.filter { ForkLiveReminders.isLive(it) }.sortedBy { it.releaseDateMs } }
+        .stateIn(viewModelScope, SharingStarted.Eagerly, emptyList())
+
+    val leadMinutes: StateFlow<Int> = channelsDataStore.liveReminderLeadMinutes
+        .stateIn(viewModelScope, SharingStarted.Eagerly, 5)
+
+    fun cycleLead() {
+        val choices = ForkLiveReminders.LEAD_CHOICES
+        val next = choices[(choices.indexOf(leadMinutes.value) + 1).mod(choices.size)]
+        viewModelScope.launch { channelsDataStore.setLiveReminderLeadMinutes(next) }
+    }
+
+    fun delete(reminder: ReleaseReminder) {
+        viewModelScope.launch {
+            store.remove(reminder.itemId, reminder.itemType)
+            coordinator.scheduleNextAlarm()
+        }
+    }
+}
+
+/** Settings > Live TV: how early Live TV reminders fire and the list of saved ones (click removes). */
+@Composable
+internal fun TvLiveRemindersGroup(
+    viewModel: TvLiveRemindersSettingsViewModel = hiltViewModel()
+) {
+    val reminders by viewModel.reminders.collectAsStateWithLifecycle()
+    val lead by viewModel.leadMinutes.collectAsStateWithLifecycle()
+    SettingsGroupCard(
+        modifier = Modifier.fillMaxWidth(),
+        title = stringResource(R.string.live_reminders_title),
+        subtitle = stringResource(R.string.live_reminders_subtitle)
+    ) {
+        SettingsActionRow(
+            title = stringResource(R.string.live_reminders_lead),
+            subtitle = null,
+            value = stringResource(R.string.live_reminders_lead_value, lead),
+            leadingIcon = Icons.Default.Notifications,
+            onClick = { viewModel.cycleLead() }
+        )
+        if (reminders.isEmpty()) {
+            SettingsActionRow(
+                title = stringResource(R.string.live_reminders_empty),
+                subtitle = null,
+                onClick = {}
+            )
+        }
+        reminders.forEach { reminder ->
+            SettingsActionRow(
+                title = reminder.title,
+                subtitle = reminder.releaseDateIso,
+                onClick = { viewModel.delete(reminder) }
+            )
+        }
+    }
+}
