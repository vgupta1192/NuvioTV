+package com.nuvio.tv.forklivetv
+
+import com.nuvio.tv.data.local.ReleaseReminder
+import com.nuvio.tv.domain.model.TvChannelItem
+import kotlinx.coroutines.flow.MutableStateFlow
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/**
+ * Nuvio fork: Live TV reminders (for example Nuvio Live Sports upcoming events). They reuse the
+ * release reminder store, alarm and boot re-arm; the item type carries a "live:" prefix so the
+ * notification opens Live TV on that channel instead of a detail page.
+ */
+object ForkLiveReminders {
+    const val TYPE_PREFIX = "live:"
+    val LEAD_CHOICES = listOf(0, 5, 10, 15, 30)
+
+    fun isLive(reminder: ReleaseReminder) = reminder.itemType.startsWith(TYPE_PREFIX)
+
+    fun isUpcoming(channel: TvChannelItem, nowMs: Long = System.currentTimeMillis()) =
+        (channel.startEpochMs ?: 0L) > nowMs
+
+    fun matches(reminder: ReleaseReminder, channel: TvChannelItem) =
+        reminder.itemId == channel.id && reminder.itemType == TYPE_PREFIX + channel.type
+
+    fun build(channel: TvChannelItem, leadMinutes: Int, nowMs: Long = System.currentTimeMillis()): ReleaseReminder {
+        val start = channel.startEpochMs ?: nowMs
+        val fireAt = (start - leadMinutes * 60_000L).coerceAtLeast(nowMs + 3_000L)
+        val label = SimpleDateFormat("EEE d MMM, HH:mm", Locale.getDefault()).format(Date(start))
+        return ReleaseReminder(
+            itemId = channel.id,
+            itemType = TYPE_PREFIX + channel.type,
+            title = channel.name,
+            releaseDateMs = fireAt,
+            releaseDateIso = label,
+            posterUrl = channel.poster ?: channel.logo,
+            createdAtMs = nowMs
+        )
+    }
+
+    fun deepLink(reminder: ReleaseReminder): String =
+        "nuvio://livetv/${android.net.Uri.encode(reminder.itemType.removePrefix(TYPE_PREFIX))}/" +
+            android.net.Uri.encode(reminder.itemId)
+
+    /** Channel a notification asked Live TV to open ("type|id"); consumed once Live TV has loaded its channels. */
+    val pendingOpen = MutableStateFlow<Pair<String, String>?>(null)
+}
