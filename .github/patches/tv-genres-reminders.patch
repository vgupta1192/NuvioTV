+++ b/app/src/main/java/com/nuvio/tv/data/local/ReleaseRemindersStore.kt
@@ -0,0 +1,144 @@
+package com.nuvio.tv.data.local
+
+import androidx.datastore.preferences.core.Preferences
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringPreferencesKey
+import com.nuvio.tv.core.profile.ProfileManager
+import kotlinx.coroutines.ExperimentalCoroutinesApi
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.flatMapLatest
+import kotlinx.coroutines.flow.map
+import org.json.JSONArray
+import org.json.JSONObject
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Nuvio fork: one "Remind me" entry on a title that has not come out yet.
+ * [releaseDateMs] is the epoch millisecond the notification should fire at
+ * (start of release day, UTC midnight for date-only values — matching the tree's
+ * episode release-date parser).
+ */
+data class ReleaseReminder(
+    val itemId: String,
+    val itemType: String,
+    val title: String,
+    val releaseDateMs: Long,
+    val releaseDateIso: String,
+    val posterUrl: String?,
+    val createdAtMs: Long
+) {
+    /** Stable identity of a reminder: one per title. */
+    val key: String get() = "$itemType|$itemId"
+}
+
+/**
+ * Nuvio fork: the detail screen's "Remind me", persisted per profile as a JSON
+ * list in the profile DataStore (same per-profile store pattern as
+ * [AmbientModeDataStore]). Delivery is handled by
+ * com.nuvio.tv.core.reminders.ReleaseReminderCoordinator (AlarmManager when the
+ * process is dead, in-process checks while it runs) via the "Release reminders"
+ * notification channel; the management list lives in Settings > Features.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+@Singleton
+class ReleaseRemindersStore @Inject constructor(
+    private val factory: ProfileDataStoreFactory,
+    private val profileManager: ProfileManager
+) {
+    companion object {
+        const val FEATURE = "release_reminders"
+        internal val LIST_KEY = stringPreferencesKey("release_reminders_json")
+    }
+
+    private fun store() = factory.get(profileManager.activeProfileId.value, FEATURE)
+
+    /** Upcoming (and any undelivered past) reminders for the active profile. */
+    val reminders: Flow<List<ReleaseReminder>> =
+        profileManager.activeProfileId.flatMapLatest { profileId ->
+            factory.get(profileId, FEATURE).data.map(::decodeReminders)
+        }.distinctUntilChanged()
+
+    suspend fun current(): List<ReleaseReminder> = decodeReminders(store().data.first())
+
+    /** Adds [reminder] unless one for the same title already exists. Returns whether it was added. */
+    suspend fun add(reminder: ReleaseReminder): Boolean {
+        val existing = current()
+        if (existing.any { it.key == reminder.key }) return false
+        store().edit { prefs ->
+            val list = decodeReminders(prefs)
+            if (list.any { it.key == reminder.key }) return@edit
+            prefs[LIST_KEY] = JSONArray().apply {
+                list.forEach { put(encodeReminder(it)) }
+                put(encodeReminder(reminder))
+            }.toString()
+        }
+        return true
+    }
+
+    suspend fun remove(itemId: String, itemType: String) {
+        store().edit { prefs ->
+            val list = decodeReminders(prefs)
+            val targetKey = "$itemType|$itemId"
+            if (list.none { it.key == targetKey }) return@edit
+            prefs[LIST_KEY] = JSONArray().apply {
+                list.filterNot { it.key == targetKey }.forEach { put(encodeReminder(it)) }
+            }.toString()
+        }
+    }
+
+    /** Removes every reminder whose [ReleaseReminder.key] is in [keys] (used after delivery). */
+    suspend fun removeAll(keys: Collection<String>) {
+        if (keys.isEmpty()) return
+        store().edit { prefs ->
+            val list = decodeReminders(prefs)
+            if (list.none { it.key in keys }) return@edit
+            prefs[LIST_KEY] = JSONArray().apply {
+                list.filterNot { it.key in keys }.forEach { put(encodeReminder(it)) }
+            }.toString()
+        }
+    }
+
+    /**
+     * Reminders whose release moment has passed and that have not been delivered
+     * yet. The coordinator posts their notifications and removes them.
+     */
+    suspend fun dueReminders(nowMs: Long = System.currentTimeMillis()): List<ReleaseReminder> =
+        current().filter { it.releaseDateMs <= nowMs }
+}
+
+private fun encodeReminder(reminder: ReleaseReminder): String =
+    JSONObject().apply {
+        put("itemId", reminder.itemId)
+        put("itemType", reminder.itemType)
+        put("title", reminder.title)
+        put("releaseDateMs", reminder.releaseDateMs)
+        put("releaseDateIso", reminder.releaseDateIso)
+        put("posterUrl", reminder.posterUrl.orEmpty())
+        put("createdAtMs", reminder.createdAtMs)
+    }.toString()
+
+internal fun decodeReminders(preferences: Preferences): List<ReleaseReminder> {
+    val raw = preferences[ReleaseRemindersStore.LIST_KEY] ?: return emptyList()
+    val out = mutableListOf<ReleaseReminder>()
+    runCatching {
+        val array = JSONArray(raw)
+        for (index in 0 until array.length()) {
+            val entry = array.optJSONObject(index) ?: continue
+            val itemId = entry.optString("itemId").takeIf { it.isNotBlank() } ?: continue
+            val itemType = entry.optString("itemType").takeIf { it.isNotBlank() } ?: continue
+            out += ReleaseReminder(
+                itemId = itemId,
+                itemType = itemType,
+                title = entry.optString("title"),
+                releaseDateMs = entry.optLong("releaseDateMs", 0L),
+                releaseDateIso = entry.optString("releaseDateIso"),
+                posterUrl = entry.optString("posterUrl").takeIf { it.isNotBlank() },
+                createdAtMs = entry.optLong("createdAtMs", 0L)
+            )
+        }
+    }
+    return out
+}
