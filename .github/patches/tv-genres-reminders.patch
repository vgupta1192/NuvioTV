+ * server calls); picking one shows a poster grid built on the same
+ * [GridContentCard] the library and search results use.
+ */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun GenresScreen(
+    showBuiltInHeader: Boolean = true,
+    onNavigateToDetail: (String, String, String?) -> Unit
+) {
+    val buckets by GenreIndex.buckets.collectAsState()
+    var selectedKey by rememberSaveable { mutableStateOf<String?>(null) }
+    val selectedBucket = selectedKey?.let { key -> buckets.firstOrNull { it.key == key } }
+
+    BackHandler(enabled = selectedKey != null) {
+        selectedKey = null
+    }
+
+    Column(
+        modifier = Modifier
+            .fillMaxSize()
+            .padding(horizontal = NuvioTheme.spacing.xxxl, vertical = NuvioTheme.spacing.lg)
+    ) {
+        Text(
+            text = stringResource(R.string.genres_title),
+            style = MaterialTheme.typography.headlineMedium,
+            color = if (showBuiltInHeader) NuvioTheme.colors.TextPrimary else Color.Transparent
+        )
