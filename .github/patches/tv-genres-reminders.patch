+package com.nuvio.tv.core.reminders
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+import android.util.Log
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+
+/**
+ * Nuvio fork: fires the "Release reminders" alarm at a title's release moment
+ * (and re-arms after a reboot, via the BOOT_COMPLETED filter). Deliver + reschedule
+ * run inside goAsync's window; anything slow — reading the DataStore, loading the
+ * poster, posting the notification — happens on a background dispatcher.
+ */
+class ReleaseReminderAlarmReceiver : BroadcastReceiver() {
+
+    @EntryPoint
+    @InstallIn(SingletonComponent::class)
+    interface ReleaseReminderEntryPoint {
+        fun releaseReminderCoordinator(): ReleaseReminderCoordinator
+    }
+
+    override fun onReceive(context: Context, intent: Intent) {
+        if (intent.action != Intent.ACTION_BOOT_COMPLETED &&
+            intent.action != ACTION_DELIVER
+        ) {
+            return
+        }
+        val result = goAsync()
+        CoroutineScope(Dispatchers.Default).launch {
+            try {
+                val coordinator = EntryPointAccessors
+                    .fromApplication(context.applicationContext, ReleaseReminderEntryPoint::class.java)
+                    .releaseReminderCoordinator()
+                coordinator.deliverDue()
+                coordinator.scheduleNextAlarm()
+            } catch (e: Exception) {
+                Log.w(TAG, "Release reminder delivery failed", e)
+            } finally {
+                result.finish()
+            }
+        }
+    }
+
+    companion object {
+        const val ACTION_DELIVER = "com.nuvio.tv.action.DELIVER_RELEASE_REMINDERS"
+        private const val TAG = "ReleaseReminders"
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderCoordinator.kt b/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderCoordinator.kt
