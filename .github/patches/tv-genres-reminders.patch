+            style = MaterialTheme.typography.bodyMedium,
+            color = NuvioTheme.colors.TextSecondary,
+            modifier = Modifier.padding(top = NuvioTheme.spacing.xxs)
+        )
+
+        val bucket = selectedBucket
+        when {
+            buckets.isEmpty() -> {
+                Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                    EmptyScreenState(
+                        title = stringResource(R.string.genres_title),
+                        subtitle = stringResource(R.string.genres_empty)
+                    )
+                }
+            }
+
+            bucket != null -> {
+                GenreItemsGrid(
+                    bucket = bucket,
+                    onBack = { selectedKey = null },
+                    onNavigateToDetail = onNavigateToDetail,
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .padding(top = NuvioTheme.spacing.md)
+                )
+            }
+
+            else -> {
+                GenreChipsGrid(
+                    buckets = buckets,
+                    onSelect = { key -> selectedKey = key },
+                    modifier = Modifier
+                        .fillMaxSize()
+                        .padding(top = NuvioTheme.spacing.md)
+                )
+            }
+        }
+    }
+}
