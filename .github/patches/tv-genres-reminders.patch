+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun GenreChipsGrid(
+    buckets: List<GenreBucket>,
+    onSelect: (String) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val firstChipFocusRequester = remember { FocusRequester() }
+    var requestedInitialFocus by rememberSaveable { mutableStateOf(false) }
+    LaunchedEffect(buckets) {
+        if (buckets.isNotEmpty() && !requestedInitialFocus) {
+            requestedInitialFocus = true
+            runCatching { firstChipFocusRequester.requestFocus() }
+        }
+    }
+    LazyVerticalGrid(
+        columns = GridCells.Fixed(GENRE_CHIP_COLUMNS),
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md),
+        verticalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md),
+        contentPadding = androidx.compose.foundation.layout.PaddingValues(bottom = NuvioTheme.spacing.lg)
+    ) {
+        itemsIndexed(buckets, key = { _, bucket -> bucket.key }) { index, bucket ->
+            val chipShape = RoundedCornerShape(14.dp)
+            Card(
+                onClick = { onSelect(bucket.key) },
+                modifier = Modifier
+                    .then(if (index == 0) Modifier.focusRequester(firstChipFocusRequester) else Modifier),
+                shape = CardDefaults.shape(shape = chipShape),
+                colors = CardDefaults.colors(
+                    containerColor = NuvioTheme.colors.BackgroundCard,
+                    focusedContainerColor = NuvioTheme.colors.Secondary
+                ),
+                border = CardDefaults.border(
+                    focusedBorder = Border(
+                        border = NuvioTheme.focusRing.border(NuvioTheme.spacing.xxs),
+                        shape = chipShape
+                    )
+                )
+            ) {
+                Column(
+                    modifier = Modifier
+                        .fillMaxWidth()
+                        .padding(horizontal = NuvioTheme.spacing.lg, vertical = NuvioTheme.spacing.md),
+                    verticalArrangement = Arrangement.spacedBy(2.dp)
+                ) {
+                    Text(
+                        text = localizedGenreLabel(bucket.label),
+                        style = MaterialTheme.typography.titleMedium,
+                        color = NuvioTheme.colors.TextPrimary,
+                        maxLines = 1,
+                        overflow = TextOverflow.Ellipsis
+                    )
