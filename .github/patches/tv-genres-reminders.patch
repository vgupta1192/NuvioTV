+/**
+ * Nuvio fork: view model behind the hero's "Remind me" action. Holds the per-profile
+ * reminder list and keeps the delivery alarm in step after every change.
+ */
+@HiltViewModel
+class ReleaseReminderViewModel @Inject constructor(
+    private val store: ReleaseRemindersStore,
+    private val coordinator: ReleaseReminderCoordinator
+) : ViewModel() {
+
+    val reminders: StateFlow<List<ReleaseReminder>> =
+        store.reminders.stateIn(viewModelScope, SharingStarted.Eagerly, emptyList())
+
+    fun add(reminder: ReleaseReminder) {
+        viewModelScope.launch {
+            store.add(reminder)
+            coordinator.scheduleNextAlarm()
+        }
+    }
+
+    fun remove(reminder: ReleaseReminder) {
+        viewModelScope.launch {
+            store.remove(reminder.itemId, reminder.itemType)
+            coordinator.scheduleNextAlarm()
+        }
+    }
+}
+
+/**
+ * Nuvio fork: the hero action row's "Remind me" icon button. Only composed for
+ * titles with a future release/air date (parsed with the tree's own
+ * [parseEpisodeReleaseLocalDate]); clicking toggles the reminder in the local
+ * DataStore, requesting POST_NOTIFICATIONS lazily on the first add for Android 13+.
+ */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun ReleaseReminderAction(
+    meta: Meta,
+    onFocused: () -> Unit = {}
+) {
+    val releaseDate = remember(meta.id, meta.released) {
+        parseEpisodeReleaseLocalDate(meta.released)
+    } ?: return
+    if (!releaseDate.isAfter(LocalDate.now())) return
+
+    val viewModel: ReleaseReminderViewModel = hiltViewModel()
+    val reminders by viewModel.reminders.collectAsStateWithLifecycle()
+    val context = LocalContext.current
+    val isSet = reminders.any { it.itemId == meta.id && it.itemType == meta.apiType }
+    var pendingReminder by remember { mutableStateOf<ReleaseReminder?>(null) }
+
+    val permissionLauncher = rememberLauncherForActivityResult(
+        ActivityResultContracts.RequestPermission()
+    ) { _ ->
+        pendingReminder?.let { viewModel.add(it) }
+        pendingReminder = null
+    }
+
+    ReleaseReminderIconButton(
+        isSet = isSet,
+        onFocused = onFocused,
+        onClick = {
+            val reminder = buildReleaseReminder(meta, releaseDate)
+            if (isSet) {
+                viewModel.remove(reminder)
+            } else {
+                val needsPermission = Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+                    context.checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) !=
+                    PackageManager.PERMISSION_GRANTED
+                if (needsPermission) {
+                    pendingReminder = reminder
+                    permissionLauncher.launch(Manifest.permission.POST_NOTIFICATIONS)
+                } else {
+                    viewModel.add(reminder)
+                }
+            }
+        }
+    )
+}
+
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun ReleaseReminderIconButton(
+    isSet: Boolean,
+    onClick: () -> Unit,
+    onFocused: () -> Unit
+) {
+    IconButton(
+        onClick = onClick,
+        modifier = Modifier
+            .size(NuvioTheme.spacing.xxxl)
+            .onFocusChanged { state ->
+                if (state.isFocused) onFocused()
+            },
+        colors = IconButtonDefaults.colors(
+            containerColor = if (isSet) NuvioTheme.colors.Secondary else NuvioTheme.colors.BackgroundCard,
+            focusedContainerColor = NuvioTheme.colors.Secondary,
+            contentColor = if (isSet) NuvioTheme.colors.OnSecondary else NuvioTheme.colors.TextPrimary,
+            focusedContentColor = NuvioTheme.colors.OnSecondary
+        ),
+        border = IconButtonDefaults.border(
+            focusedBorder = Border(
+                border = NuvioTheme.focusRing.border(NuvioTheme.spacing.xxs),
+                shape = CircleShape
+            )
+        ),
+        shape = IconButtonDefaults.shape(
+            shape = CircleShape
+        )
+    ) {
+        Icon(
+            imageVector = if (isSet) Icons.Default.Notifications else Icons.Default.NotificationsNone,
+            contentDescription = if (isSet) {
+                stringResource(R.string.reminder_set)
+            } else {
+                stringResource(R.string.remind_me)
+            },
+            modifier = Modifier.size(22.dp)
+        )
+    }
+}
+
+private fun buildReleaseReminder(meta: Meta, releaseDate: LocalDate): ReleaseReminder =
+    ReleaseReminder(
+        itemId = meta.id,
+        itemType = meta.apiType,
+        title = meta.name,
+        releaseDateMs = releaseDate.atStartOfDay(ZoneOffset.UTC).toInstant().toEpochMilli(),
+        releaseDateIso = meta.released ?: releaseDate.toString(),
+        posterUrl = meta.poster ?: meta.landscapePoster ?: meta.rawPosterUrl,
+        createdAtMs = System.currentTimeMillis()
+    )
