+++ b/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderCoordinator.kt
@@ -0,0 +1,146 @@
+package com.nuvio.tv.core.reminders
+
+import android.app.AlarmManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.util.Log
+import com.nuvio.tv.data.local.ReleaseRemindersStore
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Nuvio fork: delivers the detail screen's "Remind me".
+ *
+ * Scheduling choice (the tree has no AlarmManager infra of its own — its only
+ * scheduler is the TV-channel JobService, which is periodic, not exact): an
+ * [AlarmManager] alarm set with setExactAndAllowWhileIdle (setAndAllowWhileIdle
+ * when exact alarms are not grantable, Android 12+) fires at the release moment
+ * even when the app process is dead, handled by
+ * [ReleaseReminderAlarmReceiver]. While the process runs this coordinator also
+ * checks due reminders on start, on every reminder-list change, and on a
+ * 6-hour in-process loop, so a lost or deferred alarm (reboot, OEM battery
+ * rules, denied exact alarms) still delivers at the next check. Reminders are
+ * removed once delivered.
+ */
+@Singleton
+class ReleaseReminderCoordinator @Inject constructor(
+    @ApplicationContext private val context: Context,
+    private val store: ReleaseRemindersStore
+) {
+    companion object {
+        private const val TAG = "ReleaseReminders"
+        private const val IN_PROCESS_CHECK_INTERVAL_MS = 6L * 60 * 60 * 1000
+        private const val ALARM_REQUEST_CODE = 40321
+    }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    @Volatile
+    private var started = false
+
+    /** Called once from Application.onCreate. */
+    fun start() {
+        if (started) return
+        started = true
+        scope.launch {
+            deliverDue()
+            scheduleNextAlarm()
+        }
+        scope.launch {
+            store.reminders.collect {
+                scheduleNextAlarm()
+            }
+        }
+        scope.launch {
+            while (true) {
+                delay(IN_PROCESS_CHECK_INTERVAL_MS)
+                deliverDue()
+                scheduleNextAlarm()
+            }
+        }
+    }
+
+    /** Fires every due reminder's notification, then forgets them. Returns how many fired. */
+    suspend fun deliverDue(): Int {
+        val due = try {
+            store.dueReminders()
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to read due reminders", e)
+            return 0
+        }
+        if (due.isEmpty()) return 0
+        ReleaseReminderNotifications.ensureChannel(context)
+        for (reminder in due) {
+            val poster = ReleaseReminderNotifications.posterBitmapOrNull(context, reminder.posterUrl)
+            ReleaseReminderNotifications.post(context, reminder, poster)
+        }
+        try {
+            store.removeAll(due.map { it.key })
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to clear delivered reminders", e)
+        }
+        return due.size
+    }
+
+    /**
+     * Arms the alarm for the next upcoming reminder (or cancels the alarm when
+     * there is none). Safe to call repeatedly; the PendingIntent is the same.
+     * Suspending so the DataStore read never blocks the caller's thread.
+     */
+    suspend fun scheduleNextAlarm() {
+        val alarmManager = context.getSystemService(Context.ALARM_SERVICE) as? AlarmManager ?: return
+        val pendingIntent = alarmPendingIntent()
+        val nextAtMs = try {
+            withContext(Dispatchers.IO) {
+                store.current()
+                    .filter { it.releaseDateMs > System.currentTimeMillis() }
+                    .minByOrNull { it.releaseDateMs }
+            }?.releaseDateMs
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to read reminders for scheduling", e)
+            null
+        }
+        try {
+            if (nextAtMs == null) {
+                alarmManager.cancel(pendingIntent)
+                return
+            }
+            val canExact = Build.VERSION.SDK_INT < Build.VERSION_CODES.S || alarmManager.canScheduleExactAlarms()
+            if (canExact) {
+                alarmManager.setExactAndAllowWhileIdle(
+                    AlarmManager.RTC_WAKEUP,
+                    nextAtMs,
+                    pendingIntent
+                )
+            } else {
+                alarmManager.setAndAllowWhileIdle(
+                    AlarmManager.RTC_WAKEUP,
+                    nextAtMs,
+                    pendingIntent
+                )
+            }
+        } catch (e: Exception) {
+            Log.w(TAG, "Failed to schedule release reminder alarm", e)
+        }
+    }
+
+    private fun alarmPendingIntent(): PendingIntent {
+        val intent = Intent(context, ReleaseReminderAlarmReceiver::class.java)
+            .setAction(ReleaseReminderAlarmReceiver.ACTION_DELIVER)
+        return PendingIntent.getBroadcast(
+            context,
+            ALARM_REQUEST_CODE,
+            intent,
+            PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
+        )
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderNotifications.kt b/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderNotifications.kt
new file mode 100644
index 00000000..61155236
--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderNotifications.kt
@@ -0,0 +1,108 @@
+package com.nuvio.tv.core.reminders
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.content.Context
+import android.graphics.Bitmap
+import android.os.Build
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import coil3.BitmapImage
+import coil3.imageLoader
+import coil3.request.ImageRequest
+import coil3.request.SuccessResult
+import coil3.request.allowHardware
+import coil3.size.Size
+import com.nuvio.tv.R
+import com.nuvio.tv.data.local.ReleaseReminder
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+/**
+ * Nuvio fork: the "Release reminders" notification channel and its one poster
+ * (or plain) notification per title. Kept free of Compose so the AlarmManager
+ * receiver can post without an Activity.
+ */
+internal object ReleaseReminderNotifications {
+
+    const val CHANNEL_ID = "release_reminders"
+    private const val POSTER_WIDTH_PX = 256
+    private const val POSTER_HEIGHT_PX = 384
+
+    fun ensureChannel(context: Context) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O) return
+        val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as? NotificationManager ?: return
+        if (manager.getNotificationChannel(CHANNEL_ID) != null) return
+        val channel = NotificationChannel(
+            CHANNEL_ID,
+            context.getString(R.string.reminder_channel_name),
+            NotificationManager.IMPORTANCE_DEFAULT
+        ).apply {
+            description = context.getString(R.string.reminder_channel_description)
+        }
+        manager.createNotificationChannel(channel)
+    }
+
+    /** Posts one notification for [reminder]; tapping opens the title's detail screen. */
+    fun post(context: Context, reminder: ReleaseReminder, poster: Bitmap?) {
+        ensureChannel(context)
+        // Android 13+: notifications need the runtime grant; silently skip otherwise.
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU &&
+            context.checkSelfPermission(android.Manifest.permission.POST_NOTIFICATIONS) !=
+            android.content.pm.PackageManager.PERMISSION_GRANTED
+        ) {
+            return
+        }
+        val deepLink = "nuvio://detail/${reminder.itemType}/${android.net.Uri.encode(reminder.itemId)}"
+        val contentIntent = android.app.PendingIntent.getActivity(
+            context,
+            notificationId(reminder),
+            android.content.Intent(android.content.Intent.ACTION_VIEW, android.net.Uri.parse(deepLink))
+                .setPackage(context.packageName),
+            android.app.PendingIntent.FLAG_UPDATE_CURRENT or android.app.PendingIntent.FLAG_IMMUTABLE
+        )
+        val builder = NotificationCompat.Builder(context, CHANNEL_ID)
+            .setSmallIcon(R.drawable.ic_notification_reminder)
+            .setContentTitle(reminder.title)
+            .setContentText(context.getString(R.string.reminder_notification_text))
+            .setContentIntent(contentIntent)
+            .setAutoCancel(true)
+            .setCategory(NotificationCompat.CATEGORY_REMINDER)
+        if (poster != null) {
+            builder.setStyle(NotificationCompat.BigPictureStyle().bigPicture(poster))
+        }
+        runCatching {
+            NotificationManagerCompat.from(context).notify(notificationId(reminder), builder.build())
+        }
+    }
+
+    fun cancel(context: Context, reminder: ReleaseReminder) {
+        NotificationManagerCompat.from(context).cancel(notificationId(reminder))
+    }
+
+    private fun notificationId(reminder: ReleaseReminder): Int = reminder.key.hashCode()
+
+    /**
+     * Loads the poster for the notification's big picture, sampled small, bounded
+     * by Coil's own request timeout. Any failure returns null and the caller
+     * posts the plain variant.
+     */
+    suspend fun posterBitmapOrNull(context: Context, posterUrl: String?): Bitmap? =
+        withContext(Dispatchers.IO) {
+            if (posterUrl.isNullOrBlank()) return@withContext null
+            val request = ImageRequest.Builder(context)
+                .data(posterUrl)
+                .allowHardware(false)
+                .size(Size(POSTER_WIDTH_PX, POSTER_HEIGHT_PX))
+                .build()
+            val result = try {
+                context.imageLoader.execute(request)
+            } catch (cancellation: CancellationException) {
+                throw cancellation
+            } catch (_: Exception) {
+                return@withContext null
+            }
+            ((result as? SuccessResult)?.image as? BitmapImage)?.bitmap
+        }
+}
