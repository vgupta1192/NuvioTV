+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun GenreItemsGrid(
+    bucket: GenreBucket,
+    onBack: () -> Unit,
+    onNavigateToDetail: (String, String, String?) -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val firstCardFocusRequester = remember(bucket.key) { FocusRequester() }
+    LaunchedEffect(bucket.key) {
+        runCatching { firstCardFocusRequester.requestFocus() }
+    }
+    LazyVerticalGrid(
+        columns = GridCells.Adaptive(minSize = PosterCardDefaults.Style.width),
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md),
+        verticalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md),
+        contentPadding = androidx.compose.foundation.layout.PaddingValues(bottom = NuvioTheme.spacing.lg)
+    ) {
+        item(span = { androidx.compose.foundation.lazy.grid.GridItemSpan(maxLineSpan) }) {
+            GenreBackChip(onBack = onBack, focusRequester = firstCardFocusRequester)
+        }
+        items(bucket.items, key = { "${it.apiType}:${it.id}" }) { item ->
+            GridContentCard(
+                item = item,
+                onClick = {
+                    onNavigateToDetail(item.id, item.apiType, item.sourceAddonBaseUrl ?: "")
