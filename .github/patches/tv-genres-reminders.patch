@@ -0,0 +1,75 @@
+package com.nuvio.tv.core.genres
+
+import com.nuvio.tv.domain.model.CatalogRow
+import com.nuvio.tv.domain.model.MetaPreview
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * A genre and the catalog/hero titles that carry it. [items] are the home catalog
+ * [MetaPreview]s themselves, so the Genres screen can reuse the existing poster-card
+ * grid without a second fetch.
+ */
+data class GenreBucket(
+    /** Normalised (lowercase) genre key used for grouping and selection. */
+    val key: String,
+    /** Genre spelling as first seen on a catalog item; the UI localises known names. */
+    val label: String,
+    val items: List<MetaPreview>
+)
+
+/**
+ * Nuvio fork: in-memory genre index for the Genres sidebar destination.
+ *
+ * Derived entirely from meta the app already fetched for Home (catalog rows + hero
+ * items) — no new server API and no persistence. [com.nuvio.tv.ui.screens.home]
+ * pipelines refresh it every time catalog rows are recomputed, so the index tracks
+ * whatever the user's addons currently show. Empties on every process start until
+ * Home loads once, which the Genres screen presents as an empty state.
+ */
+object GenreIndex {
+
+    /** Per-genre cap; home catalogs can hold thousands of items across addons. */
+    private const val MAX_ITEMS_PER_GENRE = 200
+
+    private val _buckets = MutableStateFlow<List<GenreBucket>>(emptyList())
+
+    val buckets: StateFlow<List<GenreBucket>> = _buckets.asStateFlow()
+
+    /** Rebuilds the index from the given rows (plus hero items). Cheap; StateFlow dedupes equal results. */
+    fun updateFromCatalogs(rows: List<CatalogRow>, heroItems: List<MetaPreview>) {
+        val itemsByKey = LinkedHashMap<String, MutableGenreAccumulator>()
+        fun accumulate(item: MetaPreview) {
+            if (item.name.isBlank()) return
+            for (genre in item.genres) {
+                val key = genre.trim().lowercase()
+                if (key.isEmpty() || key == "none") continue
+                val accumulator = itemsByKey.getOrPut(key) { MutableGenreAccumulator(label = genre.trim()) }
+                if (accumulator.items.none { it.id == item.id && it.apiType == item.apiType }) {
+                    if (accumulator.items.size < MAX_ITEMS_PER_GENRE) {
+                        accumulator.items.add(item)
+                    }
+                }
+            }
+        }
+        rows.forEach { row -> row.items.forEach(::accumulate) }
+        heroItems.forEach(::accumulate)
+
+        val buckets = itemsByKey.map { (key, accumulator) ->
+            GenreBucket(key = key, label = accumulator.label, items = accumulator.items)
+        }.sortedWith(
+            compareByDescending<GenreBucket> { it.items.size }.thenBy { it.key }
+        )
+        _buckets.value = buckets
+    }
+
+    /** Returns the bucket whose key matches, for selection from the UI. */
+    fun bucketOrNull(key: String): GenreBucket? =
+        _buckets.value.firstOrNull { it.key == key }
+
+    private class MutableGenreAccumulator(
+        val label: String,
+        val items: MutableList<MetaPreview> = mutableListOf()
+    )
+}
diff --git a/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderAlarmReceiver.kt b/app/src/main/java/com/nuvio/tv/core/reminders/ReleaseReminderAlarmReceiver.kt
