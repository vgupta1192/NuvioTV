+/** Brand colour for a rating value, matching Mobile. Key is a provider id or a display name. */
+internal fun forkRatingValueColor(source: String): Color? = when (source.lowercase()) {
+    "imdb" -> Color(0xFFF5C518)
+    "tmdb" -> Color(0xFF01B4E4)
+    "trakt" -> Color(0xFFED1C24)
+    "letterboxd" -> Color(0xFF00E054)
+    "mal" -> Color(0xFF2E51A2)
+    "tomatoes", "audience" -> Color(0xFFFA320A)
+    "metacritic" -> Color(0xFFFFCC33)
+    "simkl" -> Color.White
+    else -> null
+}
+
 /** Logo plus value for one non-IMDb episode rating source. */
 @Composable
 internal fun ForkEpisodeSourceRating(
@@ -145,7 +158,7 @@ internal fun ForkEpisodeSourceRating(
         }
         Text(
             text = String.format(Locale.US, "%.1f", rating),
-            style = textStyle,
+            style = forkRatingValueColor(source)?.let { textStyle.copy(color = it) } ?: textStyle,
             maxLines = 1
         )
     }
