+@Composable
+private fun MenuRow(label: String, focusRequester: FocusRequester? = null, onClick: () -> Unit) {
+    var focused by remember { mutableStateOf(false) }
+    // The OK press that opened this menu was already down when the row took focus; its release must not activate the row.
+    var pressedHere by remember { mutableStateOf(false) }
+    Text(
+        label,
+        color = Color.White,
+        fontSize = 16.sp,
+        maxLines = 1,
+        overflow = TextOverflow.Ellipsis,
+        modifier = Modifier
+            .fillMaxWidth()
+            .clip(RoundedCornerShape(8.dp))
+            .background(if (focused) Color(0xFF34343A) else Color.Transparent)
+            .border(2.dp, if (focused) Color.White else Color.Transparent, RoundedCornerShape(8.dp))
+            .then(if (focusRequester != null) Modifier.focusRequester(focusRequester) else Modifier)
+            .onFocusChanged {
+                focused = it.isFocused
+                if (!it.isFocused) pressedHere = false
+            }
+            .onPreviewKeyEvent { e ->
+                val isOk = e.key == androidx.compose.ui.input.key.Key.DirectionCenter ||
+                    e.key == androidx.compose.ui.input.key.Key.Enter ||
+                    e.key == androidx.compose.ui.input.key.Key.NumPadEnter
+                if (!isOk) return@onPreviewKeyEvent false
