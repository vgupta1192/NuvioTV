@@ -0,0 +1,105 @@
+package com.nuvio.tv.ui.screens.jellyfin
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.nuvio.tv.core.tmdb.TmdbMetadataService
+import com.nuvio.tv.core.tmdb.TmdbService
+import com.nuvio.tv.data.local.MDBListSettingsDataStore
+import com.nuvio.tv.data.repository.ImdbEpisodeRatingsRepository
+import com.nuvio.tv.data.repository.MDBListRepository
+import com.nuvio.tv.domain.model.ContentType
+import com.nuvio.tv.domain.model.JellyfinItem
+import com.nuvio.tv.domain.model.MDBListRatings
+import com.nuvio.tv.domain.model.MDBListSettings
+import com.nuvio.tv.domain.model.Meta
+import com.nuvio.tv.ui.screens.detail.ForkTvExtraEpisodeRatings
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+
+/** Title and per-episode ratings for a Jellyfin item, looked up through its IMDb/TMDB provider ids. */
+data class JellyfinRatingsState(
+    val mdbListRatings: MDBListRatings? = null,
+    val mdbListRatingOrder: List<String> = MDBListSettings.DEFAULT_RATING_ORDER,
+    val tmdbRating: Float? = null,
+    val episodeImdbRatings: Map<Pair<Int, Int>, Double> = emptyMap(),
+    val episodeTmdbRatings: Map<Pair<Int, Int>, Double> = emptyMap(),
+    val episodeExtraRatings: Map<String, Map<Pair<Int, Int>, Double>> = emptyMap(),
+)
+
+@HiltViewModel
+class JellyfinRatingsViewModel @Inject constructor(
+    private val mdbListRepository: MDBListRepository,
+    private val mdbListSettingsDataStore: MDBListSettingsDataStore,
+    private val tmdbService: TmdbService,
+    private val tmdbMetadataService: TmdbMetadataService,
+    private val imdbEpisodeRatingsRepository: ImdbEpisodeRatingsRepository,
+    private val forkExtraEpisodeRatings: ForkTvExtraEpisodeRatings,
+) : ViewModel() {
+
+    private val _state = MutableStateFlow(JellyfinRatingsState())
+    val state: StateFlow<JellyfinRatingsState> = _state.asStateFlow()
+
+    private var loadedKey: String? = null
+    private var job: Job? = null
+
+    fun load(item: JellyfinItem, meta: Meta, seasonNumbers: List<Int>) {
+        val imdbId = item.imdbId
+        val tmdbHint = item.tmdbId
+        if (imdbId == null && tmdbHint == null) return
+        val key = "${item.id}:${seasonNumbers.joinToString(",")}"
+        if (key == loadedKey) return
+        if (loadedKey?.substringBefore(':') != item.id) _state.value = JellyfinRatingsState()
+        loadedKey = key
+        job?.cancel()
+        job = viewModelScope.launch {
+            try {
+                val type = if (item.isSeries) ContentType.SERIES else ContentType.MOVIE
+                val apiType = type.toApiString()
+                val tmdbId = (tmdbHint ?: imdbId?.let { tmdbService.ensureTmdbId(it, apiType, fallbackImdbId = it) })
+                    ?.toIntOrNull()
+
+                val settings = mdbListSettingsDataStore.settings.first()
+                val mdb = runCatching {
+                    mdbListRepository.getRatingsForMeta(meta, fallbackItemId = imdbId ?: item.id, fallbackItemType = apiType)
+                }.getOrNull()
+                _state.update {
+                    it.copy(mdbListRatings = mdb?.ratings, mdbListRatingOrder = settings.enabledRatingOrder())
+                }
+
+                if (tmdbId != null) {
+                    val rating = runCatching {
+                        tmdbMetadataService.fetchEnrichment(tmdbId = tmdbId.toString(), contentType = type, language = "en")
+                    }.getOrNull()?.rating
+                    if (rating != null) _state.update { it.copy(tmdbRating = rating.toFloat()) }
+                }
+
+                if (item.isSeries) {
+                    val imdb = runCatching {
+                        imdbEpisodeRatingsRepository.getEpisodeRatings(imdbId = imdbId, tmdbId = tmdbId)
+                    }.getOrDefault(emptyMap())
+                    if (imdb.isNotEmpty()) _state.update { it.copy(episodeImdbRatings = imdb) }
+                    if (tmdbId != null && seasonNumbers.isNotEmpty()) {
+                        val votes = runCatching {
+                            tmdbMetadataService.fetchEpisodeVoteAverages(tmdbId, seasonNumbers.filter { it > 0 })
+                        }.getOrDefault(emptyMap())
+                        if (votes.isNotEmpty()) _state.update { it.copy(episodeTmdbRatings = votes) }
+                    }
+                    if (imdbId != null) {
+                        val extra = runCatching { forkExtraEpisodeRatings.fetch(imdbId) }.getOrDefault(emptyMap())
+                        if (extra.isNotEmpty()) _state.update { it.copy(episodeExtraRatings = extra) }
+                    }
+                }
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            }
+        }
+    }
+}
