+    suspend fun refreshInstalledManifests(maxAgeMs: Long = 0L): Unit = kotlinx.coroutines.withContext<Unit>(dispatcher) {
+        synchronized(manifestRefreshLock) {
+            if (manifestRefreshJob?.isActive == true) return@withContext
