+        val results = coroutineScope { urls.map { url -> async { fetchAddon(url) } }.awaitAll() }
+        Log.d(TAG, "Manifest refresh: ${results.count { it is NetworkResult.Success }}/${urls.size} addon(s) re-read")
+    }
