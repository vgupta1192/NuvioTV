diff --git a/app/src/main/java/com/nuvio/tv/core/di/NetworkModule.kt b/app/src/main/java/com/nuvio/tv/core/di/NetworkModule.kt
index 8c473aa98..c03ef745c 100644
--- a/app/src/main/java/com/nuvio/tv/core/di/NetworkModule.kt
+++ b/app/src/main/java/com/nuvio/tv/core/di/NetworkModule.kt
@@ -166,6 +166,22 @@ object NetworkModule {
             .cache(Cache(File(context.cacheDir, "addon_http_cache"), 50L * 1024 * 1024))
             .sslSocketFactory(sslContext.socketFactory, trustAllManager)
             .hostnameVerifier { _, _ -> true }
+            // Nuvio fork: catalog JSON without its own cache lifetime is reused for 60 s (Home re-entry, Search).
+            .addNetworkInterceptor { chain ->
+                val response = chain.proceed(chain.request())
+                val path = chain.request().url.encodedPath
+                val cacheControl = response.header("Cache-Control").orEmpty()
+                if (response.isSuccessful && chain.request().method == "GET" && path.contains("/catalog/") &&
+                    !cacheControl.contains("max-age") && !cacheControl.contains("no-store")
+                ) {
+                    response.newBuilder()
+                        .removeHeader("Pragma")
+                        .header("Cache-Control", "public, max-age=60")
+                        .build()
+                } else {
+                    response
+                }
+            }
             .build()
     }
 
