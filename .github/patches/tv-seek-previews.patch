+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.res.stringResource
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.tv.R
+import com.nuvio.tv.ui.screens.player.seekpreview.local.LocalSeekPreviewSettings
+
+/**
+ * Seek-preview rows (ported from NuvioTV-Reshaped): "Generate previews on device" and the
+ * user's own Seekr key. Drawn with Nuvio's settings rows under Playback › Player interface.
+ */
+@Composable
+internal fun seekPreviewSettingsRows(enabled: Boolean) {
+    val context = LocalContext.current
+    val checked by LocalSeekPreviewSettings.enabled(context).collectAsStateWithLifecycle()
+
+    SettingsToggleRow(
+        title = stringResource(R.string.settings_seek_preview_local),
+        subtitle = stringResource(R.string.settings_seek_preview_local_description),
+        checked = checked,
+        onToggle = { LocalSeekPreviewSettings.setEnabled(context, !checked) },
+        enabled = enabled,
+    )
+    seekrKeySettingsRow(enabled = enabled)
+}
