+/**
+ * Fork: shared state for the picture and sound effects (Smart Enhance, sharpen, equalizer, sound modes...).
+ * Saved in SharedPreferences, remembered per title, and read by the player and the Settings section.
+ */
+internal object PlayerEffects {
+    private const val PREFS_NAME = "nuvio_tv_player_effects"
+    private const val KEY_AUDIO = "audio"
+    private const val KEY_PICTURE = "picture"
+    private const val KEY_SMART = "smart_enhance"
+    private const val KEY_AUTO = "auto_enhance"
+    private const val KEY_BEST = "prefer_best_quality"
+    private const val KEY_REMEMBER = "remember_per_title"
+    private const val KEY_TITLES = "titles"
+    private const val MAX_TITLES = 200
+    private const val LOW_RESOLUTION_HEIGHT = 720
+    private const val LOW_BITRATE = 2_000_000
+
+    private val lock = Any()
+    @Volatile private var preferences: SharedPreferences? = null
+
+    private val _audio = MutableStateFlow(AudioFxState())
+    val audio: StateFlow<AudioFxState> = _audio.asStateFlow()
+
+    private val _picture = MutableStateFlow(PictureState())
+    val picture: StateFlow<PictureState> = _picture.asStateFlow()
+
+    private val _smartEnhance = MutableStateFlow(false)
+    val smartEnhance: StateFlow<Boolean> = _smartEnhance.asStateFlow()
+
+    private val _bannerTick = MutableStateFlow(0)
+    val bannerTick: StateFlow<Int> = _bannerTick.asStateFlow()
+
+    private val _autoEnhance = MutableStateFlow(false)
+    val autoEnhance: StateFlow<Boolean> = _autoEnhance.asStateFlow()
+
+    private val _rememberPerTitle = MutableStateFlow(true)
+    val rememberPerTitle: StateFlow<Boolean> = _rememberPerTitle.asStateFlow()
+
+    /** Read by the stream auto-play code, which runs before any player screen exists. */
+    @Volatile
+    var preferBestQuality: Boolean = false
+        private set
+
+    private var currentTitle: String? = null
+    private var enhanceUserSet = false
+    private var titles: LinkedHashMap<String, String>? = null
+
+    fun ensureLoaded(context: Context) {
+        if (preferences != null) return
+        synchronized(lock) {
+            if (preferences != null) return
+            val prefs = context.applicationContext.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)
+            preferences = prefs
+            loadGlobal(prefs)
+        }
+    }
+
+    private fun loadGlobal(prefs: SharedPreferences) {
+        _audio.value = AudioFxState.decode(prefs.getString(KEY_AUDIO, null))
+        _picture.value = PictureState.decode(prefs.getString(KEY_PICTURE, null))
+        _smartEnhance.value = prefs.getBoolean(KEY_SMART, false)
+        _autoEnhance.value = prefs.getBoolean(KEY_AUTO, false)
+        preferBestQuality = prefs.getBoolean(KEY_BEST, false)
+        _rememberPerTitle.value = prefs.getBoolean(KEY_REMEMBER, true)
+    }
+
+    private fun saveGlobal() {
+        preferences?.edit()
+            ?.putString(KEY_AUDIO, _audio.value.encode())
+            ?.putString(KEY_PICTURE, _picture.value.encode())
+            ?.putBoolean(KEY_SMART, _smartEnhance.value)
+            ?.putBoolean(KEY_AUTO, _autoEnhance.value)
+            ?.putBoolean(KEY_BEST, preferBestQuality)
+            ?.putBoolean(KEY_REMEMBER, _rememberPerTitle.value)
+            ?.apply()
+    }
+
+    fun setPicture(next: PictureState) {
+        _picture.value = next
+        saveGlobal()
+        rememberTitle()
+    }
+
+    fun setAudio(next: AudioFxState) {
+        _audio.value = next
+        saveGlobal()
+        rememberTitle()
+    }
+
+    fun toggleSmartEnhance() {
+        val next = !_smartEnhance.value
+        _smartEnhance.value = next
+        if (next) _bannerTick.value = _bannerTick.value + 1
+        enhanceUserSet = true
+        saveGlobal()
+        rememberTitle()
+    }
+
+    fun setAutoEnhance(enabled: Boolean) {
+        _autoEnhance.value = enabled
+        saveGlobal()
+    }
+
+    fun setPreferBestQuality(enabled: Boolean) {
+        preferBestQuality = enabled
+        saveGlobal()
+    }
+
+    fun setRememberPerTitle(enabled: Boolean) {
+        _rememberPerTitle.value = enabled
+        saveGlobal()
+        if (enabled) rememberTitle()
+    }
+
+    /** Called when a title starts playing: restores what was last used on it, else the last global choice. */
+    fun enterTitle(key: String?) {
+        val prefs = preferences ?: return
+        currentTitle = key?.takeIf { it.isNotBlank() }
+        enhanceUserSet = false
+        loadGlobal(prefs)
+        val entry = currentTitle?.takeIf { _rememberPerTitle.value }?.let { titleEntries()[it] } ?: return
+        val parts = entry.split("\t")
+        _picture.value = PictureState.decode(parts.getOrNull(0))
+        _audio.value = AudioFxState.decode(parts.getOrNull(1))
+        _smartEnhance.value = parts.getOrNull(2) == "1"
+    }
+
+    /** Switches Smart Enhance on for sources that look soft: under 720p, or under about 2 Mbps. */
+    fun maybeAutoEnhance(heightPx: Int?, bitrate: Int?) {
+        if (!_autoEnhance.value || enhanceUserSet || _smartEnhance.value) return
+        val lowResolution = heightPx != null && heightPx in 1 until LOW_RESOLUTION_HEIGHT
+        val lowBitrate = bitrate != null && bitrate in 1 until LOW_BITRATE
+        if (lowResolution || lowBitrate) {
+            _smartEnhance.value = true
+            _bannerTick.value = _bannerTick.value + 1
+        }
+    }
+
+    private fun titleEntries(): LinkedHashMap<String, String> {
+        titles?.let { return it }
+        val map = LinkedHashMap<String, String>()
+        preferences?.getString(KEY_TITLES, null)?.lineSequence()?.forEach { line ->
+            val at = line.indexOf('\t')
+            if (at > 0) map[line.substring(0, at)] = line.substring(at + 1)
+        }
+        titles = map
+        return map
+    }
+
+    private fun rememberTitle() {
+        val key = currentTitle ?: return
+        if (!_rememberPerTitle.value) return
+        val map = titleEntries()
+        map.remove(key)
+        map[key] = listOf(
+            _picture.value.encode(),
+            _audio.value.encode(),
+            if (_smartEnhance.value) "1" else "0",
+        ).joinToString("\t")
+        while (map.size > MAX_TITLES) map.remove(map.keys.first())
+        preferences?.edit()
+            ?.putString(KEY_TITLES, map.entries.joinToString("\n") { "${it.key}\t${it.value}" })
+            ?.apply()
+    }
+}
