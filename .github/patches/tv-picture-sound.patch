+++ b/app/src/main/java/com/nuvio/tv/ui/screens/settings/PlaybackPictureSoundSettings.kt
@@ -0,0 +1,127 @@
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.tv.ui.screens.player.AudioPreset
+import com.nuvio.tv.ui.screens.player.EqPreset
+import com.nuvio.tv.ui.screens.player.PicturePreset
+import com.nuvio.tv.ui.screens.player.PlayerEffects
+
+private val StepNames = listOf("Off", "Low", "Medium", "High")
+
+private fun <T> List<T>.after(current: T): T = this[(indexOf(current) + 1).mod(size)]
+
+/**
+ * Nuvio fork: Picture & Sound defaults for the player. The same choices are in the audio overlay while a video
+ * plays; here they are set up front, together with the per-title memory and auto-enhance rules.
+ */
+@Composable
+internal fun PlaybackPictureSoundSection() {
+    PlayerEffects.ensureLoaded(LocalContext.current)
+    val picture by PlayerEffects.picture.collectAsStateWithLifecycle()
+    val audio by PlayerEffects.audio.collectAsStateWithLifecycle()
+    val smartEnhance by PlayerEffects.smartEnhance.collectAsStateWithLifecycle()
+    val autoEnhance by PlayerEffects.autoEnhance.collectAsStateWithLifecycle()
+    val rememberTitle by PlayerEffects.rememberPerTitle.collectAsStateWithLifecycle()
+    var preferBest by remember { mutableStateOf(PlayerEffects.preferBestQuality) }
+
+    SettingsSectionLabel(text = "Picture")
+    SettingsToggleRow(
+        title = "Smart Enhance",
+        subtitle = "A contrast and colour lift for a more immersive picture.",
+        checked = smartEnhance,
+        onToggle = { PlayerEffects.toggleSmartEnhance() },
+    )
+    SettingsToggleRow(
+        title = "Auto Smart Enhance",
+        subtitle = "Turns Smart Enhance on for sources under 720p or under 2 Mbps.",
+        checked = autoEnhance,
+        onToggle = { PlayerEffects.setAutoEnhance(!autoEnhance) },
+    )
+    val presets = PicturePreset.values().filter { it != PicturePreset.CUSTOM }
+    SettingsActionRow(
+        title = "Picture preset",
+        subtitle = "Brightness, contrast and colour. Press to change.",
+        value = picture.preset.label,
+        onClick = { PlayerEffects.setPicture(picture.withPreset(presets.after(picture.preset.takeIf { it in presets } ?: presets.first()))) },
+    )
+    SettingsActionRow(
+        title = "Sharpen",
+        subtitle = "Crisper edges on soft video. ExoPlayer and libmpv.",
+        value = StepNames[picture.sharpen.coerceIn(0, 3)],
+        onClick = { PlayerEffects.setPicture(picture.copy(preset = PicturePreset.CUSTOM, sharpen = (picture.sharpen + 1) % 4)) },
+    )
+    SettingsActionRow(
+        title = "Denoise",
+        subtitle = "Smooths compression noise on low bitrate streams. ExoPlayer only.",
+        value = StepNames[picture.denoise.coerceIn(0, 3)],
+        onClick = { PlayerEffects.setPicture(picture.copy(preset = PicturePreset.CUSTOM, denoise = (picture.denoise + 1) % 4)) },
+    )
+    SettingsToggleRow(
+        title = "Remove banding",
+        subtitle = "Smooths colour steps in skies and dark scenes.",
+        checked = picture.deband,
+        onToggle = { PlayerEffects.setPicture(picture.copy(preset = PicturePreset.CUSTOM, deband = !picture.deband)) },
+    )
+    val tones = com.nuvio.tv.ui.screens.player.ToneMapping.values().toList()
+    SettingsActionRow(
+        title = "HDR tone mapping",
+        subtitle = "How HDR video is squeezed onto a standard screen. libmpv engine only.",
+        value = picture.toneMapping.label,
+        onClick = { PlayerEffects.setPicture(picture.copy(toneMapping = tones.after(picture.toneMapping))) },
+    )
+    SettingsToggleRow(
+        title = "Smooth motion",
+        subtitle = "Frame interpolation. Can look like a soap opera. libmpv engine only.",
+        checked = picture.interpolation,
+        onToggle = { PlayerEffects.setPicture(picture.copy(interpolation = !picture.interpolation)) },
+    )
+
+    SettingsSectionLabel(text = "Sound")
+    val sounds = AudioPreset.values().toList()
+    SettingsActionRow(
+        title = "Sound mode",
+        subtitle = "Dialogue lifts voices and levels loud scenes so speech stays clear.",
+        value = audio.preset.label,
+        onClick = { PlayerEffects.setAudio(audio.copy(preset = sounds.after(audio.preset))) },
+    )
+    SettingsToggleRow(
+        title = "Equalizer",
+        subtitle = "Five bands, 60 Hz to 14 kHz.",
+        checked = audio.eqEnabled,
+        onToggle = { PlayerEffects.setAudio(audio.copy(eqEnabled = !audio.eqEnabled)) },
+    )
+    val eqPresets = EqPreset.values().filter { it != EqPreset.CUSTOM }
+    SettingsActionRow(
+        title = "Equalizer preset",
+        subtitle = "Starting curve for the equalizer. Press to change.",
+        value = audio.eqPreset.label,
+        onClick = {
+            PlayerEffects.setAudio(
+                audio.copy(eqPreset = eqPresets.after(audio.eqPreset.takeIf { it in eqPresets } ?: eqPresets.first())),
+            )
+        },
+    )
+
+    SettingsSectionLabel(text = "Behaviour")
+    SettingsToggleRow(
+        title = "Remember per title",
+        subtitle = "Keeps the picture and sound choices for each title you watch.",
+        checked = rememberTitle,
+        onToggle = { PlayerEffects.setRememberPerTitle(!rememberTitle) },
+    )
+    SettingsToggleRow(
+        title = "Prefer best picture",
+        subtitle = "Auto-play picks the highest resolution and best codec first.",
+        checked = preferBest,
+        onToggle = {
+            preferBest = !preferBest
+            PlayerEffects.setPreferBestQuality(preferBest)
+        },
+    )
+}
