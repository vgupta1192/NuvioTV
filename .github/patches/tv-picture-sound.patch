+/** Centre frequencies of the five equaliser bands, the same layout Android's own equaliser uses. */
+internal val EQ_BAND_FREQUENCIES_HZ = listOf(60, 230, 910, 3600, 14000)
+private val FLAT_BANDS = listOf(0f, 0f, 0f, 0f, 0f)
+
+/** Fork: one-tap sound modes from the audio effect panel. Dialogue lifts the speech range and levels loud scenes. */
+enum class AudioPreset(val id: String, val label: String, val curve: List<Float>) {
+    ORIGINAL("original", "Original", FLAT_BANDS),
+    CLARITY("clarity", "Clarity", listOf(-2f, -1f, 2f, 3f, 1f)),
+    BASS_BOOST("bass", "Bass Boost", listOf(6f, 4f, 0f, 0f, 0f)),
+    TREBLE_BOOST("treble", "Treble Boost", listOf(0f, 0f, 0f, 3f, 6f)),
+    MOVIE("movie", "Movie", listOf(3f, 1f, 0f, 2f, 3f)),
+    MUSIC("music", "Music", listOf(3f, 1f, -1f, 2f, 3f)),
+    DIALOGUE("dialogue", "Dialogue", listOf(-6f, -3f, 3f, 5f, 0f));
+
+    companion object {
+        fun fromId(id: String?): AudioPreset = values().firstOrNull { it.id == id } ?: ORIGINAL
+    }
+}
+
+/** Equaliser curves in dB for the five bands. [CUSTOM] has no curve of its own: the sliders hold it. */
+enum class EqPreset(val id: String, val label: String, val bands: List<Float>?) {
+    CUSTOM("custom", "Custom", null),
+    NORMAL("normal", "Normal", listOf(3f, 0f, 0f, 0f, 3f)),
+    CLASSICAL("classical", "Classical", listOf(5f, 3f, -2f, 4f, 4f)),
+    DANCE("dance", "Dance", listOf(6f, 0f, 2f, 4f, 1f)),
+    FLAT("flat", "Flat", FLAT_BANDS),
+    FOLK("folk", "Folk", listOf(3f, 0f, 0f, 2f, -1f)),
+    HEAVY_METAL("metal", "Heavy metal", listOf(4f, 1f, 9f, 3f, 0f)),
+    HIP_HOP("hiphop", "Hip hop", listOf(5f, 3f, 0f, 1f, 3f)),
+    JAZZ("jazz", "Jazz", listOf(4f, 2f, -2f, 2f, 5f)),
+    POP("pop", "Pop", listOf(-1f, 2f, 5f, 1f, -2f)),
+    ROCK("rock", "Rock", listOf(5f, 3f, -1f, 3f, 5f));
+
+    companion object {
+        fun fromId(id: String?): EqPreset = values().firstOrNull { it.id == id } ?: NORMAL
+    }
+}
+
+data class AudioFxState(
+    val preset: AudioPreset = AudioPreset.ORIGINAL,
+    val eqEnabled: Boolean = false,
+    val eqPreset: EqPreset = EqPreset.NORMAL,
+    val customBands: List<Float> = FLAT_BANDS,
+) {
+    val eqBands: List<Float> get() = eqPreset.bands ?: customBands
+    val isActive: Boolean get() = preset != AudioPreset.ORIGINAL || eqEnabled
+
+    /** Band gains in dB: the sound mode's curve plus the equaliser sliders when the equaliser is on. */
+    fun effectiveBandsDb(): List<Float> {
+        val eq = if (eqEnabled) eqBands else FLAT_BANDS
+        return List(EQ_BAND_FREQUENCIES_HZ.size) { (preset.curve[it] + eq.getOrElse(it) { 0f }).coerceIn(-12f, 12f) }
+    }
+
+    /** 0 to 1000, the scale of Android's BassBoost effect. */
+    val bassBoostStrength: Int get() = if (preset == AudioPreset.BASS_BOOST) 700 else 0
+
+    /** 0 to 1000, the scale of Android's Virtualizer effect. */
+    val virtualizerStrength: Int get() = if (preset == AudioPreset.MOVIE) 500 else 0
+
+    /** mpv audio filter chain: one equaliser per band, plus a compressor that keeps speech above loud effects. */
+    fun mpvFilterChain(): String {
+        if (!isActive) return ""
+        val bands = effectiveBandsDb()
+        val parts = ArrayList<String>()
+        EQ_BAND_FREQUENCIES_HZ.forEachIndexed { index, hz ->
+            val gain = bands[index]
+            if (abs(gain) >= 0.1f) {
+                parts += "equalizer=f=$hz:t=o:w=1:g=${round(gain * 10f) / 10f}"
+            }
+        }
+        if (preset == AudioPreset.DIALOGUE) {
+            parts += "acompressor=threshold=0.12:ratio=3:attack=10:release=250:makeup=2"
+        }
+        return if (parts.isEmpty()) "" else "lavfi=[${parts.joinToString(",")}]"
+    }
+
+    fun encode(): String =
+        listOf(preset.id, if (eqEnabled) "1" else "0", eqPreset.id, customBands.joinToString(",")).joinToString("|")
+
+    companion object {
+        fun decode(value: String?): AudioFxState {
+            val parts = value?.split("|") ?: return AudioFxState()
+            if (parts.size < 4) return AudioFxState()
+            val bands = parts[3].split(",").mapNotNull { it.toFloatOrNull() }
+            return AudioFxState(
+                preset = AudioPreset.fromId(parts[0]),
+                eqEnabled = parts[1] == "1",
+                eqPreset = EqPreset.fromId(parts[2]),
+                customBands = if (bands.size == EQ_BAND_FREQUENCIES_HZ.size) bands else FLAT_BANDS,
+            )
+        }
+    }
+}
+
+enum class PicturePreset(val id: String, val label: String) {
+    ORIGINAL("original", "Original"),
+    VIVID("vivid", "Vivid"),
+    CINEMA("cinema", "Cinema"),
+    CLEAN("clean", "Clean"),
+    ANIME("anime", "Anime"),
+    CUSTOM("custom", "Custom");
+
+    companion object {
+        fun fromId(id: String?): PicturePreset = values().firstOrNull { it.id == id } ?: ORIGINAL
+    }
+}
+
+/** HDR to SDR tone mapping curves (libmpv only). A null [mpv] leaves the engine's own choice. */
+enum class ToneMapping(val id: String, val label: String, val mpv: String?) {
+    AUTO("auto", "Auto", null),
+    BT2390("bt2390", "BT.2390", "bt.2390"),
+    HABLE("hable", "Hable", "hable"),
+    MOBIUS("mobius", "Mobius", "mobius"),
+    REINHARD("reinhard", "Reinhard", "reinhard");
+
+    companion object {
+        fun fromId(id: String?): ToneMapping = values().firstOrNull { it.id == id } ?: AUTO
+    }
+}
+
+/**
+ * Picture controls. Sliders are in percent steps; [sharpen] and [denoise] run 0 (off) to 3 (high).
+ * [smartEnhance] is filled in when the state is handed to the engine, from the Smart Enhance button.
+ */
+data class PictureState(
+    val preset: PicturePreset = PicturePreset.ORIGINAL,
+    val brightness: Int = 0,
+    val contrast: Int = 0,
+    val saturation: Int = 0,
+    val gamma: Int = 0,
+    val sharpen: Int = 0,
+    val denoise: Int = 0,
+    val deband: Boolean = false,
+    val toneMapping: ToneMapping = ToneMapping.AUTO,
+    val interpolation: Boolean = false,
+    val matchRefreshRate: Boolean = true,
+    val smartEnhance: Boolean = false,
+) {
+    /** True when the frame needs the custom sharpen, denoise, deband or gamma shader (ExoPlayer). */
+    val usesShader: Boolean get() = sharpen > 0 || denoise > 0 || deband || gamma != 0
+
+    fun withPreset(next: PicturePreset): PictureState = when (next) {
+        PicturePreset.ORIGINAL -> copy(preset = next, brightness = 0, contrast = 0, saturation = 0, gamma = 0, sharpen = 0, denoise = 0, deband = false)
+        PicturePreset.VIVID -> copy(preset = next, brightness = 0, contrast = 10, saturation = 22, gamma = 0, sharpen = 1, denoise = 0, deband = false)
+        PicturePreset.CINEMA -> copy(preset = next, brightness = -3, contrast = 8, saturation = 4, gamma = 0, sharpen = 0, denoise = 0, deband = false)
+        PicturePreset.CLEAN -> copy(preset = next, brightness = 0, contrast = 4, saturation = 6, gamma = 0, sharpen = 1, denoise = 2, deband = true)
+        PicturePreset.ANIME -> copy(preset = next, brightness = 0, contrast = 6, saturation = 14, gamma = 0, sharpen = 2, denoise = 0, deband = true)
+        PicturePreset.CUSTOM -> copy(preset = next)
+    }
+
+    fun encode(): String = listOf(
+        preset.id, brightness, contrast, saturation, gamma, sharpen, denoise,
+        if (deband) 1 else 0, toneMapping.id, if (interpolation) 1 else 0, if (matchRefreshRate) 1 else 0,
+    ).joinToString("|")
+
+    companion object {
+        fun decode(value: String?): PictureState {
+            val p = value?.split("|") ?: return PictureState()
+            if (p.size < 11) return PictureState()
+            return PictureState(
+                preset = PicturePreset.fromId(p[0]),
+                brightness = p[1].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                contrast = p[2].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                saturation = p[3].toIntOrNull()?.coerceIn(-50, 50) ?: 0,
+                gamma = p[4].toIntOrNull()?.coerceIn(-30, 30) ?: 0,
+                sharpen = p[5].toIntOrNull()?.coerceIn(0, 3) ?: 0,
+                denoise = p[6].toIntOrNull()?.coerceIn(0, 3) ?: 0,
+                deband = p[7] == "1",
+                toneMapping = ToneMapping.fromId(p[8]),
+                interpolation = p[9] == "1",
+                matchRefreshRate = p[10] != "0",
+            )
+        }
+    }
+}
+
+
+/** Fork: why a stream label scores higher; a rough picture-quality ranking used to bias auto-play. */
+private val QUALITY_UHD = Regex("(2160p|\\b4k\\b|\\buhd\\b)", RegexOption.IGNORE_CASE)
+private val QUALITY_QHD = Regex("1440p", RegexOption.IGNORE_CASE)
+private val QUALITY_FHD = Regex("1080p", RegexOption.IGNORE_CASE)
+private val QUALITY_HD = Regex("720p", RegexOption.IGNORE_CASE)
+private val QUALITY_SD = Regex("(576p|480p)", RegexOption.IGNORE_CASE)
+private val QUALITY_HDR = Regex("(hdr10|\\bhdr\\b|\\bdv\\b|dolby.?vision)", RegexOption.IGNORE_CASE)
+private val QUALITY_EFFICIENT_CODEC = Regex("(x265|hevc|h\\.?265)", RegexOption.IGNORE_CASE)
+private val QUALITY_AV1 = Regex("\\bav1\\b", RegexOption.IGNORE_CASE)
+private val QUALITY_SOURCE = Regex("(remux|blu-?ray|web-?dl)", RegexOption.IGNORE_CASE)
+private val QUALITY_POOR = Regex("(\\bcam\\b|hdcam|telesync|\\bts\\b|telecine|\\bscr\\b)", RegexOption.IGNORE_CASE)
+
+internal fun streamPictureQualityScore(text: String): Int {
+    var score = when {
+        QUALITY_UHD.containsMatchIn(text) -> 40
+        QUALITY_QHD.containsMatchIn(text) -> 34
+        QUALITY_FHD.containsMatchIn(text) -> 30
+        QUALITY_HD.containsMatchIn(text) -> 20
+        QUALITY_SD.containsMatchIn(text) -> 10
+        else -> 0
+    }
+    if (QUALITY_HDR.containsMatchIn(text)) score += 3
+    if (QUALITY_EFFICIENT_CODEC.containsMatchIn(text)) score += 4
+    if (QUALITY_AV1.containsMatchIn(text)) score += 5
+    if (QUALITY_SOURCE.containsMatchIn(text)) score += 3
+    if (QUALITY_POOR.containsMatchIn(text)) score -= 50
+    return score
+}
