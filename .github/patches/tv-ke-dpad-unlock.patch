+     * makes shorter sequences fail by construction rather than by hash luck. No server call, so
+     * unlike [verifyProfilePin] there is no in-progress gate.
+     */
+    fun verifyDpadCombo(sequence: List<DpadDirection>, onComplete: (DpadComboVerifyResult) -> Unit) {
+        viewModelScope.launch {
+            val lockedSeconds = dpadComboLockout.remainingSeconds()
+            if (lockedSeconds > 0) {
+                onComplete(DpadComboVerifyResult.LockedOut(lockedSeconds))
+                return@launch
+            }
