+package com.nuvio.tv.ui.screens.profile
+
+import androidx.activity.compose.BackHandler
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.focusable
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.widthIn
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.input.key.Key
+import androidx.compose.ui.input.key.KeyEventType
+import androidx.compose.ui.input.key.key
+import androidx.compose.ui.input.key.onPreviewKeyEvent
+import androidx.compose.ui.input.key.type
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.core.profile.DpadDirection
+import com.nuvio.tv.ui.components.DpadCaptureOutcome
+import com.nuvio.tv.ui.components.DpadSlots
+import com.nuvio.tv.ui.components.rememberDpadFailShake
+import com.nuvio.tv.ui.theme.NuvioTheme
+import kotlinx.coroutines.delay
+
+// Interaction holds ported from the Nuvio-KE setup screen: a mismatch resets to a cleared
+// create step after the fail state lands; a save auto-closes after the slots turn green.
+private const val DPAD_SETUP_MISMATCH_RESET_MS = 1100L
+private const val DPAD_SETUP_SAVED_AUTO_CLOSE_MS = 1400L
+
+/**
+ * Full-screen D-pad combination setup (ported from Nuvio-KE's DpadComboSetupScreen capture flow,
+ * restyled to this tree's profile PIN overlay idiom). Stages: create (6-12 arrow presses, OK
+ * submits; auto-submit at the max) -> confirm (exactly the created length; a mismatch resets to a
+ * cleared create step) -> saved (auto-closes). Every press produces identical visual feedback;
+ * nothing on screen encodes the direction, so the combination cannot be read off the screen.
+ *
+ * Persistence is device-local: [onSaved] receives the confirmed sequence once, and the caller
+ * stores only its salted SHA-256 via [com.nuvio.tv.data.local.ProfileLockStateDataStore.setDpadCombo].
+ */
+@Composable
+internal fun DpadSetupOverlay(
+    onSaved: (List<DpadDirection>) -> Unit,
+    onDismiss: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val flow = remember { DpadSetupFlow() }
+    var outcome by remember { mutableStateOf(DpadCaptureOutcome.Idle) }
+    var saved by remember { mutableStateOf(false) }
+    // Entered-count snapshot for the fail state: submit() resets the flow synchronously, but the
+    // slots stay filled and red through the shake and only clear at the mismatch boundary.
+    var failSlotCount by remember { mutableIntStateOf(0) }
+    val focusRequester = remember { FocusRequester() }
+    val shakeX = rememberDpadFailShake(outcome)
+
+    fun submitNow() {
+        val countAtSubmit = flow.entered.size
+        when (flow.submit()) {
+            DpadSetupOutcome.AdvancedToConfirm -> Unit
+            DpadSetupOutcome.Saved -> {
+                outcome = DpadCaptureOutcome.Success
+                saved = true
+                onSaved(flow.draft)
+            }
+            DpadSetupOutcome.Mismatch -> {
+                failSlotCount = countAtSubmit
+                outcome = DpadCaptureOutcome.Fail
+            }
+            DpadSetupOutcome.NotReady -> Unit
+        }
+    }
+
+    fun press(direction: DpadDirection) {
+        if (saved || outcome == DpadCaptureOutcome.Fail) return
+        flow.press(direction)
+        val autoSubmit = flow.isCaptureFull ||
+            (flow.step == DpadSetupStep.Confirm && flow.confirmLength == flow.entered.size)
+        if (autoSubmit) submitNow()
+    }
+
+    fun confirmOk() {
+        if (outcome == DpadCaptureOutcome.Fail || saved) return
+        if (flow.canSubmit) submitNow()
+    }
+
+    // A mismatch resets to a cleared create step after the fail state lands.
+    LaunchedEffect(outcome) {
+        if (outcome == DpadCaptureOutcome.Fail) {
+            delay(DPAD_SETUP_MISMATCH_RESET_MS)
+            outcome = DpadCaptureOutcome.Idle
+        }
+    }
+
+    // Auto-close shortly after the slots turn green.
+    LaunchedEffect(saved) {
+        if (saved) {
+            delay(DPAD_SETUP_SAVED_AUTO_CLOSE_MS)
+            onDismiss()
+        }
+    }
+
+    LaunchedEffect(Unit) {
+        // Frame-anchored focus, the ProfilePinOverlay pattern (delay guesses drift).
+        repeat(2) { withFrameNanos { } }
+        runCatching { focusRequester.requestFocus() }
+    }
+
+    BackHandler(onBack = onDismiss)
+
+    val failed = outcome == DpadCaptureOutcome.Fail
+    Box(
+        modifier = modifier
+            .fillMaxSize()
+            // Full-screen scrim: the setup overlay floats over the profile picker, so it must
+            // cover the cards behind it (visually and for pointer input) while it holds focus.
+            .background(Color.Black.copy(alpha = 0.9f))
+            .focusRequester(focusRequester)
+            .focusable()
+            .onPreviewKeyEvent { keyEvent ->
+                if (keyEvent.type != KeyEventType.KeyDown) return@onPreviewKeyEvent false
+                // One physical press = one combination press: a held button's
+                // auto-repeat must not fill the capture (setup-flow filter).
+                if (keyEvent.nativeKeyEvent.repeatCount > 0) return@onPreviewKeyEvent true
+                val direction = when (keyEvent.key) {
+                    Key.DirectionUp -> DpadDirection.UP
+                    Key.DirectionDown -> DpadDirection.DOWN
+                    Key.DirectionLeft -> DpadDirection.LEFT
+                    Key.DirectionRight -> DpadDirection.RIGHT
+                    else -> null
+                }
+                when {
+                    direction != null -> {
+                        press(direction)
+                        true
+                    }
+                    keyEvent.key == Key.DirectionCenter || keyEvent.key == Key.Enter || keyEvent.key == Key.NumPadEnter -> {
+                        confirmOk()
+                        true
+                    }
+                    else -> false
+                }
+            }
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = NuvioTheme.spacing.huge),
+            verticalArrangement = Arrangement.Center,
+            horizontalAlignment = Alignment.CenterHorizontally
+        ) {
+            Text(
+                text = stringResource(
+                    if (saved || flow.step == DpadSetupStep.Confirm) {
+                        R.string.dpad_setup_confirm_title
+                    } else {
+                        R.string.dpad_setup_create_title
+                    }
+                ),
+                color = NuvioTheme.colors.TextPrimary,
+                fontSize = 42.sp,
+                lineHeight = 48.sp,
+                fontWeight = FontWeight.Bold,
+                textAlign = TextAlign.Center
+            )
+            Spacer(modifier = Modifier.height(42.dp))
+            DpadSlots(
+                filledCount = if (failed) failSlotCount else flow.entered.size,
+                slotCount = if (failed) failSlotCount else flow.slotCount,
+                outcome = outcome,
+                modifier = Modifier.graphicsLayer { translationX = shakeX.value }
+            )
+            Spacer(modifier = Modifier.height(26.dp))
+            Text(
+                text = when {
+                    saved -> stringResource(R.string.dpad_setup_matched)
+                    failed -> stringResource(R.string.dpad_setup_no_match)
+                    flow.step == DpadSetupStep.Confirm -> stringResource(R.string.dpad_setup_confirm_support)
+                    else -> stringResource(R.string.dpad_setup_create_support)
+                },
+                modifier = Modifier.widthIn(max = 720.dp),
+                color = when {
+                    saved -> Color(0xFF4CAF50)
+                    failed -> Color(0xFFFF8E8E)
+                    else -> NuvioTheme.colors.TextSecondary
+                },
+                fontSize = 18.sp,
+                fontWeight = FontWeight.Medium,
+                textAlign = TextAlign.Center,
+                lineHeight = 24.sp
+            )
+            Spacer(modifier = Modifier.height(14.dp))
+            Text(
+                text = stringResource(R.string.dpad_setup_hint),
+                color = NuvioTheme.colors.TextTertiary,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium
+            )
+        }
+    }
+}
