+/**
+ * Nuvio-KE port (Spec 64 K3): when the app comes back on screen after the Ask-for-PIN-again time
+ * and the active profile has a PIN, [onRelock] sends it back to Who's watching, which asks for it.
+ * ON_STOP stamps the since-boot clock into saveable state (so a restored process is checked too),
+ * except while an external player is tracked (a film on screen never counts). ON_START decides
+ * synchronously from values collected beforehand ([relockDue]); unloaded or unreadable state fails
+ * closed (re-locks sooner). The relock window is device-local state
+ * ([com.nuvio.tv.data.local.ProfileLockStateDataStore.relockAfterMinutes], default
+ * [com.nuvio.tv.core.profile.PinRelock.DEFAULT_MINUTES]); there is no picker UI for it in this
+ * tree yet. Composed above the startup gates so a relock flips the session state before the main
+ * UI composes into the same frame.
+ */
+@Composable
+private fun RelockToPickerAfterTimeAway(
+    profileManager: ProfileManager,
+    profileLockStateDataStore: com.nuvio.tv.data.local.ProfileLockStateDataStore,
+    pinEnabled: Map<Int, Boolean>,
+    isExternalPlaybackTracking: () -> Boolean,
+    onRelock: () -> Unit
+) {
+    val minutesFlow = remember(profileLockStateDataStore) {
+        profileLockStateDataStore.relockAfterMinutes
+            .map<Int, Int?> { it }
+            .catch { if (it is java.io.IOException) emit(null) else throw it }
+    }
+    val relockMinutes = minutesFlow.collectAsState(initial = null)
+    val latestOnRelock by rememberUpdatedState(onRelock)
+    val latestPinEnabled by rememberUpdatedState(pinEnabled)
+    val lifecycleOwner = LocalLifecycleOwner.current
+    var stoppedAtMs by rememberSaveable { mutableStateOf<Long?>(null) }
+    DisposableEffect(lifecycleOwner, profileManager, profileLockStateDataStore) {
+        val observer = LifecycleEventObserver { _, event ->
+            when (event) {
+                Lifecycle.Event.ON_STOP ->
+                    stoppedAtMs = if (isExternalPlaybackTracking()) {
+                        null
+                    } else {
+                        android.os.SystemClock.elapsedRealtime()
+                    }
+                Lifecycle.Event.ON_START -> {
+                    val stoppedAt = stoppedAtMs
+                    stoppedAtMs = null
+                    val activeId = profileManager.activeProfileId.value
+                    if (relockDue(
+                            stoppedAt,
+                            android.os.SystemClock.elapsedRealtime(),
+                            relockMinutes.value,
+                            latestPinEnabled,
+                            activeId
+                        )
+                    ) {
+                        latestOnRelock()
+                    }
+                }
+                else -> Unit
+            }
+        }
+        lifecycleOwner.lifecycle.addObserver(observer)
+        onDispose { lifecycleOwner.lifecycle.removeObserver(observer) }
+    }
+}
