@@ -0,0 +1,76 @@
+package com.nuvio.tv.core.profile
+
+import android.os.SystemClock
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/** Verdict of one D-pad combination check as the unlock overlay acts on it. */
+sealed interface DpadComboVerifyResult {
+    data object Matched : DpadComboVerifyResult
+    data object Wrong : DpadComboVerifyResult
+
+    /** The device-local cooldown refused the check and runs for [seconds] more. */
+    data class LockedOut(val seconds: Int) : DpadComboVerifyResult
+}
+
+/**
+ * Device-local wrong-attempt lockout for the D-pad combination unlock, in the shape of Nuvio-KE's
+ * PinLockouts: an expiry on [SystemClock.elapsedRealtime] (wall-clock changes cannot shorten one)
+ * kept for the process so a countdown survives closing and reopening the unlock screen.
+ *
+ * KE's PinLockouts itself is not ported: it is coupled to the server verify result
+ * (`SupabaseProfilePinVerifyResult.retry_after_seconds`), and the PIN unlock in this tree already
+ * gets its lockouts from the server the same way. The combination has no server, so the trigger is
+ * local: [MAX_WRONG_ATTEMPTS] consecutive wrong entries arm a [COOLDOWN_SECONDS] countdown, cleared
+ * by a match. Process-memory only — a restart clears it — matching the combination's threat model
+ * (shoulder-surf and casual device access, not an attacker holding the file).
+ */
+@Singleton
+class DpadComboLockout @Inject constructor() {
+
+    private val _lockedUntil = MutableStateFlow<Long?>(null)
+
+    /** Cooldown expiry in elapsedRealtime ms, or null when not locked. */
+    val lockedUntil: StateFlow<Long?> = _lockedUntil.asStateFlow()
+
+    private var wrongAttempts = 0
+
+    /** A match clears the attempt count and any running cooldown. */
+    fun onMatch() {
+        wrongAttempts = 0
+        _lockedUntil.value = null
+    }
+
+    /**
+     * Records a wrong entry; returns whole seconds the capture is locked for (rounded up), 0 when
+     * still allowed. The cooldown starts at the attempt that reaches [MAX_WRONG_ATTEMPTS]; further
+     * wrong entries while locked do not extend it.
+     */
+    fun onWrongAttempt(nowMs: Long = SystemClock.elapsedRealtime()): Int {
+        val locked = remainingSeconds(nowMs)
+        if (locked > 0) return locked
+        wrongAttempts += 1
+        if (wrongAttempts < MAX_WRONG_ATTEMPTS) return 0
+        wrongAttempts = 0
+        _lockedUntil.value = nowMs + COOLDOWN_SECONDS * 1000L
+        return COOLDOWN_SECONDS.toInt()
+    }
+
+    /** Whole seconds left on the cooldown, rounded up; 0 when none. */
+    fun remainingSeconds(nowMs: Long = SystemClock.elapsedRealtime()): Int =
+        secondsLeft(_lockedUntil.value, nowMs)
+
+    companion object {
+        const val MAX_WRONG_ATTEMPTS = 5
+        const val COOLDOWN_SECONDS = 60L
+
+        /** Whole seconds from [nowMs] to an expiry [until] (a [lockedUntil] value), rounded up; 0 when none. */
+        fun secondsLeft(until: Long?, nowMs: Long): Int {
+            if (until == null || until <= nowMs) return 0
+            return ((until - nowMs + 999) / 1000).toInt()
+        }
+    }
+}
