+
+/** Outcome state of a D-pad capture surface (unlock overlay + setup flow). */
+internal enum class DpadCaptureOutcome { Idle, Success, Fail }
+
+/**
+ * The fail shake shared by the slot row (ported from Nuvio-KE): the slot row reads it in its
+ * graphicsLayer, so a wrong sequence shakes as one. ±13 decaying over ~400 ms.
+ */
+@Composable
+internal fun rememberDpadFailShake(outcome: DpadCaptureOutcome): Animatable<Float, *> {
+    val shakeX = remember { Animatable(0f) }
+    LaunchedEffect(outcome) {
+        if (outcome == DpadCaptureOutcome.Fail) {
+            listOf(-13f, 11f, -10f, 9f, -8f, 7f, -5f, 4f, -2f, 0f).forEach { target ->
+                shakeX.animateTo(target, tween(40))
+            }
+        } else {
+            shakeX.snapTo(0f)
+        }
+    }
+    return shakeX
+}
+
+/**
+ * The combination slots (ported from Nuvio-KE's DpadSlots, restyled to this tree's PIN-box idiom):
+ * [slotCount] PIN-style boxes, count-only (never a direction, so a shoulder-surfer cannot read the
+ * combination off the screen); [filledCount] carry a dot, the next one a white edge while [outcome]
+ * is Idle; all turn red on Fail and green on Success. Slots are smaller than the 4-digit PIN boxes
+ * because a combination runs 6-12 presses.
+ */
+@Composable
+internal fun DpadSlots(
+    filledCount: Int,
+    slotCount: Int,
+    outcome: DpadCaptureOutcome,
+    modifier: Modifier = Modifier
+) {
+    val shape = RoundedCornerShape(NuvioTheme.radii.xxs)
+    val success = outcome == DpadCaptureOutcome.Success
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(DpadSlotGap),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        repeat(slotCount) { index ->
+            val filled = index < filledCount
+            val next = outcome == DpadCaptureOutcome.Idle && index == filledCount
+            val look = when {
+                outcome == DpadCaptureOutcome.Fail ->
+                    SlotLook(DpadSlotErrorEdge, DpadSlotErrorFill, DpadSlotErrorDot)
+                success -> SlotLook(DpadSlotSuccessEdge, DpadSlotSuccessFill, DpadSlotSuccessEdge)
+                next -> SlotLook(Color.White, Color.White.copy(alpha = 0.04f), Color.White)
+                filled -> SlotLook(Color.White.copy(alpha = 0.92f), Color.White.copy(alpha = 0.07f), Color.White)
+                else -> SlotLook(Color.White.copy(alpha = 0.72f), Color.Transparent, Color.White)
+            }
+            // Success fades in so the row settles instead of snapping (the KE easing); every other
+            // state shows its target directly (the snap keeps the animation's start point current).
+            val colorFade = tween<Color>(DpadSlotSuccessFadeMs)
+            val edgeColor by animateColorAsState(look.edge, if (success) colorFade else snap(), label = "slotEdge")
+            val fillColor by animateColorAsState(look.fill, if (success) colorFade else snap(), label = "slotFill")
+            val dotColor by animateColorAsState(look.dot, if (success) colorFade else snap(), label = "slotDot")
+            Box(
+                modifier = Modifier
+                    .size(DpadSlotWidth, DpadSlotHeight)
+                    .clip(shape)
+                    .background(fillColor)
+                    .border(BorderStroke(NuvioTheme.spacing.hairline, edgeColor), shape),
+                contentAlignment = Alignment.Center
+            ) {
+                if (filled) {
+                    Box(
+                        modifier = Modifier
+                            .size(DpadSlotDot)
+                            .clip(CircleShape)
+                            .background(dotColor)
+                    )
+                }
+            }
+        }
+    }
+}
+
+/** One slot's colours: edge, fill, dot. */
+private data class SlotLook(val edge: Color, val fill: Color, val dot: Color)
+
+// Slot metrics and the error/success palette reuse the profile PIN overlay's colours
+// (ProfileSelectionScreen) at combination scale; success green is the tree's success token.
+private val DpadSlotWidth = 46.dp
+private val DpadSlotHeight = 58.dp
+private val DpadSlotGap = 10.dp
+private val DpadSlotDot = 12.dp
+private const val DpadSlotSuccessFadeMs = 320
+private val DpadSlotErrorEdge = Color(0xFFE35D5D)
+private val DpadSlotErrorFill = Color(0xFF311818).copy(alpha = 0.76f)
+private val DpadSlotErrorDot = Color(0xFFFF8E8E)
+private val DpadSlotSuccessEdge = Color(0xFF4CAF50)
+private val DpadSlotSuccessFill = Color(0xFF1B2E1C)
