+package com.nuvio.tv.ui.screens.profile
+
+import android.os.SystemClock
+import androidx.activity.compose.BackHandler
+import androidx.compose.foundation.focusable
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Box
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Spacer
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.height
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.widthIn
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableIntStateOf
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.runtime.withFrameNanos
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.graphicsLayer
+import androidx.compose.ui.input.key.Key
+import androidx.compose.ui.input.key.KeyEventType
+import androidx.compose.ui.input.key.key
+import androidx.compose.ui.input.key.onPreviewKeyEvent
+import androidx.compose.ui.input.key.type
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.text.style.TextAlign
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.core.profile.DpadComboLockout
+import com.nuvio.tv.core.profile.DpadDirection
+import com.nuvio.tv.domain.model.UserProfile
+import com.nuvio.tv.ui.components.DpadCaptureOutcome
+import com.nuvio.tv.ui.components.DpadSlots
+import com.nuvio.tv.ui.components.rememberDpadFailShake
+import com.nuvio.tv.ui.theme.NuvioTheme
+import kotlinx.coroutines.delay
+
+// Interaction holds ported from the Nuvio-KE unlock overlay: the fail hold mirrors the
+// setup flow (1100 ms); the success hold sits between the KE setup's auto-close (1400 ms)
+// and the KE unlock's own 1000 ms.
+private const val DPAD_FAIL_RESET_MS = 1100L
+private const val DPAD_SUCCESS_CLOSE_MS = 1000L
+private const val DPAD_LOCK_POLL_MS = 250L
+
+/**
+ * Pure capture state for the D-pad unlock overlay (ported from Nuvio-KE).
+ * Screen-agnostic so the capture rules stay unit-testable: presses stop at the
+ * stored combination length (so a sequence shorter than the stored one can never
+ * be submitted, and a longer one cannot exist), and every state change is visible
+ * to composition via snapshot state.
+ */
+internal class DpadUnlockCapture(
+    val comboLength: Int
+) {
+    var entered by mutableStateOf<List<DpadDirection>>(emptyList())
+        private set
+
+    var outcome by mutableStateOf(DpadCaptureOutcome.Idle)
+        private set
+
+    /** True once the stored length is reached — the auto-submit boundary. */
+    val isFull: Boolean
+        get() = entered.size >= comboLength
+
+    /** No-ops once the capture is full or an outcome is showing. */
+    fun press(direction: DpadDirection) {
+        if (outcome != DpadCaptureOutcome.Idle || isFull) return
+        entered = entered + direction
+    }
+
+    /** Verdicts are set by the verify path and only from Idle. */
+    fun markSuccess() {
+        if (outcome == DpadCaptureOutcome.Idle) outcome = DpadCaptureOutcome.Success
+    }
+
+    fun markFail() {
+        if (outcome == DpadCaptureOutcome.Idle) outcome = DpadCaptureOutcome.Fail
+    }
+
+    /** Clears the sequence and the outcome — the wrong-combo retry boundary. */
+    fun reset() {
+        entered = emptyList()
+        outcome = DpadCaptureOutcome.Idle
+    }
+}
+
+/**
+ * D-pad combination unlock (ported from Nuvio-KE): the profile PIN overlay's shell (heading,
+ * count-only [DpadSlots] — one per stored press, never the direction — support line and hints)
+ * replaces the digit entry while the device-local D-pad unlock is armed. Every D-pad direction is a
+ * combination press; OK / Enter is "Use PIN instead" (the hint at the bottom), run on the key-up of
+ * an OK pressed here so that release can never land on the PIN overlay and type a digit.
+ *
+ * Wrong entries are answered by [onComboEntered]'s verify path; [lockedUntilMs] (a
+ * [android.os.SystemClock.elapsedRealtime] expiry from the device-local lockout) freezes the
+ * capture and counts down on the support line.
+ */
+@Composable
+internal fun DpadUnlockOverlay(
+    profile: UserProfile,
+    capture: DpadUnlockCapture,
+    lockedUntilMs: Long?,
+    onDismiss: () -> Unit,
+    onUsePinInstead: () -> Unit,
+    onComboEntered: (List<DpadDirection>) -> Unit,
+    onUnlocked: () -> Unit,
+    modifier: Modifier = Modifier
+) {
+    val rootFocusRequester = remember { FocusRequester() }
+    val shakeX = rememberDpadFailShake(capture.outcome)
+    // Set by an OK key-down on this screen; its key-up switches to the PIN pad.
+    var okArmed by remember { mutableStateOf(false) }
+    // Whole seconds left on the device-local wrong-attempt cooldown; seeded so a locked
+    // overlay never shows a frame open, then polled like the KE setup gate's countdown.
+    var lockedSeconds by remember(lockedUntilMs) {
+        mutableIntStateOf(
+            DpadComboLockout.secondsLeft(
+                lockedUntilMs, SystemClock.elapsedRealtime()
+            )
+        )
+    }
+
+    LaunchedEffect(lockedUntilMs) {
+        while (lockedSeconds > 0) {
+            delay(DPAD_LOCK_POLL_MS)
+            lockedSeconds = DpadComboLockout.secondsLeft(
+                lockedUntilMs, SystemClock.elapsedRealtime()
+            )
+        }
+        capture.reset()
+    }
+
+    // A wrong combination keeps the slots filled and red through the shake, then resets;
+    // a success holds the green state before the unlock path runs.
+    LaunchedEffect(capture.outcome) {
+        when (capture.outcome) {
+            DpadCaptureOutcome.Fail -> {
+                delay(DPAD_FAIL_RESET_MS)
+                capture.reset()
+            }
+            DpadCaptureOutcome.Success -> {
+                delay(DPAD_SUCCESS_CLOSE_MS)
+                onUnlocked()
+            }
+            DpadCaptureOutcome.Idle -> Unit
+        }
+    }
+
+    LaunchedEffect(Unit) {
+        // Frame-anchored focus, the ProfilePinOverlay pattern (delay guesses drift).
+        repeat(2) { withFrameNanos { } }
+        runCatching { rootFocusRequester.requestFocus() }
+    }
+
+    BackHandler(onBack = onDismiss)
+
+    Box(
+        modifier = modifier
+            .fillMaxSize()
+            .focusRequester(rootFocusRequester)
+            .focusable()
+            .onPreviewKeyEvent { keyEvent ->
+                val action = dpadUnlockKeyAction(keyEvent.key)
+                if (keyEvent.type == KeyEventType.KeyUp) {
+                    // Use PIN instead runs on the release of an OK pressed here, so that release
+                    // can never land on the PIN overlay's focused key and type a digit.
+                    if (action == DpadUnlockKeyAction.UsePin && okArmed) {
+                        okArmed = false
+                        // Not during the success hold: leaving would cancel the unlock about to run.
+                        if (capture.outcome != DpadCaptureOutcome.Success) onUsePinInstead()
+                    }
+                    return@onPreviewKeyEvent action != null
+                }
+                if (keyEvent.type != KeyEventType.KeyDown) return@onPreviewKeyEvent false
+                // One physical press = one combination press: a held button's
+                // auto-repeat must not fill the capture (setup-flow filter).
+                if (keyEvent.nativeKeyEvent.repeatCount > 0) return@onPreviewKeyEvent true
+                when (action) {
+                    is DpadUnlockKeyAction.Press -> {
+                        if (lockedSeconds > 0) return@onPreviewKeyEvent true
+                        val wasFull = capture.isFull
+                        capture.press(action.direction)
+                        // Auto-submit exactly when this press reached the stored length.
+                        if (!wasFull && capture.isFull) onComboEntered(capture.entered)
+                        true
+                    }
+                    DpadUnlockKeyAction.UsePin -> {
+                        okArmed = true
+                        true
+                    }
+                    null -> false
+                }
+            }
+    ) {
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .padding(horizontal = NuvioTheme.spacing.huge),
+            verticalArrangement = Arrangement.Center,
+            horizontalAlignment = Alignment.CenterHorizontally
+        ) {
+            Text(
+                text = stringResource(R.string.dpad_unlock_title, profile.name),
+                color = NuvioTheme.colors.TextPrimary,
+                fontSize = 42.sp,
+                lineHeight = 48.sp,
+                fontWeight = FontWeight.Bold,
+                textAlign = TextAlign.Center
+            )
+            Spacer(modifier = Modifier.height(42.dp))
+            DpadSlots(
+                filledCount = capture.entered.size,
+                slotCount = capture.comboLength,
+                outcome = capture.outcome,
+                modifier = Modifier.graphicsLayer { translationX = shakeX.value }
+            )
+            Spacer(modifier = Modifier.height(26.dp))
+            Text(
+                text = when {
+                    lockedSeconds > 0 -> stringResource(R.string.dpad_unlock_locked, lockedSeconds)
+                    capture.outcome == DpadCaptureOutcome.Fail -> stringResource(R.string.dpad_unlock_wrong)
+                    capture.outcome == DpadCaptureOutcome.Success -> stringResource(R.string.dpad_unlock_unlocked)
+                    else -> stringResource(R.string.dpad_unlock_support)
+                },
+                modifier = Modifier.widthIn(max = 720.dp),
+                color = when {
+                    lockedSeconds > 0 || capture.outcome == DpadCaptureOutcome.Fail -> Color(0xFFFF8E8E)
+                    capture.outcome == DpadCaptureOutcome.Success -> Color(0xFF4CAF50)
+                    else -> NuvioTheme.colors.TextSecondary
+                },
+                fontSize = 18.sp,
+                fontWeight = FontWeight.Medium,
+                textAlign = TextAlign.Center,
+                lineHeight = 24.sp
+            )
+            Spacer(modifier = Modifier.height(14.dp))
+            Text(
+                text = stringResource(R.string.dpad_unlock_hint),
+                color = NuvioTheme.colors.TextTertiary,
+                fontSize = 14.sp,
+                fontWeight = FontWeight.Medium
+            )
+        }
+    }
+}
+
+/** What a key does on the unlock screen: an arrow is a combination press, OK / Enter switches to the PIN pad. */
+internal sealed interface DpadUnlockKeyAction {
+    data class Press(val direction: DpadDirection) : DpadUnlockKeyAction
+    data object UsePin : DpadUnlockKeyAction
+}
+
+/** Routes [key] on the unlock screen; null = not ours (Back goes to the BackHandler). */
+internal fun dpadUnlockKeyAction(key: Key): DpadUnlockKeyAction? = when (key) {
+    Key.DirectionUp -> DpadUnlockKeyAction.Press(DpadDirection.UP)
+    Key.DirectionDown -> DpadUnlockKeyAction.Press(DpadDirection.DOWN)
+    Key.DirectionLeft -> DpadUnlockKeyAction.Press(DpadDirection.LEFT)
+    Key.DirectionRight -> DpadUnlockKeyAction.Press(DpadDirection.RIGHT)
+    Key.DirectionCenter, Key.Enter, Key.NumPadEnter -> DpadUnlockKeyAction.UsePin
+    else -> null
+}
