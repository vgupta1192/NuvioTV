+     * 3D is a default exclusion, so misreading it dropped those streams from auto-play (KE B9).
+     */
+    private val THREE_D_TEXT_REGEX = Regex("(^|[^A-Za-z0-9])3D([^A-Za-z0-9]|$)")
+    private val THREE_D_LAYOUT_REGEX = Regex(
