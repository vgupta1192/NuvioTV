+package com.nuvio.tv.data.tracking
+
+import com.nuvio.tv.core.tracking.TrackingLibraryProvider
+import com.nuvio.tv.core.tracking.TrackingProviderId
+import com.nuvio.tv.data.publicmetadb.PublicMetaDbService
+import com.nuvio.tv.data.wetrakr.WeTrakrService
+import com.nuvio.tv.domain.model.LibraryEntry
+import com.nuvio.tv.domain.model.LibraryListTab
+import javax.inject.Inject
+import javax.inject.Singleton
+import kotlinx.coroutines.flow.map
+import org.json.JSONObject
+
+private const val TMDB_IMAGE = "https://image.tmdb.org/t/p/w500"
+
+private fun JSONObject.str(vararg keys: String): String? =
+    keys.firstNotNullOfOrNull { key -> optString(key, "").takeIf { it.isNotBlank() && it != "null" } }
+
+private fun JSONObject.long(vararg keys: String): Long? =
+    keys.firstNotNullOfOrNull { key -> if (has(key) && !isNull(key)) optLong(key, -1L).takeIf { it > 0L } else null }
+
+private fun tmdbPoster(path: String?): String? =
+    path?.takeIf { it.isNotBlank() }?.let { if (it.startsWith("http")) it else "$TMDB_IMAGE${if (it.startsWith("/")) it else "/$it"}" }
+
+private fun parseTimeMs(raw: String?): Long = raw?.let { runCatching { java.time.Instant.parse(it).toEpochMilli() }.getOrNull() } ?: 0L
+
+private fun entry(
+    id: String, type: String, name: String, year: Int?, poster: String?, background: String?,
+    genres: List<String>, imdb: String?, tmdb: Long?, listKey: String, listedAt: Long, providerId: TrackingProviderId
+) = LibraryEntry(
+    id = id,
+    type = type,
+    name = name,
+    poster = poster,
+    background = background,
+    logo = null,
+    description = null,
+    releaseInfo = year?.toString(),
+    imdbRating = null,
+    genres = genres,
+    addonBaseUrl = null,
+    listKeys = setOf(listKey),
+    listedAt = listedAt,
+    imdbId = imdb,
+    tmdbId = tmdb?.toInt(),
+    trackingProviderId = providerId.storageId,
+    trackingProviderItemId = id
+)
+
+private fun List<LibraryEntry>.mergeByTitle(): List<LibraryEntry> =
+    groupBy { "${it.type}:${it.id}" }.map { (_, group) ->
+        group.first().copy(listKeys = group.flatMapTo(linkedSetOf()) { it.listKeys }, listedAt = group.maxOf { it.listedAt })
+    }
+
+@Singleton
+class PublicMetaDbTrackingLibraryProvider @Inject constructor(
+    private val service: PublicMetaDbService
+) : TrackingLibraryProvider by ForkTvReadOnlyLibrary(
+    providerId = TrackingProviderId.PUBLICMETADB,
+    isAuthenticated = service.state.map { it.isConnected },
+    listKeyPrefix = "publicmetadb:",
+    load = {
+        val lists = service.getPaged("/api/external/lists")
+        if (lists == null) null else {
+            val tabs = mutableListOf<LibraryListTab>()
+            val items = mutableListOf<LibraryEntry>()
+            for (list in lists) {
+                val id = list.str("id") ?: continue
+                val key = "publicmetadb:list:$id"
+                val type = list.str("type")?.lowercase()
+                tabs += LibraryListTab(
+                    key = key,
+                    title = list.str("name", "title") ?: "Watchlist",
+                    type = if (type == "watchlist") LibraryListTab.Type.WATCHLIST else LibraryListTab.Type.PERSONAL,
+                    trackingProviderId = TrackingProviderId.PUBLICMETADB.storageId,
+                    isMembershipDestination = false
+                )
+                val rows = service.getPaged("/api/external/lists/${java.net.URLEncoder.encode(id, "UTF-8")}/items").orEmpty()
+                for (row in rows) {
+                    val media = row.optJSONObject("media")
+                    val rawType = (row.str("media_type", "mediaType") ?: media?.str("media_type", "type"))?.lowercase()
+                    val isMovie = rawType != "tv" && rawType != "series" && rawType != "show"
+                    val tmdb = row.long("tmdb_id", "tmdbId") ?: media?.long("tmdb_id", "tmdbId", "id") ?: row.long("id") ?: continue
+                    val name = row.str("title", "name") ?: media?.str("title", "name") ?: continue
+                    val year = row.optInt("year", 0).takeIf { it > 0 }
+                        ?: (row.str("release_date", "first_air_date") ?: media?.str("release_date", "first_air_date"))
+                            ?.take(4)?.toIntOrNull()
+                    items += entry(
+                        id = "tmdb:$tmdb", type = if (isMovie) "movie" else "series", name = name, year = year,
+                        poster = tmdbPoster(row.str("poster", "poster_path") ?: media?.str("poster", "poster_path")),
+                        background = null, genres = emptyList(), imdb = null, tmdb = tmdb, listKey = key,
+                        listedAt = parseTimeMs(row.str("added_at", "created", "created_at", "updated")),
+                        providerId = TrackingProviderId.PUBLICMETADB
+                    )
+                }
+            }
+            ForkTvLibrarySnapshot(tabs, items.mergeByTitle())
+        }
+    }
+)
+
+@Singleton
+class WeTrakrTrackingLibraryProvider @Inject constructor(
+    private val service: WeTrakrService
+) : TrackingLibraryProvider by ForkTvReadOnlyLibrary(
+    providerId = TrackingProviderId.WETRAKR,
+    isAuthenticated = service.state.map { it.isConnected },
+    listKeyPrefix = "wetrakr:",
+    load = {
+        val statuses = listOf(
+            "planning" to "Planning", "watching" to "Watching", "waiting" to "Waiting",
+            "watched" to "Watched", "paused" to "Paused", "dropped" to "Dropped"
+        )
+        val tabs = mutableListOf<LibraryListTab>()
+        val items = mutableListOf<LibraryEntry>()
+        var connected = true
+        for ((status, title) in statuses) {
+            val key = "wetrakr:status:$status"
+            var any = false
+            for ((kind, entryType, extended) in listOf(
+                Triple("movies", "movie", "movie_level_1"),
+                Triple("shows", "series", "show_level_1")
+            )) {
+                if (kind == "movies" && status !in setOf("planning", "watched", "dropped")) continue
+                val rows = service.getPaged("/sync/tracking/$status/$kind", "&extended=$extended")
+                if (rows == null) { connected = false; break }
+                for (row in rows) {
+                    val node = row.optJSONObject(if (kind == "movies") "movie" else "show") ?: row
+                    val ids = node.optJSONObject("ids")
+                    val imdb = ids?.str("imdb")?.takeIf { it.startsWith("tt") }
+                    val tmdb = ids?.long("tmdb")
+                    val id = imdb ?: tmdb?.let { "tmdb:$it" } ?: continue
+                    val name = node.str("title", "name", "original_title") ?: continue
+                    val year = node.optInt("year", 0).takeIf { it > 0 }
+                        ?: node.str("release_date", "first_air_date")?.take(4)?.toIntOrNull()
+                    any = true
+                    items += entry(
+                        id = id, type = entryType, name = name, year = year,
+                        poster = tmdbPoster(node.str("poster_path")), background = tmdbPoster(node.str("backdrop_path")),
+                        genres = emptyList(), imdb = imdb, tmdb = tmdb, listKey = key,
+                        listedAt = parseTimeMs(row.str("tracked_at", "added_at", "listed_at", "updated_at")),
+                        providerId = TrackingProviderId.WETRAKR
+                    )
+                }
+            }
+            if (!connected) break
+            if (any) tabs += LibraryListTab(
+                key = key, title = title, type = LibraryListTab.Type.STATUS,
+                trackingProviderId = TrackingProviderId.WETRAKR.storageId, isMembershipDestination = false
+            )
+        }
+        if (!connected) null else ForkTvLibrarySnapshot(tabs, items.mergeByTitle())
+    }
+)
