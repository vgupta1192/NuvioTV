+    /** Pages through a read-only list endpoint; null when not connected. */
+    suspend fun getPaged(path: String, extra: String = "", limit: Int = 100, maxPages: Int = 30): List<JSONObject>? {
+        val profileId = activeProfile
+        val results = mutableListOf<JSONObject>()
+        for (page in 1..maxPages) {
+            val query = "?page=$page&limit=$limit$extra"
+            var token = accessToken(profileId, forceRefresh = false) ?: return null
+            var response = send("GET", path + query, null, token)
+            if (response.status == 401) {
+                token = accessToken(profileId, forceRefresh = true) ?: return null
+                response = send("GET", path + query, null, token)
+            }
+            if (response.status == 404) break
+            if (response.status !in 200..299) throw IllegalStateException("WeTrakr $path failed (${response.status})")
+            val array = runCatching {
+                val trimmed = response.body.trim()
+                if (trimmed.startsWith("[")) JSONArray(trimmed)
+                else JSONObject(trimmed).let { root ->
+                    listOf("items", "results", "data").firstNotNullOfOrNull { root.optJSONArray(it) } ?: JSONArray()
+                }
+            }.getOrDefault(JSONArray())
+            for (i in 0 until array.length()) array.optJSONObject(i)?.let(results::add)
+            if (array.length() < limit) break
+        }
+        return results
+    }
