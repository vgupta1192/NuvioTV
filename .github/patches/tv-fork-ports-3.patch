+package com.nuvio.tv.data.tracking
+
+import com.nuvio.tv.core.tracking.TrackingLibraryProvider
+import com.nuvio.tv.core.tracking.TrackingProviderId
+import com.nuvio.tv.core.tracking.TrackingRefreshIntent
+import com.nuvio.tv.domain.model.LibraryEntry
+import com.nuvio.tv.domain.model.LibraryEntryInput
+import com.nuvio.tv.domain.model.LibraryListTab
+import com.nuvio.tv.domain.model.ListMembershipChanges
+import com.nuvio.tv.domain.model.ListMembershipSnapshot
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.flow.map
+import kotlinx.coroutines.flow.onStart
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+
+/** Lists and their items as loaded from a tracking account. */
+data class ForkTvLibrarySnapshot(
+    val tabs: List<LibraryListTab>,
+    val items: List<LibraryEntry>
+)
+
+/**
+ * Read-only library for a tracking account: the account's lists show as tabs, adding or removing
+ * from the app is not supported. [load] returns null when the account is not connected.
+ */
+class ForkTvReadOnlyLibrary(
+    override val providerId: TrackingProviderId,
+    override val isAuthenticated: Flow<Boolean>,
+    private val listKeyPrefix: String,
+    private val load: suspend () -> ForkTvLibrarySnapshot?
+) : TrackingLibraryProvider {
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private val mutex = Mutex()
+    private val refreshing = MutableStateFlow(false)
+    private val snapshot = MutableStateFlow(ForkTvLibrarySnapshot(emptyList(), emptyList()))
+    @Volatile private var loadedAt = 0L
+
+    override val isRefreshing: Flow<Boolean> = refreshing
+    override val items: Flow<List<LibraryEntry>> =
+        snapshot.map { it.items }.onStart { refreshAsync() }.distinctUntilChanged()
+    override val tabs: Flow<List<LibraryListTab>> =
+        snapshot.map { it.tabs }.onStart { refreshAsync() }.distinctUntilChanged()
+
+    override fun recognizesListKey(key: String): Boolean = key.startsWith(listKeyPrefix)
+
+    override fun observeMembership(itemId: String, itemType: String): Flow<Set<String>> =
+        snapshot.map { membership(itemId, null) }.distinctUntilChanged()
+
+    override fun toggledDefaultMembership(currentMembership: Map<String, Boolean>): Map<String, Boolean> =
+        currentMembership
+
+    override suspend fun getMembershipSnapshot(item: LibraryEntryInput): ListMembershipSnapshot {
+        refresh(TrackingRefreshIntent.AUTOMATIC)
+        val keys = membership(item.itemId, item.tmdbId)
+        return ListMembershipSnapshot(snapshot.value.tabs.associate { it.key to (it.key in keys) })
+    }
+
+    override suspend fun applyMembershipChanges(
+        item: LibraryEntryInput,
+        changes: ListMembershipChanges,
+        destructiveRemovalConfirmed: Boolean
+    ) {
+        throw UnsupportedOperationException("This account library is read-only here")
+    }
+
+    override suspend fun refresh(intent: TrackingRefreshIntent) {
+        val now = System.currentTimeMillis()
+        if (intent == TrackingRefreshIntent.AUTOMATIC && now - loadedAt in 0 until AUTOMATIC_INTERVAL_MS) return
+        mutex.withLock {
+            if (intent == TrackingRefreshIntent.AUTOMATIC && System.currentTimeMillis() - loadedAt in 0 until AUTOMATIC_INTERVAL_MS) return
+            refreshing.value = true
+            try {
+                val loaded = load()
+                if (loaded != null) {
+                    snapshot.value = loaded
+                    loadedAt = System.currentTimeMillis()
+                } else {
+                    snapshot.value = ForkTvLibrarySnapshot(emptyList(), emptyList())
+                }
+            } catch (error: CancellationException) {
+                throw error
+            } catch (error: Exception) {
+                if (intent != TrackingRefreshIntent.AUTOMATIC) throw error
+            } finally {
+                refreshing.value = false
+            }
+        }
+    }
+
+    private fun refreshAsync() {
+        scope.launch { runCatching { refresh(TrackingRefreshIntent.AUTOMATIC) } }
+    }
+
+    private fun membership(itemId: String, tmdbId: Int?): Set<String> {
+        val tmdbAlias = "tmdb:$tmdbId"
+        return snapshot.value.items
+            .filter { it.id == itemId || (tmdbId != null && (it.tmdbId == tmdbId || it.id == tmdbAlias)) ||
+                it.imdbId == itemId || "tmdb:${it.tmdbId}" == itemId }
+            .flatMapTo(linkedSetOf()) { it.listKeys }
+    }
+
+    private companion object {
+        const val AUTOMATIC_INTERVAL_MS = 5 * 60 * 1000L
+    }
+}
