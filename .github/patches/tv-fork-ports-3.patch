@@ -0,0 +1,23 @@
+package com.nuvio.tv.ui.screens.cast
+
+import com.nuvio.tv.domain.model.LibraryEntry
+import com.nuvio.tv.domain.model.MetaPreview
+import com.nuvio.tv.domain.model.WatchProgress
+
+/**
+ * What the user already has, keyed by id and by folded title (TMDB credits use TMDB ids while library
+ * and progress use IMDb ids, so the title is the practical match). Watching wins over In library.
+ */
+internal fun ownedKeys(id: String, title: String): List<String> =
+    listOf(id, title.lowercase().filter { it.isLetterOrDigit() }).filter { it.isNotBlank() }
+
+internal fun buildOwnedLabels(library: List<LibraryEntry>, progress: List<WatchProgress>): Map<String, String> {
+    val labels = HashMap<String, String>()
+    library.forEach { entry -> ownedKeys(entry.id, entry.name).forEach { labels[it] = "In library" } }
+    progress.filterNot { it.isCompleted() }
+        .forEach { entry -> ownedKeys(entry.contentId, entry.name).forEach { labels[it] = "Watching" } }
+    return labels
+}
+
+internal fun Map<String, String>.ownedLabelFor(item: MetaPreview): String? =
+    ownedKeys(item.id, item.name).firstNotNullOfOrNull { this[it] }
