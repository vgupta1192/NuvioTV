+
+        assertTrue(result[0]);
+    }
+
+    @Test
+    public void testMultiThreadAccess() throws InterruptedException {
+        v8.add("foo", "bar");
+        v8.getLocker().release();
+        Thread t = new Thread(new Runnable() {
+
+            @Override
+            public void run() {
+                v8.getLocker().acquire();
+                v8.add("foo", "baz");
+                v8.getLocker().release();
+            }
+        });
+        t.start();
+        t.join();
+        v8.getLocker().acquire();
+
+        assertEquals("baz", v8.getString("foo"));
+    }
