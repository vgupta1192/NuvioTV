+    @Override
+    public float getVolumeLevel() {
+        float result = 1.0f; // the live loudness
+
+        //if (mLoudnessDb != 0) {
+        //    // Original tv web: Math.min(1, 10 ** (-loudnessDb / 20))
+        //    // -5db...5db (0.7...1.4) Base formula: normalLevel*10^(-db/20)
