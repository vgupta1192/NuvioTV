+     */
+    public static <T> T[] shuffleArray(T[] arr) {
+        if (arr == null || arr.length == 0) {
+            return arr;
+        }
+
+        for (int i = arr.length - 1; i > 0; i--) {
+            int index = getRandom().nextInt(i + 1);
+            // Simple swap
+            T item = arr[index];
+            arr[index] = arr[i];
+            arr[i] = item;
+        }
+
+        return arr;
+    }
