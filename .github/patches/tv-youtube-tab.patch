+    private Object getDefaultValue(final Class<?> type) {
+        if (type.equals(V8Object.class)) {
+            return new V8Object.Undefined();
+        } else if (type.equals(V8Array.class)) {
+            return new V8Array.Undefined();
+        }
+        return invalid;
+    }
