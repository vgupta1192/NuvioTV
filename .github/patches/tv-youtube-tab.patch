+
+        cpnCode = jsCode?.let { ClientPlaybackNonceExtractor.extractClientPlaybackNonceCode(it) }
+        signatureTimestamp = jsCode?.let { CommonExtractor.extractSignatureTimestamp(it) }
+    }
+
