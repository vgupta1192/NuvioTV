+     * @throws NullPointerException if {@code obj} is {@code null}
+     * @since 1.8
+     */
+    //public static <T> T requireNonNull(T obj, Supplier<String> messageSupplier) {
+    //    if (obj == null)
+    //        throw new NullPointerException(messageSupplier.get());
+    //    return obj;
+    //}
+}
