+     * Price in local currency.<br/>
+     * Example: <b>"$19.99"</b>
+     */
+    String getPurchasePrice();
+    String getRentalPrice();
+    /**
+     * Video rating max points.<br/>
+     * Example: {@link Rating#RATING_5_STARS}
+     */
+    int getRatingStyle();
+    /**
+     * Video rating score.<br/>
+     * Example: <b>4.05f</b>
+     */
+    double getRatingScore();
