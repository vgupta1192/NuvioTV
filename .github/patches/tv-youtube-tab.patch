+private const val STATUS_LOGIN_REQUIRED = "LOGIN_REQUIRED"
+private const val STATUS_AGE_CHECK_REQUIRED = "AGE_CHECK_REQUIRED"
+private const val STATUS_AGE_VERIFICATION_REQUIRED = "AGE_VERIFICATION_REQUIRED"
