diff --git a/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/regexp/typeadapter/RegExpTypeAdapter.java b/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/googlecommon/common/converters/regexp/typeadapter/RegExpTypeAdapter.java
new file mode 100644
index 000000000..e6f2ef6c0
