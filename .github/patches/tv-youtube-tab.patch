+	public boolean equals( Object obj ) {
+
+		if ( obj == this ) {
+			return true;
+		}
+
+		if ( !( obj instanceof UrlEncodedQueryStringBase) ) {
+			return false;
+		}
+
+		String query = toString();
+		String thatQuery = ( (UrlEncodedQueryStringBase) obj ).toString();
+
+		return query.equals( thatQuery );
+	}
+
+	/**
