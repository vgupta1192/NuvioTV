+    private fun checkSigData() {
+        if (nFuncCode) {
+            return
+        }
+
+        try {
+            val nParam = "5cNpZqIJ7ixNqU68Y7S"
+            val code = playerCode ?: return
+            val result = TclChallengeProvider.solveN(fixedPlayerUrl, code, listOf(nParam))
