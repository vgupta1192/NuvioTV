diff --git a/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/browse/v1/BrowseService.java b/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/browse/v1/BrowseService.java
