+	 * use <code>getMap().hashCode</code>.
+	 *
+	 * @return a hash code value for this UrlEncodedQueryString.
+	 */
+
+	@Override
+	public int hashCode() {
+
+		return toString().hashCode();
+	}
+
+	/**
+	 * Returns a <code>www-form-urlencoded</code> string of the query parameters.
+	 * <p>
