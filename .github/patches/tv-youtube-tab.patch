+    private static boolean isNaN(String num) {
+        return num == null                                      ||
+               num.isEmpty()                                    ||
+               num.contains(" ")                                ||
+               num.contains(";")                                ||
+               num.contains("&")                                ||
+               num.contains(",")                                ||
+               num.contains(".")                                ||
+               num.contains(":")                                ||
+               num.contains("/")                                ||
+               num.contains("\\")                               ||
+               !Character.isDigit(num.charAt(num.length() - 1)) ||
+               !Character.isDigit(num.charAt(0));
+    }
