diff --git a/mediaservicecore/j2v8/src/androidTest/java/com/eclipsesource/v8/LibraryLoaderTest.java b/mediaservicecore/j2v8/src/androidTest/java/com/eclipsesource/v8/LibraryLoaderTest.java
