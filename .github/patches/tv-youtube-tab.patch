+import androidx.compose.foundation.lazy.items
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.text.style.TextOverflow
+import androidx.compose.ui.unit.dp
+import androidx.tv.material3.Border
+import androidx.tv.material3.Card
+import androidx.tv.material3.CardDefaults
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import androidx.tv.material3.MaterialTheme
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.core.genres.GenreIndex
+import com.nuvio.tv.ui.theme.NuvioTheme
+import com.nuvio.tv.ui.util.localizedGenreLabel
+
+/**
+ * Genres fork: the Genres tab, moved onto Home as one more built-in row. Shows the genre
+ * buckets [GenreIndex] derives from Home's own catalogs (no server calls); picking one opens
+ * the Genres page with that bucket selected. Hidden when the Layout setting turns it off or
+ * nothing has been indexed yet.
+ */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+internal fun GenresHomeRow(onOpenGenres: (String) -> Unit) {
+    val buckets by GenreIndex.buckets.collectAsState()
+    if (buckets.isEmpty()) return
+
+    Column(
+        modifier = Modifier
+            .fillMaxWidth()
+            .padding(vertical = NuvioTheme.spacing.sm)
+    ) {
+        Text(
+            text = stringResource(R.string.genres_title),
+            style = MaterialTheme.typography.titleMedium,
+            color = NuvioTheme.colors.TextPrimary,
+            modifier = Modifier.padding(horizontal = NuvioTheme.spacing.xxxl)
+        )
+        LazyRow(
+            horizontalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.md),
+            contentPadding = PaddingValues(horizontal = NuvioTheme.spacing.xxxl, vertical = NuvioTheme.spacing.sm)
+        ) {
+            items(buckets, key = { it.key }) { bucket ->
+                val chipShape = RoundedCornerShape(14.dp)
+                Card(
+                    onClick = { onOpenGenres(bucket.key) },
+                    shape = CardDefaults.shape(shape = chipShape),
+                    colors = CardDefaults.colors(
+                        containerColor = NuvioTheme.colors.BackgroundCard,
+                        focusedContainerColor = NuvioTheme.colors.Secondary
+                    ),
+                    border = CardDefaults.border(
+                        focusedBorder = Border(
+                            border = NuvioTheme.focusRing.border(NuvioTheme.spacing.xxs),
+                            shape = chipShape
+                        )
+                    )
+                ) {
+                    Column(
+                        modifier = Modifier.padding(horizontal = NuvioTheme.spacing.lg, vertical = NuvioTheme.spacing.md)
+                    ) {
+                        Text(
+                            text = localizedGenreLabel(bucket.label),
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = NuvioTheme.colors.TextPrimary,
+                            maxLines = 1,
+                            overflow = TextOverflow.Ellipsis
+                        )
+                        Text(
+                            text = stringResource(R.string.genres_item_count, bucket.items.size),
+                            style = MaterialTheme.typography.labelSmall,
+                            color = NuvioTheme.colors.TextSecondary
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
