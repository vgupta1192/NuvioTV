+        if (list == null) {
+            Log.w(TAG, "Seems that read permissions not granted for file: " + source.getAbsolutePath());
+            return;
+        }
+
+        for (String f : list) {
+            copyRecursive(new File(source, f), new File(target, f), fileFiler, dirFiler, rootLocation);
+        }
+    }
