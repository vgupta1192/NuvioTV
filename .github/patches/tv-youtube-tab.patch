+    public static <T> List<T> parseList(String delim, String data, Parser<T> itemParser) {
+        List<T> result = new ArrayList<>();
+
+        if (data != null) {
+            String[] listArr = split(data, delim);
+
+            for (String item : listArr) {
+                T parsed = itemParser.parse(item);
+                if (parsed != null) {
+                    result.add(parsed);
+                }
+            }
+        }
+
+        return result;
+    }
