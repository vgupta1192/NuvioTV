diff --git a/mediaservicecore/j2v8/src/main/java/com/eclipsesource/v8/debug/mirror/ObjectMirror.java b/mediaservicecore/j2v8/src/main/java/com/eclipsesource/v8/debug/mirror/ObjectMirror.java
