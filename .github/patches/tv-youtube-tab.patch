+                    onToggle = {
+                        sponsorAsk = !sponsorAsk
+                        YouTubeSettings.setSponsorAsk(context, sponsorAsk)
+                    }
+                )
+                SettingsToggleRow(
+                    title = "Show a notice when skipping",
