+    //            continue
+    //
+    //        poToken = RetrofitHelper.get(api.getPoTokenPart2("$baseUrl/part2", Gson().toJson(part2)))
+    //
+    //        if (poToken?.poToken != null)
+    //            break
+    //
+    //        baseUrl = Helpers.getNextValue(baseUrl, PO_TOKEN_CLOUD_BASE_URLS)
+    //
+    //        if (i < (RETRY_TIMES - 1))
+    //            delay(RETRY_DELAY_MS)
+    //    }
+    //
+    //    return poToken
+    //}
