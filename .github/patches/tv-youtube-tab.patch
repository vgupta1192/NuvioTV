diff --git a/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/models/V2/TileItem.java b/mediaservicecore/youtubeapi/src/main/java/com/liskovsoft/youtubeapi/common/models/V2/TileItem.java
