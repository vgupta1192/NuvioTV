+@file:OptIn(androidx.tv.material3.ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.tv.material3.Button
+import androidx.tv.material3.MaterialTheme
+import androidx.tv.material3.Text
+import com.nuvio.tv.ui.components.NuvioDialog
+import com.nuvio.tv.ui.screens.player.DxStatSummary
+import com.nuvio.tv.ui.screens.player.DxWatchStats
+import com.nuvio.tv.ui.theme.NuvioTheme
+
+private fun dxHours(seconds: Double): String {
+    val minutes = (seconds / 60.0).toLong()
+    return if (minutes < 60) "${minutes} min" else "${minutes / 60} h ${minutes % 60} min"
+}
+
+/** Advanced settings card (dx.bi port): opens the "Your stats" page, with the Count watch time switch. */
+@Composable
+internal fun DxWatchStatsSettingsCard() {
+    val context = LocalContext.current
+    val enabled by DxWatchStats.enabled.collectAsStateWithLifecycle()
+    var showStats by remember { mutableStateOf(false) }
+    LaunchedEffectEnsureLoaded()
+    SettingsGroupCard(modifier = Modifier.fillMaxWidth(), title = "Your stats") {
+        SettingsActionRow(
+            title = "Your stats",
+            subtitle = "Hours watched, streaks and your most watched titles. Kept on this device only.",
+            onClick = { showStats = true },
+        )
+        SettingsToggleRow(
+            title = "Count watch time",
+            subtitle = "Count the time a video is really playing. Turn it off to stop collecting stats.",
+            checked = enabled,
+            onToggle = { DxWatchStats.setEnabled(context, !enabled) },
+        )
+    }
+    if (showStats) {
+        DxWatchStatsDialog(onDismiss = { showStats = false })
+    }
+}
+
+@Composable
+private fun LaunchedEffectEnsureLoaded() {
+    val context = LocalContext.current
+    remember { DxWatchStats.ensureLoaded(context); true }
+}
+
+@Composable
+private fun DxWatchStatsDialog(onDismiss: () -> Unit) {
+    val context = LocalContext.current
+    var summary by remember { mutableStateOf<DxStatSummary>(DxWatchStats.summary(context)) }
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = "Your stats",
+        subtitle = "Counting since ${summary.since}",
+        width = 640.dp,
+        contentSpacing = 8.dp,
+    ) {
+        val style = MaterialTheme.typography.bodyMedium
+        val color = NuvioTheme.colors.TextPrimary
+        Text("Today: ${dxHours(summary.today)}   Last 7 days: ${dxHours(summary.week)}", style = style, color = color)
+        Text("Last 30 days: ${dxHours(summary.month)}   All time: ${dxHours(summary.total)}", style = style, color = color)
+        Text("Streak: ${summary.currentStreak} days   Best streak: ${summary.bestStreak} days", style = style, color = color)
+        if (summary.topTitles.isEmpty()) {
+            Text("Nothing counted yet. Watch something and come back.", style = style, color = NuvioTheme.colors.TextSecondary)
+        } else {
+            Text("Most watched", style = MaterialTheme.typography.titleSmall, color = color)
+            summary.topTitles.forEachIndexed { i, row ->
+                Text("${i + 1}. ${row.name.ifBlank { "Untitled" }}  -  ${dxHours(row.seconds)}", style = style, color = color, maxLines = 1)
+            }
+        }
+        Row(modifier = Modifier.padding(top = 8.dp), horizontalArrangement = Arrangement.spacedBy(12.dp)) {
+            Button(onClick = onDismiss) { Text("Close") }
+            Button(onClick = {
+                DxWatchStats.reset(context)
+                summary = DxWatchStats.summary(context)
+            }) { Text("Reset stats") }
+        }
+    }
+}
