+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import android.os.SystemClock
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+import org.json.JSONObject
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Locale
+import java.util.TimeZone
+
+internal data class DxStatTitleRow(val name: String, val type: String, val seconds: Double)
+
+internal data class DxStatSummary(
+    val today: Double,
+    val week: Double,
+    val month: Double,
+    val total: Double,
+    val currentStreak: Int,
+    val bestStreak: Int,
+    val topTitles: List<DxStatTitleRow>,
+    val since: String,
+)
+
+/**
+ * dx.bi port: "Your stats". Counts the seconds a video is really playing (a once-a-second check while the
+ * player reports playing), per day and per title, on this device only. Settings has a switch to stop counting
+ * and a reset.
+ */
+internal object DxWatchStats {
+    private const val PREFS = "nuvio_tv_dx_watch_stats"
+    private val _enabled = MutableStateFlow(true)
+    val enabled: StateFlow<Boolean> = _enabled.asStateFlow()
+    private val days = HashMap<String, Double>()
+    private val titles = HashMap<String, DxStatTitleRow>()
+    private var since = ""
+    private var loaded = false
+    private var unsaved = 0.0
+
+    private fun prefs(context: Context) =
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    @Synchronized
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        val p = prefs(context)
+        _enabled.value = p.getBoolean("enabled", true)
+        since = p.getString("since", null) ?: dayKey(Calendar.getInstance())
+        runCatching {
+            val root = JSONObject(p.getString("data", null) ?: return@runCatching)
+            root.optJSONObject("days")?.let { o -> o.keys().forEach { days[it] = o.optDouble(it, 0.0) } }
+            root.optJSONObject("titles")?.let { o ->
+                o.keys().forEach { k ->
+                    val t = o.optJSONObject(k) ?: return@forEach
+                    titles[k] = DxStatTitleRow(t.optString("n"), t.optString("t"), t.optDouble("s", 0.0))
+                }
+            }
+        }
+    }
+
+    @Synchronized
+    fun setEnabled(context: Context, on: Boolean) {
+        ensureLoaded(context)
+        _enabled.value = on
+        prefs(context).edit().putBoolean("enabled", on).apply()
+    }
+
+    @Synchronized
+    fun reset(context: Context) {
+        ensureLoaded(context)
+        days.clear()
+        titles.clear()
+        unsaved = 0.0
+        since = dayKey(Calendar.getInstance())
+        prefs(context).edit().remove("data").putString("since", since).apply()
+    }
+
+    /** Starts the once-a-second counter for one player session. It stops when [scope] ends. */
+    fun start(
+        scope: CoroutineScope,
+        context: Context,
+        isPlaying: () -> Boolean,
+        titleId: () -> String,
+        titleName: () -> String,
+        titleType: () -> String,
+    ) {
+        ensureLoaded(context)
+        scope.launch {
+            var last = SystemClock.elapsedRealtime()
+            try {
+                while (isActive) {
+                    delay(1000L)
+                    val now = SystemClock.elapsedRealtime()
+                    val gap = (now - last) / 1000.0
+                    last = now
+                    if (_enabled.value && isPlaying() && gap in 0.1..3.0) {
+                        add(gap, titleId(), titleName(), titleType())
+                        if (unsaved >= 30.0) flush(context)
+                    }
+                }
+            } finally {
+                flush(context)
+            }
+        }
+    }
+
+    @Synchronized
+    private fun add(seconds: Double, id: String, name: String, type: String) {
+        val day = dayKey(Calendar.getInstance())
+        days[day] = (days[day] ?: 0.0) + seconds
+        if (id.isNotBlank()) {
+            val old = titles[id]
+            titles[id] = DxStatTitleRow(
+                name.ifBlank { old?.name.orEmpty() },
+                type.ifBlank { old?.type.orEmpty() },
+                (old?.seconds ?: 0.0) + seconds,
+            )
+        }
+        unsaved += seconds
+    }
+
+    @Synchronized
+    fun flush(context: Context) {
+        if (!loaded || unsaved <= 0.0) return
+        unsaved = 0.0
+        if (days.size > 800) {
+            days.keys.sorted().dropLast(800).forEach { days.remove(it) }
+        }
+        if (titles.size > 300) {
+            titles.entries.sortedByDescending { it.value.seconds }.drop(300).forEach { titles.remove(it.key) }
+        }
+        val root = JSONObject()
+        root.put("days", JSONObject().also { o -> days.forEach { (k, v) -> o.put(k, v) } })
+        root.put("titles", JSONObject().also { o ->
+            titles.forEach { (k, v) ->
+                o.put(k, JSONObject().put("n", v.name).put("t", v.type).put("s", v.seconds))
+            }
+        })
+        prefs(context).edit().putString("data", root.toString()).putString("since", since).apply()
+    }
+
+    @Synchronized
+    fun summary(context: Context): DxStatSummary {
+        ensureLoaded(context)
+        flush(context)
+        val cal = Calendar.getInstance()
+        val todayKey = dayKey(cal)
+        var week = 0.0
+        var month = 0.0
+        val activeToday = (days[todayKey] ?: 0.0) >= 60.0
+        var current = 0
+        var counting = true
+        for (i in 0 until 30) {
+            val k = dayKey(cal)
+            val sec = days[k] ?: 0.0
+            if (i < 7) week += sec
+            month += sec
+            if (counting) {
+                if (sec >= 60.0) current++ else if (i > 0 || activeToday) counting = false
+            }
+            cal.add(Calendar.DAY_OF_MONTH, -1)
+        }
+        // keep counting the streak past 30 days
+        if (counting) {
+            while (current < 800 && (days[dayKey(cal)] ?: 0.0) >= 60.0) {
+                current++
+                cal.add(Calendar.DAY_OF_MONTH, -1)
+            }
+        }
+        val utc = SimpleDateFormat("yyyy-MM-dd", Locale.US).apply { timeZone = TimeZone.getTimeZone("UTC") }
+        var best = 0
+        var run = 0
+        var prev = Long.MIN_VALUE
+        days.filter { it.value >= 60.0 }.keys.sorted().forEach { k ->
+            val d = (utc.parse(k)?.time ?: return@forEach) / 86_400_000L
+            run = if (prev != Long.MIN_VALUE && d - prev == 1L) run + 1 else 1
+            best = maxOf(best, run)
+            prev = d
+        }
+        return DxStatSummary(
+            today = days[todayKey] ?: 0.0,
+            week = week,
+            month = month,
+            total = days.values.sum(),
+            currentStreak = current,
+            bestStreak = maxOf(best, current),
+            topTitles = titles.values.filter { it.seconds >= 60.0 }.sortedByDescending { it.seconds }.take(5),
+            since = since,
+        )
+    }
+
+    private fun dayKey(cal: Calendar): String = String.format(
+        Locale.US, "%04d-%02d-%02d",
+        cal.get(Calendar.YEAR), cal.get(Calendar.MONTH) + 1, cal.get(Calendar.DAY_OF_MONTH),
+    )
+}
