+@file:OptIn(androidx.media3.common.util.UnstableApi::class)
+
+package com.nuvio.tv.ui.screens.player.audiosync
+
+import android.net.Uri
+import android.os.Process
+import androidx.media3.common.C
+import androidx.media3.common.util.TimestampAdjuster
+import androidx.media3.common.util.UriUtil
+import androidx.media3.datasource.ByteArrayDataSource
+import androidx.media3.datasource.DataSource
+import androidx.media3.datasource.DataSourceUtil
+import androidx.media3.datasource.DataSpec
+import androidx.media3.extractor.DefaultExtractorInput
+import androidx.media3.extractor.Extractor
+import androidx.media3.extractor.ExtractorOutput
+import androidx.media3.extractor.ExtractorsFactory
+import androidx.media3.extractor.DiscardingTrackOutput
+import androidx.media3.extractor.PositionHolder
+import androidx.media3.extractor.SeekMap
+import androidx.media3.extractor.TrackOutput
+import androidx.media3.extractor.text.SubtitleParser
+import androidx.media3.extractor.ts.DefaultTsPayloadReaderFactory
+import androidx.media3.extractor.ts.TsExtractor
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.atomic.AtomicInteger
+import java.util.concurrent.atomic.AtomicLong
+import java.util.concurrent.atomic.AtomicReference
+import javax.crypto.Cipher
+import javax.crypto.spec.IvParameterSpec
+import javax.crypto.spec.SecretKeySpec
+
+/**
+ * [AudioSpotSampler] for HLS VOD streams (MPEG-TS segments, optionally AES-128): reads the
+ * playlist, downloads the segments that cover each spot and demuxes their audio to the workers'
+ * sinks, so a playlist stream gets the same look-ahead across the film as a single file.
+ *
+ * Sample times follow ExoPlayer's HLS timeline: per discontinuity sequence, the first segment read
+ * maps its first timestamp to the segment's start in the playlist. Blocking; run it on a
+ * background thread.
+ */
+internal class HlsAudioSpotSampler(
+    private val uri: Uri,
+    private val dataSourceFactory: DataSource.Factory,
+    private val maxBytes: Long,
+) {
+    private class Key(val uri: String, val iv: ByteArray?)
+
+    private class Segment(
+        val uri: String,
+        val startUs: Long,
+        val durationUs: Long,
+        val discontinuity: Int,
+        val mediaSequence: Long,
+        val key: Key?,
+        val byteOffset: Long,
+        val byteLength: Long,
+    )
+
+    private val bytes = AtomicLong()
+    private val keys = ConcurrentHashMap<String, ByteArray>()
+    private val adjusters = ConcurrentHashMap<Int, TimestampAdjuster>()
+
+    fun run(
+        spotsMs: List<Long>,
+        spotMs: Long,
+        sinks: List<AudioSampleSink>,
+        isCancelled: () -> Boolean,
+        onSpot: (sampled: Int, bytes: Long) -> Unit,
+    ): AudioSpotSampler.Result {
+        val segments = try {
+            loadSegments()
+        } catch (error: Exception) {
+            return AudioSpotSampler.Result(0, bytes.get(), error.message ?: error.javaClass.simpleName, sinks.size)
+        }
+        val next = AtomicInteger(0)
+        val sampled = AtomicInteger(0)
+        val failure = AtomicReference<String?>(null)
+        val stop = { isCancelled() || failure.get() != null || bytes.get() >= maxBytes }
+
+        fun work(sink: AudioSampleSink) {
+            try {
+                while (!stop()) {
+                    val index = next.getAndIncrement()
+                    if (index >= spotsMs.size) return
+                    val fromUs = spotsMs[index] * 1_000L
+                    val toUs = fromUs + spotMs * 1_000L
+                    val covering = segments.filter { it.startUs < toUs && it.startUs + it.durationUs > fromUs }
+                    if (covering.isEmpty()) continue
+                    sink.onDiscontinuity()
+                    for (segment in covering) {
+                        if (stop()) return
+                        demux(segment, sink)
+                    }
+                    onSpot(sampled.incrementAndGet(), bytes.get())
+                }
+            } catch (error: Exception) {
+                failure.compareAndSet(null, error.message ?: error.javaClass.simpleName)
+            }
+        }
+
+        val helpers = sinks.drop(1).map { sink ->
+            Thread({
+                Process.setThreadPriority(Process.THREAD_PRIORITY_BACKGROUND)
+                work(sink)
+            }, "NuvioAudioSyncHls").apply {
+                isDaemon = true
+                start()
+            }
+        }
+        sinks.firstOrNull()?.let(::work)
+        helpers.forEach(Thread::join)
+        return AudioSpotSampler.Result(sampled.get(), bytes.get(), failure.get(), sinks.size)
+    }
+
+    /** The media playlist's segments; a master playlist is resolved to its cheapest variant. */
+    private fun loadSegments(): List<Segment> {
+        var (playlistUri, text) = fetchText(uri)
+        if (!text.trimStart().startsWith("#EXTM3U")) throw IllegalStateException("not an HLS playlist")
+        if (text.contains("#EXT-X-STREAM-INF")) {
+            val media = pickMediaPlaylist(playlistUri, text) ?: throw IllegalStateException("no variant in playlist")
+            val loaded = fetchText(Uri.parse(media))
+            playlistUri = loaded.first
+            text = loaded.second
+        }
+        if (!text.contains("#EXT-X-ENDLIST")) throw IllegalStateException("live playlist")
+        if (text.contains("#EXT-X-MAP")) throw IllegalStateException("fMP4 segments not supported")
+        val base = playlistUri.toString()
+        val segments = ArrayList<Segment>()
+        var mediaSequence = 0L
+        var startUs = 0L
+        var durationUs = C.TIME_UNSET
+        var discontinuity = 0
+        var key: Key? = null
+        var nextByteOffset = 0L
+        var byteRange: Pair<Long, Long>? = null
+        for (raw in text.lineSequence()) {
+            val line = raw.trim()
+            when {
+                line.isEmpty() -> Unit
+                line.startsWith("#EXT-X-MEDIA-SEQUENCE:") ->
+                    mediaSequence = line.substringAfter(':').trim().toLongOrNull() ?: 0L
+                line.startsWith("#EXTINF:") -> {
+                    val seconds = line.substringAfter(':').substringBefore(',').trim().toDoubleOrNull()
+                    durationUs = seconds?.let { (it * 1_000_000).toLong() } ?: C.TIME_UNSET
+                }
+                line == "#EXT-X-DISCONTINUITY" -> discontinuity++
+                line.startsWith("#EXT-X-KEY:") -> {
+                    val attributes = attributes(line)
+                    key = when (attributes["METHOD"]) {
+                        null, "NONE" -> null
+                        "AES-128" -> Key(
+                            UriUtil.resolve(base, attributes["URI"] ?: throw IllegalStateException("key without URI")),
+                            attributes["IV"]?.let(::parseIv),
+                        )
+                        else -> throw IllegalStateException("${attributes["METHOD"]} encryption not supported")
+                    }
+                }
+                line.startsWith("#EXT-X-BYTERANGE:") -> {
+                    val value = line.substringAfter(':').trim()
+                    val length = value.substringBefore('@').toLong()
+                    val offset = if ('@' in value) value.substringAfter('@').toLong() else nextByteOffset
+                    byteRange = length to offset
+                }
+                line.startsWith("#") -> Unit
+                else -> {
+                    if (durationUs == C.TIME_UNSET) throw IllegalStateException("segment without duration")
+                    val range = byteRange
+                    segments += Segment(
+                        uri = UriUtil.resolve(base, line),
+                        startUs = startUs,
+                        durationUs = durationUs,
+                        discontinuity = discontinuity,
+                        mediaSequence = mediaSequence + segments.size,
+                        key = key,
+                        byteOffset = range?.second ?: 0L,
+                        byteLength = range?.first ?: C.LENGTH_UNSET.toLong(),
+                    )
+                    nextByteOffset = range?.let { it.second + it.first } ?: 0L
+                    byteRange = null
+                    startUs += durationUs
+                    durationUs = C.TIME_UNSET
+                }
+            }
+        }
+        if (segments.isEmpty()) throw IllegalStateException("empty playlist")
+        return segments
+    }
+
+    /**
+     * The media playlist to read: a separate audio rendition when the stream has one (audio only, so
+     * cheap), otherwise the lowest-bandwidth variant (same audio as the others, least video).
+     */
+    private fun pickMediaPlaylist(masterUri: Uri, text: String): String? {
+        val base = masterUri.toString()
+        val lines = text.lines().map(String::trim)
+        val audio = lines.filter { it.startsWith("#EXT-X-MEDIA:") }
+            .map(::attributes)
+            .filter { it["TYPE"] == "AUDIO" && it["URI"] != null }
+        (audio.firstOrNull { it["DEFAULT"] == "YES" } ?: audio.firstOrNull())?.let { return UriUtil.resolve(base, it["URI"]!!) }
+        var best: Pair<Long, String>? = null
+        for ((index, line) in lines.withIndex()) {
+            if (!line.startsWith("#EXT-X-STREAM-INF:")) continue
+            val variant = lines.drop(index + 1).firstOrNull { it.isNotEmpty() && !it.startsWith("#") } ?: continue
+            val bandwidth = attributes(line)["BANDWIDTH"]?.toLongOrNull() ?: Long.MAX_VALUE
+            if (best == null || bandwidth < best.first) best = bandwidth to variant
+        }
+        return best?.let { UriUtil.resolve(base, it.second) }
+    }
+
+    /** Downloads [segment] and passes its audio, on the player's timeline, to [sink]. */
+    private fun demux(segment: Segment, sink: AudioSampleSink) {
+        var data = fetch(DataSpec.Builder()
+            .setUri(segment.uri)
+            .setPosition(segment.byteOffset)
+            .setLength(segment.byteLength)
+            .build())
+        segment.key?.let { key -> data = decrypt(data, key, segment.mediaSequence) }
+        if (data.isEmpty() || data[0] != TS_SYNC_BYTE) throw IllegalStateException("segments are not MPEG-TS")
+        val adjuster = adjusters.computeIfAbsent(segment.discontinuity) { TimestampAdjuster(segment.startUs) }
+        val tsFactory = ExtractorsFactory {
+            arrayOf(
+                TsExtractor(
+                    TsExtractor.MODE_HLS,
+                    TsExtractor.FLAG_EMIT_RAW_SUBTITLE_DATA,
+                    SubtitleParser.Factory.UNSUPPORTED,
+                    adjuster,
+                    DefaultTsPayloadReaderFactory(0),
+                    TsExtractor.DEFAULT_TIMESTAMP_SEARCH_BYTES,
+                ),
+            )
+        }
+        val extractor: Extractor = AudioSyncExtractorsFactory(tsFactory, sink).createExtractors()[0]
+        val source = ByteArrayDataSource(data)
+        try {
+            source.open(DataSpec(Uri.EMPTY))
+            val input = DefaultExtractorInput(source, 0L, data.size.toLong())
+            extractor.init(DiscardingOutput)
+            val position = PositionHolder()
+            while (extractor.read(input, position) == Extractor.RESULT_CONTINUE) Unit
+        } finally {
+            extractor.release()
+            source.close()
+        }
+    }
+
+    private fun decrypt(data: ByteArray, key: Key, mediaSequence: Long): ByteArray {
+        val secret = keys.getOrPut(key.uri) { fetch(DataSpec(Uri.parse(key.uri))) }
+        val iv = key.iv ?: ByteArray(16).also { iv ->
+            for (index in 0 until 8) iv[15 - index] = (mediaSequence ushr (8 * index)).toByte()
+        }
+        val cipher = Cipher.getInstance("AES/CBC/PKCS5Padding")
+        cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(secret, "AES"), IvParameterSpec(iv))
+        return cipher.doFinal(data)
+    }
+
+    /** Text of [target] and the address it was finally served from (relative links resolve to it). */
+    private fun fetchText(target: Uri): Pair<Uri, String> {
+        val source = dataSourceFactory.createDataSource()
+        try {
+            source.open(DataSpec(target))
+            val text = String(DataSourceUtil.readToEnd(source), Charsets.UTF_8)
+            bytes.addAndGet(text.length.toLong())
+            return (source.uri ?: target) to text
+        } finally {
+            source.close()
+        }
+    }
+
+    private fun fetch(spec: DataSpec): ByteArray {
+        val source = dataSourceFactory.createDataSource()
+        try {
+            source.open(spec)
+            return DataSourceUtil.readToEnd(source).also { bytes.addAndGet(it.size.toLong()) }
+        } finally {
+            source.close()
+        }
+    }
+
+    /** Only audio is wanted; every track goes to a discarding output (the audio tap copies first). */
+    private object DiscardingOutput : ExtractorOutput {
+        override fun track(id: Int, type: Int): TrackOutput = DiscardingTrackOutput()
+
+        override fun endTracks() = Unit
+
+        override fun seekMap(seekMap: SeekMap) = Unit
+    }
+
+    private companion object {
+        const val TS_SYNC_BYTE: Byte = 0x47
+        val attribute = Regex("""([A-Z0-9-]+)=("[^"]*"|[^,]*)""")
+
+        fun attributes(line: String): Map<String, String> =
+            attribute.findAll(line.substringAfter(':')).associate { match ->
+                match.groupValues[1] to match.groupValues[2].removeSurrounding("\"")
+            }
+
+        fun parseIv(value: String): ByteArray {
+            val hex = value.removePrefix("0x").removePrefix("0X").padStart(32, '0')
+            return ByteArray(16) { index -> hex.substring(index * 2, index * 2 + 2).toInt(16).toByte() }
+        }
+    }
+}
