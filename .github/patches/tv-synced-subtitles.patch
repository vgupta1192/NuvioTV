+@file:OptIn(androidx.media3.common.util.UnstableApi::class)
+
+package com.nuvio.tv.ui.screens.player
+
+import android.content.Context
+import android.graphics.Typeface
+import android.text.Spanned
+import android.text.style.StyleSpan
+import android.util.Log
+import androidx.media3.common.C
+import androidx.media3.common.text.Cue
+import androidx.media3.extractor.text.CuesWithTiming
+import com.nuvio.tv.domain.model.Addon
+import com.nuvio.tv.domain.model.Subtitle
+import com.nuvio.tv.domain.repository.AddonRepository
+import com.nuvio.tv.ui.screens.player.autosync.AutoSyncSyncedSubtitle
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withTimeoutOrNull
+
+/*
+ * Nuvio fork: synced subtitles in the TV player (see SyncedSubtitles). Saves the subtitle
+ * AutoSync or the audio sync synced, shows a saved one again with its timing instead of syncing,
+ * and picks the latest saved one when a stream that has one starts.
+ */
+
+@EntryPoint
+@InstallIn(SingletonComponent::class)
+internal interface SyncedSubtitlesEntryPoint {
+    fun addonRepository(): AddonRepository
+}
+
+internal object SyncedSubtitlesAddons {
+    @Volatile
+    private var cached: List<Addon> = emptyList()
+
+    /** The installed addons (for Mobile-compatible addon ids), read once and then refreshed. */
+    suspend fun get(context: Context): List<Addon> {
+        val fresh = runCatching {
+            withTimeoutOrNull(3_000L) {
+                EntryPointAccessors.fromApplication(context.applicationContext, SyncedSubtitlesEntryPoint::class.java)
+                    .addonRepository().getInstalledAddons().first()
+            }
+        }.getOrNull()
+        if (fresh != null) cached = fresh
+        return cached
+    }
+
+    fun current(): List<Addon> = cached
+}
+
+private const val TAG = "NuvioSyncedSubtitles"
+private const val SETTLE_MS = 4_000L
+private const val SHOW_WAIT_MS = 10_000L
+private const val LOOP_MS = 1_000L
+
+/** This playback's title + stream key, in Nuvio Mobile's form. */
+private fun PlayerRuntimeController.syncedStreamKey(addons: List<Addon>): String? {
+    val torrent = isTorrentStream && currentInfoHash != null
+    val label = _uiState.value.currentStreamName?.takeIf { it.isNotBlank() } ?: streamName?.takeIf { it.isNotBlank() } ?: "Stream"
+    return SyncedSubtitles.streamKey(
+        addonId = SyncedSubtitles.addonInstanceId(currentAddonName, addons),
+        name = label,
+        description = currentStreamDescription,
+        torrentInfoHash = if (torrent) currentInfoHash else null,
+        torrentFileIdx = if (torrent) currentFileIdx else null,
+    )
+}
+
+/** The coarse canonical key of the playing stream (first line of the stream name). */
+private fun PlayerRuntimeController.syncedCanonicalKey(): String? =
+    SyncedSubtitles.canonicalStreamKey(
+        _uiState.value.currentStreamName?.takeIf { it.isNotBlank() }
+            ?: streamName?.takeIf { it.isNotBlank() }
+            ?: "Stream",
+    )
+
+private fun PlayerRuntimeController.syncedVideoId(): String? =
+    currentVideoId?.takeIf { it.isNotBlank() } ?: contentId?.let { id ->
+        val season = currentSeason
+        val episode = currentEpisode
+        if (season != null && episode != null) "$id:$season:$episode" else id
+    }
+
+/**
+ * Shows [subtitle] with the timing saved when it was synced before for this title + stream, so
+ * AutoSync does not run again. False when nothing is saved or the sidecar can't show it.
+ */
+internal fun PlayerRuntimeController.restoreSyncedSubtitle(subtitle: Subtitle): Boolean {
+    if (isUsingMpvEngine()) {
+        Log.i(TAG, "synced restore: stream plays on mpv, skipping")
+        return false
+    }
+    if (GeneratedSubtitles.isGenerated(subtitle.url)) return false
+    val saved = SyncedSubtitles.savedFor(subtitle.url)
+    if (saved == null) {
+        Log.i(TAG, "synced restore: nothing saved for this subtitle url")
+        return false
+    }
+    val player = _exoPlayer
+    if (player == null) {
+        Log.i(TAG, "synced restore: exoPlayer not ready")
+        return false
+    }
+    cancelAutomaticSubtitleSync()
+    SyncedSubtitles.restoredUrls += subtitle.url
+    val started = startSidecarAddonSubtitle(subtitle, rawBodyLoader = { saved.srt })
+    if (!started) {
+        SyncedSubtitles.restoredUrls -= subtitle.url
+        Log.i(TAG, "synced restore: sidecar refused the saved subtitle")
+        return false
+    }
+    player.trackSelectionParameters = player.trackSelectionParameters
+        .buildUpon()
+        .setTrackTypeDisabled(C.TRACK_TYPE_TEXT, true)
+        .build()
+    resetSubtitleDelayForAutoSync()
+    val url = subtitle.url
+    scope.launch {
+        var waitedMs = 0L
+        while (activeSidecarSubtitleKey == url && sidecarTimedCues.isEmpty() && waitedMs < SHOW_WAIT_MS) {
+            delay(100L)
+            waitedMs += 100L
+        }
+        if (activeSidecarSubtitleKey == url && sidecarTimedCues.isNotEmpty()) {
+            AutoSyncSyncedSubtitle.mark(url)
+            Log.i(TAG, "showing saved synced subtitle ($url)")
+        }
+    }
+    return true
+}
+
+/**
+ * Follows the playback: tells [SyncedSubtitles] which title + stream plays, picks a saved synced
+ * subtitle once per playback, and saves what AutoSync or the audio sync syncs.
+ */
+internal fun PlayerRuntimeController.startSyncedSubtitles(viewModelScope: CoroutineScope) {
+    SyncedSubtitles.initialize(context)
+    SyncedSubtitles.describeSubtitle = { url -> _uiState.value.addonSubtitles.firstOrNull { it.url == url } }
+    viewModelScope.launch {
+        var addons = SyncedSubtitlesAddons.get(context)
+        var addonsReadAt = System.currentTimeMillis()
+        var savedCues: List<CuesWithTiming>? = null
+        var seenCues: List<CuesWithTiming>? = null
+        var seenAtMs = 0L
+        try {
+            while (true) {
+                if (System.currentTimeMillis() - addonsReadAt > 60_000L) {
+                    addons = SyncedSubtitlesAddons.get(context)
+                    addonsReadAt = System.currentTimeMillis()
+                }
+                SyncedSubtitles.setPlayback(syncedVideoId(), syncedStreamKey(addons), syncedCanonicalKey())
+                pickSavedSyncedSubtitle()
+
+                // Save the synced timing once it has settled (the audio sync keeps refining it).
+                val syncedUrl = AutoSyncSyncedSubtitle.url.value
+                if (syncedUrl != null && syncedUrl == activeSidecarSubtitleKey && syncedUrl !in SyncedSubtitles.restoredUrls) {
+                    val cues = sidecarTimedCues
+                    if (cues !== seenCues) {
+                        seenCues = cues
+                        seenAtMs = System.currentTimeMillis()
+                    } else if (cues.isNotEmpty() && cues !== savedCues && System.currentTimeMillis() - seenAtMs >= SETTLE_MS) {
+                        SyncedSubtitles.save(syncedUrl, syncedCuesToSrt(cues), method = "autosync", nowMs = System.currentTimeMillis())
+                        savedCues = cues
+                        Log.i(TAG, "saved synced subtitle ($syncedUrl, ${cues.size} lines)")
+                    }
+                }
+                delay(LOOP_MS)
+            }
+        } finally {
+            SyncedSubtitles.setPlayback(null, null)
+        }
+    }
+}
+
+/**
+ * Selects a subtitle saved as synced for this title + stream, once per playback: the one already
+ * selected when it is among them, else the latest synced one. A different subtitle the user
+ * picked by hand is kept.
+ */
+private fun PlayerRuntimeController.pickSavedSyncedSubtitle() {
+    val savedState = SyncedSubtitles.saved.value
+    if (savedState == null) {
+        logPickState("nothing saved/pulled for this title + stream yet")
+        return
+    }
+    val (playback, subtitles) = savedState
+    if (playback != SyncedSubtitles.playback.value || subtitles.isEmpty()) {
+        logPickState("pull came back for another playback or is empty")
+        return
+    }
+    val state = _uiState.value
+    if (state.isLoadingAddonSubtitles) {
+        logPickState("addon subtitles still loading")
+        return
+    }
+    if (isUsingMpvEngine()) {
+        logPickState("stream plays on mpv")
+        return
+    }
+    if (_exoPlayer == null) {
+        logPickState("exoPlayer not ready")
+        return
+    }
+    val list = SyncedSubtitles.withEntry(state.addonSubtitles, loading = false)
+    val selected = state.selectedAddonSubtitle
+    val target = selected?.takeIf { it.url in subtitles }
+        ?: subtitles.values.sortedByDescending { it.savedAtMs }
+            .firstNotNullOfOrNull { saved -> list.firstOrNull { it.url == saved.subtitleUrl } }
+        ?: return
+    if (!SyncedSubtitles.claimAutoSelect(playback)) {
+        logPickMiss("auto-select already claimed for this playback")
+        return
+    }
+    if (selected != null && selected.url != target.url && isUserExplicitSubtitleSelection) {
+        logPickMiss("user picked a subtitle by hand (${selected.url})")
+        return
+    }
+    if (selected?.url == target.url && target.url in SyncedSubtitles.restoredUrls) return
+    Log.i(TAG, "picking saved synced subtitle (${target.url})")
+    autoSubtitleSelected = true
+    if (selected?.url != target.url) {
+        stopAutomaticSubtitleSync()
+        selectAddonSubtitle(target)
+    }
+    restoreSyncedSubtitle(target)
+}
+
+private var lastPickMissLogAtMs = 0L
+private var lastPickStateLogAtMs = 0L
+
+/** Logs why no saved subtitle is being picked yet, at most every 60 s (the loop retries). */
+private fun PlayerRuntimeController.logPickState(reason: String) {
+    val now = System.currentTimeMillis()
+    if (now - lastPickStateLogAtMs < 60_000L) return
+    lastPickStateLogAtMs = now
+    Log.i(TAG, "synced pick state: $reason")
+}
+
+/** Logs why the saved subtitle was not auto-picked, at most every 15 s (the loop retries). */
+private fun PlayerRuntimeController.logPickMiss(reason: String) {
+    val now = System.currentTimeMillis()
+    if (now - lastPickMissLogAtMs < 15_000L) return
+    lastPickMissLogAtMs = now
+    Log.i(TAG, "synced pick: $reason")
+}
+
+/** Adds saved synced subtitles that this TV's addons don't list to the player's subtitle list. */
+internal fun withSyncedSubtitleEntries(subtitles: List<Subtitle>, loading: Boolean): List<Subtitle> =
+    SyncedSubtitles.withEntry(subtitles, loading)
+
+/** [cues] as SRT; italic/bold kept as tags, lines placed at the top kept with {\an8}. */
+internal fun syncedCuesToSrt(cues: List<CuesWithTiming>): String {
+    val out = StringBuilder()
+    var index = 1
+    for (entry in cues) {
+        if (entry.startTimeUs == C.TIME_UNSET) continue
+        val endUs = when {
+            entry.endTimeUs != C.TIME_UNSET -> entry.endTimeUs
+            entry.durationUs != C.TIME_UNSET -> entry.startTimeUs + entry.durationUs
+            else -> entry.startTimeUs + 2_000_000L
+        }
+        val text = entry.cues.mapNotNull { cue -> srtCueText(cue) }.joinToString("\n").trim()
+        if (text.isEmpty()) continue
+        val top = entry.cues.any { cue ->
+            cue.lineType == Cue.LINE_TYPE_FRACTION && cue.line != Cue.DIMEN_UNSET && cue.line < 0.4f
+        }
+        out.append(index++).append('\n')
+        out.append(srtTime(entry.startTimeUs)).append(" --> ").append(srtTime(endUs)).append('\n')
+        if (top) out.append("{\\an8}")
+        out.append(text).append("\n\n")
+    }
+    return out.toString()
+}
+
+private fun srtCueText(cue: Cue): String? {
+    val text = cue.text ?: return null
+    if (text !is Spanned) return text.toString()
+    val opens = HashMap<Int, String>()
+    val closes = HashMap<Int, String>()
+    for (span in text.getSpans(0, text.length, StyleSpan::class.java)) {
+        val start = text.getSpanStart(span)
+        val end = text.getSpanEnd(span)
+        if (start < 0 || end <= start) continue
+        opens[start] = opens[start].orEmpty() + srtOpenTag(span.style)
+        closes[end] = srtCloseTag(span.style) + closes[end].orEmpty()
+    }
+    val builder = StringBuilder()
+    for (i in 0..text.length) {
+        closes[i]?.let(builder::append)
+        opens[i]?.let(builder::append)
+        if (i < text.length) builder.append(text[i])
+    }
+    return builder.toString()
+}
+
+private fun srtOpenTag(style: Int) = when (style) {
+    Typeface.ITALIC -> "<i>"
+    Typeface.BOLD -> "<b>"
+    Typeface.BOLD_ITALIC -> "<b><i>"
+    else -> ""
+}
+
+private fun srtCloseTag(style: Int) = when (style) {
+    Typeface.ITALIC -> "</i>"
+    Typeface.BOLD -> "</b>"
+    Typeface.BOLD_ITALIC -> "</i></b>"
+    else -> ""
+}
+
+private fun srtTime(us: Long): String {
+    val totalMs = (us / 1_000L).coerceAtLeast(0L)
+    val h = totalMs / 3_600_000L
+    val m = totalMs / 60_000L % 60
+    val s = totalMs / 1_000L % 60
+    val ms = totalMs % 1_000L
+    return "%02d:%02d:%02d,%03d".format(h, m, s, ms)
+}
