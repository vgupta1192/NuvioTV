+package com.nuvio.tv.ui.screens.player
+
+import androidx.compose.foundation.background
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.width
+import androidx.compose.foundation.lazy.LazyColumn
+import androidx.compose.foundation.lazy.items
+import androidx.compose.foundation.shape.RoundedCornerShape
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.window.Dialog
+import androidx.media3.exoplayer.ExoPlayer
+import androidx.tv.material3.MaterialTheme
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.ui.theme.NuvioTheme
+
+/** Control-bar quality picker: pins a video height of an adaptive stream, or back to Auto. */
+@Composable
+internal fun VideoQualityDialog(exoPlayer: ExoPlayer, onDismiss: () -> Unit) {
+    var options by remember { mutableStateOf(exoPlayer.extractVideoQualities()) }
+    val rightTarget = remember { FocusRequester() }
+    Dialog(onDismissRequest = onDismiss) {
+        Column(
+            modifier = Modifier
+                .width(360.dp)
+                .background(Color(0xE6101010), RoundedCornerShape(NuvioTheme.radii.md))
+                .padding(NuvioTheme.spacing.md)
+        ) {
+            Text(
+                text = stringResource(R.string.player_video_quality),
+                style = MaterialTheme.typography.titleLarge,
+                color = Color.White,
+                modifier = Modifier.padding(bottom = NuvioTheme.spacing.sm)
+            )
+            LazyColumn(modifier = Modifier.fillMaxWidth()) {
+                item(key = "auto") {
+                    VideoQualityCard(
+                        label = stringResource(R.string.player_video_quality_auto),
+                        isSelected = options.none { it.isSelected },
+                        onClick = {
+                            exoPlayer.applyVideoQuality(null)
+                            onDismiss()
+                        },
+                        rightFocusRequester = rightTarget
+                    )
+                }
+                items(items = options, key = { it.heightPx }) { option ->
+                    VideoQualityCard(
+                        label = option.label,
+                        isSelected = option.isSelected,
+                        onClick = {
+                            exoPlayer.applyVideoQuality(option.heightPx)
+                            options = options.map { it.copy(isSelected = it.heightPx == option.heightPx) }
+                            onDismiss()
+                        },
+                        rightFocusRequester = rightTarget
+                    )
+                }
+            }
+        }
+    }
+}
