+    companion object {
+        const val KIND_HLS = "hls"
+        const val KIND_DASH = "dash"
+
+        /** [KIND_HLS] or [KIND_DASH] when [uri] serves such a manifest, by address or first bytes; else null. */
+        fun manifestKind(uri: Uri, dataSourceFactory: DataSource.Factory): String? {
+            val path = uri.path.orEmpty().lowercase()
+            if (path.endsWith(".m3u8")) return KIND_HLS
+            if (path.endsWith(".mpd")) return KIND_DASH
+            val head = sniff(uri, dataSourceFactory) ?: return null
+            return when {
+                head.trimStart('\uFEFF', ' ', '\r', '\n', '\t').startsWith("#EXTM3U") -> KIND_HLS
+                head.contains("<MPD") -> KIND_DASH
+                else -> null
+            }
+        }
+
+        /** Whether [uri] serves an HLS playlist even though its address doesn't say so. Blocking. */
+        fun looksLikePlaylist(uri: Uri, dataSourceFactory: DataSource.Factory): Boolean =
+            sniff(uri, dataSourceFactory)?.trimStart('\uFEFF', ' ', '\r', '\n', '\t')?.startsWith("#EXTM3U") == true
+
+        private fun sniff(uri: Uri, dataSourceFactory: DataSource.Factory): String? {
+            val source = dataSourceFactory.createDataSource()
+            return try {
+                source.open(DataSpec.Builder().setUri(uri).setLength(SNIFF_BYTES.toLong()).build())
+                val buffer = ByteArray(SNIFF_BYTES)
+                var read = 0
+                while (read < buffer.size) {
+                    val count = source.read(buffer, read, buffer.size - read)
+                    if (count <= 0) break
+                    read += count
+                }
+                String(buffer, 0, read, Charsets.UTF_8)
+            } catch (_: Exception) {
+                null
+            } finally {
+                runCatching { source.close() }
+            }
+        }
