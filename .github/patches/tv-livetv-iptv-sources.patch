+/** Fork feature: IPTV sources (M3U / Xtream / Stalker) section of the Live TV sources dialog. */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun TvIptvSourcesSection(
+    sources: List<IptvSource>,
+    errors: Map<String, String>,
+    onToggle: (String) -> Unit,
+    onRemove: (String) -> Unit,
+    onAdd: (IptvSource) -> Unit,
+) {
+    var showAdd by remember { mutableStateOf(false) }
+
+    Text(
+        text = "IPTV sources",
+        style = MaterialTheme.typography.labelLarge,
+        fontWeight = FontWeight.SemiBold,
+        color = Color.White.copy(alpha = 0.7f),
+    )
+    Spacer(modifier = Modifier.height(6.dp))
+
+    if (sources.isEmpty()) {
+        Text(
+            text = "Add an M3U playlist, an Xtream Codes login or a Stalker portal.",
+            style = MaterialTheme.typography.bodySmall,
+            color = Color.White.copy(alpha = 0.5f),
+        )
+    } else {
+        LazyColumn(
+            modifier = Modifier
+                .fillMaxWidth()
+                .height((sources.size.coerceAtMost(3) * 52).dp),
+            verticalArrangement = Arrangement.spacedBy(6.dp),
+        ) {
+            items(sources, key = { it.id }) { source ->
+                val shape = RoundedCornerShape(8.dp)
+                Row(
+                    modifier = Modifier.fillMaxWidth(),
+                    verticalAlignment = Alignment.CenterVertically,
+                    horizontalArrangement = Arrangement.spacedBy(6.dp),
+                ) {
+                    Surface(
+                        onClick = { onToggle(source.id) },
+                        modifier = Modifier.weight(1f),
+                        shape = ClickableSurfaceDefaults.shape(shape),
+                        scale = ClickableSurfaceDefaults.scale(focusedScale = 1.02f),
+                        colors = ClickableSurfaceDefaults.colors(
+                            containerColor = if (source.isEnabled) {
+                                NuvioTheme.colors.Secondary.copy(alpha = 0.16f)
+                            } else {
+                                Color.White.copy(alpha = 0.05f)
+                            },
+                            focusedContainerColor = NuvioTheme.colors.Secondary.copy(alpha = 0.35f),
+                        ),
+                        border = ClickableSurfaceDefaults.border(
+                            focusedBorder = Border(BorderStroke(2.dp, NuvioTheme.colors.Secondary), shape),
+                            border = Border(BorderStroke(1.dp, Color.White.copy(alpha = 0.08f)), shape),
+                        ),
+                    ) {
+                        Row(
+                            modifier = Modifier
+                                .fillMaxWidth()
+                                .padding(horizontal = 12.dp, vertical = 8.dp),
+                            verticalAlignment = Alignment.CenterVertically,
+                            horizontalArrangement = Arrangement.spacedBy(10.dp),
+                        ) {
+                            Column(modifier = Modifier.weight(1f)) {
+                                Text(
+                                    text = source.name,
+                                    style = MaterialTheme.typography.labelLarge,
+                                    fontWeight = FontWeight.SemiBold,
+                                    color = Color.White,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                )
+                                val error = errors[source.id]
+                                Text(
+                                    text = error ?: source.kindLabel,
+                                    style = MaterialTheme.typography.bodySmall,
+                                    color = if (error != null) Color(0xFFFF8A80) else Color.White.copy(alpha = 0.45f),
+                                    fontSize = 11.sp,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                )
+                            }
+                            Box(
+                                modifier = Modifier
+                                    .size(22.dp)
+                                    .clip(RoundedCornerShape(4.dp))
+                                    .border(
+                                        1.dp,
+                                        if (source.isEnabled) NuvioTheme.colors.Secondary else Color.White.copy(alpha = 0.3f),
+                                        RoundedCornerShape(4.dp),
+                                    ),
+                                contentAlignment = Alignment.Center,
+                            ) {
+                                if (source.isEnabled) {
+                                    Icon(
+                                        imageVector = Icons.Rounded.Check,
+                                        contentDescription = null,
+                                        tint = NuvioTheme.colors.Secondary,
+                                        modifier = Modifier.size(14.dp),
+                                    )
+                                }
+                            }
+                        }
+                    }
+                    Button(
+                        onClick = { onRemove(source.id) },
+                        shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+                        colors = ButtonDefaults.colors(
+                            containerColor = Color.White.copy(alpha = 0.10f),
+                            focusedContainerColor = Color(0xFFFF5252),
+                            focusedContentColor = Color.White,
+                        ),
+                    ) {
+                        Icon(
+                            imageVector = Icons.Rounded.Close,
+                            contentDescription = "Remove source",
+                            modifier = Modifier.size(16.dp),
+                        )
+                    }
+                }
+            }
+        }
+    }
+
+    Spacer(modifier = Modifier.height(8.dp))
+    Button(
+        onClick = { showAdd = true },
+        shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+        colors = ButtonDefaults.colors(
+            containerColor = Color.White.copy(alpha = 0.10f),
+            focusedContainerColor = Color.White,
+            focusedContentColor = Color.Black,
+        ),
+        modifier = Modifier.fillMaxWidth(),
+    ) {
+        Text(text = "+ Add IPTV source", fontSize = 12.sp, fontWeight = FontWeight.SemiBold)
+    }
+
+    if (showAdd) {
+        TvIptvAddDialog(
+            onDismiss = { showAdd = false },
+            onAdd = {
+                onAdd(it)
+                showAdd = false
+            },
+        )
+    }
+}
