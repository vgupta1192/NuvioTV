@@ -0,0 +1,455 @@
+package com.nuvio.tv.data.iptv
+
+import android.content.Context
+import android.util.Log
+import com.nuvio.tv.data.repository.epg.EpgSourceConfig
+import com.nuvio.tv.domain.model.ProxyHeaders
+import com.nuvio.tv.domain.model.Stream
+import com.nuvio.tv.domain.model.StreamBehaviorHints
+import com.nuvio.tv.domain.model.TvChannelItem
+import dagger.hilt.android.qualifiers.ApplicationContext
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.async
+import kotlinx.coroutines.awaitAll
+import kotlinx.coroutines.coroutineScope
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withPermit
+import kotlinx.coroutines.withContext
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import org.json.JSONArray
+import org.json.JSONObject
+import java.net.URLEncoder
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.TimeUnit
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/** What one source returned: its channels plus the XMLTV guide URLs it knows about. */
+data class IptvLoadResult(
+    val channels: List<TvChannelItem>,
+    val epgUrls: List<String>,
+)
+
+@Singleton
+class IptvRepository @Inject constructor(
+    @ApplicationContext private val context: Context,
+    okHttpClient: OkHttpClient,
+) {
+    companion object {
+        private const val TAG = "IptvRepository"
+        private const val PREFS = "nuvio_iptv"
+        private const val KEY_SOURCES = "sources"
+        private const val STALKER_UA =
+            "Mozilla/5.0 (QtEmbedded; U; Linux; MAG254; en) AppleWebKit/533.3 MAG200 stbapp ver: 4 rev: 2721 Mobile Safari/533.3"
+        private val STREAM_HEADERS = mapOf("User-Agent" to "Mozilla/5.0", "Accept" to "*/*")
+        private val ATTR_REGEX = Regex("""([A-Za-z0-9_-]+)="([^"]*)"""")
+    }
+
+    private val http: OkHttpClient = okHttpClient.newBuilder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(60, TimeUnit.SECONDS)
+        .followRedirects(true)
+        .build()
+
+    private val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+
+    private val _sources = MutableStateFlow(IptvSource.listFromJson(prefs.getString(KEY_SOURCES, null)))
+    val sources: StateFlow<List<IptvSource>> = _sources.asStateFlow()
+
+    private val _channels = MutableStateFlow<List<TvChannelItem>>(emptyList())
+    val channels: StateFlow<List<TvChannelItem>> = _channels.asStateFlow()
+
+    private val _guides = MutableStateFlow<List<EpgSourceConfig>>(emptyList())
+    val guides: StateFlow<List<EpgSourceConfig>> = _guides.asStateFlow()
+
+    private val _errors = MutableStateFlow<Map<String, String>>(emptyMap())
+    val errors: StateFlow<Map<String, String>> = _errors.asStateFlow()
+
+    private val _isLoading = MutableStateFlow(false)
+    val isLoading: StateFlow<Boolean> = _isLoading.asStateFlow()
+
+    private val cache = ConcurrentHashMap<String, IptvLoadResult>()
+    private val stalkerTokens = ConcurrentHashMap<String, String>()
+    private var loadJob: Job? = null
+    private var started = false
+
+    fun initialize() {
+        if (started) return
+        started = true
+        load(forceReload = false)
+    }
+
+    fun refresh() = load(forceReload = true)
+
+    fun addSource(source: IptvSource) {
+        persist(_sources.value.filterNot { it.id == source.id } + source)
+        load(forceReload = true)
+    }
+
+    fun removeSource(sourceId: String) {
+        persist(_sources.value.filterNot { it.id == sourceId })
+        cache.remove(sourceId)
+        load(forceReload = false)
+    }
+
+    fun toggleSource(sourceId: String) {
+        persist(_sources.value.map { if (it.id == sourceId) it.copy(isEnabled = !it.isEnabled) else it })
+        load(forceReload = false)
+    }
+
+    private fun persist(sources: List<IptvSource>) {
+        _sources.value = sources
+        prefs.edit().putString(KEY_SOURCES, IptvSource.listToJson(sources)).apply()
+    }
+
+    private fun load(forceReload: Boolean) {
+        loadJob?.cancel()
+        val sources = _sources.value.filter { it.isEnabled && it.isConfigured }
+        cache.keys.retainAll(sources.map { it.id }.toSet())
+        if (sources.isEmpty()) {
+            _channels.value = emptyList()
+            _guides.value = emptyList()
+            _errors.value = emptyMap()
+            _isLoading.value = false
+            return
+        }
+        _isLoading.value = true
+        _errors.value = emptyMap()
+        loadJob = scope.launch {
+            val gate = Semaphore(3)
+            val results = coroutineScope {
+                sources.map { source ->
+                    async {
+                        gate.withPermit {
+                            val cached = cache[source.id]
+                            if (cached != null && !forceReload) return@withPermit Triple(source, cached, null as String?)
+                            try {
+                                val loaded = loadSource(source)
+                                cache[source.id] = loaded
+                                Triple(source, loaded, null as String?)
+                            } catch (e: CancellationException) {
+                                throw e
+                            } catch (e: Throwable) {
+                                Log.w(TAG, "IPTV source ${source.name} failed: ${e.message}")
+                                Triple(source, null as IptvLoadResult?, e.message?.take(120) ?: "Could not load this source")
+                            }
+                        }
+                    }
+                }.awaitAll()
+            }
+            _errors.value = results.mapNotNull { (source, _, error) -> error?.let { source.id to it } }.toMap()
+            val seen = HashSet<String>()
+            _channels.value = results.flatMap { (_, loaded, _) -> loaded?.channels.orEmpty() }
+                .filter { seen.add(it.stableKey()) }
+            _guides.value = results.flatMap { (source, loaded, _) ->
+                loaded?.epgUrls.orEmpty().distinct().mapIndexed { index, url ->
+                    EpgSourceConfig(id = "iptv_${source.id}_$index", name = source.name, url = url, isEnabled = true)
+                }
+            }
+            _isLoading.value = false
+        }
+    }
+
+    /** Streams for an IPTV channel; Stalker channels get a fresh play link first. */
+    suspend fun resolveStreams(channel: TvChannelItem): List<Stream> {
+        val sourceId = channel.iptvSourceId ?: return emptyList()
+        val source = _sources.value.firstOrNull { it.id == sourceId } ?: return emptyList()
+        var url = channel.directUrl?.takeIf { it.isNotBlank() }
+        var headers = channel.directHeaders
+        val command = channel.stalkerCommand?.takeIf { it.isNotBlank() }
+        if (source.kind == IptvKind.STALKER && command != null) {
+            val token = stalkerToken(source)
+            val result = stalkerRequest(source, token, "itv", "create_link", mapOf("cmd" to command)).js()
+            val created = (result.str("cmd") ?: result.str("url") ?: result.str("stream_url"))?.playableUrl()
+            url = created?.takeIf { it.isNotBlank() } ?: url
+            headers = stalkerHeaders(source, token)
+        }
+        val resolved = url ?: return emptyList()
+        return listOf(
+            Stream(
+                name = channel.name,
+                title = channel.name,
+                description = source.name,
+                url = resolved,
+                ytId = null,
+                infoHash = null,
+                fileIdx = null,
+                externalUrl = null,
+                behaviorHints = StreamBehaviorHints(
+                    notWebReady = null,
+                    bingeGroup = null,
+                    countryWhitelist = null,
+                    proxyHeaders = headers.takeIf { it.isNotEmpty() }?.let { ProxyHeaders(request = it, response = null) },
+                ),
+                addonName = source.name,
+                addonLogo = null,
+            )
+        )
+    }
+
+    // ---- loading ----
+
+    private suspend fun loadSource(source: IptvSource): IptvLoadResult = withContext(Dispatchers.IO) {
+        when (source.kind) {
+            IptvKind.M3U -> loadM3u(source)
+            IptvKind.XTREAM -> loadXtream(source)
+            IptvKind.STALKER -> loadStalker(source)
+        }
+    }
+
+    private fun channel(
+        source: IptvSource,
+        key: String,
+        name: String,
+        logo: String?,
+        group: String?,
+        directUrl: String?,
+        headers: Map<String, String>,
+        epgId: String?,
+        stalkerCommand: String? = null,
+    ): TvChannelItem {
+        val category = group?.trim()?.takeIf { it.isNotEmpty() } ?: source.name
+        return TvChannelItem(
+            id = "${source.id}:${key.hashCode()}",
+            type = "tv",
+            name = name.trim(),
+            poster = logo,
+            logo = logo,
+            genres = listOf(category),
+            addonName = source.name,
+            addonManifestUrl = "iptv:${source.id}",
+            catalogId = source.id,
+            catalogName = category,
+            directUrl = directUrl,
+            directHeaders = headers,
+            stalkerCommand = stalkerCommand,
+            epgId = epgId,
+            iptvSourceId = source.id,
+        )
+    }
+
+    // ---- M3U ----
+
+    private fun loadM3u(source: IptvSource): IptvLoadResult =
+        parseM3u(httpGet(source.url.trim(), emptyMap()), source)
+
+    internal fun parseM3u(text: String, source: IptvSource): IptvLoadResult {
+        val epgUrls = mutableListOf<String>()
+        val channels = mutableListOf<TvChannelItem>()
+        var attrs: Map<String, String> = emptyMap()
+        var name: String? = null
+        var group: String? = null
+        var userAgent: String? = null
+        var referrer: String? = null
+        for (raw in text.lineSequence()) {
+            val line = raw.trim()
+            if (line.isEmpty()) continue
+            when {
+                line.startsWith("#EXTM3U", ignoreCase = true) -> {
+                    val header = ATTR_REGEX.findAll(line).associate { it.groupValues[1].lowercase() to it.groupValues[2] }
+                    (header["url-tvg"] ?: header["x-tvg-url"] ?: header["tvg-url"])
+                        ?.split(',', ' ')
+                        ?.map { it.trim() }
+                        ?.filter { it.startsWith("http", ignoreCase = true) }
+                        ?.let(epgUrls::addAll)
+                }
+                line.startsWith("#EXTINF", ignoreCase = true) -> {
+                    attrs = ATTR_REGEX.findAll(line).associate { it.groupValues[1].lowercase() to it.groupValues[2] }
+                    val tail = line.substringAfterLast('"', line)
+                    name = tail.substringAfter(',', "").trim().ifBlank { attrs["tvg-name"] }
+                    group = attrs["group-title"]?.trim()?.takeIf { it.isNotEmpty() }
+                }
+                line.startsWith("#EXTGRP:", ignoreCase = true) -> {
+                    if (group == null) group = line.substringAfter(':').trim().takeIf { it.isNotEmpty() }
+                }
+                line.startsWith("#EXTVLCOPT:", ignoreCase = true) -> {
+                    val option = line.substringAfter(':')
+                    when (option.substringBefore('=').lowercase()) {
+                        "http-user-agent" -> userAgent = option.substringAfter('=').trim()
+                        "http-referrer", "http-referer" -> referrer = option.substringAfter('=').trim()
+                    }
+                }
+                line.startsWith("#") -> Unit
+                else -> {
+                    val channelName = name
+                    if (!channelName.isNullOrBlank()) {
+                        val headers = buildMap {
+                            userAgent?.takeIf { it.isNotBlank() }?.let { put("User-Agent", it) }
+                            referrer?.takeIf { it.isNotBlank() }?.let { put("Referer", it) }
+                        }
+                        channels += channel(
+                            source = source,
+                            key = line,
+                            name = channelName,
+                            logo = attrs["tvg-logo"]?.takeIf { it.isNotBlank() },
+                            group = group,
+                            directUrl = line,
+                            headers = headers,
+                            epgId = attrs["tvg-id"]?.takeIf { it.isNotBlank() },
+                        )
+                    }
+                    attrs = emptyMap(); name = null; group = null; userAgent = null; referrer = null
+                }
+            }
+        }
+        val extra = source.epgUrl.trim().takeIf { it.isNotBlank() }
+        return IptvLoadResult(channels.distinctBy { it.id }, listOfNotNull(extra) + epgUrls)
+    }
+
+    // ---- Xtream Codes ----
+
+    private fun enc(value: String) = URLEncoder.encode(value, "UTF-8").replace("+", "%20")
+
+    private fun loadXtream(source: IptvSource): IptvLoadResult {
+        val server = source.url.trim().trimEnd('/').substringBefore("/player_api.php").trimEnd('/')
+        val user = source.username.trim()
+        val pass = source.password.trim()
+        fun call(action: String): Any? {
+            val url = "$server/player_api.php?username=${enc(user)}&password=${enc(pass)}&action=${enc(action)}"
+            val body = httpGet(url, mapOf("Accept" to "application/json, text/plain, */*", "User-Agent" to "Nuvio/1.0")).trim()
+            return when {
+                body.startsWith("[") -> JSONArray(body)
+                body.startsWith("{") -> JSONObject(body)
+                else -> null
+            }
+        }
+        fun rows(value: Any?): List<JSONObject> {
+            val arr = when (value) {
+                is JSONArray -> value
+                is JSONObject -> value.optJSONArray("data") ?: JSONArray()
+                else -> JSONArray()
+            }
+            return (0 until arr.length()).mapNotNull { arr.optJSONObject(it) }
+        }
+        val categories = rows(call("get_live_categories")).mapNotNull { item ->
+            val id = item.str("category_id") ?: item.str("id") ?: return@mapNotNull null
+            id to (item.str("category_name") ?: item.str("name") ?: id)
+        }.toMap()
+        val channels = rows(call("get_live_streams")).mapNotNull { item ->
+            val name = item.str("name") ?: return@mapNotNull null
+            val streamId = item.str("stream_id") ?: item.str("id") ?: return@mapNotNull null
+            val extension = item.str("container_extension")?.trim()?.trimStart('.')?.ifBlank { null } ?: "ts"
+            val direct = item.str("direct_source")?.takeIf { it.startsWith("http://") || it.startsWith("https://") }
+            val url = direct ?: "$server/live/${enc(user)}/${enc(pass)}/${enc(streamId)}.${enc(extension)}"
+            channel(
+                source = source,
+                key = "x$streamId",
+                name = name,
+                logo = item.str("stream_icon") ?: item.str("logo"),
+                group = item.str("category_id")?.let(categories::get),
+                directUrl = url,
+                headers = STREAM_HEADERS,
+                epgId = item.str("epg_channel_id"),
+            )
+        }.distinctBy { it.id }
+        val epg = source.epgUrl.trim().ifBlank { "$server/xmltv.php?username=${enc(user)}&password=${enc(pass)}" }
+        return IptvLoadResult(channels, listOf(epg))
+    }
+
+    // ---- Stalker (MAG) portal ----
+
+    private fun loadStalker(source: IptvSource): IptvLoadResult {
+        stalkerTokens.remove(source.id)
+        val token = stalkerToken(source)
+        val genres = stalkerRequest(source, token, "itv", "get_genres").js().arr("data").mapNotNull { item ->
+            val id = item.str("id") ?: item.str("alias") ?: return@mapNotNull null
+            id to (item.str("title") ?: item.str("name") ?: id)
+        }.toMap()
+        val channels = mutableListOf<TvChannelItem>()
+        for (page in 1..60) {
+            val data = stalkerRequest(source, token, "itv", "get_ordered_list", mapOf("p" to page.toString())).js().arr("data")
+            if (data.isEmpty()) break
+            data.forEachIndexed { index, item ->
+                val command = item.str("cmd") ?: item.str("mc_cmd") ?: item.str("url") ?: return@forEachIndexed
+                val name = item.str("name") ?: item.str("title") ?: return@forEachIndexed
+                val url = command.playableUrl()
+                channels += channel(
+                    source = source,
+                    key = "s${item.str("id") ?: "$page:$index"}",
+                    name = name,
+                    logo = item.str("logo") ?: item.str("logo_url"),
+                    group = (item.str("tv_genre_id") ?: item.str("genre_id"))?.let(genres::get),
+                    directUrl = url.takeIf { it.startsWith("http") },
+                    headers = stalkerHeaders(source, token),
+                    epgId = item.str("xmltv_id"),
+                    stalkerCommand = command,
+                )
+            }
+        }
+        return IptvLoadResult(channels.distinctBy { it.id }, listOfNotNull(source.epgUrl.trim().takeIf { it.isNotBlank() }))
+    }
+
+    private fun stalkerToken(source: IptvSource): String =
+        stalkerTokens[source.id] ?: run {
+            val token = stalkerRequest(source, null, "stb", "handshake").js().str("token").orEmpty()
+            require(token.isNotBlank()) { "Stalker portal did not return an authorization token" }
+            stalkerTokens[source.id] = token
+            token
+        }
+
+    private fun stalkerRequest(
+        source: IptvSource,
+        token: String?,
+        type: String,
+        action: String,
+        extra: Map<String, String> = emptyMap(),
+    ): JSONObject {
+        val parameters = linkedMapOf("type" to type, "action" to action, "JsHttpRequest" to "1-xml")
+        if (!token.isNullOrBlank()) parameters["token"] = token
+        if (source.username.isNotBlank()) parameters["login"] = source.username.trim()
+        if (source.password.isNotBlank()) parameters["password"] = source.password.trim()
+        parameters.putAll(extra)
+        val endpoint = stalkerEndpoint(source)
+        val query = parameters.entries.joinToString("&", prefix = if ('?' in endpoint) "&" else "?") { (k, v) -> "${enc(k)}=${enc(v)}" }
+        return JSONObject(httpGet(endpoint + query, stalkerHeaders(source, token)))
+    }
+
+    private fun stalkerEndpoint(source: IptvSource): String {
+        val url = source.url.trim().trimEnd('/')
+        return when {
+            url.contains("portal.php", ignoreCase = true) -> url
+            url.contains("server/load.php", ignoreCase = true) -> url
+            url.endsWith("/c", ignoreCase = true) -> url.dropLast(2) + "/portal.php"
+            else -> "$url/portal.php"
+        }
+    }
+
+    private fun stalkerHeaders(source: IptvSource, token: String?): Map<String, String> = buildMap {
+        val base = source.url.trim().substringBefore("/portal.php").substringBefore("/server/load.php").trimEnd('/').removeSuffix("/c")
+        put("User-Agent", STALKER_UA)
+        put("X-User-Agent", "Model: MAG254; Link: Ethernet")
+        put("Referer", "$base/c/")
+        put("Cookie", "mac=${source.mac.trim().uppercase()}; stb_lang=en; timezone=Europe%2FIstanbul")
+        if (!token.isNullOrBlank()) put("Authorization", "Bearer $token")
+    }
+
+    // ---- helpers ----
+
+    private fun httpGet(url: String, headers: Map<String, String>): String {
+        val request = Request.Builder().url(url).apply { headers.forEach { (k, v) -> header(k, v) } }.build()
+        http.newCall(request).execute().use { response ->
+            if (!response.isSuccessful) error("HTTP ${response.code} from ${request.url.host}")
+            return response.body?.string().orEmpty()
+        }
+    }
+
+    private fun String.playableUrl() = trim().removePrefix("ffmpeg ").removePrefix("auto ").substringBefore(' ').trim()
+    private fun JSONObject.js(): JSONObject = optJSONObject("js") ?: this
+    private fun JSONObject.str(key: String): String? =
+        if (isNull(key)) null else opt(key)?.toString()?.trim()?.takeIf { it.isNotBlank() }
+    private fun JSONObject.arr(key: String): List<JSONObject> {
+        val arr = optJSONArray(key) ?: return emptyList()
+        return (0 until arr.length()).mapNotNull { arr.optJSONObject(it) }
+    }
+}
