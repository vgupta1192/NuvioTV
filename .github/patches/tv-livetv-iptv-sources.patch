+package com.nuvio.tv.data.iptv
+
+import org.json.JSONArray
+import org.json.JSONObject
+
+/**
+ * Fork feature: custom IPTV sources for Live TV next to the addon channels. A source is an M3U
+ * playlist URL, an Xtream Codes login or a Stalker (MAG) portal.
+ */
+enum class IptvKind { M3U, XTREAM, STALKER }
+
+data class IptvSource(
+    val id: String,
+    val kind: IptvKind,
+    val name: String,
+    /** M3U playlist URL, Xtream server URL or Stalker portal URL. */
+    val url: String,
+    val username: String = "",
+    val password: String = "",
+    /** Stalker only. */
+    val mac: String = "",
+    /** Optional XMLTV guide URL (Xtream and M3U playlists often carry their own). */
+    val epgUrl: String = "",
+    val isEnabled: Boolean = true,
+) {
+    val isConfigured: Boolean
+        get() = when (kind) {
+            IptvKind.M3U -> url.isNotBlank()
+            IptvKind.XTREAM -> url.isNotBlank() && username.isNotBlank() && password.isNotBlank()
+            IptvKind.STALKER -> url.isNotBlank() && mac.isNotBlank()
+        }
+
+    val kindLabel: String
+        get() = when (kind) {
+            IptvKind.M3U -> "M3U playlist"
+            IptvKind.XTREAM -> "Xtream Codes"
+            IptvKind.STALKER -> "Stalker portal"
+        }
+
+    fun toJson(): JSONObject = JSONObject()
+        .put("id", id).put("kind", kind.name).put("name", name).put("url", url)
+        .put("username", username).put("password", password).put("mac", mac)
+        .put("epgUrl", epgUrl).put("isEnabled", isEnabled)
+
+    companion object {
+        fun fromJson(o: JSONObject): IptvSource? {
+            val kind = runCatching { IptvKind.valueOf(o.optString("kind")) }.getOrNull() ?: return null
+            val id = o.optString("id").takeIf { it.isNotBlank() } ?: return null
+            return IptvSource(
+                id = id,
+                kind = kind,
+                name = o.optString("name"),
+                url = o.optString("url"),
+                username = o.optString("username"),
+                password = o.optString("password"),
+                mac = o.optString("mac"),
+                epgUrl = o.optString("epgUrl"),
+                isEnabled = o.optBoolean("isEnabled", true),
+            )
+        }
+
+        fun listToJson(list: List<IptvSource>): String =
+            JSONArray().also { arr -> list.forEach { arr.put(it.toJson()) } }.toString()
+
+        fun listFromJson(text: String?): List<IptvSource> {
+            if (text.isNullOrBlank()) return emptyList()
+            return runCatching {
+                val arr = JSONArray(text)
+                (0 until arr.length()).mapNotNull { fromJson(arr.getJSONObject(it)) }
+            }.getOrDefault(emptyList())
+        }
+    }
+}
diff --git a/app/src/main/java/com/nuvio/tv/data/iptv/IptvRepository.kt b/app/src/main/java/com/nuvio/tv/data/iptv/IptvRepository.kt
