+    var password by remember { mutableStateOf("") }
+    var mac by remember { mutableStateOf("00:1A:79:") }
+    var epgUrl by remember { mutableStateOf("") }
+
+    val draft = IptvSource(
+        id = "src" + System.currentTimeMillis(),
+        kind = kind,
+        name = name.trim().ifBlank {
+            when (kind) {
+                IptvKind.M3U -> "M3U playlist"
+                IptvKind.XTREAM -> "Xtream"
+                IptvKind.STALKER -> "Stalker"
+            }
+        },
+        url = url.trim(),
+        username = username.trim(),
+        password = password.trim(),
+        mac = mac.trim(),
+        epgUrl = epgUrl.trim(),
+    )
+
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = "Add IPTV source",
+        width = 540.dp,
+        contentPadding = 16.dp,
+        contentSpacing = 8.dp,
+    ) {
+        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            IptvKind.entries.forEach { option ->
+                Button(
+                    onClick = { kind = option },
+                    shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+                    colors = ButtonDefaults.colors(
+                        containerColor = if (option == kind) NuvioTheme.colors.Secondary else Color.White.copy(alpha = 0.10f),
+                        focusedContainerColor = Color.White,
+                        focusedContentColor = Color.Black,
+                    ),
+                    modifier = Modifier.weight(1f),
+                ) {
+                    Text(
+                        text = when (option) {
+                            IptvKind.M3U -> "M3U"
+                            IptvKind.XTREAM -> "Xtream"
+                            IptvKind.STALKER -> "Stalker"
+                        },
+                        fontSize = 12.sp,
+                        fontWeight = FontWeight.SemiBold,
+                    )
+                }
+            }
+        }
+        NuvioTextField(value = name, onValueChange = { name = it }, modifier = Modifier.fillMaxWidth(), placeholder = "Name (optional)")
+        NuvioTextField(
+            value = url,
+            onValueChange = { url = it },
+            modifier = Modifier.fillMaxWidth(),
+            placeholder = when (kind) {
+                IptvKind.M3U -> "Playlist URL (.m3u / .m3u8)"
+                IptvKind.XTREAM -> "Server URL, e.g. http://host:8080"
+                IptvKind.STALKER -> "Portal URL, e.g. http://host/c/"
+            },
+        )
+        if (kind != IptvKind.M3U) {
+            NuvioTextField(
+                value = username,
+                onValueChange = { username = it },
+                modifier = Modifier.fillMaxWidth(),
+                placeholder = if (kind == IptvKind.XTREAM) "Username" else "Login (optional)",
+            )
+            NuvioTextField(
+                value = password,
+                onValueChange = { password = it },
+                modifier = Modifier.fillMaxWidth(),
+                placeholder = if (kind == IptvKind.XTREAM) "Password" else "Password (optional)",
+            )
+        }
+        if (kind == IptvKind.STALKER) {
+            NuvioTextField(value = mac, onValueChange = { mac = it }, modifier = Modifier.fillMaxWidth(), placeholder = "MAC address")
+        } else {
+            NuvioTextField(value = epgUrl, onValueChange = { epgUrl = it }, modifier = Modifier.fillMaxWidth(), placeholder = "Guide URL (optional XMLTV)")
+        }
+        Row(modifier = Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            Button(
+                onClick = onDismiss,
+                shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+                colors = ButtonDefaults.colors(
+                    containerColor = Color.White.copy(alpha = 0.10f),
+                    focusedContainerColor = Color.White,
+                    focusedContentColor = Color.Black,
+                ),
+                modifier = Modifier.weight(1f),
+            ) { Text(text = "Cancel", fontSize = 12.sp, fontWeight = FontWeight.SemiBold) }
+            Button(
+                onClick = { if (draft.isConfigured) onAdd(draft) },
+                shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+                colors = ButtonDefaults.colors(
+                    containerColor = NuvioTheme.colors.Secondary,
+                    focusedContainerColor = Color.White,
+                    focusedContentColor = Color.Black,
+                ),
+                modifier = Modifier.weight(1f),
+            ) { Text(text = if (draft.isConfigured) "Add" else "Fill the fields", fontSize = 12.sp, fontWeight = FontWeight.Bold) }
+        }
+    }
+}
