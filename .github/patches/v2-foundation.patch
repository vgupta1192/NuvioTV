diff --git a/app/src/test/java/com/nuvio/tv/ui/navigation/ProfileNavigationViewModelStoreOwnerTest.kt b/app/src/test/java/com/nuvio/tv/ui/navigation/ProfileNavigationViewModelStoreOwnerTest.kt
new file mode 100644
