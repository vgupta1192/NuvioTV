+    /**
+     * The audio sync found no better timing for [url]. True when the user asked to sync it again
+     * and a saved timing exists: the caller then shows the saved one instead of leaving the
+     * subtitle on its original timing.
+     */
+    fun resyncGaveUp(url: String): Boolean {
+        val pending = forceResync.filter { nvioSameSubtitleFile(it, url) }
+        if (pending.isEmpty()) return false
+        forceResync.removeAll(pending.toSet())
+        return savedFor(url) != null
+    }
