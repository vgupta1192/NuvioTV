+
+    @Test
+    fun noIndexIsBuiltBeforeATitleNeedsOne() = runBlocking {
+        val provider = FakeServerProvider().apply {
+            indexedIds["42"] = TrackingExternalIds(imdb = "tt0078788")
+            titleLookup = { _, query -> listOf(ServerIndexEntry("42", query.ids)) }
+        }
