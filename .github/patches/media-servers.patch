+                    "VideoRange": "HDR", "VideoRangeType": "DOVIWithHDR10", "DvProfile": 7, "DvBlSignalCompatibilityId": 6,
+                    "DisplayTitle": "4K HEVC Dolby Vision Profile 7.6 (HDR10)"},
