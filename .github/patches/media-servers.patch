+                                color = NuvioTheme.colors.TextSecondary,
+                                modifier = Modifier.padding(horizontal = NuvioTheme.spacing.sm)
+                            )
+                        }
+                    }
+                    items(connection.libraries, key = { "library_${it.id}" }) { library ->
