diff --git a/app/src/full/java/com/nuvio/tv/updater/UpdateViewModel.kt b/app/src/full/java/com/nuvio/tv/updater/UpdateViewModel.kt
index 57c58ca9..bc6591b9 100644
--- a/app/src/full/java/com/nuvio/tv/updater/UpdateViewModel.kt
+++ b/app/src/full/java/com/nuvio/tv/updater/UpdateViewModel.kt
@@ -310,18 +310,21 @@ class UpdateViewModel @Inject constructor(
             return
         }
 
-        if (!ApkInstaller.canRequestPackageInstalls(context)) {
-            _uiState.update { it.copy(showUnknownSourcesDialog = true, showBanner = true) }
-            return
-        }
-
+        // Try the real install first: the session install never consults our own pre-check, so a
+        // false-negative permission read cannot block an install the system would allow. When the
+        // session fails, hand the APK to the system installer screen, which carries the
+        // "install unknown apps" grant interactively on devices that resolve it. The in-app
+        // dialog is the last resort for TVs where neither path can run.
         _uiState.update { it.copy(showUnknownSourcesDialog = false) }
         viewModelScope.launch(Dispatchers.IO) {
-            runCatching { ApkInstaller.install(context, apkFile, background = false) }
-                .onFailure {
-                    Log.w(TAG, "Session install failed, falling back to the system installer", it)
-                    ApkInstaller.launchSystemInstaller(context, apkFile)
+            val sessionInstalled = runCatching { ApkInstaller.install(context, apkFile, background = false) }
+            if (sessionInstalled.isFailure) {
+                Log.w(TAG, "Session install failed, trying the system installer", sessionInstalled.exceptionOrNull())
+                val handedOff = runCatching { ApkInstaller.launchSystemInstaller(context, apkFile) }
+                if (handedOff.isFailure) {
+                    _uiState.update { it.copy(showUnknownSourcesDialog = true, showBanner = true) }
                 }
+            }
         }
     }
 
