+/**
+ * The full list of suggested videos, opened with the Down key while a video plays, like the list under a
+ * YouTube video. Up and Down move the highlight and scroll it into view, OK plays the highlighted video.
+ * Back is handled by the player's key hook, which closes the list.
+ */
+@Composable
+fun BoxScope.YouTubeUpNextList(
+    videoId: String,
+    viewModel: YouTubeViewModel,
+    onPlay: (YtItem, List<YtItem>) -> Unit
+) {
+    val related by viewModel.related.collectAsState()
+    val loading by viewModel.relatedLoading.collectAsState()
+    LaunchedEffect(videoId) { viewModel.loadRelated(videoId) }
+
+    val listState = rememberLazyListState()
+    val focus = remember { FocusRequester() }
+    var selected by remember { mutableIntStateOf(0) }
+    LaunchedEffect(Unit) { runCatching { focus.requestFocus() } }
+    LaunchedEffect(related.size) {
+        if (selected > related.lastIndex) selected = related.lastIndex.coerceAtLeast(0)
+    }
+    // Keep the highlighted row in view, only scrolling when it is not fully visible.
+    LaunchedEffect(selected, related.size) {
+        if (related.isEmpty()) return@LaunchedEffect
+        val info = listState.layoutInfo
+        val row = info.visibleItemsInfo.firstOrNull { it.index == selected }
+        val fullyVisible = row != null && row.offset >= 0 && row.offset + row.size <= info.viewportEndOffset
+        if (!fullyVisible) listState.animateScrollToItem(selected)
+    }
+
+    Column(
+        Modifier
+            .align(Alignment.CenterEnd)
+            .fillMaxHeight()
+            .width(460.dp)
+            .background(Color(0xF2111114))
+            .padding(horizontal = 20.dp, vertical = 22.dp)
+            .focusRequester(focus)
+            .focusable()
+            .onPreviewKeyEvent { e ->
+                val handled = when (e.key) {
+                    Key.DirectionDown, Key.DirectionUp, Key.DirectionLeft, Key.DirectionRight,
+                    Key.DirectionCenter, Key.Enter, Key.NumPadEnter -> true
+                    else -> false
+                }
+                if (handled && e.type == KeyEventType.KeyDown) {
+                    when (e.key) {
+                        Key.DirectionDown -> if (selected < related.lastIndex) selected += 1
+                        Key.DirectionUp -> if (selected > 0) selected -= 1
+                        Key.DirectionCenter, Key.Enter, Key.NumPadEnter ->
+                            related.getOrNull(selected)?.let { onPlay(it, related) }
+                        else -> Unit
+                    }
+                }
+                handled
+            },
+        verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Text("Up next", color = Color.White, fontSize = 20.sp, fontWeight = FontWeight.Bold)
+        if (related.isEmpty()) {
+            Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                if (loading) CircularProgressIndicator(color = Color.White)
+                else Text("No suggestions for this video.", color = Color(0xFFBBBBBB), fontSize = 14.sp)
+            }
+        } else {
+            LazyColumn(
+                state = listState,
+                modifier = Modifier.fillMaxSize(),
+                verticalArrangement = Arrangement.spacedBy(10.dp)
+            ) {
+                itemsIndexed(related, key = { _, item -> item.videoId ?: item.title }) { index, item ->
+                    val isSelected = index == selected
+                    Row(
+                        Modifier
+                            .fillMaxWidth()
+                            .clip(RoundedCornerShape(10.dp))
+                            .background(if (isSelected) Color(0xFF2A2A2E) else Color(0xFF1B1B1F))
+                            .border(2.dp, if (isSelected) Color.White else Color.Transparent, RoundedCornerShape(10.dp))
+                            .padding(8.dp),
