+
+    fun loadRelated(currentVideoId: String) {
+        if (relatedFor == currentVideoId && _related.value.isNotEmpty()) return
+        relatedFor = currentVideoId
+        _related.value = emptyList()
+        _relatedLoading.value = true
+        viewModelScope.launch {
