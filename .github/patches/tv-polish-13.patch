+                        .filter { it.kind == YtKind.VIDEO && it.videoId != currentVideoId }
+                        .distinctBy { it.videoId }
+                }.getOrDefault(emptyList())
+            }
+            if (relatedFor == currentVideoId) {
+                _related.value = items
+                _relatedLoading.value = false
+            }
+        }
+    }
