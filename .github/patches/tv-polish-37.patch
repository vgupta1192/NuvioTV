+/**
+ * YouTube fork: 1440p and 4K come only in VP9/AV1, and a box without a fast decoder drops frames there. When the
+ * player keeps dropping frames on a tall size, step down one size (twice at most per video) instead of stuttering.
+ */
+internal fun PlayerRuntimeController.youtubeOnDroppedFrames(droppedFrames: Int, elapsedMs: Long) {
+    val player = _exoPlayer ?: return
+    if (!com.nuvio.tv.youtube.YouTubeProgress.isYouTubeId(contentId)) return
+    if (youtubeDropKey != contentId) {
+        youtubeDropKey = contentId
+        youtubeDropStrikes = 0
+        youtubeStepDowns = 0
+    }
+    val current = player.videoFormat?.height ?: return
+    if (current <= 1080 || youtubeStepDowns >= 2 || elapsedMs <= 0L) return
+    val perSecond = droppedFrames * 1000f / elapsedMs
+    if (droppedFrames < 8 || perSecond < 4f) {
+        youtubeDropStrikes = 0
+        return
+    }
+    if (++youtubeDropStrikes < 2) return
+    val lower = player.currentTracks.groups
+        .filter { it.type == C.TRACK_TYPE_VIDEO }
+        .flatMap { g -> (0 until g.length).filter { g.isTrackSupported(it) }.map { g.getTrackFormat(it).height } }
+        .filter { it in 1..(current - 1) }
+        .maxOrNull() ?: return
+    youtubeDropStrikes = 0
+    youtubeStepDowns++
+    selectVideoQuality(lower)
+    android.os.Handler(android.os.Looper.getMainLooper()).post {
+        android.widget.Toast.makeText(context, "Dropping frames at ${current}p. Switched to ${lower}p.", android.widget.Toast.LENGTH_LONG).show()
+    }
 }
 
