+++ b/app/src/main/java/com/nuvio/tv/ui/screens/settings/TvIptvSettingsGroup.kt
@@ -0,0 +1,95 @@
+@file:OptIn(ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.filled.Add
+import androidx.compose.material.icons.filled.Delete
+import androidx.compose.material.icons.filled.Refresh
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.hilt.navigation.compose.hiltViewModel
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import com.nuvio.tv.data.iptv.IptvRepository
+import com.nuvio.tv.data.iptv.IptvSource
+import com.nuvio.tv.ui.screens.tvchannels.components.TvIptvAddDialog
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+
+@HiltViewModel
+class TvIptvSettingsViewModel @Inject constructor(
+    private val iptvRepository: IptvRepository
+) : ViewModel() {
+    val sources = iptvRepository.sources
+    val errors = iptvRepository.errors
+    val isLoading = iptvRepository.isLoading
+
+    fun add(source: IptvSource) = iptvRepository.addSource(source)
+    fun remove(sourceId: String) = iptvRepository.removeSource(sourceId)
+    fun toggle(sourceId: String) = iptvRepository.toggleSource(sourceId)
+    fun refresh() = iptvRepository.refresh()
+}
+
+/** Settings → Live TV: add, switch on or off, remove and reload M3U / Xtream / Stalker sources. */
+@Composable
+internal fun TvIptvSettingsGroup(
+    viewModel: TvIptvSettingsViewModel = hiltViewModel()
+) {
+    val sources by viewModel.sources.collectAsStateWithLifecycle()
+    val errors by viewModel.errors.collectAsStateWithLifecycle()
+    val isLoading by viewModel.isLoading.collectAsStateWithLifecycle()
+    var showAdd by remember { mutableStateOf(false) }
+
+    SettingsGroupCard(
+        modifier = Modifier.fillMaxWidth(),
+        title = "IPTV sources",
+        subtitle = "M3U playlists, Xtream Codes logins and Stalker portals. Their channels appear in Live TV."
+    ) {
+        sources.forEach { source ->
+            SettingsToggleRow(
+                title = source.name,
+                subtitle = errors[source.id] ?: source.kindLabel,
+                checked = source.isEnabled,
+                onToggle = { viewModel.toggle(source.id) }
+            )
+            SettingsActionRow(
+                title = "Remove ${source.name}",
+                subtitle = source.url,
+                leadingIcon = Icons.Default.Delete,
+                onClick = { viewModel.remove(source.id) }
+            )
+        }
+        SettingsActionRow(
+            title = "Add IPTV source",
+            subtitle = "M3U playlist link, Xtream Codes login or Stalker portal",
+            leadingIcon = Icons.Default.Add,
+            onClick = { showAdd = true }
+        )
+        if (sources.isNotEmpty()) {
+            SettingsActionRow(
+                title = "Reload IPTV sources",
+                subtitle = if (isLoading) "Loading channels..." else "Fetch the playlists and guides again",
+                leadingIcon = Icons.Default.Refresh,
+                enabled = !isLoading,
+                onClick = { viewModel.refresh() }
+            )
+        }
+    }
+
+    if (showAdd) {
+        TvIptvAddDialog(
+            onDismiss = { showAdd = false },
+            onAdd = {
+                viewModel.add(it)
+                showAdd = false
+            }
+        )
+    }
+}
