@@ -0,0 +1,38 @@
+package com.nuvio.tv.core.streams
+
+import com.nuvio.tv.domain.model.AddonStreams
+
+/**
+ * Process-wide handoff of the Stream screen's loaded results so the player's Sources panel can
+ * show the same links (and per-source counts) instantly instead of re-querying every addon.
+ * Entries are keyed to the exact request and expire; an explicit refresh always bypasses it.
+ */
+object StreamScreenResultsCache {
+    private const val MAX_AGE_MS = 15 * 60_000L
+
+    private data class Entry(
+        val type: String,
+        val videoId: String,
+        val season: Int?,
+        val episode: Int?,
+        val groups: List<AddonStreams>,
+        val savedAtMs: Long
+    )
+
+    @Volatile private var entry: Entry? = null
+
+    fun put(type: String, videoId: String, season: Int?, episode: Int?, groups: List<AddonStreams>) {
+        entry = Entry(type, videoId, season, episode, groups, System.currentTimeMillis())
+    }
+
+    fun find(type: String, videoId: String, season: Int?, episode: Int?): List<AddonStreams>? {
+        val e = entry ?: return null
+        if (e.type != type || e.videoId != videoId || e.season != season || e.episode != episode) return null
+        if (System.currentTimeMillis() - e.savedAtMs > MAX_AGE_MS) return null
+        return e.groups
+    }
+
+    fun clear() {
+        entry = null
+    }
+}
