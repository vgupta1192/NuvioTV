--- /dev/null
+++ b/app/src/main/java/com/nuvio/tv/data/repository/ForkMemoryTrim.kt
@@ -0,0 +1,20 @@
+package com.nuvio.tv.data.repository
+
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * Nuvio fork: lets in-memory caches shed entries when Android reports memory pressure.
+ * Caches register once; NuvioApplication.onTrimMemory and low-RAM prewarm call [dispatch].
+ */
+object ForkMemoryTrim {
+    private val listeners = CopyOnWriteArrayList<(Int) -> Unit>()
+
+    fun register(listener: (Int) -> Unit) {
+        listeners.add(listener)
+    }
+
+    /** [level] uses the ComponentCallbacks2 TRIM_MEMORY_* values. */
+    fun dispatch(level: Int) {
+        listeners.forEach { runCatching { it(level) } }
+    }
+}
