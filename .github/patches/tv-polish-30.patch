+    /** Cap for the player back buffer in low-RAM mode (custom buffer engine only). */
+    const val BACK_BUFFER_CAP_MS = 20_000
+
+    /** Completed stream searches kept in low-RAM mode. */
+    const val STREAM_SESSIONS_KEPT = 3
+
+    @Volatile
+    private var lowRamDevice: Boolean? = null
+
+    /** On when the user turned it on, or when Android reports a low-RAM device. */
+    fun active(context: Context): Boolean {
+        if (ForkTvPreferences.lowRamMode.current(context)) return true
+        val cached = lowRamDevice
+        if (cached != null) return cached
+        val detected = runCatching {
+            (context.applicationContext.getSystemService(Context.ACTIVITY_SERVICE) as? android.app.ActivityManager)
+                ?.isLowRamDevice == true
+        }.getOrDefault(false)
+        lowRamDevice = detected
+        return detected
+    }
 
     fun decodeScale(context: Context): Float = if (active(context)) DECODE_SCALE else 1f
 }
