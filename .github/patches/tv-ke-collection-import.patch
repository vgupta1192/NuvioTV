+        CollectionImportItemStatus.SKIPPED -> stringResource(R.string.collections_import_status_skipped)
+    }
+    val statusColor = when (item.status) {
+        CollectionImportItemStatus.OK -> NuvioTheme.colors.Success
+        CollectionImportItemStatus.WARNING -> NuvioTheme.colors.Warning
+        CollectionImportItemStatus.SKIPPED -> NuvioTheme.colors.Error
+    }
+    Column(modifier = Modifier.fillMaxWidth()) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(
+                text = item.title?.let { title ->
+                    stringResource(R.string.collections_import_item_label, item.index) + " · " + title
