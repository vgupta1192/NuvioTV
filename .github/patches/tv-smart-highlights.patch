+/**
+ * The modern layout's Smart Highlights carousel row. Built outside the ViewModel presentation
+ * pipeline so ranking arriving late simply adds this row (or reorders its items) without
+ * touching the cached catalog rows beside it. [globalRowIndex] stays -1 like the continue
+ * watching row: the rail is not one of the catalog rows the vertical scroll map indexes.
+ */
+internal fun buildSmartHighlightsCarouselRow(
+    picks: List<SmartHighlightPick>,
+    rowTitle: String,
+    useLandscapePosters: Boolean,
+    showFullReleaseDate: Boolean,
+    showImdbRatings: Boolean,
+    strTypeMovie: String,
+    strTypeSeries: String
+): HeroCarouselRow? {
+    if (picks.isEmpty()) return null
+    val row = smartHighlightsCatalogRow()
+    return HeroCarouselRow(
+        key = SMART_HIGHLIGHTS_ROW_KEY,
+        title = rowTitle,
+        globalRowIndex = -1,
+        items = picks.mapIndexed { index, pick ->
+            val built = buildCatalogItem(
+                item = pick.item,
+                row = row,
+                useLandscapePosters = useLandscapePosters,
+                occurrence = index,
+                strTypeMovie = strTypeMovie,
+                strTypeSeries = strTypeSeries,
+                showFullReleaseDate = showFullReleaseDate,
+                showImdbRatings = showImdbRatings
+            )
+            built.copy(
+                key = row.stableItemKey(pick.item, index),
+                reasonChip = pick.reason.takeIf { it.isNotBlank() },
