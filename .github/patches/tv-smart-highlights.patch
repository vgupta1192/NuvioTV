+package com.nuvio.tv.data.gemini
+
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.longPreferencesKey
+import androidx.datastore.preferences.core.stringPreferencesKey
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.data.local.ProfileDataStoreFactory
+import kotlinx.coroutines.flow.first
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Persisted Gemini ranking for the Smart Highlights rail, scoped to the active profile.
+ * A ranking is valid for [TTL_MS] and only for the candidate set it was computed from
+ * ([hash]); a changed library or a changed progress picture simply misses the cache.
+ */
+@Singleton
+class SmartHighlightsRankingCache @Inject constructor(
+    private val factory: ProfileDataStoreFactory,
+    private val profileManager: ProfileManager
+) {
+    companion object {
+        private const val FEATURE = "smart_highlights"
+        private const val HASH_KEY = "ranking_hash"
+        private const val PAYLOAD_KEY = "ranking_payload"
+        private const val SAVED_AT_KEY = "ranking_saved_at"
+
+        /** How long a Gemini ranking is reused before home asks Gemini again. */
+        const val TTL_MS = 6L * 60L * 60L * 1000L
+    }
+
+    private fun store() = factory.get(profileManager.activeProfileId.value, FEATURE)
+
+    /** The cached ranking for [hash], or null when absent, stale, or unreadable. */
+    suspend fun read(hash: String): List<GeminiRankEntry>? {
+        if (hash.isBlank()) return null
+        return runCatching {
+            val prefs = store().data.first()
+            val savedHash = prefs[stringPreferencesKey(HASH_KEY)] ?: return@runCatching null
+            if (savedHash != hash) return@runCatching null
+            val savedAt = prefs[longPreferencesKey(SAVED_AT_KEY)] ?: 0L
+            if (System.currentTimeMillis() - savedAt > TTL_MS) return@runCatching null
+            decode(prefs[stringPreferencesKey(PAYLOAD_KEY)].orEmpty())
+        }.getOrNull()?.takeIf { it.isNotEmpty() }
+    }
+
+    suspend fun write(hash: String, ranking: List<GeminiRankEntry>) {
+        if (hash.isBlank() || ranking.isEmpty()) return
+        runCatching {
+            store().edit { prefs ->
+                prefs[stringPreferencesKey(HASH_KEY)] = hash
+                prefs[stringPreferencesKey(PAYLOAD_KEY)] = encode(ranking)
+                prefs[longPreferencesKey(SAVED_AT_KEY)] = System.currentTimeMillis()
+            }
+        }
+    }
+
+    /** Called when the key is removed so a stale ranking cannot resurface for this profile. */
+    suspend fun clear() {
+        runCatching {
+            store().edit { prefs ->
+                prefs.remove(stringPreferencesKey(HASH_KEY))
+                prefs.remove(stringPreferencesKey(PAYLOAD_KEY))
+                prefs.remove(longPreferencesKey(SAVED_AT_KEY))
+            }
+        }
+    }
+
+    private fun encode(ranking: List<GeminiRankEntry>): String =
+        ranking.joinToString("|") { entry ->
+            entry.index.toString() + ":" + entry.reason.replace("\n", " ").replace("|", "/")
+        }
+
+    private fun decode(payload: String): List<GeminiRankEntry> =
+        payload.split("|").mapNotNull { part ->
+            val separator = part.indexOf(':')
+            if (separator <= 0) return@mapNotNull null
+            val index = part.substring(0, separator).toIntOrNull() ?: return@mapNotNull null
+            val reason = part.substring(separator + 1)
+            if (reason.isBlank()) return@mapNotNull null
+            GeminiRankEntry(index, reason)
+        }
+}
