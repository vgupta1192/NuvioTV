+package com.nuvio.tv.ui.screens.home
+
+import android.util.Log
+import androidx.compose.runtime.Immutable
+import com.nuvio.tv.R
+import com.nuvio.tv.data.gemini.GeminiRankEntry
+import com.nuvio.tv.data.gemini.GeminiRankingClient
+import com.nuvio.tv.data.gemini.SmartHighlightsRankingCache
+import com.nuvio.tv.domain.model.ContentType
+import com.nuvio.tv.domain.model.LibraryEntry
+import com.nuvio.tv.domain.model.MetaPreview
+import com.nuvio.tv.domain.model.PosterShape
+import com.nuvio.tv.domain.model.WatchProgress
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.flow.collectLatest
+import kotlinx.coroutines.flow.distinctUntilChanged
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+/** One featured title with the short reason its chip shows. */
+@Immutable
+data class SmartHighlightPick(
+    val item: MetaPreview,
+    val reason: String,
+    /** True when Gemini chose the position and wrote the reason; false for the fallback order. */
+    val ranked: Boolean
+)
+
+/** A title eligible for the rail, before ranking. */
+internal data class SmartHighlightCandidate(
+    val item: MetaPreview,
+    /** 0..100 when the viewer is part way through, else null. */
+    val progressPercent: Int?,
+    /** True when the title comes from the saved library rather than playback progress. */
+    val fromLibrary: Boolean
+)
+
+private data class SmartHighlightsInput(
+    val enabled: Boolean,
+    val profileId: Int,
+    val library: List<LibraryEntry>,
+    val progress: List<WatchProgress>
+)
+
+/**
+ * The Smart Highlights home rail pipeline.
+ *
+ * Candidates are a blend of the profile's saved library (most recently listed first) and
+ * in-progress playback (most recently watched first), deduplicated and capped. The rail renders
+ * the fallback order straight away; while a Gemini key is configured for the profile, a cached
+ * or freshly fetched ranking reorders the same candidates and attaches a short reason to each
+ * pick. With no key nothing is fetched — the fallback order is the rail, silently.
+ */
+internal fun HomeViewModel.observeSmartHighlightsPipeline() {
+    viewModelScope.launch {
+        var firstRun = true
+        combine(
+            layoutPreferenceDataStore.smartHighlightsEnabled,
+            profileManager.activeProfileId,
+            libraryRepository.libraryItems,
+            watchProgressRepository.allProgress
+        ) { enabled, profileId, library, progress ->
+            SmartHighlightsInput(enabled, profileId, library, progress)
+        }
+            .distinctUntilChanged()
+            .collectLatest { input ->
+                if (!input.enabled) {
+                    _smartHighlights.value = emptyList()
+                    firstRun = false
+                    return@collectLatest
+                }
+                if (firstRun) {
+                    // Let home's catalogs and continue watching load before spending IO on the rail.
+                    delay(SmartHighlightsLimits.STARTUP_DELAY_MS)
+                }
+                firstRun = false
+                val candidates = buildSmartHighlightCandidates(input.library, input.progress)
+                _smartHighlights.value = if (candidates.isEmpty()) {
+                    emptyList()
+                } else {
+                    computeSmartHighlightPicks(input.profileId, candidates)
+                }
+            }
+    }
+}
+
+internal suspend fun HomeViewModel.computeSmartHighlightPicks(
+    profileId: Int,
+    candidates: List<SmartHighlightCandidate>
+): List<SmartHighlightPick> {
+    val fallback = candidates
+        .take(SmartHighlightsLimits.MAX_PICKS)
+        .map { it.toPick(fallbackReason(it)) }
+    if (!geminiRankingClient.hasKey(profileId)) return fallback
+
+    // The cache key covers the candidate set: a changed library or progress picture misses it.
+    val hash = candidates.joinToString("|") { "${it.item.apiType}:${it.item.id}" } +
+        "#${candidates.size}"
+    val cached = withContext(Dispatchers.IO) { smartHighlightsRankingCache.read(hash) }
+    if (cached != null) return applySmartHighlightsRanking(candidates, cached)
+
+    val fetched = withContext(Dispatchers.IO) {
+        runCatching {
+            geminiRankingClient.rank(
+                profileId = profileId,
+                candidates = candidates.take(SmartHighlightsLimits.MAX_CANDIDATES)
+                    .map(::describeCandidate),
+                pickCount = SmartHighlightsLimits.MAX_PICKS
+            )
+        }.getOrElse { error ->
+            if (error is CancellationException) throw error
+            Log.i(HomeViewModel.TAG, "Smart Highlights ranking skipped: ${error.message}")
+            null
+        }
+    }
+    if (fetched != null) smartHighlightsRankingCache.write(hash, fetched)
+    return fetched?.let { applySmartHighlightsRanking(candidates, it) } ?: fallback
+}
+
+/** Ranked picks in Gemini's order, with the remaining candidates appended in fallback order. */
+private fun applySmartHighlightsRanking(
+    candidates: List<SmartHighlightCandidate>,
+    ranking: List<GeminiRankEntry>
+): List<SmartHighlightPick> {
+    val byIndex = candidates.withIndex().associate { (index, candidate) -> index to candidate }
+    val ranked = ranking.mapNotNull { entry ->
+        byIndex[entry.index]?.let { candidate ->
+            SmartHighlightPick(item = candidate.item, reason = entry.reason, ranked = true)
+        }
+    }
+    val rankedIds = ranked.map { it.item.id }.toSet()
+    val remainder = candidates
+        .filter { it.item.id !in rankedIds }
+        .map { it.toPick(fallbackReason(it)) }
+    return (ranked + remainder)
+        .distinctBy { it.item.id }
+        .take(SmartHighlightsLimits.MAX_PICKS)
+}
+
+internal fun buildSmartHighlightCandidates(
+    library: List<LibraryEntry>,
+    progress: List<WatchProgress>
+): List<SmartHighlightCandidate> {
+    val seen = HashSet<String>()
+    val candidates = ArrayList<SmartHighlightCandidate>()
+    fun addCandidate(item: MetaPreview, progressPercent: Int?, fromLibrary: Boolean) {
+        if (item.name.isBlank()) return
+        // A card without art would render as an empty frame on the home screen.
+        if (item.poster.isNullOrBlank() && item.backdropUrl.isNullOrBlank()) return
+        if (!seen.add(item.id)) return
+        candidates += SmartHighlightCandidate(item, progressPercent, fromLibrary)
+    }
+
+    progress.asSequence()
+        .filter { it.name.isNotBlank() }
+        .filterNot { it.isCompleted() }
+        .sortedByDescending { it.lastWatched }
+        .take(SmartHighlightsLimits.MAX_PROGRESS_CANDIDATES)
+        .forEach { addCandidate(it.toCandidatePreview(), it.candidateProgressPercent(), fromLibrary = false) }
+
+    library.asSequence()
+        .sortedByDescending { it.listedAt }
+        .take(SmartHighlightsLimits.MAX_LIBRARY_CANDIDATES)
+        .forEach { addCandidate(it.toCandidatePreview(), progressPercent = null, fromLibrary = true) }
+
+    return candidates.take(SmartHighlightsLimits.MAX_CANDIDATES)
+}
+
+private fun WatchProgress.toCandidatePreview(): MetaPreview = MetaPreview(
+    id = contentId,
+    type = ContentType.fromString(contentType),
+    rawType = contentType,
+    name = name,
+    poster = poster,
+    posterShape = PosterShape.POSTER,
+    background = backdrop,
+    logo = logo,
+    description = null,
+    releaseInfo = null,
+    imdbRating = null,
+    genres = emptyList()
+)
+
+private fun LibraryEntry.toCandidatePreview(): MetaPreview = toMetaPreview()
+
+/** A whole 0..100 percent when the title is part way through, else null. */
+private fun WatchProgress.candidateProgressPercent(): Int? {
+    val percent = (progressPercentage * 100f).toInt()
+    return percent.takeIf { it in 1..99 }
+}
+
+/** One prompt line per candidate: title, type, year, genres and how far along the viewer is. */
+private fun describeCandidate(candidate: SmartHighlightCandidate): String = buildString {
+    append(candidate.item.name)
+    append(" (")
+    append(candidate.item.apiType)
+    candidate.item.releaseInfo?.takeIf { it.isNotBlank() }?.let { year ->
+        append(", ")
+        append(year.take(12))
+    }
+    append(")")
+    val genres = candidate.item.genres.take(3).filter { it.isNotBlank() }
+    if (genres.isNotEmpty()) {
+        append(" [")
+        append(genres.joinToString(", "))
+        append("]")
+    }
+    when {
+        candidate.progressPercent != null -> {
+            append(" — ")
+            append(candidate.progressPercent)
+            append("% watched")
+        }
+        candidate.fromLibrary -> append(" — in their watchlist")
+    }
+}
+
+private fun SmartHighlightCandidate.toPick(reason: String) =
+    SmartHighlightPick(item = item, reason = reason, ranked = false)
+
+private fun HomeViewModel.fallbackReason(candidate: SmartHighlightCandidate): String =
+    if (candidate.progressPercent != null) {
+        appContext.getString(R.string.smart_highlights_reason_continue)
+    } else {
+        appContext.getString(R.string.smart_highlights_reason_recent)
+    }
+
+internal object SmartHighlightsLimits {
+    /** Picks actually shown; a handful. */
+    const val MAX_PICKS = 6
+
+    /** Candidates described to Gemini. */
+    const val MAX_CANDIDATES = 12
+
+    /** In-progress and library candidates considered before the cap. */
+    const val MAX_PROGRESS_CANDIDATES = 8
+    const val MAX_LIBRARY_CANDIDATES = 8
+
+    /** Home is given this long to settle before the first ranking pass. */
+    const val STARTUP_DELAY_MS = 5_000L
+}
