@@ -0,0 +1,94 @@
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.viewModelScope
+import com.nuvio.tv.core.profile.ProfileManager
+import com.nuvio.tv.data.gemini.GeminiCredentialStore
+import com.nuvio.tv.data.gemini.GeminiRankingClient
+import com.nuvio.tv.data.gemini.GeminiRankingException
+import com.nuvio.tv.data.gemini.SmartHighlightsRankingCache
+import dagger.hilt.android.lifecycle.HiltViewModel
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import javax.inject.Inject
+
+data class GeminiConnectionState(
+    val configured: Boolean = false,
+    val busy: Boolean = false,
+    val message: String? = null
+)
+
+@HiltViewModel
+class GeminiSettingsViewModel @Inject constructor(
+    private val credentials: GeminiCredentialStore,
+    private val client: GeminiRankingClient,
+    private val rankingCache: SmartHighlightsRankingCache,
+    private val profiles: ProfileManager
+) : ViewModel() {
+    private val mutableState = MutableStateFlow(GeminiConnectionState())
+    private var generation = 0L
+    val state = mutableState.asStateFlow()
+
+    init {
+        viewModelScope.launch {
+            profiles.activeProfileId.collect { id ->
+                generation++
+                val configured = withContext(Dispatchers.IO) { credentials.read(id) != null }
+                mutableState.value = GeminiConnectionState(configured)
+            }
+        }
+    }
+
+    fun save(value: String?) = operation { profileId ->
+        withContext(Dispatchers.IO) {
+            credentials.save(profileId, value)
+            // A removed key must not leave a stale ranking behind for this profile.
+            if (value.isNullOrBlank()) rankingCache.clear()
+        }
+        GeminiConnectionState(
+            configured = !value.isNullOrBlank(),
+            message = if (value.isNullOrBlank()) {
+                "API key removed"
+            } else {
+                "API key saved. Test the connection to verify it."
+            }
+        )
+    }
+
+    fun test() = operation { profileId ->
+        client.testConnection(profileId)
+        GeminiConnectionState(true, message = "Connected to Google Gemini")
+    }
+
+    private fun operation(action: suspend (Int) -> GeminiConnectionState) {
+        if (state.value.busy) return
+        val profileId = profiles.activeProfileId.value
+        val requestGeneration = generation
+        mutableState.value = state.value.copy(busy = true, message = null)
+        viewModelScope.launch {
+            val result = try {
+                action(profileId)
+            } catch (e: CancellationException) {
+                throw e
+            } catch (e: GeminiRankingException) {
+                state.value.copy(busy = false, message = when (e.reason) {
+                    GeminiRankingException.Reason.NO_KEY -> "Save a Gemini API key first."
+                    GeminiRankingException.Reason.AUTHENTICATION ->
+                        "Gemini rejected the key. Check that the Generative Language API is enabled for it."
+                    GeminiRankingException.Reason.RATE_LIMIT ->
+                        "Gemini rate limit reached. Try again later."
+                    else -> "Unable to reach Gemini. Check your connection and try again."
+                })
+            } catch (_: Exception) {
+                state.value.copy(busy = false, message = "Unable to access Gemini credentials. Try saving the key again.")
+            }
+            if (profiles.activeProfileId.value == profileId && generation == requestGeneration) {
+                mutableState.value = result
+            }
+        }
+    }
+}
