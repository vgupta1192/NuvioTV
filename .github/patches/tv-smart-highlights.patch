+++ b/app/src/main/java/com/nuvio/tv/data/gemini/GeminiRankingClient.kt
@@ -0,0 +1,139 @@
+package com.nuvio.tv.data.gemini
+
+import android.util.Log
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.IOException
+import javax.inject.Inject
+import javax.inject.Named
+import javax.inject.Singleton
+
+/** One ranked candidate: the candidate list index plus a short "why" for the reason chip. */
+data class GeminiRankEntry(val index: Int, val reason: String)
+
+/** Thrown when Gemini cannot serve a ranking; callers fall back to the unranked order. */
+class GeminiRankingException(val reason: Reason) : IOException(reason.name) {
+    enum class Reason { NO_KEY, AUTHENTICATION, RATE_LIMIT, UNAVAILABLE, INVALID_RESPONSE }
+}
+
+/**
+ * REST call to Gemini (`generateContent`) that orders a compact candidate list and returns a
+ * short reason per pick. The key travels in the `x-goog-api-key` header only — never in a URL,
+ * a log line, or storage outside the encrypted credential store. Every failure mode maps to
+ * [GeminiRankingException] so the caller can fall back silently.
+ */
+@Singleton
+class GeminiRankingClient @Inject constructor(
+    private val credentials: GeminiCredentialStore,
+    @Named("gemini") private val http: OkHttpClient
+) {
+    fun hasKey(profileId: Int): Boolean = credentials.read(profileId) != null
+
+    /** Cheap round trip used by the settings screen to verify a key. */
+    suspend fun testConnection(profileId: Int) {
+        val body = JSONObject()
+            .put("contents", JSONArray().put(
+                JSONObject().put("parts", JSONArray().put(JSONObject().put("text", "Reply with the single word: ok")))
+            ))
+            .put("generationConfig", JSONObject().put("maxOutputTokens", 8))
+        post(profileId, body)
+    }
+
+    /**
+     * Ranks [candidates] (already formatted one-per-line, 1-based). Returns entries in the
+     * order Gemini preferred them, restricted to in-range indexes with a non-blank reason.
+     */
+    suspend fun rank(profileId: Int, candidates: List<String>, pickCount: Int): List<GeminiRankEntry> {
+        if (candidates.isEmpty()) return emptyList()
+        val prompt = buildString {
+            append("You curate a short \"Smart Highlights\" row on a TV streaming app's home screen. ")
+            append("Below is a numbered list of titles from this viewer's own library and continue-watching progress. ")
+            append("Choose the ")
+            append(pickCount.coerceAtMost(candidates.size))
+            append(" most appealing titles to feature first — favour a good mix, momentum (things they are part way through) ")
+            append("and what fits together — and order them best first. ")
+            append("For each pick give a reason of at most 6 words, addressed like a note to the viewer (e.g. \"you left off mid-season\"). ")
+            append("Respond with the picks as a JSON array of {\"index\": <candidate number>, \"reason\": \"...\"} objects, best pick first.\n\n")
+            append(candidates.joinToString("\n"))
+        }
+        val schema = JSONObject()
+            .put("type", "ARRAY")
+            .put("items", JSONObject()
+                .put("type", "OBJECT")
+                .put("properties", JSONObject()
+                    .put("index", JSONObject().put("type", "INTEGER"))
+                    .put("reason", JSONObject().put("type", "STRING")))
+                .put("required", JSONArray().put("index").put("reason")))
+        val body = JSONObject()
+            .put("contents", JSONArray().put(
+                JSONObject().put("parts", JSONArray().put(JSONObject().put("text", prompt)))
+            ))
+            .put("generationConfig", JSONObject()
+                .put("responseMimeType", "application/json")
+                .put("responseSchema", schema)
+                .put("temperature", 0.3))
+        val text = withContext(Dispatchers.IO) { post(profileId, body) }
+        return parse(text, candidates.size)
+    }
+
+    private fun parse(text: String, candidateCount: Int): List<GeminiRankEntry> {
+        val array = runCatching {
+            JSONArray(text.trim().removePrefix("```json").removePrefix("```").trim().removeSuffix("```"))
+        }.getOrNull() ?: throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+        val out = ArrayList<GeminiRankEntry>(array.length())
+        for (i in 0 until array.length()) {
+            val entry = array.optJSONObject(i) ?: continue
+            val index = entry.optInt("index", -1) - 1
+            if (index < 0 || index >= candidateCount) continue
+            val reason = entry.optString("reason").trim().takeIf { it.isNotEmpty() } ?: continue
+            out += GeminiRankEntry(index, reason.take(MAX_REASON_LENGTH))
+        }
+        if (out.isEmpty()) throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+        return out.distinctBy { it.index }
+    }
+
+    private fun post(profileId: Int, body: JSONObject): String {
+        val apiKey = credentials.read(profileId)
+            ?: throw GeminiRankingException(GeminiRankingException.Reason.NO_KEY)
+        val request = Request.Builder()
+            .url("https://generativelanguage.googleapis.com/v1beta/models/$MODEL:generateContent")
+            .header("x-goog-api-key", apiKey)
+            .post(body.toString().toRequestBody("application/json".toMediaType()))
+            .build()
+        http.newCall(request).execute().use { resp ->
+            when (resp.code) {
+                200, 201 -> Unit
+                401, 403 -> throw GeminiRankingException(GeminiRankingException.Reason.AUTHENTICATION)
+                429 -> throw GeminiRankingException(GeminiRankingException.Reason.RATE_LIMIT)
+                else -> throw GeminiRankingException(GeminiRankingException.Reason.UNAVAILABLE)
+            }
+            val payload = resp.body?.string().orEmpty()
+            val text = runCatching {
+                JSONObject(payload)
+                    .optJSONArray("candidates")?.optJSONObject(0)
+                    ?.optJSONObject("content")?.optJSONArray("parts")?.optJSONObject(0)
+                    ?.optString("text")
+            }.getOrNull().orEmpty()
+            if (text.isBlank()) {
+                Log.w(TAG, "generateContent returned no text")
+                throw GeminiRankingException(GeminiRankingException.Reason.INVALID_RESPONSE)
+            }
+            return text
+        }
+    }
+
+    companion object {
+        private const val TAG = "GeminiRanking"
+        private const val MODEL = "gemini-2.0-flash"
+
+        /** Reason chips are one short line; anything longer is clipped. */
+        const val MAX_REASON_LENGTH = 48
+    }
+}
