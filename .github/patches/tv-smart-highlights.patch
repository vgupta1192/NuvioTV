+package com.nuvio.tv.data.gemini
+
+import android.content.Context
+import com.nuvio.tv.core.profile.ProfileScopedCredentialStore
+import com.nuvio.tv.core.profile.ProtectedProfilePreferences
+import dagger.hilt.android.qualifiers.ApplicationContext
+import java.util.concurrent.ConcurrentHashMap
+import javax.inject.Inject
+import javax.inject.Singleton
+
+/**
+ * Per-profile Gemini API key, kept under the same Keystore-backed encrypted
+ * persistence the other native integrations use. The key is only ever handed
+ * to the ranking client as a request header; it is never logged or displayed.
+ */
+@Singleton
+class GeminiCredentialStore @Inject constructor(@ApplicationContext context: Context) : ProfileScopedCredentialStore {
+    private val protected = ProtectedProfilePreferences(context, "gemini_credentials", "com.nuvio.tv.gemini.credentials.v1")
+    private val lock = Any()
+
+    fun read(profileId: Int): String? = synchronized(lock) { protected.read(profileId) }
+
+    fun save(profileId: Int, apiKey: String?) = synchronized(lock) {
+        protected.write(profileId, apiKey?.trim()?.takeIf(String::isNotBlank))
+    }
+
+    override fun removeProfile(profileId: Int) = save(profileId, null)
+
+    override fun clearAllProfiles() = synchronized(lock) { protected.clear() }
+}
diff --git a/app/src/main/java/com/nuvio/tv/data/gemini/GeminiRankingClient.kt b/app/src/main/java/com/nuvio/tv/data/gemini/GeminiRankingClient.kt
