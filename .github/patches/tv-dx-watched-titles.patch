@@ -0,0 +1,77 @@
+package com.nuvio.tv.ui.components
+
+import android.content.Context
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.draw.alpha
+import androidx.compose.ui.platform.LocalContext
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.tv.domain.model.CatalogRow
+import com.nuvio.tv.domain.model.MetaPreview
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+enum class DxWatchedMode { Show, Dim, Hide }
+
+/**
+ * dx.bi port: titles you already watched can stay as they are (Show, default), fade (Dim) or disappear (Hide)
+ * in Home rows, Discover and Search. It uses the same watched mark as the check badge on a poster. Library and
+ * details screens are never affected. A row where every title is watched is left as it is instead of emptied.
+ */
+object DxWatchedTitles {
+    private const val PREFS = "nuvio_tv_dx_watched_titles"
+    private val _mode = MutableStateFlow(DxWatchedMode.Show)
+    val mode: StateFlow<DxWatchedMode> = _mode.asStateFlow()
+    private var loaded = false
+
+    fun ensureLoaded(context: Context) {
+        if (loaded) return
+        loaded = true
+        val saved = context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .getString("mode", null)
+        _mode.value = DxWatchedMode.values().firstOrNull { it.name == saved } ?: DxWatchedMode.Show
+    }
+
+    fun setMode(context: Context, mode: DxWatchedMode) {
+        ensureLoaded(context)
+        _mode.value = mode
+        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            .edit().putString("mode", mode.name).apply()
+    }
+
+    fun filterItems(
+        items: List<MetaPreview>,
+        mode: DxWatchedMode,
+        isWatched: (MetaPreview) -> Boolean,
+    ): List<MetaPreview> {
+        if (mode != DxWatchedMode.Hide) return items
+        val kept = items.filterNot { isWatched(it) }
+        return if (kept.isEmpty() || kept.size == items.size) items else kept
+    }
+
+    fun filterRow(
+        row: CatalogRow,
+        mode: DxWatchedMode,
+        isWatched: (MetaPreview) -> Boolean,
+    ): CatalogRow {
+        val kept = filterItems(row.items, mode, isWatched)
+        return if (kept === row.items) row else row.copy(items = kept)
+    }
+}
+
+@Composable
+fun rememberDxWatchedMode(): DxWatchedMode {
+    val context = LocalContext.current
+    DxWatchedTitles.ensureLoaded(context)
+    val mode by DxWatchedTitles.mode.collectAsStateWithLifecycle()
+    return mode
+}
+
+/** Fades a watched poster when the mode is Dim. */
+@Composable
+fun Modifier.dxWatchedDim(isWatched: Boolean): Modifier {
+    val mode = rememberDxWatchedMode()
+    return if (isWatched && mode == DxWatchedMode.Dim) this.alpha(0.35f) else this
+}
