@@ -0,0 +1,30 @@
+@file:OptIn(androidx.tv.material3.ExperimentalTvMaterial3Api::class)
+
+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.platform.LocalContext
+import com.nuvio.tv.ui.components.DxWatchedMode
+import com.nuvio.tv.ui.components.DxWatchedTitles
+import com.nuvio.tv.ui.components.rememberDxWatchedMode
+
+/** Home layout settings row (dx.bi port): watched titles show, dim or hide in Home, Discover and Search. */
+@Composable
+internal fun DxWatchedTitlesSettingsRow() {
+    val context = LocalContext.current
+    val mode = rememberDxWatchedMode()
+    val label = when (mode) {
+        DxWatchedMode.Show -> "Show"
+        DxWatchedMode.Dim -> "Dim"
+        DxWatchedMode.Hide -> "Hide"
+    }
+    SettingsActionRow(
+        title = "Watched titles",
+        subtitle = "Show keeps watched titles as they are, Dim fades them, Hide removes them from Home rows, Discover and Search. Press to switch. Your Library is never changed.",
+        value = label,
+        onClick = {
+            val next = DxWatchedMode.values()[(mode.ordinal + 1) % DxWatchedMode.values().size]
+            DxWatchedTitles.setMode(context, next)
+        },
+    )
+}
