@@ -0,0 +1,39 @@
+package com.nuvio.tv.forklivetv
+
+import android.content.Context
+import android.media.AudioManager
+import android.os.SystemClock
+
+/**
+ * Nuvio fork: after 30 minutes without any remote input the app returns to the profile picker, so a
+ * shared TV does not stay on the last person's profile. Skipped while audio is playing, on the
+ * player screen, and when there is only one profile.
+ */
+object ForkIdleReturn {
+    const val IDLE_MS = 30 * 60_000L
+    private const val PREFS = "fork_idle_return"
+    private const val KEY_ENABLED = "enabled"
+
+    @Volatile
+    private var lastInputMs = SystemClock.elapsedRealtime()
+
+    fun touch() {
+        lastInputMs = SystemClock.elapsedRealtime()
+    }
+
+    fun enabled(context: Context): Boolean =
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getBoolean(KEY_ENABLED, true)
+
+    fun setEnabled(context: Context, enabled: Boolean) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putBoolean(KEY_ENABLED, enabled).apply()
+    }
+
+    /** True when the app has been idle long enough, nothing is playing and the user is not in the player. */
+    fun shouldReturn(context: Context, currentRoute: String?, profileCount: Int): Boolean {
+        if (profileCount < 2 || !enabled(context)) return false
+        if (currentRoute?.startsWith("player") == true) return false
+        if (SystemClock.elapsedRealtime() - lastInputMs < IDLE_MS) return false
+        val audio = context.getSystemService(Context.AUDIO_SERVICE) as? AudioManager
+        return audio?.isMusicActive != true
+    }
+}
