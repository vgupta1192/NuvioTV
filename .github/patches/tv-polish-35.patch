+
+/** Lets the user pick the guide (EPG) channel for one Live TV channel by hand. */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun TvFixChannelDialog(
+    channel: TvChannelItem?,
+    hasOverride: Boolean,
+    search: (String) -> List<GuideChannelHit>,
+    onPick: (GuideChannelHit) -> Unit,
+    onReset: () -> Unit,
+    onDismiss: () -> Unit
+) {
+    if (channel == null) return
+    var query by remember(channel.id) { mutableStateOf(channel.name) }
+    var hits by remember(channel.id) { mutableStateOf<List<GuideChannelHit>>(emptyList()) }
+
+    val firstHitFocus = remember { FocusRequester() }
+    var focusedFirst by remember(channel.id) { mutableStateOf(false) }
+
+    LaunchedEffect(channel.id, query) {
+        delay(250)
+        hits = withContext(Dispatchers.Default) { search(query) }
+        // Land on the first result once (not while the user is typing in the search field).
+        if (!focusedFirst && hits.isNotEmpty()) {
+            focusedFirst = true
+            delay(100)
+            runCatching { firstHitFocus.requestFocus() }
+        }
+    }
+
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = stringResource(R.string.fix_guide_title, channel.name),
+        subtitle = stringResource(R.string.fix_guide_subtitle),
+        width = 580.dp
+    ) {
+        Column(modifier = Modifier.fillMaxWidth().padding(vertical = 4.dp)) {
+            OutlinedTextField(
+                value = query,
+                onValueChange = { query = it },
+                singleLine = true,
+                label = { androidx.compose.material3.Text(stringResource(R.string.fix_guide_search_hint)) },
+                modifier = Modifier.fillMaxWidth()
+            )
+            if (hits.isEmpty()) {
+                Text(
+                    text = stringResource(R.string.fix_guide_no_results),
+                    style = MaterialTheme.typography.bodyMedium,
+                    color = Color.White.copy(alpha = 0.5f),
+                    modifier = Modifier.padding(vertical = 16.dp)
+                )
+            } else {
+                LazyColumn(
+                    modifier = Modifier.fillMaxWidth().height(260.dp).padding(top = 8.dp),
+                    verticalArrangement = Arrangement.spacedBy(6.dp)
+                ) {
+                    items(hits, key = { it.id }) { hit ->
+                        Button(
+                            onClick = { onPick(hit) },
+                            modifier = Modifier.fillMaxWidth().then(if (hit.id == hits.first().id) Modifier.focusRequester(firstHitFocus) else Modifier),
+                            shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+                            colors = ButtonDefaults.colors(
+                                containerColor = Color.White.copy(alpha = 0.06f),
+                                contentColor = Color.White,
+                                focusedContainerColor = Color.White,
+                                focusedContentColor = Color.Black
+                            )
+                        ) {
+                            Row(
+                                modifier = Modifier.fillMaxWidth(),
+                                horizontalArrangement = Arrangement.SpaceBetween
+                            ) {
+                                Text(
+                                    text = hit.name,
+                                    fontSize = 13.sp,
+                                    fontWeight = FontWeight.SemiBold,
+                                    maxLines = 1,
+                                    overflow = TextOverflow.Ellipsis,
+                                    modifier = Modifier.weight(1f)
+                                )
+                                Text(
+                                    text = stringResource(R.string.fix_guide_programs, hit.programCount),
+                                    fontSize = 11.sp
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+            if (hasOverride) {
+                Button(
+                    onClick = onReset,
+                    modifier = Modifier.padding(top = 10.dp),
+                    shape = ButtonDefaults.shape(shape = RoundedCornerShape(22.dp)),
+                    colors = ButtonDefaults.colors(
+                        containerColor = Color.White.copy(alpha = 0.10f),
+                        contentColor = Color.White,
+                        focusedContainerColor = Color.White,
+                        focusedContentColor = Color.Black
+                    )
+                ) {
+                    Text(text = stringResource(R.string.fix_guide_reset), fontSize = 12.sp)
+                }
+            }
+        }
+    }
+}
