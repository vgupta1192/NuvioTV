+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="wetrakr_name">WeTrakr</string>
+    <string name="wetrakr_description">Send what you watch to WeTrakr. Sign in with a code.</string>
+    <string name="wetrakr_connected_as">Connected as %1$s</string>
+    <string name="wetrakr_account_fallback">your account</string>
+    <string name="wetrakr_dialog_subtitle">Sign in to send watch updates to WeTrakr</string>
+    <string name="wetrakr_open_url">On your phone or computer, open %1$s and enter this code:</string>
+    <string name="wetrakr_try_again">Try again</string>
+</resources>
