+package com.nuvio.tv.ui.screens.settings
+
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.res.stringResource
+import androidx.compose.ui.unit.dp
+import androidx.hilt.navigation.compose.hiltViewModel
+import androidx.lifecycle.ViewModel
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import androidx.tv.material3.MaterialTheme
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.data.wetrakr.WeTrakrService
+import com.nuvio.tv.data.wetrakr.WeTrakrUiState
+import com.nuvio.tv.ui.components.NuvioDialog
+import com.nuvio.tv.ui.theme.NuvioTheme
+import dagger.hilt.android.lifecycle.HiltViewModel
+import javax.inject.Inject
+import kotlinx.coroutines.flow.StateFlow
+
+@HiltViewModel
+class WeTrakrSettingsViewModel @Inject constructor(
+    private val service: WeTrakrService
+) : ViewModel() {
+    val state: StateFlow<WeTrakrUiState> = service.state
+
+    fun connect() = service.connect()
+    fun cancel() = service.cancelConnect()
+    fun disconnect() = service.disconnect()
+}
+
+/** WeTrakr entry in Tracking settings (fork): sign in with a device code, scrobble and watched history. */
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+internal fun WeTrakrSettingsRow(viewModel: WeTrakrSettingsViewModel = hiltViewModel()) {
+    val state by viewModel.state.collectAsStateWithLifecycle()
+    var showDialog by remember { mutableStateOf(false) }
+
+    SettingsActionRow(
+        title = stringResource(R.string.wetrakr_name),
+        subtitle = when {
+            state.isConnected -> stringResource(R.string.wetrakr_connected_as, state.username ?: stringResource(R.string.wetrakr_account_fallback))
+            state.userCode != null -> stringResource(R.string.tracking_finish_connection)
+            else -> state.error ?: stringResource(R.string.wetrakr_description)
+        },
+        value = when {
+            state.isConnected -> stringResource(R.string.tracking_status_connected)
+            state.userCode != null -> stringResource(R.string.tracking_status_waiting)
+            else -> stringResource(R.string.tracking_status_disconnected)
+        },
+        valueColor = when {
+            state.isConnected -> NuvioTheme.colors.Success
+            state.userCode != null -> NuvioTheme.colors.Warning
+            else -> NuvioTheme.colors.TextSecondary
+        },
+        onClick = {
+            if (!state.isConnected && state.userCode == null) viewModel.connect()
+            showDialog = true
+        }
+    )
+
+    if (showDialog) {
+        val dismiss = {
+            if (!state.isConnected) viewModel.cancel()
+            showDialog = false
+        }
+        NuvioDialog(
+            onDismiss = dismiss,
+            title = stringResource(R.string.wetrakr_name),
+            subtitle = if (state.isConnected) {
+                stringResource(R.string.wetrakr_connected_as, state.username ?: stringResource(R.string.wetrakr_account_fallback))
+            } else {
+                stringResource(R.string.wetrakr_dialog_subtitle)
+            },
+            width = 520.dp,
+            suppressFirstKeyUp = false
+        ) {
+            if (!state.isConnected) {
+                Column(modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp)) {
+                    val url = state.verificationUrl
+                    val code = state.userCode
+                    when {
+                        code != null -> {
+                            Text(
+                                text = stringResource(R.string.wetrakr_open_url, url ?: ""),
+                                style = MaterialTheme.typography.bodyLarge,
+                                color = NuvioTheme.colors.TextSecondary
+                            )
+                            Text(
+                                text = code,
+                                style = MaterialTheme.typography.displaySmall,
+                                color = NuvioTheme.colors.TextPrimary,
+                                modifier = Modifier.padding(top = 12.dp)
+                            )
+                        }
+                        state.error != null -> Text(
+                            text = state.error.orEmpty(),
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.Warning
+                        )
+                        else -> Text(
+                            text = stringResource(R.string.tracking_status_connecting),
+                            style = MaterialTheme.typography.bodyLarge,
+                            color = NuvioTheme.colors.TextSecondary
+                        )
+                    }
+                }
+            }
+            SettingsDialogActionRow {
+                SettingsDialogActionButton(
+                    text = stringResource(R.string.action_cancel),
+                    onClick = dismiss
+                )
+                if (state.isConnected) {
+                    SettingsDialogActionButton(
+                        text = stringResource(R.string.trakt_disconnect),
+                        onClick = {
+                            viewModel.disconnect()
+                            showDialog = false
+                        },
+                        primary = true
+                    )
+                } else if (state.userCode == null && !state.busy) {
+                    SettingsDialogActionButton(
+                        text = stringResource(R.string.wetrakr_try_again),
+                        onClick = viewModel::connect,
+                        primary = true
+                    )
+                }
+            }
+        }
+    }
+}
