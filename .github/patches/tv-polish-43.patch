+private val SPORT_ORDER = listOf("Football", "Basketball", "Baseball", "Hockey", "Soccer", "MMA", "Cricket", "Tennis", "Motorsport", "Other")
+
+private fun sportOf(ch: TvChannelItem): String {
+    val text = (ch.name + " " + ch.genres.joinToString(" ") + " " + ch.catalogName).lowercase()
+    return when {
+        "nba" in text || "basketball" in text || "wnba" in text -> "Basketball"
+        "nfl" in text || "ncaaf" in text || "american football" in text -> "Football"
+        "mlb" in text || "baseball" in text -> "Baseball"
+        "nhl" in text || "hockey" in text -> "Hockey"
+        "ufc" in text || "mma" in text || "boxing" in text || "wwe" in text -> "MMA"
+        "cricket" in text || "ipl" in text -> "Cricket"
+        "tennis" in text -> "Tennis"
+        "formula" in text || "f1" in text || "motogp" in text || "nascar" in text -> "Motorsport"
+        "soccer" in text || "premier league" in text || "la liga" in text || "champions league" in text ||
+            "serie a" in text || "bundesliga" in text || "ligue 1" in text || "football" in text || " fc" in text -> "Soccer"
+        else -> "Other"
+    }
+}
+
+private val TEAM_SPLIT = Regex("\\s+(?:vs\\.?|v|@|-|\u2013)\\s+", RegexOption.IGNORE_CASE)
+
+/** "Lakers vs Celtics" gives both team names; anything else gives null. */
+private fun teamsOf(ch: TvChannelItem): Pair<String, String>? {
+    val title = ch.name.substringAfter(": ", ch.name)
+    val parts = title.split(TEAM_SPLIT, limit = 2).map { it.trim() }
+    return if (parts.size == 2 && parts[0].isNotEmpty() && parts[1].isNotEmpty()) parts[0] to parts[1] else null
+}
+
+private fun teamColor(name: String): Color {
+    val hue = ((name.lowercase().hashCode() and 0x7fffffff) % 360).toFloat()
+    return Color.hsv(hue, 0.6f, 0.42f)
+}
+
+private fun initialsOf(name: String): String =
+    name.split(' ').filter { it.isNotBlank() }.take(2).joinToString("") { it.first().uppercase() }.ifEmpty { "?" }
