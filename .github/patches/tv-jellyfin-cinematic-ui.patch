+@Composable
+private fun JellyfinSeasonsChips(state: com.nuvio.tv.domain.model.JellyfinUiState, modifier: Modifier = Modifier) {
+    Column(modifier = modifier.padding(horizontal = NuvioTheme.spacing.xxxl)) {
+        Row(
+            horizontalArrangement = Arrangement.spacedBy(8.dp),
+            modifier = Modifier.horizontalScroll(rememberScrollState()),
+        ) {
+            state.seasons.forEach { season ->
+                JellyfinPillChip(
+                    label = season.name ?: "Season ${season.indexNumber ?: ""}",
+                    isSelected = state.selectedSeasonId == season.id,
+                    onClick = { JellyfinRepository.selectSeason(season.id) },
+                )
+            }
+        }
+    }
+}
