+@Composable
+private fun JellyfinDetailEpisodes(
+    state: com.nuvio.tv.domain.model.JellyfinUiState,
+    onPlay: (JellyfinItem) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Column(modifier = modifier) {
+        Text(
+            text = if (state.selectedDetail?.isFolder == true) "Files in this folder" else "Episodes",
+            style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),
+            color = NuvioTheme.colors.TextPrimary,
+            modifier = Modifier.padding(horizontal = NuvioTheme.spacing.xxxl, vertical = NuvioTheme.spacing.sm),
+        )
+        when {
+            state.isLoadingDetail && state.episodes.isEmpty() -> Box(
+                Modifier.fillMaxWidth().padding(vertical = 24.dp),
+                contentAlignment = Alignment.Center,
+            ) {
+                LoadingIndicator(modifier = Modifier.size(28.dp))
+            }
+
+            state.detailError != null && state.episodes.isEmpty() -> Text(
+                text = state.detailError.orEmpty(),
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.error,
+                modifier = Modifier.padding(horizontal = NuvioTheme.spacing.xxxl),
+            )
+
+            else -> LazyRow(
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+                contentPadding = androidx.compose.foundation.layout.PaddingValues(horizontal = NuvioTheme.spacing.xxxl),
+            ) {
+                items(state.episodes, key = { it.id }) { episode ->
+                    if (state.selectedDetail?.isFolder == true) {
+                        JellyfinFileRow(episode = episode, onPlay = onPlay)
+                    } else {
+                        JellyfinEpisodeCard(episode = episode, onPlay = onPlay)
+                    }
+                }
+            }
+        }
+    }
+}
