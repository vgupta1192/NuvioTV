+/** The photo's badge pills: "1080p H264 · English Dolby Atmos 5.1 · CC None (+38)" + Ends at. */
+@Composable
+private fun JellyfinMediaBadgesRow(item: JellyfinItem) {
+    val media = item.mediaInfo
+    val badges = buildList {
+        media?.videoLabel?.let { add(it) }
+        media?.audioLabel?.let { add(it) }
+        val subtitles = media?.subtitleCount ?: 0
+        add(if (subtitles > 0) "CC None (+$subtitles)" else "CC None")
+    }
+    val endsAt = remember(item.runTimeTicks) {
+        item.runTimeMinutes?.let { minutes ->
+            val calendar = java.util.Calendar.getInstance()
+            calendar.add(java.util.Calendar.MINUTE, minutes)
+            java.text.DateFormat.getTimeInstance(java.text.DateFormat.SHORT).format(calendar.time)
+        }
+    }
+    Column(
+        modifier = Modifier.padding(
+            start = NuvioTheme.spacing.xxxl,
+            end = NuvioTheme.spacing.xxxl,
+            top = NuvioTheme.spacing.xs,
+        ),
+        verticalArrangement = Arrangement.spacedBy(NuvioTheme.spacing.sm),
+    ) {
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            badges.forEach { badge ->
+                Text(
+                    text = badge,
+                    style = MaterialTheme.typography.labelMedium.copy(fontWeight = FontWeight.Medium),
+                    color = NuvioTheme.colors.TextSecondary,
+                    modifier = Modifier
+                        .clip(RoundedCornerShape(6.dp))
+                        .background(NuvioTheme.colors.BackgroundElevated.copy(alpha = 0.72f))
+                        .border(1.dp, NuvioTheme.colors.Border.copy(alpha = 0.6f), RoundedCornerShape(6.dp))
+                        .padding(horizontal = 10.dp, vertical = 5.dp),
+                )
+            }
+        }
+        if (endsAt != null) {
+            Text(
+                text = "Ends at $endsAt",
+                style = MaterialTheme.typography.labelMedium,
+                color = NuvioTheme.colors.TextTertiary,
+            )
+        }
+    }
+}
