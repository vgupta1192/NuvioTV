+    /**
+     * Nuvio fork: resolve a TMDB person id by name (Jellyfin cast rows carry no TMDB id),
+     * used to open the shared Cast detail screen from the Jellyfin detail page.
+     */
+    suspend fun searchPersonId(name: String): Int? = withContext(kotlinx.coroutines.Dispatchers.IO) {
+        runCatching {
+            val url = "https://api.themoviedb.org/3/search/person".toHttpUrlOrNull()!!
+                .newBuilder()
+                .addQueryParameter("api_key", BuildConfig.TMDB_API_KEY)
+                .addQueryParameter("query", name)
+                .addQueryParameter("include_adult", "false")
+                .build()
+            val request = Request.Builder().url(url).get().build()
+            client.newCall(request).execute().use { response ->
+                if (!response.isSuccessful) return@runCatching null
+                val body = response.body?.string().orEmpty()
+                if (body.isBlank()) return@runCatching null
+                val results = json.parseToJsonElement(body).jsonObject["results"] as? JsonArray
+                val best = results?.firstOrNull { entry ->
+                    (entry as? JsonObject)?.get("name")?.jsonPrimitive?.contentOrNull
+                        ?.equals(name, ignoreCase = true) == true
+                } ?: results?.firstOrNull()
+                (best as? JsonObject)?.get("id")?.jsonPrimitive?.intOrNull
+            }
+        }.getOrNull()
+    }
