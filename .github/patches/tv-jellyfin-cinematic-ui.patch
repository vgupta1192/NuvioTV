+/**
+ * Full-screen Jellyfin detail page (fork feature). Mirrors the addon MetaDetailsScreen look:
+ * full-bleed backdrop with gradient scrims, the shared HeroContentSection (logo, meta pills,
+ * credits, description, play row), then the file's media badges, People cast row, seasons and
+ * episodes. Playback reuses the exact same direct-play handoff as the browse screen.
+ */
+@Composable
+fun JellyfinDetailsScreen(
+    itemId: String,
+    onPlay: (JellyfinItem) -> Unit,
+    onBack: () -> Unit,
+    onNavigateToCastDetail: (Int, String, Boolean) -> Unit = { _, _, _ -> },
+) {
+    val state by JellyfinRepository.uiState.collectAsStateWithLifecycle()
+    val castScope = rememberCoroutineScope()
+    val backFocus = remember { FocusRequester() }
+    LaunchedEffect(itemId) {
+        JellyfinRepository.selectItemById(itemId)
+    }
+
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .background(NuvioTheme.colors.Background),
+    ) {
+        val item = state.selectedDetail?.takeIf { it.id == itemId }
+        if (item == null) {
+            if (state.detailError != null) {
+                Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                    Text(
+                        text = state.detailError.orEmpty(),
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = MaterialTheme.colorScheme.error,
+                    )
+                }
+            } else {
+                Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+                    LoadingIndicator(modifier = Modifier.size(40.dp))
+                }
+            }
+            return@Box
+        }
+
+        val backdropUrl = remember(item.id, item.backdropTag) { JellyfinRepository.backdropUrlFor(item) }
+        val posterUrl = remember(item.id, item.imageTag) { JellyfinRepository.posterUrlFor(item, maxWidth = 480) }
+        val logoUrl = remember(item.id, item.logoTag) { JellyfinRepository.logoUrlFor(item) }
+        val meta = remember(item, posterUrl, backdropUrl, logoUrl) {
+            item.toMeta(poster = posterUrl, backdrop = backdropUrl ?: posterUrl, logo = logoUrl)
+                .let { withPhotos ->
+                    withPhotos.copy(
+                        castMembers = withPhotos.castMembers.zip(item.cast).map { (member, person) ->
+                            member.copy(photo = JellyfinRepository.personImageUrl(person))
+                        },
+                    )
+                }
+        }
+
+        val playable: JellyfinItem? = when {
+            item.isSeries || item.isFolder ->
+                state.episodes.firstOrNull { it.resumePositionMs > 0 } ?: state.episodes.firstOrNull()
+            item.isPlayable -> item
+            else -> null
+        }
+
+        val playFocusRequester = remember { FocusRequester() }
+        LaunchedEffect(item.id) {
+            withFrameNanos { }
+            runCatching { playFocusRequester.requestFocus() }
+        }
+
+        // Backdrop layer + gradient scrims (same visual language as MetaDetailsScreen).
+        AsyncImage(
+            model = backdropUrl ?: posterUrl,
+            contentDescription = null,
+            contentScale = ContentScale.Crop,
+            modifier = Modifier.matchParentSize(),
+        )
+        val backgroundColor = NuvioTheme.colors.Background
+        Box(
+            modifier = Modifier
+                .matchParentSize()
+                .background(
+                    Brush.horizontalGradient(
+                        colorStops = arrayOf(
+                            0f to backgroundColor,
+                            0.34f to backgroundColor.copy(alpha = 0.94f),
+                            0.58f to backgroundColor.copy(alpha = 0.72f),
+                            0.82f to backgroundColor.copy(alpha = 0.30f),
+                            1f to backgroundColor.copy(alpha = 0.06f),
+                        ),
+                    ),
+                ),
+        )
+        Box(
+            modifier = Modifier
+                .matchParentSize()
+                .background(
+                    Brush.verticalGradient(
+                        colorStops = arrayOf(
+                            0.30f to Color.Transparent,
+                            0.62f to backgroundColor.copy(alpha = 0.45f),
+                            0.85f to backgroundColor.copy(alpha = 0.85f),
+                            1f to backgroundColor,
+                        ),
+                    ),
+                ),
+        )
+
+        Column(
+            modifier = Modifier
+                .fillMaxSize()
+                .verticalScroll(rememberScrollState())
+                .focusProperties { up = backFocus },
+        ) {
+            HeroContentSection(
+                meta = meta,
+                nextEpisode = null,
+                nextToWatch = null,
+                onPlayClick = { playable?.let(onPlay) },
+                isPlayEnabled = playable != null,
+                isInLibrary = false,
+                onToggleLibrary = {},
+                onLibraryLongPress = {},
+                isMovieWatched = false,
+                isMovieWatchedPending = false,
+                onToggleMovieWatched = {},
+                playButtonFocusRequester = playFocusRequester,
+            )
+            JellyfinMediaBadgesRow(item = item)
+            if (meta.castMembers.isNotEmpty()) {
+                CastSection(
+                    cast = meta.castMembers,
+                    listState = rememberLazyListState(),
+                    title = "People",
+                    modifier = Modifier.padding(top = NuvioTheme.spacing.lg),
+                    onCastMemberClick = { member ->
+                        val preferCrew = member.character.equals("Creator", ignoreCase = true) ||
+                            member.character.equals("Director", ignoreCase = true) ||
+                            member.character.equals("Writer", ignoreCase = true)
+                        castScope.launch {
+                            val id = member.tmdbId
+                                ?: JellyfinRepository.searchPersonId(member.name)
+                            if (id != null) onNavigateToCastDetail(id, member.name, preferCrew)
+                        }
+                    },
+                )
+            }
+            if (item.isSeries && state.seasons.isNotEmpty()) {
+                JellyfinSeasonsChips(
+                    state = state,
+                    modifier = Modifier.padding(top = NuvioTheme.spacing.lg),
+                )
+            }
+            if (item.isSeries || item.isFolder) {
+                JellyfinDetailEpisodes(
+                    state = state,
+                    onPlay = onPlay,
+                    modifier = Modifier.padding(top = NuvioTheme.spacing.sm),
+                )
+            }
+            Spacer(Modifier.height(NuvioTheme.spacing.xxl))
+        }
+
+        Button(
+            onClick = onBack,
+            shape = ButtonDefaults.shape(shape = RoundedCornerShape(8.dp)),
+            colors = ButtonDefaults.colors(
+                containerColor = Color.White.copy(alpha = 0.15f),
+                focusedContainerColor = Color.White,
+                focusedContentColor = Color.Black,
+            ),
+            modifier = Modifier
+                .align(Alignment.TopStart)
+                .padding(24.dp)
+                .focusRequester(backFocus)
+                .focusProperties { down = playFocusRequester },
+        ) {
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                Icon(
+                    Icons.AutoMirrored.Rounded.ArrowBack,
+                    contentDescription = null,
+                    modifier = Modifier.size(18.dp),
+                )
+                Text(
+                    text = stringResource(com.nuvio.tv.R.string.action_back),
+                    fontWeight = FontWeight.Bold,
+                    modifier = Modifier.padding(start = 8.dp),
+                )
+            }
+        }
+    }
+}
