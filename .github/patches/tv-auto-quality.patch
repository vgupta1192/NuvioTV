@@ -0,0 +1,322 @@
+package com.nuvio.tv.ui.screens.player
+
+import android.os.SystemClock
+import android.util.Log
+import androidx.media3.common.C
+import androidx.media3.common.Player
+import androidx.media3.common.util.UnstableApi
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.launch
+
+/**
+ * Auto quality for adaptive (multi-rendition) streams, driven by a measured throughput sample of the
+ * playing stream. Three pieces:
+ *
+ *  - [AutoQualitySpeedTest] keeps the latest measured download speed: on ExoPlayer it is fed from the
+ *    player's own bandwidth meter (an `AnalyticsListener` hook, real bytes over real load time), on
+ *    mpv from its `cache-speed` (real bytes into the demuxer cache). The latest result is surfaced in
+ *    the dx stream stats overlay.
+ *  - Auto quality hot swap: while it is enabled and an adaptive stream plays, the playing rendition is
+ *    compared against the measured speed every progress tick. An upgrade needs the estimate to stay
+ *    above 1.3x the next rendition's bitrate for [AUTO_QUALITY_UPGRADE_HOLD_MS] with buffer to spare;
+ *    a downgrade takes [AUTO_QUALITY_DOWNGRADE_SAMPLES] consecutive samples below the playing
+ *    rendition's bitrate. Switches happen through the same track-selection override the quality
+ *    chooser uses, so playback never restarts.
+ *  - Fast start: when enabled (with auto quality on), a fresh adaptive stream is pinned to its lowest
+ *    rendition as soon as its tracks are known, and upgrades run through the same hysteresis once the
+ *    first buffering has completed.
+ *
+ * A quality picked by hand in the player (a video track override that auto quality did not set)
+ * stands down until the chooser's Auto entry is picked again.
+ */
+internal object AutoQualitySpeedTest {
+    /** Smoothing weight of a new measurement, Echo-style EMA. */
+    private const val EMA_NEW_WEIGHT = 0.3
+
+    /** A result older than this is from another session and is not shown. */
+    private const val FRESH_MS = 120_000L
+
+    @Volatile private var estimateBps: Long = 0L
+    @Volatile private var latestRawBps: Long = 0L
+    @Volatile private var latestAtElapsedMs: Long = 0L
+
+    /** One bandwidth-meter reading (bits/s); several arrive while data loads. */
+    fun recordBandwidthEstimate(bitrateEstimateBps: Long) {
+        if (bitrateEstimateBps <= 0L) return
+        synchronized(this) {
+            latestRawBps = bitrateEstimateBps
+            val smoothed = if (estimateBps <= 0L) {
+                bitrateEstimateBps.toDouble()
+            } else {
+                estimateBps * (1.0 - EMA_NEW_WEIGHT) + bitrateEstimateBps * EMA_NEW_WEIGHT
+            }
+            estimateBps = smoothed.toLong()
+            latestAtElapsedMs = SystemClock.elapsedRealtime()
+        }
+    }
+
+    /** mpv's demuxer fill rate (bytes/s), sampled from the progress loop; feeds the overlay only. */
+    fun recordMpvCacheSpeed(bytesPerSecond: Long) {
+        if (bytesPerSecond <= 0L) return
+        recordBandwidthEstimate(bytesPerSecond * 8L)
+    }
+
+    /** The smoothed measurement, or null when nothing has been measured recently. */
+    fun latestBps(): Long? {
+        val at = latestAtElapsedMs
+        if (at == 0L || SystemClock.elapsedRealtime() - at > FRESH_MS) return null
+        return estimateBps.takeIf { it > 0L }
+    }
+}
+
+/** Per-playback state of the auto quality engine; one instance lives on the controller. */
+internal class AutoQualityState {
+    val speedTest = AutoQualitySpeedTest()
+
+    /** The stream the engine last saw; a change re-arms fast start and drops the streaks. */
+    var lastSeenStreamUrl: String? = null
+
+    /** Fast start is waiting for the stream's tracks so it can pin the lowest rendition. */
+    var fastStartPending: Boolean = false
+
+    /** The rendition auto quality itself pinned (null: none); a different override is the user's. */
+    var pinnedHeightPx: Int? = null
+
+    /** No switch this soon after the previous one: the new rendition needs time to settle. */
+    var lastSwitchAtElapsedMs: Long = Long.MIN_VALUE / 2
+
+    /** How long the estimate has been above the upgrade threshold (ms); null while it is below. */
+    var upgradeHoldSinceElapsedMs: Long? = null
+
+    /** Consecutive samples below the downgrade threshold. */
+    var downgradeStreak: Int = 0
+
+    /** Settings snapshot, kept current by [PlayerRuntimeController.observeAutoQualitySettings]. */
+    var autoEnabled: Boolean = true
+    var fastStartEnabled: Boolean = false
+
+    fun onStreamChanged() {
+        fastStartPending = false
+        upgradeHoldSinceElapsedMs = null
+        downgradeStreak = 0
+    }
+}
+
+// Tuning: an upgrade needs sustained headroom, a downgrade reacts quickly.
+private const val AUTO_QUALITY_UPGRADE_HEADROOM = 1.3
+private const val AUTO_QUALITY_UPGRADE_HOLD_MS = 5_000L
+private const val AUTO_QUALITY_UPGRADE_MIN_BUFFER_MS = 10_000L
+private const val AUTO_QUALITY_DOWNGRADE_SAMPLES = 2
+private const val AUTO_QUALITY_DOWNGRADE_HEADROOM = 1.1
+private const val AUTO_QUALITY_SWITCH_SETTLE_MS = 10_000L
+private const val AUTO_QUALITY_TAG = "AUTO_QUALITY"
+
+/**
+ * Settings observer: keeps the engine's snapshot current. Runs for the player's whole lifetime; the
+ * tick reads the snapshot, so no restart bookkeeping is needed here.
+ */
+internal fun PlayerRuntimeController.observeAutoQualitySettings() {
+    scope.launch {
+        playerSettingsDataStore.playerSettings.collect { settings ->
+            autoQualityState.autoEnabled = settings.autoQualityEnabled
+            autoQualityState.fastStartEnabled = settings.fastStartEnabled
+        }
+    }
+}
+
+/**
+ * One look at playback, from the existing progress loop (every ~500 ms while it runs). ExoPlayer
+ * only: mpv has no rendition hot swap in this tree, so nothing is faked there (its progress tick
+ * feeds the speed test instead). With auto quality off the function returns after the per-stream
+ * bookkeeping, and nothing about playback changes.
+ */
+@OptIn(UnstableApi::class)
+internal fun PlayerRuntimeController.autoQualityTick() {
+    val state = autoQualityState
+    val player = _exoPlayer ?: return
+    if (isUsingMpvEngine()) return
+    if (!state.autoEnabled) return
+
+    // A new stream: reset the per-stream bookkeeping, restore what auto quality itself pinned (the
+    // user's own override survives), and re-arm fast start.
+    if (currentStreamUrl != state.lastSeenStreamUrl) {
+        val wasOurs = state.pinnedHeightPx != null && currentVideoOverrideHeightPx() == state.pinnedHeightPx
+        if (wasOurs) {
+            player.applyVideoQuality(null)
+            state.pinnedHeightPx = null
+        }
+        state.onStreamChanged()
+        state.lastSeenStreamUrl = currentStreamUrl
+        state.fastStartPending = state.fastStartEnabled
+    }
+
+    val ui = _uiState.value
+    if (ui.playbackEnded || ui.error != null) return
+    if (_playbackTimeline.value.isLive || player.isCurrentMediaItemLive) return
+
+    val qualities = runCatching { player.extractVideoQualities() }.getOrDefault(emptyList())
+    if (qualities.size < 2) return
+    val overrideHeight = currentVideoOverrideHeightPx()
+    val isManual = overrideHeight != null && overrideHeight != state.pinnedHeightPx
+    if (isManual) {
+        // A hand-picked quality stands until the chooser's Auto entry clears it.
+        state.upgradeHoldSinceElapsedMs = null
+        state.downgradeStreak = 0
+        return
+    }
+
+    // Fast start: pin the lowest rendition the moment the tracks are known, before the initial ABR
+    // choice can start pulling a heavy variant. The settle window below is what defers the first
+    // upgrade until after the first buffering has completed.
+    if (state.fastStartPending) {
+        state.fastStartPending = false
+        val lowest = qualities.lastOrNull() ?: return
+        if (lowest.heightPx > 0 && lowest.heightPx != overrideHeight) {
+            player.applyVideoQuality(lowest.heightPx)
+            state.pinnedHeightPx = lowest.heightPx
+            state.lastSwitchAtElapsedMs = SystemClock.elapsedRealtime()
+            state.upgradeHoldSinceElapsedMs = null
+            state.downgradeStreak = 0
+            Log.i(
+                PlayerRuntimeController.TAG,
+                "$AUTO_QUALITY_TAG: fast start pinned ${lowest.label} (${qualities.size} renditions)"
+            )
+        }
+        return
+    }
+
+    if (player.playbackState != Player.STATE_READY) return
+    if (!player.playWhenReady || userPausedManually) return
+    val now = SystemClock.elapsedRealtime()
+    if (now - state.lastSwitchAtElapsedMs < AUTO_QUALITY_SWITCH_SETTLE_MS) return
+
+    val estimateBps = state.speedTest.latestBps() ?: return
+    val playing = qualities.firstOrNull { it.isSelected } ?: run {
+        // Nothing pinned and ABR is in charge: judge against the rendition the player reports.
+        val current = player.videoFormat?.height?.takeIf { it > 0 } ?: return
+        qualities.firstOrNull { it.heightPx == current } ?: return
+    }
+    val playingBitrateBps = playing.bitrate?.takeIf { it > 0 }?.toLong()
+        ?: PlayerBitrateEstimator.fileBitrateBps(currentVideoSize, _playbackTimeline.value.duration)
+            ?.toLong()
+        ?: return
+
+    // Downgrade first: two consecutive samples below what is playing. The target is the highest
+    // lower rendition the connection carries with a little to spare.
+    if (estimateBps < playingBitrateBps) {
+        state.upgradeHoldSinceElapsedMs = null
+        state.downgradeStreak += 1
+        if (state.downgradeStreak >= AUTO_QUALITY_DOWNGRADE_SAMPLES) {
+            state.downgradeStreak = 0
+            val target = qualities
+                .filter { it.heightPx < playing.heightPx }
+                .firstOrNull { candidate ->
+                    val candidateBps = candidate.bitrate?.takeIf { it > 0 }?.toLong()
+                        ?: return@firstOrNull true
+                    candidateBps * AUTO_QUALITY_DOWNGRADE_HEADROOM <= estimateBps
+                }
+                ?: return
+            switchAutoQualityRendition(
+                player,
+                state,
+                target,
+                reason = "bandwidth ${estimateBps / 1_000_000.0} Mbps below ${playingBitrateBps / 1_000_000.0} Mbps"
+            )
+        }
+        return
+    }
+    state.downgradeStreak = 0
+
+    // Upgrade: the estimate must stay above 1.3x the next rendition for a while, with buffer to
+    // hide the switch, and the next rendition must declare a bitrate (missing metadata is not
+    // evidence that it fits).
+    val bufferedAheadMs = (player.bufferedPosition - player.currentPosition).coerceAtLeast(0L)
+    val next = qualities
+        .filter { it.heightPx > playing.heightPx }
+        .minByOrNull { it.heightPx }
+    val nextBitrateBps = next?.bitrate?.takeIf { it > 0 }?.toLong()
+    val upgradeSustained = if (
+        bufferedAheadMs >= AUTO_QUALITY_UPGRADE_MIN_BUFFER_MS &&
+        !player.isLoading &&
+        nextBitrateBps != null &&
+        nextBitrateBps * AUTO_QUALITY_UPGRADE_HEADROOM <= estimateBps
+    ) {
+        val since = state.upgradeHoldSinceElapsedMs
+        if (since == null) {
+            state.upgradeHoldSinceElapsedMs = now
+            false
+        } else {
+            now - since >= AUTO_QUALITY_UPGRADE_HOLD_MS
+        }
+    } else {
+        state.upgradeHoldSinceElapsedMs = null
+        false
+    }
+    if (upgradeSustained && next != null) {
+        state.upgradeHoldSinceElapsedMs = null
+        switchAutoQualityRendition(
+            player,
+            state,
+            next,
+            reason = "bandwidth ${estimateBps / 1_000_000.0} Mbps sustained over ${AUTO_QUALITY_UPGRADE_HOLD_MS / 1000}s"
+        )
+    }
+}
+
+/** The video height pinned by a track override, or null when the selection is unconstrained. */
+@OptIn(UnstableApi::class)
+internal fun PlayerRuntimeController.currentVideoOverrideHeightPx(): Int? {
+    val player = _exoPlayer ?: return null
+    return runCatching {
+        player.trackSelectionParameters.overrides.values
+            .firstOrNull { it.mediaTrackGroup.type == C.TRACK_TYPE_VIDEO }
+            ?.let { pin -> pin.mediaTrackGroup.getFormat(pin.trackIndices.first()).height }
+            ?.takeIf { it > 0 }
+    }.getOrNull()
+}
+
+/**
+ * Applies a rendition switch through the same override the quality chooser uses (no seek, no media
+ * source change) and records it as auto quality's own pin, so a user's hand-picked quality is never
+ * mistaken for it.
+ */
+private fun PlayerRuntimeController.switchAutoQualityRendition(
+    player: ExoPlayer,
+    state: AutoQualityState,
+    target: VideoQualityOption,
+    reason: String,
+) {
+    val previous = state.pinnedHeightPx
+    runCatching { player.applyVideoQuality(target.heightPx) }
+        .onFailure {
+            Log.w(PlayerRuntimeController.TAG, "$AUTO_QUALITY_TAG: switch to ${target.label} failed", it)
+            return
+        }
+    state.pinnedHeightPx = target.heightPx
+    state.lastSwitchAtElapsedMs = SystemClock.elapsedRealtime()
+    val direction = if (previous == null || target.heightPx > previous) "up" else "down"
+    Log.i(
+        PlayerRuntimeController.TAG,
+        "$AUTO_QUALITY_TAG: $direction to ${target.label} ($reason)"
+    )
+}
+
+/**
+ * Fast start's other half: called from the player's analytics listener when the track selection
+ * changes. The first call after a stream change runs the tick, which may pin the lowest rendition;
+ * later calls drop auto quality's pin record when the override it set no longer holds (the player
+ * re-selected on its own), so the next decision starts from the truth.
+ */
+internal fun PlayerRuntimeController.onExoTracksChangedForAutoQuality() {
+    val state = autoQualityState
+    if (state.fastStartPending) {
+        autoQualityTick()
+        return
+    }
+    val pinned = state.pinnedHeightPx ?: return
+    val override = currentVideoOverrideHeightPx()
+    val playingHeight = _exoPlayer?.videoFormat?.height?.takeIf { it > 0 }
+    if (override == null && playingHeight != pinned) {
+        state.pinnedHeightPx = null
+    }
+}
