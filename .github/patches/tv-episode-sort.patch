+package com.nuvio.tv.ui.screens.detail
+
+import androidx.annotation.StringRes
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.remember
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.focusRequester
+import androidx.compose.ui.res.stringResource
+import androidx.tv.material3.Button
+import androidx.tv.material3.ButtonDefaults
+import androidx.tv.material3.ExperimentalTvMaterial3Api
+import androidx.tv.material3.Text
+import com.nuvio.tv.R
+import com.nuvio.tv.domain.model.Video
+import com.nuvio.tv.ui.components.NuvioDialog
+import com.nuvio.tv.ui.theme.NuvioTheme
+
+/** Episode navigator sort (ported from NuvioMobile-Enhanced): changes only the order shown in the episode row. */
+enum class EpisodeSortOrder(@StringRes val labelRes: Int, @StringRes val shortLabelRes: Int) {
+    FirstToLast(R.string.episode_sort_first_to_last, R.string.episode_sort_short_default),
+    LastToFirst(R.string.episode_sort_last_to_first, R.string.episode_sort_short_last),
+    HighestRated(R.string.episode_sort_highest_rated, R.string.episode_sort_short_rated),
+    NewestAired(R.string.episode_sort_newest_aired, R.string.episode_sort_short_newest),
+    UnwatchedFirst(R.string.episode_sort_unwatched_first, R.string.episode_sort_short_unwatched),
+}
+
+fun List<Video>.sortedForNavigator(
+    sort: EpisodeSortOrder,
+    isWatched: (Video) -> Boolean,
+    ratingOf: (Video) -> Double?,
+): List<Video> = when (sort) {
+    EpisodeSortOrder.FirstToLast -> this
+    EpisodeSortOrder.LastToFirst -> asReversed()
+    EpisodeSortOrder.HighestRated -> sortedByDescending { ratingOf(it) ?: -1.0 }
+    EpisodeSortOrder.NewestAired -> sortedByDescending { it.released.orEmpty() }
+    EpisodeSortOrder.UnwatchedFirst -> sortedBy { isWatched(it) }
+}
+
+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+fun EpisodeSortDialog(
+    selected: EpisodeSortOrder,
+    onDismiss: () -> Unit,
+    onSelect: (EpisodeSortOrder) -> Unit,
+) {
+    val selectedFocusRequester = remember { FocusRequester() }
+    LaunchedEffect(Unit) { selectedFocusRequester.requestFocus() }
+
+    NuvioDialog(
+        onDismiss = onDismiss,
+        title = stringResource(R.string.episode_sort_title),
+    ) {
+        EpisodeSortOrder.entries.forEach { order ->
+            Button(
+                onClick = { onSelect(order) },
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .then(if (order == selected) Modifier.focusRequester(selectedFocusRequester) else Modifier),
+                colors = ButtonDefaults.colors(
+                    containerColor = if (order == selected) NuvioTheme.colors.SurfaceVariant else NuvioTheme.colors.BackgroundCard,
+                    contentColor = NuvioTheme.colors.TextPrimary,
+                ),
+            ) {
+                Text(stringResource(order.labelRes))
+            }
+        }
+    }
+}
