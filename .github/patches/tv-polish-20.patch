+        libraryBusy = true
+        val wasIn = _state.value.isInLibrary
+        viewModelScope.launch {
+            val ok = runCatching {
+                val input = libraryInput(item, meta)
+                val first = libraryRepository.toggleDefault(input)
+                if (first.requiresRemovalConfirmation) {
+                    libraryRepository.toggleDefault(
+                        input,
+                        first.requiredRemovalConfirmations.mapTo(linkedSetOf()) { it.providerId },
+                    )
+                }
+            }
+            libraryBusy = false
+            onResult(if (ok.isSuccess) !wasIn else null)
+        }
+    }
