+import com.nuvio.tv.ui.screens.player.TvForkPlayerPrefs
+import dagger.hilt.EntryPoint
+import dagger.hilt.InstallIn
+import dagger.hilt.android.EntryPointAccessors
+import dagger.hilt.components.SingletonComponent
+
+/**
+ * Live TV subtitles follow the main player's subtitle settings (size, font, colours, outline or shadow,
+ * background, position), so a channel's captions look the same as a movie's instead of ExoPlayer's
+ * default white text on a black box.
+ */
+@EntryPoint
+@InstallIn(SingletonComponent::class)
+internal interface LiveTvSubtitleStyleEntryPoint {
+    fun playerSettingsDataStore(): PlayerSettingsDataStore
+}
+
+/** Subtitle style from the main player settings, updated live; null until the first read. */
+@Composable
+internal fun rememberLiveTvSubtitleStyle(): State<SubtitleStyleSettings?> {
+    val context = LocalContext.current.applicationContext
+    return produceState<SubtitleStyleSettings?>(initialValue = null, context) {
+        val store = runCatching {
+            EntryPointAccessors.fromApplication(context, LiveTvSubtitleStyleEntryPoint::class.java)
+                .playerSettingsDataStore()
+        }.getOrNull() ?: return@produceState
+        store.playerSettings.collect { value = it.subtitleStyle }
+    }
+}
+
+private const val LIVE_TV_SUBTITLE_BASE_SP = 24f
+
+internal fun PlayerView.applyLiveTvSubtitleStyle(style: SubtitleStyleSettings) {
+    val subView = subtitleView ?: return
+    subView.apply {
+        setFixedTextSize(TypedValue.COMPLEX_UNIT_SP, LIVE_TV_SUBTITLE_BASE_SP * (style.size / 100f))
+        setApplyEmbeddedFontSizes(false)
+        setApplyEmbeddedStyles(true)
+
+        val typeface = SubtitleFontStore.exoTypeface(context, style.bold)
+            ?: if (style.bold) Typeface.DEFAULT_BOLD else Typeface.DEFAULT
+
+        val shadow = if (style.outlineEnabled) 0 else TvForkPlayerPrefs.subtitleShadow
+        val edgeType = when {
+            style.outlineEnabled -> CaptionStyleCompat.EDGE_TYPE_OUTLINE
+            shadow > 0 -> CaptionStyleCompat.EDGE_TYPE_DROP_SHADOW
+            else -> CaptionStyleCompat.EDGE_TYPE_NONE
+        }
+        val edgeColor = when (shadow) {
+            1 -> AndroidColor.argb(140, 0, 0, 0)
+            2 -> AndroidColor.BLACK
+            else -> style.outlineColor
+        }
+        setStyle(
+            CaptionStyleCompat(
+                style.textColor,
+                style.backgroundColor,
+                AndroidColor.TRANSPARENT,
+                edgeType,
+                edgeColor,
+                typeface,
+            )
+        )
+
+        val bottomPaddingFraction = (0.06f + (style.verticalOffset / 250f)).coerceIn(0f, 0.4f)
+        val applyPosition = {
+            val extraPadding = (height * (style.verticalOffset / 400f)).toInt().coerceAtLeast(0)
+            setPadding(paddingLeft, paddingTop, paddingRight, extraPadding)
