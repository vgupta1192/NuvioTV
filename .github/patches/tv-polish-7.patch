+    fun playTrailer(trailer: MetaTrailer, title: String?, year: String?) {
+        val ytId = trailer.ytId?.trim().orEmpty()
+        if (ytId.isBlank()) {
+            _state.update { it.copy(trailerOverlay = JellyfinTrailerOverlay(trailer, false, error = "Trailer unavailable")) }
+            return
+        }
+        _state.update { it.copy(trailerOverlay = JellyfinTrailerOverlay(trailer)) }
+        viewModelScope.launch {
+            val source = runCatching {
+                trailerService.getTrailerPlaybackSourceFromYouTubeUrl(
+                    youtubeUrl = "https://www.youtube.com/watch?v=$ytId",
+                    title = title,
+                    year = year,
+                )
+            }.getOrNull()
+            _state.update { current ->
+                val overlay = current.trailerOverlay
+                if (overlay == null || overlay.trailer.ytId != trailer.ytId) {
+                    current
+                } else {
+                    current.copy(
+                        trailerOverlay = overlay.copy(
+                            isLoading = false,
+                            videoUrl = source?.videoUrl,
+                            audioUrl = source?.audioUrl,
+                            error = if (source == null) "Trailer unavailable" else null,
+                        ),
+                    )
+                }
+            }
+        }
+    }
