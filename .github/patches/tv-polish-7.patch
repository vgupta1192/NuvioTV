+/** Pill tab row under the episodes; focusing a tab switches the section below it. */
+@Composable
+private fun JellyfinTabRow(
+    tabs: List<JellyfinTab>,
+    active: JellyfinTab,
+    onSelect: (JellyfinTab) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    Row(
+        modifier = modifier.padding(horizontal = NuvioTheme.spacing.xxxl),
+        horizontalArrangement = Arrangement.spacedBy(10.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        tabs.forEach { tab ->
+            val selected = tab == active
+            Surface(
+                onClick = { onSelect(tab) },
+                modifier = Modifier.onFocusChanged { if (it.isFocused) onSelect(tab) },
+                shape = ClickableSurfaceDefaults.shape(RoundedCornerShape(999.dp)),
+                scale = ClickableSurfaceDefaults.scale(focusedScale = 1.05f),
+                border = ClickableSurfaceDefaults.border(
+                    focusedBorder = Border(androidx.compose.foundation.BorderStroke(3.dp, Color.White)),
+                ),
+                colors = ClickableSurfaceDefaults.colors(
+                    containerColor = if (selected) NuvioTheme.colors.Secondary.copy(alpha = 0.22f) else Color.White.copy(alpha = 0.06f),
+                    contentColor = if (selected) NuvioTheme.colors.TextPrimary else NuvioTheme.colors.TextTertiary,
+                    focusedContainerColor = Color.White.copy(alpha = 0.18f),
+                    focusedContentColor = Color.White,
+                ),
+            ) {
+                Text(
+                    text = tab.label,
+                    style = MaterialTheme.typography.titleMedium.copy(fontWeight = FontWeight.SemiBold),
+                    modifier = Modifier.padding(horizontal = 20.dp, vertical = 9.dp),
+                )
+            }
+        }
+    }
+}
+
+/** Fills the Jellyfin item's meta from TMDB the same way the addon detail page does. */
+private fun mergeTmdbEnrichment(meta: Meta, e: TmdbEnrichment?, trailers: List<MetaTrailer>): Meta {
+    if (e == null) return meta
+    val tmdbCast = e.castMembers + e.directorMembers + e.writerMembers
+    val cast = meta.castMembers.map { member ->
+        val match = tmdbCast.firstOrNull { it.name.equals(member.name, ignoreCase = true) }
+        if (match == null) member else member.copy(tmdbId = member.tmdbId ?: match.tmdbId, photo = member.photo ?: match.photo)
+    }
+    val leading = (e.directorMembers + e.writerMembers).filter { crew ->
+        cast.none { it.name.equals(crew.name, ignoreCase = true) }
+    }.distinctBy { it.name }
+    return meta.copy(
+        description = meta.description?.takeIf { it.isNotBlank() } ?: e.description,
+        genres = meta.genres.ifEmpty { e.genres },
+        status = e.status ?: meta.status,
+        country = meta.country ?: e.countries?.joinToString(", ")?.takeIf { it.isNotBlank() },
+        language = meta.language ?: e.language,
+        ageRating = meta.ageRating ?: e.ageRating,
+        director = meta.director.ifEmpty { e.director },
+        writer = meta.writer.ifEmpty { e.writer },
+        castMembers = leading + cast,
+        networks = meta.networks.ifEmpty { e.networks },
+        productionCompanies = meta.productionCompanies.ifEmpty { e.productionCompanies },
+        trailers = trailers,
+    )
+}
